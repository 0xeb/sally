// Slovak (sk-SK) resources for unmime. Translation: Roman Paholík.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unmime/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unmime.rh2"

LANGUAGE LANG_SLOVAK, SUBLANG_SLOVAK_SLOVAKIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 241, 111
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnMIME - Konfigurácia"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Možnosti výpisu",IDC_STATIC_1,7,7,54,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ,63,11,172,1
    CONTROL         "Výpis e-mail &hlavičiek",IDC_CHECK_HEADERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,20,84,10
    CONTROL         "Výpis &tiel správ",IDC_CHECK_BODIES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,35,63,10
    CONTROL         "Pridať info o &znakovej sada, ak je iná ako US-ASCII",IDC_CHECK_APPEND,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,31,50,184,10
    CONTROL         "Výpis &príloh",IDC_CHECK_ATTACHMENTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,65,52,10
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ,6,82,229,1
    DEFPUSHBUTTON   "OK",IDOK,127,90,50,14
    PUSHBUTTON      "Zrušiť",IDCANCEL,184,90,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGINNAME, "UnMIME"
 IDS_OPENERROR, "Nie je možné otvoriť súbor."
 IDS_LOWMEM, "Nedostatok pamäti."
 IDS_LIST, "Nie je možné pridať záznam archívu do výpisu súborov."
 IDS_UNKNOWN, "Tento súbor obsahuje jeden alebo viac blokov s neznámym kódovaním.\nTieto bloky nebudú dekódované."
 IDS_WRITEERROR, "Chyba zápisu"
 IDS_EXTRTITLE, "Extrahovanie e-mail súboru - %s"
 IDS_UNPACKING, "extrahujem: "
 IDS_PARSE, "Analyzujem súbor..."
 IDS_BADBLOCK_DAMAGED, "Jeden alebo viac %s blokov je poškodených alebo\nmajú neznáma formát a nebudú dekódované."
 IDS_BADBLOCK_CRC, "Neplatný CRC v jednom alebo viacerých %s blokoch.\nTieto bloky nebudú dekódované."
 IDS_PLUGIN_DESCRIPTION, "Prehliada a extrahuje MIME/Base64, UU/XXEncode, yEncode a BinHex súbory."
 IDS_ABOUT_TITLE, "O plugine"
 IDS_RESOURCE_FORK_LOST, "Upozornenie: tento súbor obsahuje Mac zdrojovú časť.\nTáto časť nebude extrahovaná."
 IDS_DONT_SHOW_AGAIN, "&Nabudúce nezobrazovať"
}
