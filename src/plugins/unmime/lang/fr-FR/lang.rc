//
// French (fr-FR) resources for unmime. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unmime/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unmime.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 331, 111
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration UnMIME"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Options de liste",IDC_STATIC_1,7,7,54,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ,63,11,262,1
    CONTROL         "Lister les &en-têtes d'email",IDC_CHECK_HEADERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,20,99,10
    CONTROL         "Lister les &corps de message",IDC_CHECK_BODIES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,35,105,10
    CONTROL         "Ajouter les &infos du jeu de caractères au nom de fichier si différent du jeu US-ASCII",IDC_CHECK_APPEND,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,31,50,294,10
    CONTROL         "Lister les &pièces jointes",IDC_CHECK_ATTACHMENTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,65,91,10
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ,6,82,319,1
    DEFPUSHBUTTON   "OK",IDOK,217,90,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,274,90,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGINNAME, "UnMIME"
 IDS_OPENERROR, "Ouverture du fichier impossible."
 IDS_LOWMEM, "Mémoire insuffisante."
 IDS_LIST, "Ajout d'archive à la liste des fichiers impossible."
 IDS_UNKNOWN, "Ce fichier contient un ou plusieurs blocs à l'necodage inconnu.\nCes blocs ne seront pas décodés."
 IDS_WRITEERROR, "Erreur d'écriture"
 IDS_EXTRTITLE, "Décompression du fichier email - %s"
 IDS_UNPACKING, "décompression: "
 IDS_PARSE, "Analyse du fichier en cours..."
 IDS_BADBLOCK_DAMAGED, "Un ou plusieurs blocs %s sont endommagés ou présentent\nun format inconnu, et ne seront donc pas décodés."
 IDS_BADBLOCK_CRC, "Mauvais CRC dans un ou plusieurs blocs %s.\nCes blocs ne seront pas décodés."
 IDS_PLUGIN_DESCRIPTION, "Parcourt et extrait les fichiers MIME/Base64, UU/XXEncode, yEncode et BinHex."
 IDS_ABOUT_TITLE, "A propos du module"
 IDS_RESOURCE_FORK_LOST, "Attention: ce fichier contient un fork de ressource Mac.\nCe fork ne sera pas extrait."
 IDS_DONT_SHOW_AGAIN, "&Ne plus me le montrer"
}
