// Chinese (Simplified) (zh-CN) resources for unmime. Translation: Michael Lu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unmime/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unmime.rh2"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 251, 111
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnMIME 配置"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "列表选项",IDC_STATIC_1,7,7,37,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ,46,11,199,1
    CONTROL         "列出邮件头部(&H)",IDC_CHECK_HEADERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,20,76,10
    CONTROL         "列出消息主体(&B)",IDC_CHECK_BODIES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,35,80,10
    CONTROL         "附加 US-ASCII 以外的字符集信息到文件名(&C)",IDC_CHECK_APPEND,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,26,50,179,10
    CONTROL         "列出附件(&A)",IDC_CHECK_ATTACHMENTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,65,69,10
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ,6,82,239,1
    DEFPUSHBUTTON   "确定",IDOK,137,90,50,14
    PUSHBUTTON      "取消",IDCANCEL,194,90,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGINNAME, "UnMIME"
 IDS_OPENERROR, "不能打开文件。"
 IDS_LOWMEM, "内存不足。"
 IDS_LIST, "不能添加压缩包项到文件列表。"
 IDS_UNKNOWN, "此文件包含一个或多个未知编码的块。\n这些块将不会被解码。"
 IDS_WRITEERROR, "写入错误"
 IDS_EXTRTITLE, "正在解压邮件文件 - %s"
 IDS_UNPACKING, "正在解压: "
 IDS_PARSE, "正在分析文件..."
 IDS_BADBLOCK_DAMAGED, "一个或多个 %s 块已损坏或含有\n未知格式，将不会被解码。"
 IDS_BADBLOCK_CRC, "一个或多个 %s 块中 CRC 错误。\n这些块将不会被解码。"
 IDS_PLUGIN_DESCRIPTION, "浏览并解压 MIME/Base64, UU/XXEncode, yEncode 和 BinHex 文件。"
 IDS_ABOUT_TITLE, "关于插件"
 IDS_RESOURCE_FORK_LOST, "警告: 此文件包含 Mac 资源叉路。\n此叉路将不会被解码。"
 IDS_DONT_SHOW_AGAIN, "不要再次显示(&D)"
}
