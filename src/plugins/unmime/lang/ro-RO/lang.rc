//
// Romanian (ro-RO) resources for unmime. Translation: Ioan Stefancu, Donca Radu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unmime/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unmime.rh2"

LANGUAGE LANG_ROMANIAN, SUBLANG_ROMANIAN_ROMANIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 251, 111
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configurare UnMIME"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Lista optiuni",IDC_STATIC_1,7,7,42,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ,51,11,194,1
    CONTROL         "&Lista mail headers",IDC_CHECK_HEADERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,20,74,10
    CONTROL         "Lista mesaje &corpuri",IDC_CHECK_BODIES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,35,80,10
    CONTROL         "A&dauga charset info la nume fisier de e diferit de US-ASCII",IDC_CHECK_APPEND,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,31,50,210,10
    CONTROL         "Listeaza &atasamente",IDC_CHECK_ATTACHMENTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,65,82,10
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ,6,82,239,1
    DEFPUSHBUTTON   "OK",IDOK,137,90,50,14
    PUSHBUTTON      "Anuleaza",IDCANCEL,194,90,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGINNAME, "UnMIME"
 IDS_OPENERROR, "Nu pot deschide fisierul."
 IDS_LOWMEM, "Memorie insuficienta."
 IDS_LIST, "Nu pot adauga intrare arhiva la lista fisierelor."
 IDS_UNKNOWN, "Acest fisier contine unul sau mai multe blocuri cu codare necunoscuta.\nAceste blocuri nu vor fi decodate."
 IDS_WRITEERROR, "Eroare la scriere"
 IDS_EXTRTITLE, "Dezarhivare Fisier Mail - %s"
 IDS_UNPACKING, "dezarhivare: "
 IDS_PARSE, "Parcurg fisierul..."
 IDS_BADBLOCK_DAMAGED, "Unul sau mai multe %s blocuri sunt stricate sau au\nformat necunoscut si nu vor mai decodate."
 IDS_BADBLOCK_CRC, "CRC rau in unul sau mai multe %s blocuri.\nAceste blocuri nu vor fi decodate."
 IDS_PLUGIN_DESCRIPTION, "Rasfoieste si extrage fisierele MIME/Base64, UU/XXEncode, yEncode si BinHex."
 IDS_ABOUT_TITLE, "Despre Plugin"
 IDS_RESOURCE_FORK_LOST, "Atentie: acest fisier contine Mac resource fork.\nAceasta fork nu va fi dezarhivata."
 IDS_DONT_SHOW_AGAIN, "&Nu mai arata acest lucru din nou"
}
