// Russian (ru-RU) resources for unmime. Translation: Ален Хайруллин, Vasiliy, Игорь Полякофф, Neutron16.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unmime/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unmime.rh2"

LANGUAGE LANG_RUSSIAN, SUBLANG_RUSSIAN_RUSSIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 299, 111
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Настройка UnMIME"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Параметры списка",IDC_STATIC_1,7,7,68,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ,77,11,216,1
    CONTROL         "Отображать &заголовки сообщений",IDC_CHECK_HEADERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,20,134,10
    CONTROL         "Отображать &содержимое сообщений",IDC_CHECK_BODIES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,35,142,10
    CONTROL         "Указывать &кодировку символов, если кодировка отлична от US-ASCII",IDC_CHECK_APPEND,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,31,50,257,10
    CONTROL         "Отображать &присоединения",IDC_CHECK_ATTACHMENTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,65,112,10
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ,6,82,287,1
    DEFPUSHBUTTON   "ОК",IDOK,185,90,50,14
    PUSHBUTTON      "Отмена",IDCANCEL,242,90,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGINNAME, "UnMIME"
 IDS_OPENERROR, "Невозможно открыть файл."
 IDS_LOWMEM, "Недостаточно памяти."
 IDS_LIST, "Не удалось включить элемент архива в перечень файлов."
 IDS_UNKNOWN, "Файл содержит один или несколько блоков с неизвестной кодировкой символов.\nЭти блоки не будут декодированы."
 IDS_WRITEERROR, "Ошибка записи"
 IDS_EXTRTITLE, "Распаковка файла почты - %s"
 IDS_UNPACKING, "распаковка: "
 IDS_PARSE, "Обработка файла..."
 IDS_BADBLOCK_DAMAGED, "Один или несколько %s блоков повреждены или имеют\nнеизвестный формат и не будут декодированы."
 IDS_BADBLOCK_CRC, "Некорректная контрольная сумма CRC в одном или нескольких %s блоках.\nЭти блоки не будут декодированы."
 IDS_PLUGIN_DESCRIPTION, "Просмотр и извлечение файлов MIME/Base64, UU/XXEncode, yEncode и BinHex."
 IDS_ABOUT_TITLE, "О модуле"
 IDS_RESOURCE_FORK_LOST, "Предупреждение: файл содержит ветвь ресурсов Mac.\nЭта ветвь не будет распакована."
 IDS_DONT_SHOW_AGAIN, "&Больше не показывать это сообщение"
}
