// Dutch (nl-NL) resources for unmime. Translation: Cor van der Smissen, Marco Fung, Patrick Vijgeboom, S.V. (Stephan) Rietveld.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unmime/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unmime.rh2"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 321, 111
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnMIME configuratie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Geef opties weer",IDC_STATIC_1,7,7,59,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ,68,11,247,1
    CONTROL         "Geef Mail-&koppen weer",IDC_CHECK_HEADERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,20,90,10
    CONTROL         "Geef berichten&structuur weer",IDC_CHECK_BODIES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,35,111,10
    CONTROL         "&Voeg tekenset informatie toe aan de bestandsnaam indien anders dan US-ASCII",IDC_CHECK_APPEND,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,31,50,282,10
    CONTROL         "Geef &bijlagen weer",IDC_CHECK_ATTACHMENTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,65,76,10
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ,6,82,309,1
    DEFPUSHBUTTON   "OK",IDOK,207,90,50,14
    PUSHBUTTON      "Annuleren",IDCANCEL,264,90,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGINNAME, "UnMIME"
 IDS_OPENERROR, "Kan het bestand niet openen."
 IDS_LOWMEM, "Onvoldoende geheugen."
 IDS_LIST, "Kan geen toegang verkrijgen tot het achiefbestand om bestanden toe te voegen."
 IDS_UNKNOWN, "Dit bestand bevat één of meerdere blokken met een onbekende codering.\nDeze blokken zullen niet worden gedecodeerd."
 IDS_WRITEERROR, "Schrijf fout"
 IDS_EXTRTITLE, "Uitpakken van Mail-bestand - %s"
 IDS_UNPACKING, "uitpakken van: "
 IDS_PARSE, "Ontleden van bestand..."
 IDS_BADBLOCK_DAMAGED, "Één of meerdere %s blokken zijn beschadigd of van onbekend bestandsformaat\nen zal daardoor niet worden gedecodeerd."
 IDS_BADBLOCK_CRC, "Slecht CRC in één of meerdere %s blokken.\nDeze blokken zullen niet worden gedecodeerd."
 IDS_PLUGIN_DESCRIPTION, "Blader en extraheer MIME/Base64, UU/XXEncode, yEncode en BinHex bestanden."
 IDS_ABOUT_TITLE, "Over deze plugin"
 IDS_RESOURCE_FORK_LOST, "Waarschuwing: dit bestand bevat een Mac bronvertakking.\nDeze vertakking zal niet uitgepakt worden."
 IDS_DONT_SHOW_AGAIN, "&Laat dit niet meer zien"
}
