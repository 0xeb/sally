// Hungarian (hu-HU) resources for unmime. Translation: Török József.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unmime/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unmime.rh2"

LANGUAGE LANG_HUNGARIAN, SUBLANG_HUNGARIAN_HUNGARY

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 241, 111
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnMIME beállítás"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Listázási beállítások",IDC_STATIC_1,7,7,68,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ,77,11,158,1
    CONTROL         "&Levél fejléc listázása",IDC_CHECK_HEADERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,20,82,10
    CONTROL         "Ü&zenettörzsek listázása",IDC_CHECK_BODIES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,35,92,10
    CONTROL         "Karakter infó &csatolás a fájlnévhez, ha nem US-ASCII",IDC_CHECK_APPEND,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,31,50,190,10
    CONTROL         "Mellékletek listázás&a",IDC_CHECK_ATTACHMENTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,65,82,10
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ,6,82,229,1
    DEFPUSHBUTTON   "OK",IDOK,127,90,50,14
    PUSHBUTTON      "Mégse",IDCANCEL,184,90,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGINNAME, "UnMIME"
 IDS_OPENERROR, "Nem nyitható meg a fájl."
 IDS_LOWMEM, "Kevés memória."
 IDS_LIST, "Nem adható archívum bejegyzés a fájl listához."
 IDS_UNKNOWN, "A fájl, egy vagy több ismeretlen kódolású blokkot tartalmaz.\nEzen blokkok nem dekódolhatók."
 IDS_WRITEERROR, "Írási hiba"
 IDS_EXTRTITLE, "Levél fájl kibontása - %s"
 IDS_UNPACKING, "kibontás: "
 IDS_PARSE, "Fájl elemzése..."
 IDS_BADBLOCK_DAMAGED, "Egy vagy több %s blokk sérült vagy\nismeretlen formátumú és nem dekódolható."
 IDS_BADBLOCK_CRC, "Egy vagy több %s blokk hibás CRC-s.\nEzen blokkok nem dekódolhatók."
 IDS_PLUGIN_DESCRIPTION, "MIME/Base64, UU/XXEncode, yEncode és BinHex fájlok böngészése és kibontása."
 IDS_ABOUT_TITLE, "Plugin névjegy"
 IDS_RESOURCE_FORK_LOST, "Figyelem: a fájl Mac forrás elágazást tartalmaz.\nEz az elágazás nem bontható ki."
 IDS_DONT_SHOW_AGAIN, "&Ne mutassa újból"
}
