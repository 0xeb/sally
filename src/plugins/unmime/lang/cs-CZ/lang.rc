// Czech (cs-CZ) resources for unmime. Translation: Hynek Mikulič.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unmime/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unmime.rh2"

LANGUAGE LANG_CZECH, SUBLANG_CZECH_CZECH_REPUBLIC

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 241, 111
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnMIME - Konfigurace"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Možnosti výpisu",IDC_STATIC_1,7,7,54,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ,63,11,172,1
    CONTROL         "Výpis e-mail &hlaviček",IDC_CHECK_HEADERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,20,82,10
    CONTROL         "Výpis &těl zpráv",IDC_CHECK_BODIES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,35,62,10
    CONTROL         "Přidat info o &znakové sadě, pokud je jiná než US-ASCII",IDC_CHECK_APPEND,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,31,50,196,10
    CONTROL         "Výpis &příloh",IDC_CHECK_ATTACHMENTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,65,52,10
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ,6,82,229,1
    DEFPUSHBUTTON   "OK",IDOK,127,90,50,14
    PUSHBUTTON      "Storno",IDCANCEL,184,90,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGINNAME, "UnMIME"
 IDS_OPENERROR, "Nelze otevřít soubor."
 IDS_LOWMEM, "Nedostatek paměti."
 IDS_LIST, "Nelze přidat záznam archivu do výpisu souborů."
 IDS_UNKNOWN, "Tento soubor obsahuje jeden nebo více bloků s neznámým kódováním.\nTyto bloky nebudou dekódovány."
 IDS_WRITEERROR, "Chyba zápisu"
 IDS_EXTRTITLE, "Extrahování e-mail souboru - %s"
 IDS_UNPACKING, "extrahuji: "
 IDS_PARSE, "Analyzuji soubor..."
 IDS_BADBLOCK_DAMAGED, "Jeden nebo více %s bloků je poškozených nebo\nmají neznámý formát a nebudou dekódovány."
 IDS_BADBLOCK_CRC, "Neplatný CRC v jednom nebo více %s bloků.\nTyto bloky nebudou dekódovány."
 IDS_PLUGIN_DESCRIPTION, "Prohlíží a extrahuje MIME/Base64, UU/XXEncode, yEncode a BinHex soubory."
 IDS_ABOUT_TITLE, "O pluginu"
 IDS_RESOURCE_FORK_LOST, "Upozornění: tento soubor obsahuje Mac zdrojovou část.\nTato část nebude extrahována."
 IDS_DONT_SHOW_AGAIN, "&Příště nezobrazovat"
}
