// Korean (ko-KR) resources for unmime. Translation: Sally contributors (AI-assisted).
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unmime/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unmime.rh2"

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 251, 111
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnMIME 설정"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "목록 옵션",IDC_STATIC_1,7,7,37,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ,46,11,199,1
    CONTROL         "메일 헤더 나열(&H)",IDC_CHECK_HEADERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,20,76,10
    CONTROL         "메시지 본문 나열(&B)",IDC_CHECK_BODIES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,35,80,10
    CONTROL         "US-ASCII가 아니면 파일 이름에 문자 집합 정보 추가(&C)",IDC_CHECK_APPEND,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,26,50,179,10
    CONTROL         "첨부 파일 나열(&A)",IDC_CHECK_ATTACHMENTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,65,69,10
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ,6,82,239,1
    DEFPUSHBUTTON   "확인",IDOK,137,90,50,14
    PUSHBUTTON      "취소",IDCANCEL,194,90,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGINNAME, "UnMIME"
 IDS_OPENERROR, "파일을 열 수 없습니다."
 IDS_LOWMEM, "메모리가 부족합니다."
 IDS_LIST, "압축 파일 항목을 파일 목록에 추가할 수 없습니다."
 IDS_UNKNOWN, "이 파일에는 알 수 없는 인코딩의 블록이 하나 이상 있습니다.\n이 블록은 디코딩되지 않습니다."
 IDS_WRITEERROR, "쓰기 오류"
 IDS_EXTRTITLE, "메일 파일 압축 풀기 - %s"
 IDS_UNPACKING, "압축 푸는 중: "
 IDS_PARSE, "파일 분석 중..."
 IDS_BADBLOCK_DAMAGED, "하나 이상의 %s 블록이 손상되었거나 형식을\n알 수 없어 디코딩되지 않습니다."
 IDS_BADBLOCK_CRC, "하나 이상의 %s 블록에 잘못된 CRC가 있습니다.\n이 블록은 디코딩되지 않습니다."
 IDS_PLUGIN_DESCRIPTION, "MIME/Base64, UU/XXEncode, yEncode, BinHex 파일을 찾아보고 추출합니다."
 IDS_ABOUT_TITLE, "플러그인 정보"
 IDS_RESOURCE_FORK_LOST, "경고: 이 파일에는 Mac 리소스 포크가 있습니다.\n이 포크는 압축이 풀리지 않습니다."
 IDS_DONT_SHOW_AGAIN, "다시 표시 안 함(&D)"
}
