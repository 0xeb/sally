// German (de-DE) resources for unmime. Translation: Dirk Bornhütter, Thomas Kelso, Thomas Pagels, Thomas Wölk, Marko Meister und Mick Weiss.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unmime/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unmime.rh2"

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 266, 111
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnMIME - Konfiguration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Auflisten - Optionen",IDC_STATIC_1,7,7,69,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ,78,11,182,1
    CONTROL         "&Nachrichtenkopf auflisten",IDC_CHECK_HEADERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,20,98,10
    CONTROL         "Nachrichten&texte auflisten",IDC_CHECK_BODIES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,35,100,10
    CONTROL         "&Zeichensatzinfo zum Dateinamen hinzufügen falls kein US-ASCII",IDC_CHECK_APPEND,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,31,50,228,10
    CONTROL         "&Anhänge auflisten",IDC_CHECK_ATTACHMENTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,65,73,10
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ,6,82,254,1
    DEFPUSHBUTTON   "OK",IDOK,152,90,50,14
    PUSHBUTTON      "Abbrechen",IDCANCEL,209,90,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGINNAME, "UnMIME"
 IDS_OPENERROR, "Kann die Datei nicht öffnen."
 IDS_LOWMEM, "Nicht genügend Speicher."
 IDS_LIST, "Kann den Archiveintrag nicht zur Dateiliste hinzufügen."
 IDS_UNKNOWN, "Diese Datei enthält einen oder mehrere Blöcke mit unbekannter Kodierung.\nDiese Blöcke werden nicht dekodiert."
 IDS_WRITEERROR, "Schreibfehler"
 IDS_EXTRTITLE, "Entpacke Nachrichtendatei - %s"
 IDS_UNPACKING, "Entpacke: "
 IDS_PARSE, "Analysiere Datei..."
 IDS_BADBLOCK_DAMAGED, "Ein oder mehrere %s Blöcke sind beschädigt oder haben\nein unbekanntes Format und werden nicht dekodiert."
 IDS_BADBLOCK_CRC, "Falsche CRC in einem oder mehreren %s Blöcken.\nDiese Blöcke werden nicht dekodiert."
 IDS_PLUGIN_DESCRIPTION, "Durchsucht und entpackt MIME/Base64, UU/XX-/yEncode und BinHex Dateien."
 IDS_ABOUT_TITLE, "Über Plugin"
 IDS_RESOURCE_FORK_LOST, "Warnung: Diese Datei enthält eine Mac Ressourceverzweigung.\nDiese Verzweigung wird nicht entpackt."
 IDS_DONT_SHOW_AGAIN, "&Nicht wieder anzeigen"
}
