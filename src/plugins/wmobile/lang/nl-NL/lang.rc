// style and control in the same order as the English source (src/plugins/wmobile/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\wmobile.rh2"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_PROGRESSDLG DIALOGEX 18, 80, 353, 77
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "",IDT_OPERATION,8,11,32,8
    CONTROL         "",IDT_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,43,11,305,8
    RTEXT           "Totaal:",IDC_STATIC_1,9,35,26,8
    CONTROL         "",IDP_PROGRESSBAR,"Static",0,39,34,301,12
    PUSHBUTTON      "Annuleren",IDCANCEL,151,57,50,14
END

IDD_PROGRESS2DLG DIALOGEX 10, 30, 353, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "",IDT_OPERATION,3,11,37,8
    CONTROL         "",IDT_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,43,11,305,8
    RTEXT           "",IDT_OPERATION2,8,23,32,8
    CONTROL         "",IDT_FILENAME2,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,43,23,305,8
    RTEXT           "Bestand:",IDC_STATIC_1,8,41,32,8
    CONTROL         "",IDP_PROGRESSBAR2,"Static",0,43,40,297,12
    RTEXT           "Totaal:",IDC_STATIC_2,8,56,32,8
    CONTROL         "",IDP_PROGRESSBAR,"Static",0,43,55,297,12
    PUSHBUTTON      "Annuleren",IDCANCEL,155,78,50,14
END

IDD_ATTRIBUTES DIALOGEX 30, 29, 193, 203
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Veranderen van attributen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,91,12,96,1
    LTEXT           "Instellen van attributen",IDC_STATIC_2,9,8,80,8
    CONTROL         "&Archief",IDC_ARCHIVE,"Button",BS_AUTO3STATE | WS_GROUP | WS_TABSTOP,16,18,37,12
    CONTROL         "&Verborgen",IDC_HIDDEN,"Button",BS_AUTO3STATE | WS_TABSTOP,83,18,48,12
    CONTROL         "Alleen-&lezen",IDC_READONLY,"Button",BS_AUTO3STATE | WS_TABSTOP,16,30,54,12
    CONTROL         "S&ysteem",IDC_SYSTEM,"Button",BS_AUTO3STATE | WS_TABSTOP,83,30,42,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,92,58,95,1
    LTEXT           "Verander datum en tijd",IDC_STATIC_4,9,54,81,8
    LTEXT           "Ge&wijzigd",IDC_STATIC_5,16,71,34,8
    CONTROL         "",IDC_ATTR_MODIFIED_DATE,"SysDateTimePick32",DTS_SHOWNONE | WS_TABSTOP,63,69,66,12
    CONTROL         "",IDC_ATTR_MODIFIED_TIME,"SysDateTimePick32",DTS_UPDOWN | WS_TABSTOP | 0x8,135,69,50,12
    LTEXT           "Aange&maakt",IDC_STATIC_6,16,87,44,8
    CONTROL         "",IDC_ATTR_CREATED_DATE,"SysDateTimePick32",DTS_SHOWNONE | WS_TABSTOP,63,85,66,12
    CONTROL         "",IDC_ATTR_CREATED_TIME,"SysDateTimePick32",DTS_UPDOWN | WS_TABSTOP | 0x8,135,85,50,12
    LTEXT           "Benaderd &op",IDC_STATIC_7,16,103,46,8
    CONTROL         "",IDC_ATTR_ACCESSED_DATE,"SysDateTimePick32",DTS_SHOWNONE | WS_TABSTOP,63,101,66,12
    CONTROL         "",IDC_ATTR_ACCESSED_TIME,"SysDateTimePick32",DTS_UPDOWN | WS_TABSTOP | 0x8,135,101,50,12
    PUSHBUTTON      "Instellen h&uidig",IDC_ATTR_CURRENT,120,118,65,14
    CONTROL         "",IDC_STATIC_8,"Static",SS_ETCHEDHORZ | WS_GROUP,35,141,152,1
    LTEXT           "Opties",IDC_STATIC_9,9,137,24,8
    CONTROL         "Inclusief &subdirectories",IDC_RECURSESUBDIRS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,16,147,90,12
    CONTROL         "",IDC_STATIC_10,"Static",SS_ETCHEDHORZ | WS_GROUP,9,172,178,1
    DEFPUSHBUTTON   "OK",IDOK,15,181,50,14,WS_GROUP
    PUSHBUTTON      "Annuleren",IDCANCEL,71,181,50,14
    PUSHBUTTON      "Help",IDHELP,127,181,50,14
END

