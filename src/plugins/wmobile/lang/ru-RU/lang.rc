// style and control in the same order as the English source (src/plugins/wmobile/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\wmobile.rh2"

LANGUAGE LANG_RUSSIAN, SUBLANG_RUSSIAN_RUSSIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_PROGRESSDLG DIALOGEX 18, 80, 359, 77
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "",IDT_OPERATION,8,11,38,8
    CONTROL         "",IDT_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,49,11,305,8
    RTEXT           "Всего:",IDC_STATIC_1,17,35,24,8
    CONTROL         "",IDP_PROGRESSBAR,"Static",0,45,34,301,12
    PUSHBUTTON      "Отмена",IDCANCEL,154,57,50,14
END

IDD_PROGRESS2DLG DIALOGEX 10, 30, 365, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "",IDT_OPERATION,3,11,49,8
    CONTROL         "",IDT_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,55,11,305,8
    RTEXT           "",IDT_OPERATION2,8,23,44,8
    CONTROL         "",IDT_FILENAME2,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,55,23,305,8
    RTEXT           "Файл:",IDC_STATIC_1,28,41,24,8
    CONTROL         "",IDP_PROGRESSBAR2,"Static",0,55,40,297,12
    RTEXT           "Всего:",IDC_STATIC_2,28,56,24,8
    CONTROL         "",IDP_PROGRESSBAR,"Static",0,55,55,297,12
    PUSHBUTTON      "Отмена",IDCANCEL,157,78,50,14
END

IDD_ATTRIBUTES DIALOGEX 30, 29, 187, 203
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Изменение атрибутов"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,87,12,94,1
    LTEXT           "Установка атрибутов",IDC_STATIC_2,9,8,76,8
    CONTROL         "&Архивный",IDC_ARCHIVE,"Button",BS_AUTO3STATE | WS_GROUP | WS_TABSTOP,16,18,48,12
    CONTROL         "&Скрытый",IDC_HIDDEN,"Button",BS_AUTO3STATE | WS_TABSTOP,89,18,45,12
    CONTROL         "Только &чтение",IDC_READONLY,"Button",BS_AUTO3STATE | WS_TABSTOP,16,30,63,12
    CONTROL         "С&истемный",IDC_SYSTEM,"Button",BS_AUTO3STATE | WS_TABSTOP,89,30,53,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,111,58,70,1
    LTEXT           "Изменение даты и времени",IDC_STATIC_4,9,54,100,8
    LTEXT           "Из&менен",IDC_STATIC_5,16,71,33,8
    CONTROL         "",IDC_ATTR_MODIFIED_DATE,"SysDateTimePick32",DTS_SHOWNONE | WS_TABSTOP,57,69,66,12
    CONTROL         "",IDC_ATTR_MODIFIED_TIME,"SysDateTimePick32",DTS_UPDOWN | WS_TABSTOP | 0x8,129,69,50,12
    LTEXT           "С&оздан",IDC_STATIC_6,16,87,30,8
    CONTROL         "",IDC_ATTR_CREATED_DATE,"SysDateTimePick32",DTS_SHOWNONE | WS_TABSTOP,57,85,66,12
    CONTROL         "",IDC_ATTR_CREATED_TIME,"SysDateTimePick32",DTS_UPDOWN | WS_TABSTOP | 0x8,129,85,50,12
    LTEXT           "От&крыт",IDC_STATIC_7,16,103,37,8
    CONTROL         "",IDC_ATTR_ACCESSED_DATE,"SysDateTimePick32",DTS_SHOWNONE | WS_TABSTOP,57,101,66,12
    CONTROL         "",IDC_ATTR_ACCESSED_TIME,"SysDateTimePick32",DTS_UPDOWN | WS_TABSTOP | 0x8,129,101,50,12
    PUSHBUTTON      "Установить т&екущие",IDC_ATTR_CURRENT,89,118,90,14
    CONTROL         "",IDC_STATIC_8,"Static",SS_ETCHEDHORZ | WS_GROUP,53,141,128,1
    LTEXT           "Параметры",IDC_STATIC_9,9,137,42,8
    CONTROL         "Включая вложенные &папки",IDC_RECURSESUBDIRS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,16,147,107,12
    CONTROL         "",IDC_STATIC_10,"Static",SS_ETCHEDHORZ | WS_GROUP,9,172,172,1
    DEFPUSHBUTTON   "ОК",IDOK,13,181,50,14,WS_GROUP
    PUSHBUTTON      "Отмена",IDCANCEL,69,181,50,14
    PUSHBUTTON      "Справка",IDHELP,125,181,50,14
END

