// style and control in the same order as the English source (src/plugins/wmobile/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\wmobile.rh2"

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_PROGRESSDLG DIALOGEX 18, 80, 353, 77
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "",IDT_OPERATION,8,11,32,8
    CONTROL         "",IDT_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,43,11,305,8
    RTEXT           "전체:",IDC_STATIC_1,11,35,24,8
    CONTROL         "",IDP_PROGRESSBAR,"Static",0,39,34,301,12
    PUSHBUTTON      "취소",IDCANCEL,151,57,50,14
END

IDD_PROGRESS2DLG DIALOGEX 10, 30, 353, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "",IDT_OPERATION,3,11,37,8
    CONTROL         "",IDT_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,43,11,305,8
    RTEXT           "",IDT_OPERATION2,8,23,32,8
    CONTROL         "",IDT_FILENAME2,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,43,23,305,8
    RTEXT           "파일:",IDC_STATIC_1,18,41,22,8
    CONTROL         "",IDP_PROGRESSBAR2,"Static",0,43,40,297,12
    RTEXT           "전체:",IDC_STATIC_2,16,56,24,8
    CONTROL         "",IDP_PROGRESSBAR,"Static",0,43,55,297,12
    PUSHBUTTON      "취소",IDCANCEL,155,78,50,14
END

IDD_ATTRIBUTES DIALOGEX 30, 29, 181, 203
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "특성 변경"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,48,12,127,1
    LTEXT           "특성 설정",IDC_STATIC_2,9,8,37,8
    CONTROL         "보관(&A)",IDC_ARCHIVE,"Button",BS_AUTO3STATE | WS_GROUP | WS_TABSTOP,16,18,41,12
    CONTROL         "숨김(&H)",IDC_HIDDEN,"Button",BS_AUTO3STATE | WS_TABSTOP,75,18,40,12
    CONTROL         "읽기 전용(&R)",IDC_READONLY,"Button",BS_AUTO3STATE | WS_TABSTOP,16,30,49,12
    CONTROL         "시스템(&Y)",IDC_SYSTEM,"Button",BS_AUTO3STATE | WS_TABSTOP,75,30,40,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,73,58,102,1
    LTEXT           "날짜 및 시간 변경",IDC_STATIC_4,9,54,62,8
    LTEXT           "수정한 날짜(&M)",IDC_STATIC_5,16,71,31,8
    CONTROL         "",IDC_ATTR_MODIFIED_DATE,"SysDateTimePick32",DTS_SHOWNONE | WS_TABSTOP,51,69,66,12
    CONTROL         "",IDC_ATTR_MODIFIED_TIME,"SysDateTimePick32",DTS_UPDOWN | WS_TABSTOP | 0x8,123,69,50,12
    LTEXT           "만든 날짜(&T)",IDC_STATIC_6,16,87,30,8
    CONTROL         "",IDC_ATTR_CREATED_DATE,"SysDateTimePick32",DTS_SHOWNONE | WS_TABSTOP,51,85,66,12
    CONTROL         "",IDC_ATTR_CREATED_TIME,"SysDateTimePick32",DTS_UPDOWN | WS_TABSTOP | 0x8,123,85,50,12
    LTEXT           "액세스한 날짜(&D)",IDC_STATIC_7,16,103,30,8
    CONTROL         "",IDC_ATTR_ACCESSED_DATE,"SysDateTimePick32",DTS_SHOWNONE | WS_TABSTOP,51,101,66,12
    CONTROL         "",IDC_ATTR_ACCESSED_TIME,"SysDateTimePick32",DTS_UPDOWN | WS_TABSTOP | 0x8,123,101,50,12
    PUSHBUTTON      "현재 시간(&U)",IDC_ATTR_CURRENT,116,118,57,14
    CONTROL         "",IDC_STATIC_8,"Static",SS_ETCHEDHORZ | WS_GROUP,31,141,144,1
    LTEXT           "옵션",IDC_STATIC_9,9,137,20,8
    CONTROL         "하위 디렉터리 포함(&S)",IDC_RECURSESUBDIRS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,16,147,87,12
    CONTROL         "",IDC_STATIC_10,"Static",SS_ETCHEDHORZ | WS_GROUP,9,172,166,1
    DEFPUSHBUTTON   "확인",IDOK,9,181,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,65,181,50,14
    PUSHBUTTON      "도움말",IDHELP,121,181,50,14
END

