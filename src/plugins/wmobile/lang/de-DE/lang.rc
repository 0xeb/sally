// German (de-DE) resources for wmobile. Translation: Dirk Bornhütter, Thomas Kelso, Thomas Pagels, Thomas Wölk, Marko Meister und Mick Weiss.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/wmobile/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\wmobile.rh2"

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_PROGRESSDLG DIALOGEX 18, 80, 353, 77
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "",IDT_OPERATION,8,11,32,8
    CONTROL         "",IDT_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,43,11,305,8
    RTEXT           "Gesamt:",IDC_STATIC_1,8,35,32,8
    CONTROL         "",IDP_PROGRESSBAR,"Static",0,43,34,297,12
    PUSHBUTTON      "Abbrechen",IDCANCEL,151,57,50,14
END

IDD_PROGRESS2DLG DIALOGEX 10, 30, 353, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "",IDT_OPERATION,3,11,37,8
    CONTROL         "",IDT_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,43,11,305,8
    RTEXT           "",IDT_OPERATION2,3,23,37,8
    CONTROL         "",IDT_FILENAME2,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,43,23,305,8
    RTEXT           "Datei:",IDC_STATIC_1,3,41,37,8
    CONTROL         "",IDP_PROGRESSBAR2,"Static",0,43,40,297,12
    RTEXT           "Gesamt:",IDC_STATIC_2,3,56,37,8
    CONTROL         "",IDP_PROGRESSBAR,"Static",0,43,55,297,12
    PUSHBUTTON      "Abbrechen",IDCANCEL,155,78,50,14
END

IDD_ATTRIBUTES DIALOGEX 30, 29, 200, 203
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Attribute ändern"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,69,12,125,1
    LTEXT           "Attribute ändern",IDC_STATIC_2,9,8,58,8
    CONTROL         "&Archiv",IDC_ARCHIVE,"Button",BS_AUTO3STATE | WS_GROUP | WS_TABSTOP,16,18,41,12
    CONTROL         "&Versteckt",IDC_HIDDEN,"Button",BS_AUTO3STATE | WS_TABSTOP,79,18,45,12
    CONTROL         "Nur &Lesen",IDC_READONLY,"Button",BS_AUTO3STATE | WS_TABSTOP,16,30,49,12
    CONTROL         "S&ystem",IDC_SYSTEM,"Button",BS_AUTO3STATE | WS_TABSTOP,79,30,40,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,93,58,101,1
    LTEXT           "Datum und Zeit ändern",IDC_STATIC_4,9,54,82,8
    LTEXT           "&Geändert am",IDC_STATIC_5,16,71,46,8
    CONTROL         "",IDC_ATTR_MODIFIED_DATE,"SysDateTimePick32",DTS_SHOWNONE | WS_TABSTOP,67,69,66,12
    CONTROL         "",IDC_ATTR_MODIFIED_TIME,"SysDateTimePick32",DTS_UPDOWN | WS_TABSTOP | 0x8,139,69,50,12
    LTEXT           "&Erstellt",IDC_STATIC_6,16,87,30,8
    CONTROL         "",IDC_ATTR_CREATED_DATE,"SysDateTimePick32",DTS_SHOWNONE | WS_TABSTOP,67,85,66,12
    CONTROL         "",IDC_ATTR_CREATED_TIME,"SysDateTimePick32",DTS_UPDOWN | WS_TABSTOP | 0x8,139,85,50,12
    LTEXT           "Letzter &Zugriff",IDC_STATIC_7,16,103,50,8
    CONTROL         "",IDC_ATTR_ACCESSED_DATE,"SysDateTimePick32",DTS_SHOWNONE | WS_TABSTOP,67,101,66,12
    CONTROL         "",IDC_ATTR_ACCESSED_TIME,"SysDateTimePick32",DTS_UPDOWN | WS_TABSTOP | 0x8,139,101,50,12
    PUSHBUTTON      "Als &Standard",IDC_ATTR_CURRENT,132,118,57,14
    CONTROL         "",IDC_STATIC_8,"Static",SS_ETCHEDHORZ | WS_GROUP,44,141,150,1
    LTEXT           "Optionen",IDC_STATIC_9,9,137,33,8
    CONTROL         "Einschließlich &Unterverzeichnisse",IDC_RECURSESUBDIRS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,16,147,122,12
    CONTROL         "",IDC_STATIC_10,"Static",SS_ETCHEDHORZ | WS_GROUP,9,172,185,1
    DEFPUSHBUTTON   "OK",IDOK,19,181,50,14,WS_GROUP
    PUSHBUTTON      "Abbrechen",IDCANCEL,75,181,50,14
    PUSHBUTTON      "Hilfe",IDHELP,131,181,50,14
END

