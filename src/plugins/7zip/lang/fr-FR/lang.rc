// French (fr-FR) resources for 7zip. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/7zip/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\7zip.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIGURATION DIALOGEX 23, 38, 286, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration de 7-Zip"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Configuration du panneau",IDC_STATIC_1,5,6,90,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,97,10,186,1
    CONTROL         "Afficher la boîte de dialogue avec les &options étendues avant l'empaquetage",IDC_CFG_SHOWEXTENDEDOPTIONS,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,10,19,268,10
    CONTROL         "Afficher les &infos étendues lors du listage de l'archive",IDC_CFG_EXTENDEDLISTINFO,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,31,190,10
    CONTROL         "Empaqueté",IDC_CFG_LISTINFOPACKEDSIZE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,26,43,51,10
    CONTROL         "Méthode",IDC_CFG_LISTINFOMETHOD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,26,55,42,10
    LTEXT           "Paramètres de compression par défaut",IDC_STATIC_3,5,70,132,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,139,74,144,1
    LTEXT           "&Niveau de compression:",IDC_STATIC_5,10,85,83,8
    COMBOBOX        IDC_CFG_COMPRESS_LEVEL,100,83,86,85,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Méthode de compression:",IDC_STATIC_6,10,103,89,8
    COMBOBOX        IDC_CFG_COMPRESS_METHOD,100,101,86,41,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Taille du &dictionnaire:",IDC_STATIC_7,10,121,75,8
    COMBOBOX        IDC_CFG_DICT_SIZE,100,119,86,114,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Taille de mot:",IDC_STATIC_8,10,139,87,8
    COMBOBOX        IDC_CFG_WORD_SIZE,100,137,86,104,CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "Créer une archive &solide",IDC_CFG_SOLID_ARCHIVE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,10,155,93,12
    CONTROL         "",IDC_STATIC_9,"Static",SS_ETCHEDHORZ | WS_GROUP,3,175,280,1
    DEFPUSHBUTTON   "OK",IDOK,119,181,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,174,181,50,14
    PUSHBUTTON      "Aide",IDHELP,229,181,50,14
END

IDD_NEWARCHIVE DIALOGEX 27, 37, 423, 224
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Créer une nouvelle archive"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Archive:",IDC_STATIC_1,16,7,30,8
    LTEXT           "",IDC_NA_ARCHIVE,47,7,367,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,8,21,407,1
    CONTROL         "&Crypter les fichiers",IDC_NA_ENCRYPTFILES,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,16,28,75,10
    LTEXT           "Mot de &passe:",IDC_NA_PASSWORD_TXT,99,29,60,8
    EDITTEXT        IDC_NA_PASSWORD,193,27,220,12,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Confirmer le mot de p&asse:",IDC_NA_CONFIRMPASSWORD_TXT,99,46,93,8
    EDITTEXT        IDC_NA_CONFIRMPASSWORD,193,44,220,12,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Paramètres de compression",IDC_STATIC_3,8,67,95,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,105,71,310,1
    LTEXT           "&Niveau de compression:",IDC_STATIC_5,16,85,83,8
    COMBOBOX        IDC_CFG_COMPRESS_LEVEL,106,83,116,85,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Méthode de compression:",IDC_STATIC_6,16,103,89,8
    COMBOBOX        IDC_CFG_COMPRESS_METHOD,106,101,116,41,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Taille du &dictionnaire:",IDC_STATIC_7,16,121,75,8
    COMBOBOX        IDC_CFG_DICT_SIZE,106,119,116,114,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Taille de mot:",IDC_STATIC_8,16,139,48,8
    COMBOBOX        IDC_CFG_WORD_SIZE,106,137,116,104,CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "Créer une archive &solide",IDC_CFG_SOLID_ARCHIVE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,16,159,93,12
    CONTROL         "",IDC_STATIC_9,"Static",SS_ETCHEDHORZ | WS_GROUP,8,181,407,1
    CONTROL         "Ne plus afficher cette &boîte de dialogue (vous pourrez changer plus tard dans la boîte de dialogue de configuration)",IDC_NA_NOTAGAIN,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,16,187,402,12
    PUSHBUTTON      "C&onfigurer...",IDC_SHOW_CONFIG,10,204,60,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,253,204,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,308,204,50,14
    PUSHBUTTON      "Aide",IDHELP,363,204,50,14
END

IDD_ENTERPASSWORD DIALOGEX 6, 15, 272, 87
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Saisie du mot de passe 7-Zip"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_LOCK_ICON,16,12,20,20
    LTEXT           "Ce fichier est crypté. Saisissez le mot de passe pour décryptage.",IDC_STATIC_1,48,12,218,8
/*    LTEXT           "File:",IDC_STATIC_2,48,26,17,8
    LTEXT           "",IDC_FILE,65,26,175,8 */
    LTEXT           "Mot de passe:",IDC_STATIC_3,48,40,50,8
    EDITTEXT        IDC_PASSWORD,99,38,154,12,ES_PASSWORD | ES_AUTOHSCROLL
/*
 // preparation for skip and skip all
    DEFPUSHBUTTON   "OK",IDOK,12,63,50,14
    PUSHBUTTON      "Skip",IDC_SKIP,72,63,50,14
    PUSHBUTTON      "Skip all",IDC_SKIPALL,132,63,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,192,63,50,14
*/    
    DEFPUSHBUTTON   "OK",IDOK,147,63,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,207,63,50,14
END

