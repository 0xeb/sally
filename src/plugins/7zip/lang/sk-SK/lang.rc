// Slovak (sk-SK) resources for 7zip. Translation: Roman Paholík.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/7zip/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\7zip.rh2"

LANGUAGE LANG_SLOVAK, SUBLANG_SLOVAK_SLOVAKIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIGURATION DIALOGEX 23, 38, 241, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "7-Zip - Konfigurácia"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Panel nastavení",IDC_STATIC_1,5,6,54,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,61,10,177,1
    CONTROL         "Pred komprimáciou zobraziť &okno dialógu rozšírených možností",IDC_CFG_SHOWEXTENDEDOPTIONS,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,10,19,223,10
    CONTROL         "Zobraziť rozšírené &informácie pri výpise archívu",IDC_CFG_EXTENDEDLISTINFO,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,31,171,10
    CONTROL         "Komprimovaná veľkosť",IDC_CFG_LISTINFOPACKEDSIZE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,26,43,90,10
    CONTROL         "Metóda",IDC_CFG_LISTINFOMETHOD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,26,55,38,10
    LTEXT           "Predvolené parametre komprimácie",IDC_STATIC_3,5,70,121,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,128,74,110,1
    LTEXT           "Komprimačná ú&roveň:",IDC_STATIC_5,10,85,77,8
    COMBOBOX        IDC_CFG_COMPRESS_LEVEL,90,83,99,85,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Komprimačná &metóda:",IDC_STATIC_6,10,103,79,8
    COMBOBOX        IDC_CFG_COMPRESS_METHOD,90,101,99,41,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Veľkosť slovníka:",IDC_STATIC_7,10,121,59,8
    COMBOBOX        IDC_CFG_DICT_SIZE,90,119,99,114,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Dĺžka slov:",IDC_STATIC_8,10,139,77,8
    COMBOBOX        IDC_CFG_WORD_SIZE,90,137,99,104,CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "Vytvoriť &solid archív",IDC_CFG_SOLID_ARCHIVE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,10,155,79,12
    CONTROL         "",IDC_STATIC_9,"Static",SS_ETCHEDHORZ | WS_GROUP,3,175,235,1
    DEFPUSHBUTTON   "OK",IDOK,74,181,50,14,WS_GROUP
    PUSHBUTTON      "Zrušiť",IDCANCEL,129,181,50,14
    PUSHBUTTON      "Nápoveda",IDHELP,184,181,50,14
END

IDD_NEWARCHIVE DIALOGEX 27, 37, 281, 224
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Vytvorenie nového archívu"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Archív:",IDC_STATIC_1,16,7,28,8
    LTEXT           "",IDC_NA_ARCHIVE,47,7,225,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,8,21,265,1
    CONTROL         "Ši&frovať súbory",IDC_NA_ENCRYPTFILES,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,16,28,66,10
    LTEXT           "&Heslo:",IDC_NA_PASSWORD_TXT,105,29,60,8
    EDITTEXT        IDC_NA_PASSWORD,167,27,78,12,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Potvrdenie hes&la:",IDC_NA_CONFIRMPASSWORD_TXT,105,46,60,8
    EDITTEXT        IDC_NA_CONFIRMPASSWORD,167,44,78,12,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Parametre komprimácie",IDC_STATIC_3,8,67,82,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,92,71,181,1
    LTEXT           "Komprimačná ú&roveň:",IDC_STATIC_5,16,85,77,8
    COMBOBOX        IDC_CFG_COMPRESS_LEVEL,98,83,86,85,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Komprimačná &metóda:",IDC_STATIC_6,16,103,79,8
    COMBOBOX        IDC_CFG_COMPRESS_METHOD,98,101,86,41,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Veľkosť slovníka:",IDC_STATIC_7,16,121,59,8
    COMBOBOX        IDC_CFG_DICT_SIZE,98,119,86,114,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Dĺžka slov:",IDC_STATIC_8,16,139,38,8
    COMBOBOX        IDC_CFG_WORD_SIZE,98,137,86,104,CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "Vytvoriť &solid archív",IDC_CFG_SOLID_ARCHIVE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,16,159,79,12
    CONTROL         "",IDC_STATIC_9,"Static",SS_ETCHEDHORZ | WS_GROUP,8,181,265,1
    CONTROL         "&Nabudúce nezobrazovať (môžete neskôr zmeniť v dialógu Konfigurácia)",IDC_NA_NOTAGAIN,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,16,187,253,12
    PUSHBUTTON      "M&ožnosti...",IDC_SHOW_CONFIG,10,204,50,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,111,204,50,14,WS_GROUP
    PUSHBUTTON      "Zrušiť",IDCANCEL,166,204,50,14
    PUSHBUTTON      "Nápoveda",IDHELP,221,204,50,14
END

IDD_ENTERPASSWORD DIALOGEX 6, 15, 266, 87
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Vloženie 7-Zip hesla"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_LOCK_ICON,16,12,20,20
    LTEXT           "Tento súbor je šifrovaný. Prosím zadajte heslo na dešifrovanie.",IDC_STATIC_1,48,12,212,8
/*    LTEXT           "File:",IDC_STATIC_2,48,26,17,8
    LTEXT           "",IDC_FILE,65,26,175,8 */
    LTEXT           "Heslo:",IDC_STATIC_3,48,40,23,8
    EDITTEXT        IDC_PASSWORD,74,38,173,12,ES_PASSWORD | ES_AUTOHSCROLL
/*
 // preparation for skip and skip all
    DEFPUSHBUTTON   "OK",IDOK,12,63,50,14
    PUSHBUTTON      "Skip",IDC_SKIP,72,63,50,14
    PUSHBUTTON      "Skip all",IDC_SKIPALL,132,63,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,192,63,50,14
*/    
    DEFPUSHBUTTON   "OK",IDOK,141,63,50,14
    PUSHBUTTON      "Zrušiť",IDCANCEL,201,63,50,14
END

