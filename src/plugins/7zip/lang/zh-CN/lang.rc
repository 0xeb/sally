// Chinese (Simplified) (zh-CN) resources for 7zip. Translation: Michael Lu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/7zip/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\7zip.rh2"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIGURATION DIALOGEX 23, 38, 220, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "7-Zip 配置"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "面板设置",IDC_STATIC_1,5,6,37,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,44,10,173,1
    CONTROL         "压缩前显示有扩展选项的对话框(&O)",IDC_CFG_SHOWEXTENDEDOPTIONS,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,10,19,202,10
    CONTROL         "列表压缩包时显示扩展信息(&I)",IDC_CFG_EXTENDEDLISTINFO,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,31,148,10
    CONTROL         "压缩的",IDC_CFG_LISTINFOPACKEDSIZE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,26,43,60,10
    CONTROL         "方法",IDC_CFG_LISTINFOMETHOD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,26,55,38,10
    LTEXT           "默认压缩参数",IDC_STATIC_3,5,70,54,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,61,74,156,1
    LTEXT           "压缩等级(&L):",IDC_STATIC_5,10,85,49,8
    COMBOBOX        IDC_CFG_COMPRESS_LEVEL,65,83,86,85,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "压缩方法(&M):",IDC_STATIC_6,10,103,51,8
    COMBOBOX        IDC_CFG_COMPRESS_METHOD,65,101,86,41,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "字典大小(&D):",IDC_STATIC_7,10,121,50,8
    COMBOBOX        IDC_CFG_DICT_SIZE,65,119,86,114,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "单词大小(&W):",IDC_STATIC_8,10,139,52,8
    COMBOBOX        IDC_CFG_WORD_SIZE,65,137,86,104,CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "创建固实压缩包(&S)",IDC_CFG_SOLID_ARCHIVE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,10,155,84,12
    CONTROL         "",IDC_STATIC_9,"Static",SS_ETCHEDHORZ | WS_GROUP,3,175,214,1
    DEFPUSHBUTTON   "确定",IDOK,53,181,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,108,181,50,14
    PUSHBUTTON      "帮助",IDHELP,163,181,50,14
END

IDD_NEWARCHIVE DIALOGEX 27, 37, 290, 224
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "创建新的压缩包"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "压缩包:",IDC_STATIC_1,16,7,31,8
    LTEXT           "",IDC_NA_ARCHIVE,48,7,233,8
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,8,21,274,1
    CONTROL         "加密文件(&E)",IDC_NA_ENCRYPTFILES,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,16,28,58,10
    LTEXT           "密码(&P):",IDC_NA_PASSWORD_TXT,105,29,32,8
    EDITTEXT        IDC_NA_PASSWORD,156,27,94,12,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "确认密码(&A):",IDC_NA_CONFIRMPASSWORD_TXT,105,46,50,8
    EDITTEXT        IDC_NA_CONFIRMPASSWORD,156,44,94,12,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "压缩参数",IDC_STATIC_3,8,67,37,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,47,71,235,1
    LTEXT           "压缩等级(&L):",IDC_STATIC_5,16,85,49,8
    COMBOBOX        IDC_CFG_COMPRESS_LEVEL,71,83,86,85,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "压缩方法(&M):",IDC_STATIC_6,16,103,51,8
    COMBOBOX        IDC_CFG_COMPRESS_METHOD,71,101,86,41,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "字典大小(&C):",IDC_STATIC_7,16,121,50,8
    COMBOBOX        IDC_CFG_DICT_SIZE,71,119,86,114,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "单词大小(&W):",IDC_STATIC_8,16,139,52,8
    COMBOBOX        IDC_CFG_WORD_SIZE,71,137,86,104,CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "创建固实压缩包(&S)",IDC_CFG_SOLID_ARCHIVE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,16,159,87,12
    CONTROL         "",IDC_STATIC_9,"Static",SS_ETCHEDHORZ | WS_GROUP,8,181,274,1
    CONTROL         "不要再次显示本对话框(以后你可以在配置对话框中更改此选项)(&D)",IDC_NA_NOTAGAIN,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,16,187,261,12
    PUSHBUTTON      "配置(&O)...",IDC_SHOW_CONFIG,10,204,50,14,WS_GROUP
    DEFPUSHBUTTON   "确定",IDOK,120,204,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,175,204,50,14
    PUSHBUTTON      "帮助",IDHELP,230,204,50,14
END

IDD_ENTERPASSWORD DIALOGEX 6, 15, 257, 87
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "输入 7-Zip 密码"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_LOCK_ICON,16,12,20,20
    LTEXT           "这个文件是加密的。请输入密码以解密。",IDC_STATIC_1,48,12,204,8
/*    LTEXT           "File:",IDC_STATIC_2,48,26,17,8
    LTEXT           "",IDC_FILE,65,26,175,8 */
    LTEXT           "密码:",IDC_STATIC_3,48,40,22,8
    EDITTEXT        IDC_PASSWORD,73,38,166,12,ES_PASSWORD | ES_AUTOHSCROLL
/*
 // preparation for skip and skip all
    DEFPUSHBUTTON   "OK",IDOK,12,63,50,14
    PUSHBUTTON      "Skip",IDC_SKIP,72,63,50,14
    PUSHBUTTON      "Skip all",IDC_SKIPALL,132,63,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,192,63,50,14
*/    
    DEFPUSHBUTTON   "确定",IDOK,132,63,50,14
    PUSHBUTTON      "取消",IDCANCEL,192,63,50,14
END

