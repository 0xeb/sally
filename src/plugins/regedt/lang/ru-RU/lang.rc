    DEFPUSHBUTTON   "ОК",IDOK,58,87,50,14,WS_GROUP
    PUSHBUTTON      "Отмена",IDCANCEL,118,87,50,14
END

IDD_EDITVAL DIALOGEX 14, 22, 227, 134
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Изменение параметра"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDE_DATA,10,79,208,12,ES_AUTOHSCROLL
    LTEXT           "Система исчисления:",IDS_BASE,124,69,78,8
    CONTROL         "&Шестнадцатеричная",IDR_HEX,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,124,78,85,12
    CONTROL         "&Десятичная",IDR_DEC,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,124,90,55,12
    DEFPUSHBUTTON   "ОК",IDOK,58,112,50,14,WS_GROUP
    PUSHBUTTON      "Отмена",IDCANCEL,118,112,50,14
    LTEXT           "Параметр:",IDC_STATIC_1,10,10,39,8
    EDITTEXT        IDE_NAME,10,20,208,12,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "&Тип:",IDC_STATIC_2,10,39,18,8
    COMBOBOX        IDC_TYPE,10,49,208,115,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Значение:",IDC_STATIC_3,10,69,38,8
END

IDD_RAWEDITVAL DIALOGEX 14, 22, 227, 153
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Изменение двоичных данных"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Параметр:",IDC_STATIC_1,10,10,39,8
    EDITTEXT        IDE_NAME,10,20,208,12,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "&Тип:",IDC_STATIC_2,10,39,18,8
    COMBOBOX        IDC_TYPE,10,49,208,115,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Открыть редактор",IDB_EDIT,10,69,78,14
    LTEXT           "По завершении редактирования и сохранения данных во внешнем редакторе, нажмите ""OK"" для записи данных в реестр или нажмите ""Отмена"", чтобы не сохранять данные в реестр.",IDS_MESSAGE,10,89,206,32,NOT WS_VISIBLE
    DEFPUSHBUTTON   "ОК",IDOK,58,131,50,14,WS_GROUP
    PUSHBUTTON      "Отмена",IDCANCEL,118,131,50,14
END

IDD_SEARCH DIALOGEX 9, 20, 435, 240
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Поиск в системном реестре"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Поиск:",IDC_STATIC_1,6,10,41,8
    COMBOBOX        IDC_PATTERN,67,8,305,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Найти",IDOK,380,7,50,14,WS_GROUP
    LTEXT           "&Область поиска:",IDC_STATIC_2,6,27,60,8
    COMBOBOX        IDC_LOOKIN,67,25,305,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Справ&ка",IDHELP,380,24,50,14,WS_GROUP
    CONTROL         "Дополнител&ьно",IDC_OPTIONS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,362,42,68,12
    CONTROL         "&Включая вложенные разделы",IDC_SUBDIRS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,67,42,116,12
    LTEXT           "Поиск в:",IDS_LOOKAT,6,60,41,8
    CONTROL         "Именах ра&зделов",IDC_KEYS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,67,58,73,12
    CONTROL         "Имена&х параметров",IDC_VALUES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,188,58,82,12
    CONTROL         "&Данных",IDC_DATA,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,303,58,55,12
    LTEXT           "Параметры:",IDS_OPTIONS,6,76,44,8
    CONTROL         "&Шестнадцатеричный режим",IDC_HEX,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,67,74,112,12
    CONTROL         "С &учетом регистра",IDC_CASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,188,74,84,12
    CONTROL         "С&лова целиком",IDC_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,67,87,65,12
    CONTROL         "&Регулярное выражение",IDC_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,188,87,95,12
    LTEXT           "Нов&ее:",IDS_NEWER,154,105,31,8
    EDITTEXT        IDC_MINTIME,188,103,80,12,ES_AUTOHSCROLL
    LTEXT           "чч:мм:сс дд.мм.гггг",IDS_FORMAT1,274,105,81,8
    LTEXT           "С&тарше:",IDS_OLDER,154,121,31,8
    EDITTEXT        IDC_MAXTIME,188,119,80,12,ES_AUTOHSCROLL
    LTEXT           "чч:мм:сс дд.мм.гггг",IDS_FORMAT2,274,121,81,8
    LTEXT           "Н&айдено:",IDC_FOUND_FILES,6,132,109,8
    CONTROL         "",IDC_RESULTS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_OWNERDATA | WS_CLIPCHILDREN | WS_BORDER | WS_TABSTOP,6,142,422,57
END

IDD_CONFIG DIALOGEX 86, 38, 270, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Настройка редактора реестра"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Настройка внешнего редактора. Внешний редактор используется для редактирования двоичных данных.",IDC_STATIC_1,10,10,250,16
    LTEXT           "&Команда:",IDC_STATIC_2,20,35,55,8
    EDITTEXT        IDE_COMMAND,77,33,166,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_BROWSE,247,33,13,12
    LTEXT           "&Параметры:",IDC_STATIC_3,20,51,55,8
    EDITTEXT        IDE_ARGUMENTS,77,49,166,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_ARGHELP,247,49,13,12
    LTEXT           "&Рабочая папка:",IDC_STATIC_4,20,67,55,8
    EDITTEXT        IDE_INITDIR,77,65,166,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_INITDIRHELP,247,65,13,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,10,87,250,1
    DEFPUSHBUTTON   "ОК",IDOK,156,92,50,14,WS_GROUP
    PUSHBUTTON      "Отмена",IDCANCEL,210,92,50,14
END

IDD_EXPORT DIALOGEX 14, 22, 227, 94
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Экспорт"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
