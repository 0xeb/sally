    EDITTEXT        IDE_INITDIR,77,57,186,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_INITDIRHELP,267,57,13,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,10,79,270,1
    DEFPUSHBUTTON   "OK",IDOK,176,84,50,14,WS_GROUP
    PUSHBUTTON      "Annuleren",IDCANCEL,230,84,50,14
END

