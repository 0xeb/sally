    PUSHBUTTON      "&Lanzar editor",IDB_EDIT,10,69,75,14
    LTEXT           "Cuando haya terminado de editar y grabado sus cambios al disco, pulse Aceptar para guardar los cambios al registro o elija Cancelar para salir sin guardar.",IDS_MESSAGE,10,89,206,24,NOT WS_VISIBLE
    DEFPUSHBUTTON   "Aceptar",IDOK,58,123,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",IDCANCEL,118,123,50,14
END

IDD_SEARCH DIALOGEX 9, 20, 333, 240
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Buscar en el registro de Windows"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Buscar:",IDC_STATIC_1,6,10,36,8
    COMBOBOX        IDC_PATTERN,56,8,197,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "B&uscar ahora",IDOK,258,7,60,14,WS_GROUP
    LTEXT           "&Mirar en:",IDC_STATIC_2,6,27,36,8
    COMBOBOX        IDC_LOOKIN,56,25,197,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Ayuda",IDHELP,258,24,60,14,WS_GROUP
    CONTROL         "Ver &opciones",IDC_OPTIONS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,262,42,56,12
    CONTROL         "&Incluir subclaves",IDC_SUBDIRS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,56,42,86,12
    LTEXT           "Mirar en:",IDS_LOOKAT,6,60,36,8
    CONTROL         "&Claves",IDC_KEYS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,56,58,55,12
    CONTROL         "&Valores",IDC_VALUES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,139,58,55,12
    CONTROL         "&Datos",IDC_DATA,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,230,58,55,12
    LTEXT           "Opciones:",IDS_OPTIONS,6,76,36,8
    CONTROL         "Modo HE&X",IDC_HEX,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,56,74,60,12
    CONTROL         "Di&stinguir M/minúsculas",IDC_CASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,139,74,93,12
    CONTROL         "&Palabras completas",IDC_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,56,87,78,12
    CONTROL         "Expresión re&gular",IDC_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,139,87,75,12
    LTEXT           "Más &reciente o igual a:",IDS_NEWER,56,105,79,8
    EDITTEXT        IDC_MINTIME,139,103,82,12,ES_AUTOHSCROLL
    LTEXT           "hh:mm:ss dd.mm.aaaa",IDS_FORMAT1,226,105,81,8
    LTEXT           "Más a&ntiguo o igual a:",IDS_OLDER,56,121,76,8
    EDITTEXT        IDC_MAXTIME,139,119,82,12,ES_AUTOHSCROLL
    LTEXT           "hh:mm:ss dd.mm.aaaa",IDS_FORMAT2,226,121,81,8
    LTEXT           "&Elementos encontrados:",IDC_FOUND_FILES,6,132,109,8
    CONTROL         "",IDC_RESULTS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_OWNERDATA | WS_CLIPCHILDREN | WS_BORDER | WS_TABSTOP,6,142,309,57
END

IDD_CONFIG DIALOGEX 86, 38, 275, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuración del editor del registro"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Ajuste del editor externo. Este editor se usa para editar valores del registro.",IDC_STATIC_1,10,10,256,8
    LTEXT           "&Comando:",IDC_STATIC_2,20,27,55,8
    EDITTEXT        IDE_COMMAND,79,25,169,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_BROWSE,252,25,13,12
    LTEXT           "&Argumentos:",IDC_STATIC_3,20,43,55,8
    EDITTEXT        IDE_ARGUMENTS,79,41,169,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_ARGHELP,252,41,13,12
    LTEXT           "&Directorio inicial:",IDC_STATIC_4,20,59,58,8
    EDITTEXT        IDE_INITDIR,79,57,169,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_INITDIRHELP,252,57,13,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,10,79,255,1
    DEFPUSHBUTTON   "Aceptar",IDOK,161,84,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",IDCANCEL,215,84,50,14
END

IDD_EXPORT DIALOGEX 14, 22, 227, 94
