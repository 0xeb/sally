    EDITTEXT        IDE_NAME,10,20,208,12,ES_AUTOHSCROLL
    CONTROL         "&Enviar ruta directamente al plugin",IDC_DIRECT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,34,189,12
    DEFPUSHBUTTON   "Aceptar",IDOK,58,53,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",IDCANCEL,118,53,50,14
END

