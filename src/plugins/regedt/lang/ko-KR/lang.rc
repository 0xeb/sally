END

IDD_RAWEDITVAL DIALOGEX 14, 22, 227, 145
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "값 원시 편집"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "값 이름:",IDC_STATIC_1,10,10,56,8
    EDITTEXT        IDE_NAME,10,20,208,12,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "값 형식(&T):",IDC_STATIC_2,10,39,56,8
    COMBOBOX        IDC_TYPE,10,49,208,115,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "편집기 실행(&L)",IDB_EDIT,10,69,75,14
    LTEXT           "외부 편집기에서 편집을 마치고 변경 내용을 저장한 다음, 확인을 눌러 변경 내용을 레지스트리에 저장하거나 취소를 눌러 저장하지 않고 끝내십시오.",IDS_MESSAGE,10,89,206,24,NOT WS_VISIBLE
    DEFPUSHBUTTON   "확인",IDOK,58,123,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,118,123,50,14
END

IDD_SEARCH DIALOGEX 9, 20, 333, 240
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Windows 레지스트리 검색"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "찾을 내용(&S):",IDC_STATIC_1,6,10,41,8
    COMBOBOX        IDC_PATTERN,61,8,198,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "지금 찾기(&F)",IDOK,264,7,54,14,WS_GROUP
    LTEXT           "찾는 위치(&L):",IDC_STATIC_2,6,27,49,8
    COMBOBOX        IDC_LOOKIN,61,25,198,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "도움말(&H)",IDHELP,264,24,54,14,WS_GROUP
    CONTROL         "옵션 표시(&O)",IDC_OPTIONS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,258,42,60,12
    CONTROL         "하위 키 포함(&B)",IDC_SUBDIRS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,61,42,86,12
    LTEXT           "검색 대상:",IDS_LOOKAT,6,60,41,8
    CONTROL         "키(&K)",IDC_KEYS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,61,58,55,12
    CONTROL         "값(&V)",IDC_VALUES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,139,58,55,12
    CONTROL         "데이터(&D)",IDC_DATA,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,217,58,55,12
    LTEXT           "옵션:",IDS_OPTIONS,6,76,41,8
    CONTROL         "16진수 모드(&X)",IDC_HEX,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,61,74,60,12
    CONTROL         "대/소문자 구분(&T)",IDC_CASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,139,74,84,12
    CONTROL         "단어 단위로(&W)",IDC_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,61,87,60,12
    CONTROL         "정규식(&G)",IDC_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,139,87,75,12
    LTEXT           "이후(같은 시간 포함)(&N):",IDS_NEWER,61,105,76,8
    EDITTEXT        IDC_MINTIME,139,103,80,12,ES_AUTOHSCROLL
    LTEXT           "hh:mm:ss dd.mm.yyyy",IDS_FORMAT1,225,105,81,8
    LTEXT           "이전(같은 시간 포함)(&R):",IDS_OLDER,61,121,76,8
    EDITTEXT        IDC_MAXTIME,139,119,80,12,ES_AUTOHSCROLL
    LTEXT           "hh:mm:ss dd.mm.yyyy",IDS_FORMAT2,225,121,81,8
    LTEXT           "찾은 항목(&I):",IDC_FOUND_FILES,6,132,109,8
    CONTROL         "",IDC_RESULTS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_OWNERDATA | WS_CLIPCHILDREN | WS_BORDER | WS_TABSTOP,6,142,309,57
END

IDD_CONFIG DIALOGEX 86, 38, 280, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "레지스트리 편집기 설정"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "외부 편집기 설정. 외부 편집기는 레지스트리 값을 원시 편집하는 데 사용됩니다.",IDC_STATIC_1,10,10,260,8
    LTEXT           "명령(&C):",IDC_STATIC_2,20,27,48,8
    EDITTEXT        IDE_COMMAND,69,25,184,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_BROWSE,257,25,13,12
    LTEXT           "인수(&A):",IDC_STATIC_3,20,43,48,8
    EDITTEXT        IDE_ARGUMENTS,69,41,184,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_ARGHELP,257,41,13,12
    LTEXT           "시작 디렉터리(&I):",IDC_STATIC_4,20,59,48,8
    EDITTEXT        IDE_INITDIR,69,57,184,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_INITDIRHELP,257,57,13,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,10,79,260,1
    DEFPUSHBUTTON   "확인",IDOK,166,84,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,220,84,50,14
END

IDD_EXPORT DIALOGEX 14, 22, 227, 94
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
