    PUSHBUTTON      "",IDB_BROWSE,298,33,13,12
    LTEXT           "&Parameter:",IDC_STATIC_3,20,51,58,8
    EDITTEXT        IDE_ARGUMENTS,79,49,215,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_ARGHELP,298,49,13,12
    LTEXT           "&Startverzeichnis:",IDC_STATIC_4,20,67,58,8
    EDITTEXT        IDE_INITDIR,79,65,215,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_INITDIRHELP,298,65,13,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,10,87,301,1
    DEFPUSHBUTTON   "OK",IDOK,207,92,50,14,WS_GROUP
    PUSHBUTTON      "Abbrechen",IDCANCEL,261,92,50,14
END

