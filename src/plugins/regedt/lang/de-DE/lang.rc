IDD_SEARCH DIALOGEX 9, 20, 333, 240
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Windows-Registrierung durchsuchen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Suchen nach:",IDC_STATIC_1,6,10,49,8
    COMBOBOX        IDC_PATTERN,61,8,202,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Jetzt suchen",IDOK,268,7,55,14,WS_GROUP
    LTEXT           "S&uchen in:",IDC_STATIC_2,6,27,41,8
    COMBOBOX        IDC_LOOKIN,61,25,202,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Hilfe",IDHELP,268,24,55,14,WS_GROUP
    CONTROL         "&Optionen anzeigen",IDC_OPTIONS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,249,42,75,12
    CONTROL         "&Einschließlich Unterschlüssel",IDC_SUBDIRS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,61,42,108,12
    LTEXT           "Suchen in:",IDS_LOOKAT,6,60,41,8
    CONTROL         "Sch&lüsseln",IDC_KEYS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,61,58,55,12
    CONTROL         "&Werten",IDC_VALUES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,139,58,55,12
    CONTROL         "&Daten",IDC_DATA,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,217,58,55,12
    LTEXT           "Optionen:",IDS_OPTIONS,6,76,41,8
    CONTROL         "HEX-&Modus",IDC_HEX,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,61,74,60,12
    CONTROL         "Groß-/&Kleinschreibung",IDC_CASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,139,74,87,12
    CONTROL         "&Ganze Wörter",IDC_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,61,87,60,12
    CONTROL         "&Regulärer Ausdruck",IDC_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,139,87,78,12
    LTEXT           "&Neuer oder gleich:",IDS_NEWER,61,105,76,8
    EDITTEXT        IDC_MINTIME,139,103,86,12,ES_AUTOHSCROLL
    LTEXT           "hh:mm:ss dd.mm.yyyy",IDS_FORMAT1,231,105,80,8
    LTEXT           "&Älter oder gleich:",IDS_OLDER,61,121,76,8
    EDITTEXT        IDC_MAXTIME,139,119,86,12,ES_AUTOHSCROLL
    LTEXT           "hh:mm:ss dd.mm.yyyy",IDS_FORMAT2,231,121,80,8
    LTEXT           "Ge&fundene Einträge:",IDC_FOUND_FILES,6,132,109,8
    CONTROL         "",IDC_RESULTS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_OWNERDATA | WS_CLIPCHILDREN | WS_BORDER | WS_TABSTOP,6,142,314,57
END

IDD_CONFIG DIALOGEX 86, 38, 321, 110
