    LTEXT           "&Type de valeur:",IDC_STATIC_2,10,39,56,8
    COMBOBOX        IDC_TYPE,10,49,208,115,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Donnée de la valeur:",IDC_STATIC_3,10,69,73,8
END

IDD_RAWEDITVAL DIALOGEX 14, 22, 253, 145
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Valeur d'édition brute"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Nom de la valeur:",IDC_STATIC_1,10,10,62,8
    EDITTEXT        IDE_NAME,10,20,234,12,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "&Type de valeur:",IDC_STATIC_2,10,39,56,8
    COMBOBOX        IDC_TYPE,10,49,234,115,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Lancer l'éditeur",IDB_EDIT,10,69,75,14
    LTEXT           "Une fois que vous avez fini d'éditer et enregistré vos modifications dans l'éditeur externe, cliquez OK pour enregistrer les modifications dans le registre ou choisissez Annuler pour quitter sans sauvegarder.",IDS_MESSAGE,10,89,232,24,NOT WS_VISIBLE
    DEFPUSHBUTTON   "OK",IDOK,71,123,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,131,123,50,14
END

IDD_SEARCH DIALOGEX 9, 20, 333, 240
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Recherche dans le registre Windows"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Rec&hercher:",IDC_STATIC_1,6,10,44,8
    COMBOBOX        IDC_PATTERN,62,8,176,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Trouver maintenant",IDOK,243,7,75,14,WS_GROUP
    LTEXT           "Re&garder dans:",IDC_STATIC_2,6,27,55,8
    COMBOBOX        IDC_LOOKIN,62,25,176,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "A&ide",IDHELP,243,24,75,14,WS_GROUP
    CONTROL         "Voir les &Options",IDC_OPTIONS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,252,42,66,12
    CONTROL         "Inclure les &sous-clés",IDC_SUBDIRS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,62,42,86,12
    LTEXT           "Chercher:",IDS_LOOKAT,6,60,41,8
    CONTROL         "&Clés",IDC_KEYS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,62,58,55,12
    CONTROL         "&Valeurs",IDC_VALUES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,140,58,55,12
    CONTROL         "&Données",IDC_DATA,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,218,58,55,12
    LTEXT           "Options:",IDS_OPTIONS,6,76,41,8
    CONTROL         "Mode HE&X",IDC_HEX,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,62,74,60,12
    CONTROL         "Sensi&ble à la casse",IDC_CASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,140,74,84,12
    CONTROL         "&Mots entiers",IDC_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,62,87,60,12
    CONTROL         "Ex&pression régulière",IDC_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,140,87,80,12
    LTEXT           "Plus &récent ou égal à:",IDS_NEWER,62,105,76,8
    EDITTEXT        IDC_MINTIME,140,103,80,12,ES_AUTOHSCROLL
    LTEXT           "hh:mm:ss jj.mm.aaaa",IDS_FORMAT1,226,105,81,8
    LTEXT           "Plus &ancien ou égal à:",IDS_OLDER,62,121,76,8
    EDITTEXT        IDC_MAXTIME,140,119,80,12,ES_AUTOHSCROLL
    LTEXT           "hh:mm:ss jj.mm.aaaa",IDS_FORMAT2,226,121,81,8
    LTEXT           "&Eléments trouvés:",IDC_FOUND_FILES,6,132,109,8
    CONTROL         "",IDC_RESULTS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_OWNERDATA | WS_CLIPCHILDREN | WS_BORDER | WS_TABSTOP,6,142,309,57
END

IDD_CONFIG DIALOGEX 86, 38, 340, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration de l'éditeur de registre"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Paramètres de l'éditeur externe. L'éditeur externe sert à l'édition brute des valeurs du registre.",IDC_STATIC_1,10,10,320,8
    LTEXT           "&Commande:",IDC_STATIC_2,20,27,60,8
    EDITTEXT        IDE_COMMAND,82,25,231,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_BROWSE,317,25,13,12
    LTEXT           "&Arguments:",IDC_STATIC_3,20,43,60,8
    EDITTEXT        IDE_ARGUMENTS,82,41,231,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_ARGHELP,317,41,13,12
    LTEXT           "Répertoire &initial:",IDC_STATIC_4,20,59,60,8
    EDITTEXT        IDE_INITDIR,82,57,231,12,ES_AUTOHSCROLL
    PUSHBUTTON      "",IDB_INITDIRHELP,317,57,13,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,10,79,320,1
    DEFPUSHBUTTON   "OK",IDOK,226,84,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,280,84,50,14
END

IDD_EXPORT DIALOGEX 14, 22, 227, 94
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
