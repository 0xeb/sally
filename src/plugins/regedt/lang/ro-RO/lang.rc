    CONTROL         "&Valori",IDC_VALUES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,139,58,55,12
    CONTROL         "&Data",IDC_DATA,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,217,58,55,12
    LTEXT           "Optiuni:",IDS_OPTIONS,6,76,41,8
    CONTROL         "HE&X-mode",IDC_HEX,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,61,74,60,12
    CONTROL         "&Sensibil la litere (mari sau mici)",IDC_CASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,139,74,118,12
    CONTROL         "Cuvintele i&ntregi",IDC_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,61,87,67,12
    CONTROL         "Expresie &regulata",IDC_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,139,87,75,12
    LTEXT           "&Mai nou sau egal cu:",IDS_NEWER,61,105,76,8
    EDITTEXT        IDC_MINTIME,139,103,80,12,ES_AUTOHSCROLL
    LTEXT           "hh:mm:ss dd.mm.yyyy",IDS_FORMAT1,225,105,81,8
    LTEXT           "M&ai vechi sau egal cu:",IDS_OLDER,61,121,76,8
    EDITTEXT        IDC_MAXTIME,139,119,80,12,ES_AUTOHSCROLL
    LTEXT           "hh:mm:ss dd.mm.yyyy",IDS_FORMAT2,225,121,81,8
    LTEXT           "Obiecte gas&ite:",IDC_FOUND_FILES,6,132,109,8
    CONTROL         "",IDC_RESULTS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_OWNERDATA | WS_CLIPCHILDREN | WS_BORDER | WS_TABSTOP,6,142,309,57
END

