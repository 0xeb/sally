  IDS_UNABLESEEK, "Impossible de positionner un pointeur sur le fichier: "
  IDS_TOOLONGNAME, "L'opération ne peut pas être achevée en raison d'un nom de chemin trop long."
  IDS_TOOLONGMASK, "L'opération ne peut pas être achevée en raison d'un masque trop long."
  IDS_ENTERPWD, "Veuillez saisir un caractère au minimum."
  IDS_ALLFILES, "Tous les Fichiers (*.*)"
  IDS_ERROR, "Erreur"
  IDS_NOTFOUND, "Fichier non trouvé"
  IDS_BADDLL, "Version du fichier unrar.dll incorrecte. Veuillez réinstaller le module UnRAR."
  IDS_SELECTFIRST, "Il semblerait que cette archive soit divisée en plusieurs volumes. Si tel est le cas, veuillez sélectionner le premier volume de l'archive et appuyer sur OK.\n\nS'il ne s'agit pas d'une archive multi-volumes, appuyez sur Annuler."
  IDS_SELECTFIRSTTITLE, "Sélectionnez le premier volume"
  IDS_FILENOTFOUND "Fichier non trouvé au sein de l'archive."
  IDS_LISTINFO_PAKEDSIZE      "Compressé"
  IDS_LISTINFO_PAKEDSIZE_DESC "Taille compressée du fichier"
}
