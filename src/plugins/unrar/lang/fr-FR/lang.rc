// French (fr-FR) resources for unrar. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unrar/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unrar.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 6, 15, 258, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Volume suivant de l'archive"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Veuillez insérer le disque contenant le volume suivant de l'archive, ou sélectionnez le fichier approprié à partir d'un autre emplacement.\n\nPuis appuyez sur OK pour continuer.",IDS_NEXTDISK,12,9,234,32
    LTEXT           "&Fichier:",IDC_STATIC_1,12,48,42,8
    EDITTEXT        IDC_FILENAME,12,58,219,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BROWSE,234,58,13,12
    DEFPUSHBUTTON   "OK",IDOK,72,76,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,135,76,50,14
END

IDD_ERROR DIALOGEX 15, 34, 352, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Erreur"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Nom:",IDC_STATIC_1,6,10,26,8
    LTEXT           "",IDS_FILENAME,36,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Erreur:",IDC_STATIC_2,6,23,26,8,NOT WS_GROUP
    LTEXT           "Ce fichier ne peut pas être extrait, car il est partiellement contenu au sein d'un volume précédent. Pour extraire ce fichier, commencez par le volume contenant sa première partie.",IDC_STATIC_3,36,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&Ne plus afficher ce message à l'avenir.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,44,183,12
    DEFPUSHBUTTON   "OK",IDOK,121,63,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,181,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 282, 115
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration de UnRAR"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "&Ignorer automatiquement les fichiers issus d'un volume précédent lors de",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,10,259,12
    CONTROL         "&Ne pas afficher d'avertissement lorsque l'ensemble du contenu de l'archive",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,263,12
    LTEXT           "la décompression.",IDC_STATIC_1,23,22,154,8
    LTEXT           "ne peut être listé.",IDC_STATIC_2,23,44,111,8
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,270,1
    CONTROL         "Afficher la colonne ""&Compressé"" en listant le contenu de l'archive",IDC_CFG_LISTINFOPACKEDSIZE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,70,230,12
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,90,270,1
    DEFPUSHBUTTON   "OK",IDOK,88,96,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,143,96,50,14
END

IDD_PASSWORD DIALOGEX 6, 15, 375, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Saisir le mot de passe"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_LOCK_ICON,18,18,18,20
    LTEXT           "Le fichier est protégé par un mot de passe. Veuillez saisir le mot de passe pour le déchiffrer.",IDC_STATIC_1,57,10,312,8
    LTEXT           "Fichier:",IDC_STATIC_2,57,25,27,8
    CONTROL         "",IDS_FILENAME,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,108,25,254,8
    LTEXT           "Mot de &passe:",IDC_STATIC_3,57,38,50,8
    EDITTEXT        IDC_PASSWORD,108,36,173,12,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "&OK",IDOK,42,58,50,14,WS_GROUP
    DEFPUSHBUTTON   "&Tout",IDALL,102,58,50,14
    PUSHBUTTON      "&Ignorer",IDSKIP,162,58,50,14
    PUSHBUTTON      "Tout i&gnorer",IDSKIPALL,222,58,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,282,58,50,14
END

IDD_WARNING DIALOGEX 6, 15, 223, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR - Avertissement"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Impossible de lister (et afficher) l'ensemble des fichiers contenus dans cette archive multi-volumes, car certains volumes n'ont pas été trouvés.",IDC_STATIC_1,11,8,204,24
    LTEXT           "Pour lister l'intégralité des fichiers contenus dans l'archive, copiez l'ensemble de ses volumes dans le même dossier.",IDC_STATIC_2,11,39,204,16
    CONTROL         "&Ne plus afficher ce message à l'avenir",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,64,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,81,212,1
    DEFPUSHBUTTON   "OK",IDOK,165,87,50,14
END

