  IDS_RARARCHIVES, "Fichiers d'Archives RAR (*.R*)"
  IDS_BROWSEARCHIVETITLE, "Sélectionnez le fichier archive"
  IDS_CRC, "Erreur au sein des données compressées. Le CRC ne correspond pas. (Ou le mot de passe est incorrect?)"
  IDS_LIST, "Impossible d'ajouter une entrée parmi la liste des fichiers de l'archive."
  IDS_EXTRPROGTITLE, "Décompression de l'archive RAR - %s"
  IDS_PREPAREDATA, "préparation des données et création des dossiers..."
  IDS_EXTRACTFILES, "décompression..."
  IDS_EXTRACTING, "décompression de: "
  IDS_UNABLEGETFIELPOS, "Impossible d'obtenir un pointeur sur le fichier: "
