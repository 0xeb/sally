// Slovak (sk-SK) resources for unrar. Translation: Roman Paholík.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unrar/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unrar.rh2"

LANGUAGE LANG_SLOVAK, SUBLANG_SLOVAK_SLOVAKIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 6, 15, 194, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ďalší zväzok archívu"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Prosím vložte disketu s ďalším zväzkom archívu alebo nájdite príslušný súbor na disku.\n\nKliknite na OK, ak je pripravený.",IDS_NEXTDISK,12,9,170,32
    LTEXT           "&Názov súboru:",IDC_STATIC_1,12,48,53,8
    EDITTEXT        IDC_FILENAME,12,58,155,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BROWSE,170,58,13,12
    DEFPUSHBUTTON   "OK",IDOK,39,76,50,14
    PUSHBUTTON      "Zrušiť",IDCANCEL,102,76,50,14
END

IDD_ERROR DIALOGEX 15, 34, 350, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Chyba"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Názov:",IDC_STATIC_1,4,10,26,8
    LTEXT           "",IDS_FILENAME,34,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Chyba:",IDC_STATIC_2,4,23,26,8,NOT WS_GROUP
    LTEXT           "Súbor nemôže byť extrahovaný, pretože je pokračujúci z predchádzajúceho zväzku. Na extrahovanie tohto súboru musíte začať zväzkom, v ktorom súbor začína.",IDC_STATIC_3,34,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&Nabudúce nezobrazovať.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,34,44,183,12
    DEFPUSHBUTTON   "OK",IDOK,120,63,50,14,WS_GROUP
    PUSHBUTTON      "Zrušiť",IDCANCEL,180,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 230, 115
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR - Konfigurácia"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "&Pri extrahovaní automaticky preskočiť súbory pokračujúce",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,10,206,12
    CONTROL         "&Nezobrazovať upozornenie, ak nemôže byť vypísaný celý",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,203,12
    LTEXT           "z predchádzajúcich zväzkov.",IDC_STATIC_1,23,22,154,8
    LTEXT           "obsah archívu.",IDC_STATIC_2,23,44,111,8
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,218,1
    CONTROL         "Zobraziť stĺpec ""&Komprimovaná veľkosť"" pri výpise archívu",IDC_CFG_LISTINFOPACKEDSIZE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,70,209,12
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,90,218,1
    DEFPUSHBUTTON   "OK",IDOK,62,96,50,14,WS_GROUP
    PUSHBUTTON      "Zrušiť",IDCANCEL,117,96,50,14
END

IDD_PASSWORD DIALOGEX 6, 15, 350, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Zadanie hesla"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_LOCK_ICON,18,18,18,20
    LTEXT           "Tento súbor je šifrovaný. Prosím zadajte heslo na dešifrovanie.",IDC_STATIC_1,57,10,212,8
    LTEXT           "Súbor:",IDC_STATIC_2,57,25,24,8
    CONTROL         "",IDS_FILENAME,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,84,25,253,8
    LTEXT           "&Heslo:",IDC_STATIC_3,57,38,22,8
    EDITTEXT        IDC_PASSWORD,84,36,170,12,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "&OK",IDOK,20,58,55,14,WS_GROUP
    DEFPUSHBUTTON   "&Všetko",IDALL,81,58,55,14
    PUSHBUTTON      "&Preskočiť",IDSKIP,142,58,55,14
    PUSHBUTTON      "Pres&kočiť všetko",IDSKIPALL,203,58,65,14
    PUSHBUTTON      "Zrušiť",IDCANCEL,274,58,55,14
END

IDD_WARNING DIALOGEX 6, 15, 213, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR - Upozornenie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Nie všetky súbory vo viaczväzkovom archíve môžu byť vypísané (a zobrazené v paneli), pretože nie je možné nájsť niektorý zväzok archívu.",IDC_STATIC_1,11,8,194,24
    LTEXT           "Na výpis celého obsahu archívu skopírujte všetky zväzky archívu do jedného adresára.",IDC_STATIC_2,11,39,194,16
    CONTROL         "&Nabudúce nezobrazovať",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,64,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,81,202,1
    DEFPUSHBUTTON   "OK",IDOK,155,87,50,14
END

