// Czech (cs-CZ) resources for unrar. Translation: Hynek Mikulič.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unrar/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unrar.rh2"

LANGUAGE LANG_CZECH, SUBLANG_CZECH_CZECH_REPUBLIC

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 6, 15, 199, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Další svazek archivu"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Prosím vložte disketu s dalším svazkem archivu nebo najděte příslušný soubor na disku.\n\nKlikněte na OK, pokud je připraven.",IDS_NEXTDISK,12,9,177,32
    LTEXT           "&Název souboru:",IDC_STATIC_1,12,48,55,8
    EDITTEXT        IDC_FILENAME,12,58,160,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BROWSE,175,58,13,12
    DEFPUSHBUTTON   "OK",IDOK,43,76,50,14
    PUSHBUTTON      "Storno",IDCANCEL,106,76,50,14
END

IDD_ERROR DIALOGEX 15, 34, 350, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Chyba"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Název:",IDC_STATIC_1,4,10,26,8
    LTEXT           "",IDS_FILENAME,34,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Chyba:",IDC_STATIC_2,4,23,26,8,NOT WS_GROUP
    LTEXT           "Soubor nemůže být extrahován, protože je pokračující z předchozího svazku. Pro extrahování tohoto souboru musíte začít svazkem, v kterém soubor začíná.",IDC_STATIC_3,34,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&Příště nezobrazovat.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,34,44,183,12
    DEFPUSHBUTTON   "OK",IDOK,120,63,50,14,WS_GROUP
    PUSHBUTTON      "Storno",IDCANCEL,180,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 235, 115
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR - Konfigurace"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "&Při extrahování automaticky přeskočit soubory pokračující",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,10,203,12
    CONTROL         "&Nezobrazovat upozornění, pokud nemůže být vypsán celý",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,205,12
    LTEXT           "z předchozích svazků.",IDC_STATIC_1,23,22,154,8
    LTEXT           "obsah archivu.",IDC_STATIC_2,23,44,111,8
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,223,1
    CONTROL         "Zobrazit sloupec ""&Komprimovaná velikost"" při výpisu archivu",IDC_CFG_LISTINFOPACKEDSIZE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,70,213,12
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,90,223,1
    DEFPUSHBUTTON   "OK",IDOK,65,96,50,14,WS_GROUP
    PUSHBUTTON      "Storno",IDCANCEL,120,96,50,14
END

IDD_PASSWORD DIALOGEX 6, 15, 350, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Zadání hesla"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_LOCK_ICON,18,18,18,20
    LTEXT           "Tento soubor je šifrovaný. Prosím zadejte heslo pro dešifrování.",IDC_STATIC_1,57,10,214,8
    LTEXT           "Soubor:",IDC_STATIC_2,57,25,28,8
    CONTROL         "",IDS_FILENAME,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,87,25,250,8
    LTEXT           "&Heslo:",IDC_STATIC_3,57,38,23,8
    EDITTEXT        IDC_PASSWORD,87,36,167,12,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "&OK",IDOK,25,58,55,14,WS_GROUP
    DEFPUSHBUTTON   "&Vše",IDALL,86,58,55,14
    PUSHBUTTON      "&Přeskočit",IDSKIP,147,58,55,14
    PUSHBUTTON      "Přes&kočit vše",IDSKIPALL,208,58,55,14
    PUSHBUTTON      "Storno",IDCANCEL,269,58,55,14
END

IDD_WARNING DIALOGEX 6, 15, 213, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR - Upozornění"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Ne všechny soubory ve více-svazkovém archivu můžou být vypsány (a zobrazeny v panelu), protože nelze nalézt některý svazek archivu.",IDC_STATIC_1,11,8,194,24
    LTEXT           "Pro výpis celého obsahu archivu zkopírujte všechny svazky archivu do stejného adresáře.",IDC_STATIC_2,11,39,194,16
    CONTROL         "&Příště nezobrazovat",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,64,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,81,202,1
    DEFPUSHBUTTON   "OK",IDOK,155,87,50,14
END

