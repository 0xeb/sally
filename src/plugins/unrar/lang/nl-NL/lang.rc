// Dutch (nl-NL) resources for unrar. Translation: Cor van der Smissen, Marco Fung, Patrick Vijgeboom, S.V. (Stephan) Rietveld.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unrar/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unrar.rh2"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 6, 15, 212, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Volgende archief volume"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Plaats diskette die het volgende archief volume bevat of zoek naar het desbetreffende bestand in de hardeschijf.\n\nDruk op OK indien gereed.",IDS_NEXTDISK,12,9,192,32
    LTEXT           "&Bestandsnaam:",IDC_STATIC_1,12,48,54,8
    EDITTEXT        IDC_FILENAME,12,58,173,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BROWSE,188,58,13,12
    DEFPUSHBUTTON   "OK",IDOK,49,76,50,14
    PUSHBUTTON      "Annuleren",IDCANCEL,112,76,50,14
END

IDD_ERROR DIALOGEX 15, 34, 356, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Fout"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Naam:",IDC_STATIC_1,6,10,26,8
    LTEXT           "",IDS_FILENAME,36,10,313,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Fout:",IDC_STATIC_2,6,23,26,8,NOT WS_GROUP
    LTEXT           "Bestand kan niet uitgepakt worden omdat het gecontinueerd wordt vanaf het vorige volume. Om het bestand uit te pakken moet je beginnen met het volume waar het bestand begint.",IDC_STATIC_3,36,23,313,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&Toon dit bericht niet in het vervolg.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,44,183,12
    DEFPUSHBUTTON   "OK",IDOK,123,63,50,14,WS_GROUP
    PUSHBUTTON      "Annuleren",IDCANCEL,183,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 250, 115
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR Configuratie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "&Automatisch bestanden uit vorige volumes overslaan tijdens",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,10,212,12
    CONTROL         "A&ttentie niet weergeven wanneer de hele inhoud van het archief",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,229,12
    LTEXT           "uitpakken.",IDC_STATIC_1,23,22,154,8
    LTEXT           "niet opgesomd kan worden.",IDC_STATIC_2,23,44,111,8
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,238,1
    CONTROL         "Kolom ""&Ingepakt"" weergeven bij archieflijst",IDC_CFG_LISTINFOPACKEDSIZE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,70,200,12
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,90,238,1
    DEFPUSHBUTTON   "OK",IDOK,70,96,50,14,WS_GROUP
    PUSHBUTTON      "Annuleren",IDCANCEL,129,96,50,14
END

IDD_PASSWORD DIALOGEX 6, 15, 358, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Wachtwoord invoer"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_LOCK_ICON,18,18,18,20
    LTEXT           "Dit bestand is gecodeerd. Voer het wachtwoord in om te decoderen.",IDC_STATIC_1,57,10,233,8
    LTEXT           "Bestand:",IDC_STATIC_2,57,25,32,8
    CONTROL         "",IDS_FILENAME,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,105,25,240,8
    LTEXT           "&Wachtwoord:",IDC_STATIC_3,57,38,47,8
    EDITTEXT        IDC_PASSWORD,105,36,157,12,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "&OK",IDOK,28,58,50,14,WS_GROUP
    DEFPUSHBUTTON   "&Alle",IDALL,87,58,50,14
    PUSHBUTTON      "Over&slaan",IDSKIP,146,58,50,14
    PUSHBUTTON      "Alles overs&laan",IDSKIPALL,205,58,65,14
    PUSHBUTTON      "Annuleren",IDCANCEL,279,58,50,14
END

IDD_WARNING DIALOGEX 6, 15, 224, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR - Attentie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Niet alle bestanden in het multi-volume archief kunnen opgesomd worden (en weergegeven worden in het paneel), omdat sommige archief volumes niet zijn gevonden.",IDC_STATIC_1,11,8,206,24
    LTEXT           "Om de hele inhoud van het archief op te sommen kopieer alle archief volumes naar dezelfde map.",IDC_STATIC_2,11,39,205,16
    CONTROL         "&Toon dit bericht niet in het vervolg",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,64,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,81,213,1
    DEFPUSHBUTTON   "OK",IDOK,166,87,50,14
END

