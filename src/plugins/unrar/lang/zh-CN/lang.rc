// Chinese (Simplified) (zh-CN) resources for unrar. Translation: Michael Lu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unrar/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unrar.rh2"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 6, 15, 194, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "下一个压缩卷"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "请插入带有下一个压缩卷的磁盘或在磁盘上定位合适的文件。\n\n当准备好时点击""确定""。",IDS_NEXTDISK,12,9,170,32
    LTEXT           "文件名(&F):",IDC_STATIC_1,12,48,42,8
    EDITTEXT        IDC_FILENAME,12,58,155,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BROWSE,170,58,13,12
    DEFPUSHBUTTON   "确定",IDOK,39,76,50,14
    PUSHBUTTON      "取消",IDCANCEL,102,76,50,14
END

IDD_ERROR DIALOGEX 15, 34, 352, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "错误"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "名称:",IDC_STATIC_1,6,10,26,8
    LTEXT           "",IDS_FILENAME,36,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "错误:",IDC_STATIC_2,6,23,26,8,NOT WS_GROUP
    LTEXT           "无法解压文件，因为它是从上一个卷继续的。要提取这个文件，你必须从文件开头的卷开始解压。",IDC_STATIC_3,36,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "将来不再显示此消息(&D)。",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,44,183,12
    DEFPUSHBUTTON   "确定",IDOK,121,63,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,181,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 164, 115
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR 配置"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "当解压缩时自动跳过从上一个卷(&A)",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,10,144,12
    CONTROL         "当无法列出整个压缩包内容时(&D)",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,136,12
    LTEXT           "继续的文件。",IDC_STATIC_1,23,22,61,8
    LTEXT           "不显示注意。",IDC_STATIC_2,23,44,61,8
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,152,1
    CONTROL         "当列表压缩包时显示""压缩""列(&P)",IDC_CFG_LISTINFOPACKEDSIZE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,70,132,12
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,90,152,1
    DEFPUSHBUTTON   "确定",IDOK,29,96,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,84,96,50,14
END

IDD_PASSWORD DIALOGEX 6, 15, 350, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "输入密码"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_LOCK_ICON,18,18,18,20
    LTEXT           "这个文件是加密的。请输入密码来解密。",IDC_STATIC_1,57,10,202,8
    LTEXT           "文件:",IDC_STATIC_2,57,25,22,8
    CONTROL         "",IDS_FILENAME,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,92,25,245,8
    LTEXT           "密码(&P):",IDC_STATIC_3,57,38,32,8
    EDITTEXT        IDC_PASSWORD,92,36,162,12,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "确定(&O)",IDOK,28,58,54,14,WS_GROUP
    DEFPUSHBUTTON   "全部(&A)",IDALL,88,58,54,14
    PUSHBUTTON      "跳过(&S)",IDSKIP,148,58,54,14
    PUSHBUTTON      "跳过全部(&K)",IDSKIPALL,208,58,54,14
    PUSHBUTTON      "取消",IDCANCEL,268,58,54,14
END

IDD_WARNING DIALOGEX 6, 15, 239, 89
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR - 注意"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "不是所有多卷压缩包中的文件都能被列出(并显示在面板中)，因为一些压缩包卷无法找到。",IDC_STATIC_1,11,8,220,16
    LTEXT           "要列出整个压缩包内容，复制所有压缩包卷到相同的目录。",IDC_STATIC_2,11,31,220,16
    CONTROL         "将来不再显示此消息(&D)",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,48,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,65,228,1
    DEFPUSHBUTTON   "确定",IDOK,181,71,50,14
END

