// Spanish (es-ES) resources for unrar. Translation: Juan Pablo Barrio Lera.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unrar/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unrar.rh2"

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 6, 15, 202, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Siguiente volumen de archivo"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Por favor, inserte un disco con el siguiente volumen del archivo o localice el fichero apropiado en el disco.\n\nPulse Aceptar cuando esté preparado.",IDS_NEXTDISK,12,9,182,32
    LTEXT           "&Nombre de fichero:",IDC_STATIC_1,12,48,68,8
    EDITTEXT        IDC_FILENAME,12,58,163,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BROWSE,178,58,13,12
    DEFPUSHBUTTON   "Aceptar",IDOK,44,76,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,107,76,50,14
END

IDD_ERROR DIALOGEX 15, 34, 352, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Error"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Nombre:",IDC_STATIC_1,6,10,32,8
    LTEXT           "",IDS_FILENAME,42,10,303,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Error:",IDC_STATIC_2,6,23,32,8,NOT WS_GROUP
    LTEXT           "El fichero no puede ser extraido porque continúa desde un volumen anterior. Para extraer este fichero debe empezar con el volumen donde comienza el fichero.",IDC_STATIC_3,42,23,303,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&No mostrar este mensaje en lo sucesivo.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,42,44,177,12
    DEFPUSHBUTTON   "Aceptar",IDOK,121,63,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",IDCANCEL,181,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 220, 115
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuración de UnRAR"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "&Automáticamente saltar ficheros que continúan desde",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,10,195,12
    CONTROL         "&No mostrar aviso cuando todo el contenido del archivo",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,195,12
    LTEXT           "volúmenes anteriores al desempaquetar.",IDC_STATIC_1,23,22,154,8
    LTEXT           "no pueda ser listado.",IDC_STATIC_2,23,44,111,8
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,208,1
    CONTROL         "Mostrar columna ""&Comprimido"" al listar el archivo",IDC_CFG_LISTINFOPACKEDSIZE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,70,200,12
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,90,208,1
    DEFPUSHBUTTON   "Aceptar",IDOK,57,96,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",IDCANCEL,112,96,50,14
END

IDD_PASSWORD DIALOGEX 6, 15, 350, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Escriba la contraseña"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_LOCK_ICON,18,18,18,20
    LTEXT           "Este fichero está encriptado. Escriba la contraseña para su desencriptación.",IDC_STATIC_1,57,10,256,8
    LTEXT           "Fichero:",IDC_STATIC_2,57,25,30,8
    CONTROL         "",IDS_FILENAME,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,100,25,240,8
    LTEXT           "&Contraseña:",IDC_STATIC_3,57,38,42,8
    EDITTEXT        IDC_PASSWORD,100,36,157,12,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "C&orrecto",IDOK,30,58,50,14,WS_GROUP
    DEFPUSHBUTTON   "&Todos",IDALL,90,58,50,14
    PUSHBUTTON      "&Saltar",IDSKIP,150,58,50,14
    PUSHBUTTON      "S&altar todos",IDSKIPALL,210,58,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,270,58,50,14
END

IDD_WARNING DIALOGEX 6, 15, 213, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR - Aviso"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "No todos los ficheros del archivo multivolumen pueden listarse (y verse en el panel), porque algunos de los volúmenes del archivo no se encontraron.",IDC_STATIC_1,11,8,194,24
    LTEXT           "Para listar todo el contenido del archivo copie todos los volúmenes del archivo al mismo directorio.",IDC_STATIC_2,11,39,194,16
    CONTROL         "&No mostrar este mensaje en lo sucesivo",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,64,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,81,202,1
    DEFPUSHBUTTON   "Aceptar",IDOK,155,87,50,14
END

