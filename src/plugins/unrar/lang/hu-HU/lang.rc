// Hungarian (hu-HU) resources for unrar. Translation: Török József.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unrar/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unrar.rh2"

LANGUAGE LANG_HUNGARIAN, SUBLANG_HUNGARIAN_HUNGARY

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 6, 15, 194, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Következő kötet"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Kérem helyezze be a következő kötet lemezét vagy keresse ki a következő fájlt.\n\nOK ha kész.",IDS_NEXTDISK,12,9,170,32
    LTEXT           "&Fájlnév:",IDC_STATIC_1,12,48,42,8
    EDITTEXT        IDC_FILENAME,12,58,155,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BROWSE,170,58,13,12
    DEFPUSHBUTTON   "OK",IDOK,39,76,50,14
    PUSHBUTTON      "Mégse",IDCANCEL,102,76,50,14
END

IDD_ERROR DIALOGEX 15, 34, 350, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Hiba"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Név:",IDC_STATIC_1,8,10,22,8
    LTEXT           "",IDS_FILENAME,34,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Hiba:",IDC_STATIC_2,8,23,22,8,NOT WS_GROUP
    LTEXT           "A fájl nem tömöríthető ki, mert egy előző kötet tartalmának folytatása. A fájl kitömörítéséhez az első kötettel kell kezdenie, ahol a fájl kezdődik.",IDC_STATIC_3,34,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&Ne mutassa ezt az üzenetet.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,34,44,183,12
    DEFPUSHBUTTON   "OK",IDOK,120,63,50,14,WS_GROUP
    PUSHBUTTON      "Mégse",IDCANCEL,180,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 220, 115
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR beállítás"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "&Automatikusan hagyja ki az előző kötetekből",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,10,195,12
    CONTROL         "&Ne figyelmeztessen, ha az archívum teljes tartalma nem",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,199,12
    LTEXT           "folytatandó fájlokat.",IDC_STATIC_1,23,22,154,8
    LTEXT           "listázható ki.",IDC_STATIC_2,23,44,111,8
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,208,1
    CONTROL         """&Tömörített"" oszlop mutatása az archívum listázásakor",IDC_CFG_LISTINFOPACKEDSIZE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,70,200,12
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,90,208,1
    DEFPUSHBUTTON   "OK",IDOK,57,96,50,14,WS_GROUP
    PUSHBUTTON      "Mégse",IDCANCEL,112,96,50,14
END

IDD_PASSWORD DIALOGEX 6, 15, 350, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Jelszó megadása"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_LOCK_ICON,18,18,18,20
    LTEXT           "A fájl titkosított. Adja meg a dekódolási jelszót.",IDC_STATIC_1,57,10,197,8
    LTEXT           "Fájl:",IDC_STATIC_2,57,25,17,8
    CONTROL         "",IDS_FILENAME,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,84,25,253,8
    LTEXT           "&Jelszó:",IDC_STATIC_3,57,38,24,8
    EDITTEXT        IDC_PASSWORD,84,36,170,12,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "&OK",IDOK,30,58,50,14,WS_GROUP
    DEFPUSHBUTTON   "&Mind",IDALL,90,58,50,14
    PUSHBUTTON      "Ki&hagy",IDSKIP,150,58,50,14
    PUSHBUTTON      "Mind &kihagy",IDSKIPALL,210,58,50,14
    PUSHBUTTON      "Mégse",IDCANCEL,270,58,50,14
END

IDD_WARNING DIALOGEX 6, 15, 213, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR - Figyelmeztetés"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "A több-kötetes archívum nem minden fájlja listázható (és látható a panelben), mert néhány archívum kötet nem található.",IDC_STATIC_1,11,8,194,24
    LTEXT           """A archívum teljes tartalmához, az archívum minden kötetét másoljon egy mappába.",IDC_STATIC_2,11,39,194,16
    CONTROL         "&Ne mutassa ezt az üzenetet",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,64,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,81,202,1
    DEFPUSHBUTTON   "OK",IDOK,155,87,50,14
END

