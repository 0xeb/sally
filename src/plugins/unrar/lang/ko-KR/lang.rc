// Korean (ko-KR) resources for unrar. Translation: Sally contributors (AI-assisted).
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unrar/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unrar.rh2"

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 6, 15, 194, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "다음 압축 파일 볼륨"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "다음 압축 파일 볼륨이 있는 디스크를 넣거나 디스크에서 해당 파일을 찾으십시오.\n\n준비되면 확인을 누르십시오.",IDS_NEXTDISK,12,9,170,32
    LTEXT           "파일 이름(&F):",IDC_STATIC_1,12,48,42,8
    EDITTEXT        IDC_FILENAME,12,58,155,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BROWSE,170,58,13,12
    DEFPUSHBUTTON   "확인",IDOK,39,76,50,14
    PUSHBUTTON      "취소",IDCANCEL,102,76,50,14
END

IDD_ERROR DIALOGEX 15, 34, 352, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "오류"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "이름:",IDC_STATIC_1,6,10,26,8
    LTEXT           "",IDS_FILENAME,36,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "오류:",IDC_STATIC_2,6,23,26,8,NOT WS_GROUP
    LTEXT           "이 파일은 이전 볼륨에서 이어지므로 추출할 수 없습니다. 이 파일을 추출하려면 파일이 시작되는 볼륨부터 시작해야 합니다.",IDC_STATIC_3,36,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "이 메시지를 다시 표시 안 함(&D)",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,44,183,12
    DEFPUSHBUTTON   "확인",IDOK,121,63,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,181,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 164, 115
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR 설정"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "이전 볼륨에서 이어지는 파일 자동으로 건너뛰기(&A)",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,10,144,12
    CONTROL         "압축 파일 전체 내용을 나열할 수 없을 때(&D)",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,136,12
    LTEXT           "(압축을 풀 때)",IDC_STATIC_1,23,22,61,8
    LTEXT           "주의 메시지 표시 안 함",IDC_STATIC_2,23,44,61,8
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,152,1
    CONTROL         "압축 파일 목록에 ""압축 크기"" 열 표시(&P)",IDC_CFG_LISTINFOPACKEDSIZE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,12,70,132,12
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,90,152,1
    DEFPUSHBUTTON   "확인",IDOK,29,96,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,84,96,50,14
END

IDD_PASSWORD DIALOGEX 6, 15, 350, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "암호 입력"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_LOCK_ICON,18,18,18,20
    LTEXT           "이 파일은 암호화되어 있습니다. 해독할 암호를 입력하십시오.",IDC_STATIC_1,57,10,202,8
    LTEXT           "파일:",IDC_STATIC_2,57,25,22,8
    CONTROL         "",IDS_FILENAME,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,92,25,245,8
    LTEXT           "암호(&P):",IDC_STATIC_3,57,38,32,8
    EDITTEXT        IDC_PASSWORD,92,36,162,12,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "확인(&O)",IDOK,28,58,54,14,WS_GROUP
    DEFPUSHBUTTON   "모두(&A)",IDALL,88,58,54,14
    PUSHBUTTON      "건너뛰기(&S)",IDSKIP,148,58,54,14
    PUSHBUTTON      "모두 건너뛰기(&K)",IDSKIPALL,208,58,54,14
    PUSHBUTTON      "취소",IDCANCEL,268,58,54,14
END

IDD_WARNING DIALOGEX 6, 15, 239, 89
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnRAR - 주의"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "일부 압축 파일 볼륨을 찾을 수 없으므로 다중 볼륨 압축 파일의 모든 파일을 나열(및 패널에 표시)할 수 없습니다.",IDC_STATIC_1,11,8,220,16
    LTEXT           "압축 파일 전체 내용을 나열하려면 모든 압축 파일 볼륨을 같은 디렉터리에 복사하십시오.",IDC_STATIC_2,11,31,220,16
    CONTROL         "이 메시지를 다시 표시 안 함(&D)",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,48,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,65,228,1
    DEFPUSHBUTTON   "확인",IDOK,181,71,50,14
END

