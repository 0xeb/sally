  IDS_TOOBIG2, "Nie je možné dokončiť operáciu, kvôli 4GB limitu pre veľkosť ZIP súboru.\n\nNa komprimáciu viac ako 4GB dát do ZIP archívu použite viaczväzkový archív. Môžete vytvoriť 65536 zväzkov, každý s veľkosťou 4GB. Avšak limit veľkosti každého súboru komprimovaného do archívu je 4GB."
  IDS_FILENOTFOUND, "Súbor nenájdený."
  IDS_ALLFILES, "Všetky súbory (*.*)"
  IDS_NOTFOUND, "Súbor nenájdený."
  IDS_BADMSGBOXTYPE, "Tlačidlá ""Súhlasím + Nesúhlasím"" môžu byť použité len v spojení s typom dialógového okna ""Dlhá správa""."
  IDS_LOTFILES, "Chystáte sa vytvoriť ZIP archív obsahujúci viac ako 65535 položiek. Takýto archív nie je kompatibilný s originálnym ZIP formátom a niektoré archivačné programy nemusia byť schopné ho extrahovať.\n\nChcete pokračovať?"
  IDS_LOTFILESSFX, "Nie je možné vytvoriť samorozbaľovací ZIP archív obsahujúci viac ako 65535 položiek."
  IDS_BADAES, "Súbor je zašifrovaný neznámou AES verziou."
  IDS_PWDTOOLONG, "Heslo je príliš dlhé.\nMaximálna dĺžka hesla pre AES šifrovanie je 128 znakov."
  IDS_AESERROR, "AES chyba."
  IDS_MACERROR, "Autorizačný kód nie je zhodný. Súbor je buď poškodený alebo je neplatné heslo."
  IDS_ERRZIP64, "Požadovaná operácia nie je podporovaná pre zip64 archívy. Zip64 archívy je možné len prehliadať a extrahovať."
  IDS_ONLYFULLVERSION, " (dostupné len v plnej verzii)"
  IDS_ERRBZIP2 "Nastala chyba v BZIP2 streame. Archív môže byť poškodený."
  IDS_UNSUP_CD_ENCRYPTION "Centrálny adresár tohto archívu obsahuje šifrovaný alebo komprimovaný zoznam súborov.\nToto nie je podporované."
  IDS_LISTINFO_PAKEDSIZE      "Komprimovaná"
  IDS_LISTINFO_PAKEDSIZE_DESC "Komprimovaná veľkosť súboru"
  IDS_SIZE_KB, "KB"
  IDS_SIZE_MB, "MB"
  IDS_MODIFICATION_NOT_SUPPORTED, "Tento ZIP súbor používa formát údajov, v ktorom aktuálna verzia pluginu ZIP nedokáže vykonávať zmeny"
  IDS_WAITFOR_INFO, "Je potrebné len ak inštalačný program spustí ďalší spustiteľný súbor, ktorý pokračuje v inštalácii zatiaľ čo pôvodný inštalačný program je ukončený.\nTakto sa správajú napr. niektoré verzie Install Shield."
}

STRINGTABLE
{
  IDS_SFX_COMMENT_HEAD1, ";Voľby pre Self-Extractor\r\n\r\n;Toto je súbor s nastavením pre Self-Extractor.\r\n;\r\n;Syntax súboru:\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD2, ";Riadky začínajúce bodkočiarkou sú považované za komentáre a sú \r\n;ignorované počas spracovania súboru.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD3, ";Všetky premenné okrem premennej version sú nepovinné. Ak nie je\r\n;premenná v súbore s voľbami nájdená, je použitá jej implicitná\r\n;hodnota. Implicitné hodnoty pre jazykovo závislé premenné (dlg_text,\r\n;dlg_title, button_text) sú načítané z použitého sfx balíčka.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD4, ";Všetky hodnoty reprezentované reťazcom, vrátane prázdnych reťazcov,\r\n;musia byť uzatvorené v dvojitých úvodzovkách. Na zapísanie úvodzoviek do\r\n;reťazca použite dve po sebe idúce dvojité úvodzovky.\r\n;\r\n;Číselné hodnoty nesmú byť uzatvorené v úvodzovkách.\r\n\r\n"
  IDS_SFX_COMMENT_VERSION, "\r\n;verzia súboru s nastavením, súčasná verzia je 2\r\n;toto je jediná povinná premenná\r\n\r\n"
  IDS_SFX_COMMENT_TARGDIR1, "\r\n;špecifikácia cieľového adresára, môže to byť buď absolútna cesta\r\n;alebo relatívna cesta; relatívna cesta je relatívna k aktuálnemu \r\n;adresáru, keď je samorozbaliteľný archív spustený\r\n"
  IDS_SFX_COMMENT_TARGDIR2, ";na začiatku (!) reťazca 'target_dir' môžete použiť aj preddefinované\r\n;premenné:\r\n;\r\n"
  IDS_SFX_COMMENT_TARGDIR3, ";  $(Temp)      dočasný adresár, nesmie byť v premennej target_dir \r\n;               nasledovaný žiadnym ďalším textom\r\n"
  IDS_SFX_COMMENT_TARGDIR4, ";  $(ProgFiles) užívateľova zložka 'Program Files'\r\n;  $(WinDir)    Windows adresár\r\n;  $(SysDir)    systémový adresár\r\n"
  IDS_SFX_COMMENT_TARGDIR5, ";  $[variable]  hodnota systémovej premennej s názvom 'variable'\r\n;  $<regkey>    hodnota premennej v registroch s názvom 'regkey'\r\n;  napr. SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
  IDS_SFX_COMMENT_ALLOWCHANGE, "\r\n;určuje, či má užívateľ povolené zmeniť cieľový adresár na rozbalenie\r\n;archívu\r\n;nastavte túto hodnotu na 1, ak si prajete zmenu povoliť\r\n\r\n"
  IDS_SFX_COMMENT_REMOVE1, "\r\n;určuje, či sa majú zmazať súbory v dočasnom adresári, keď\r\n;program špecifikovaný premennou 'command' skončí\r\n"
  IDS_SFX_COMMENT_REMOVE2, ";nastavte túto hodnotu na 1, ak si prajete zmazať súbory v dočasnom\r\n;adresári\r\n;použitie tejto voľby má zmysel iba vtedy, ak je 'target_dir' nastavená\r\n;na ""$(Temp)"", v ostatných prípadoch je hodnota ignorovaná\r\n\r\n"
  IDS_SFX_COMMENT_AUTO, "\r\n;určuje, či začať rozbaľovanie automaticky po spustení samorozba-\r\n;liteľného archívu\r\n;nastavte túto hodnotu na 1, ak si prajete, aby rozbaľovanie začalo\r\n;automaticky\r\n\r\n"
  IDS_SFX_COMMENT_SUMMARY, "\r\n;určuje, či zobraziť dialógové okno informujúce o úspešnosti\r\n;rozbaľovania archívu\r\n;nastavte túto hodnotu na 1, ak si prajete zobraziť toto okno\r\n\r\n"
  IDS_SFX_COMMENT_HIDE, "\r\n;určuje, či zobraziť dialógové okno programu\r\n;nastavte túto hodnotu na 1, ak si prajete zobraziť toto okno\r\n;použitie tejto voľby má zmysel iba vtedy, ak je 'autostart' nastavená\r\n;na 1, v ostatných prípadoch je hodnota ignorovaná\r\n\r\n"
  IDS_SFX_COMMENT_OVERWRITE, "\r\n;určuje, či automaticky prepisovať súbory v cieľovom adresári\r\n;nastavte túto hodnotu na 1, ak si prajete automatické prepisovanie\r\n;súborov\r\n\r\n"
  IDS_SFX_COMMENT_AUTODIR, "\r\n;určuje, či automaticky vytvoriť cieľový adresár bez pýtania sa užívateľa\r\n;nastavte túto hodnotu na 1, ak si prajete automatické vytváranie cieľového\r\n;adresára\r\n\r\n"
  IDS_SFX_COMMENT_COMMAND, "\r\n;program, http link alebo dokument, ktorý má byť spustený/otvorený\r\n;keď je archív úspešne rozbalený, cesta je relatívna k cieľovému \r\n;adresáru, do ktorého je archív rozbaľovaný, pri programe môžete uviesť aj\r\n;jeho parametre pre spustenie\r\n\r\n"
  IDS_SFX_COMMENT_PACKAGE, "\r\n;sfx balíček, ktorý má byť použitý pre tvorbu samorozbaliteľného\r\n;archívu; relatívna cesta je relatívna k adresáru s zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_MBUT, "\r\n;tlačidlá vo voliteľnom dialógovom okne\r\n;môže byť jedno z nasledujúcich: ""ok"", ""ok_cancel"", ""yes_no"",\r\n;""agree_disagree""\r\n\r\n"
  IDS_SFX_COMMENT_MICO, "\r\n;typ voliteľného dialógového okna\r\n;môže byť jeden z nasledujúcich: ""simple"", ""exclamation"", ""information"",\r\n;""question"", ""long_message""\r\n\r\n"
  IDS_SFX_COMMENT_MBOX, "\r\n;text a titulok voliteľného dialógového okna, ktoré je zobrazené\r\n;kým začne rozbaľovanie archívu\r\n;ak si neprajete zobraziť žiadne okno, nechajte hodnoty oboch premenných\r\n;prázdne("""")\r\n\r\n"
  IDS_SFX_COMMENT_TEXT, "\r\n;text, ktorý bude zobrazený v hlavnom dialógovom okne\r\n\r\n"
  IDS_SFX_COMMENT_TITLE, "\r\n;titulok hlavného dialógového okna\r\n\r\n"
  IDS_SFX_COMMENT_BUTTON, "\r\n;text tlačidla 'rozbaliť' v hlavnom dialógovom okne\r\n\r\n"
  IDS_SFX_COMMENT_VENDOR, "\r\n;meno firmy v ľavom dolnom rohu dialógového okna\r\n\r\n"
  IDS_SFX_COMMENT_WWW, "\r\n;www odkaz v pravom dolnom rohu dialógového okna\r\n\r\n"
  IDS_SFX_COMMENT_ICOFILE, "\r\n;súbor obsahujúci ikonu, môže to byť buď ICO súbor alebo PE \r\n;spustiteľný modul (ako sú win32 EXE a DLL súbory) obsahujúci ikonu\r\n;relatívna cesta je relatívna k adresáru so zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_ICOINDEX, "\r\n;kladná hodnota znamená index ikony (poradové číslo) v spustiteľnom\r\n;súbore špecifikovanom premennou 'icon_file'\r\n;záporná hodnota znamená resource ID ikony\r\n;pre ICO súbory je index vždy 0 a hodnota premennej je ignorovaná\r\n\r\n"
  IDS_SFX_COMMENT_WAITFOR1, "\r\n;Táto voľba umožňuje čakať pred zmazaním súborov v dočasnom adresári\r\n;na iný program než program špecifikovaný premennou 'Command'\r\n;Po ukončení tohto programu self-extractor zmaže súbory v dočasnom\r\n;adresári a sám skončí.\r\n"
  IDS_SFX_COMMENT_WAITFOR2, ";Táto voľba je nutná iba v prípade, že inštalačný program spustí\r\n;program, ktorý pokračuje v inštalácii, zatiaľ čo pôvodný inštalačný\r\n;program skončí\r\n"
  IDS_SFX_COMMENT_WAITFOR3, ";Takto sa správajú napr. niektoré verzie programu Install Shield.\r\n;Táto voľba je ignorovaná ak 'remove_temp' nie je nastavený na 1.\r\n\r\n"
  IDS_SFX_COMMENT_REQUIRESADMIN, "\r\n;vyžadovať práva administrátora na OS Windows Vista alebo novšom\r\n\r\n"
}
