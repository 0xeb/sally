IDD_MANFAVS DIALOGEX 59, 61, 240, 123
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Úprava obľúbených položiek"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Obľúbené položky:",IDC_STATIC_1,9,4,66,8
    LISTBOX         IDC_FAVORITIES,9,14,142,100,LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Premenovať",IDC_RENAME,161,13,70,14,WS_GROUP
    PUSHBUTTON      "O&dstrániť",IDC_REMOVE,161,32,70,14
    PUSHBUTTON      "Odstrániť &všetko",IDC_REMOVEALL,161,51,70,14
    DEFPUSHBUTTON   "Zatvoriť",IDOK,161,100,70,14
END

IDD_WAITFOR DIALOGEX 15, 24, 227, 147
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Počkať na"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Táto voľba Vám umožní počkať na iný proces ako je proces, ktorý ste určili v poli 'Príkaz'. Po ukončení tohto procesu samorozbaliteľný archív odstráni dočasné súbory a ukončí sa.",IDC_STATIC_1,12,9,200,32
    LTEXT           "",IDC_STATIC_2,12,49,200,32
    LTEXT           "&Názov spustiteľného súboru:",IDC_STATIC_3,12,89,103,8
    EDITTEXT        IDC_FILENAME,12,99,200,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_STATIC_4,3,121,220,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,28,128,50,14
    PUSHBUTTON      "Zrušiť",IDCANCEL,88,128,50,14
    PUSHBUTTON      "Nápoveda",IDHELP,148,128,50,14
END

IDD_CHANGELANG DIALOGEX 6, 15, 240, 114
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Zmena textu Self-Extractora"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Zmenili ste jazyk Self-Extractora, chcete užívateľské texty, ktoré ste zadali v dialógovom okne 'Texty samorozbaliteľného archívu' zmeniť na štandardné hodnoty zodpovedajúce jazyku, ktorý ste vybrali?",IDC_STATIC_1,11,8,207,32
    DEFPUSHBUTTON   "Áno",IDOK,35,48,50,14
    PUSHBUTTON      "Nie",IDCANCEL,94,48,50,14
    PUSHBUTTON      "Nápoveda",IDHELP,153,48,50,14
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,3,70,223,1
    CONTROL         "Vždy sa pýtať pred zmenou &textu",IDC_ASK,"Button",BS_AUTORADIOBUTTON,11,74,127,12
    CONTROL         "Automaticky nah&radiť texty ich štandardnými hodnotami",IDC_REPLACE,
                    "Button",BS_AUTORADIOBUTTON,11,86,220,12
    CONTROL         "Nepýtať sa a vždy ponechať te&xty nezmenené",IDC_LEAVE,
                    "Button",BS_AUTORADIOBUTTON,11,98,203,12
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SFXMENU MENU 
BEGIN
    POPUP "&Súbor"
    BEGIN
        MENUITEM "&Exportovať nastavenia...\tCtrl+E", CM_SFX_EXPORT
        MENUITEM "&Importovať nastavenia...\tCtrl+I", CM_SFX_IMPORT
    END
    POPUP "&Zobrazenie"
    BEGIN
        MENUITEM "&Náhľad SFX Dialógového okna...\tCtr+V", CM_SFX_PREVIEW
    END
    POPUP "Nast&avenie"
    BEGIN
        MENUITEM "&Resetovať všetko\tCtrl+Shift+R",    CM_SFX_RESETALL
        MENUITEM "Resetovať &hodnoty\tCtrl+R",       CM_SFX_RESETVALUES
        MENUITEM "Resetovať &texty\tCtrl+T",        CM_SFX_RESETTEXTS
        MENUITEM SEPARATOR
        MENUITEM "&Pridať k obľúbeným...\tCtrl+A", CM_SFX_ADD
        MENUITEM "&Obľúbené\tCtrl+F",          CM_SFX_FAVORITIES
        MENUITEM SEPARATOR
        MENUITEM "&Naposledy použité\tCtrl+L",          CM_SFX_LASTUSED
    END
END

IDM_FAVMANMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Premenovať",                     CM_FAVRENAME
        MENUITEM "&Odstrániť",                     CM_FAVDELETE
        MENUITEM SEPARATOR
        MENUITEM "Odstrániť &všetko",                 CM_FAVREMOVEALL
    END
END

IDM_COMMENTMENU MENU 
BEGIN
    POPUP "&Súbor"
    BEGIN
        MENUITEM "&Uložiť",                       CM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "&Zatvoriť\tAlt+F4",              CM_CLOSE
    END
END

IDM_SPECDIR MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Dočasného adresára",        CM_TEMP
        MENUITEM "&Program Files",              CM_PROGFILES
        MENUITEM "Adresára &Windows",          CM_WINDIR
        MENUITEM "Adresára &System",           CM_SYSDIR
        MENUITEM SEPARATOR
        MENUITEM "Premenné pros&tredia",       CM_ENVVAR
        MENUITEM "Hodnoty z &registra",             CM_REGENTRY
    END
END

