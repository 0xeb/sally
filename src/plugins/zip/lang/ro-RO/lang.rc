    LISTBOX         IDC_FAVORITIES,9,14,142,100,LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "Re&denumeste",IDC_RENAME,161,13,60,14,WS_GROUP
    PUSHBUTTON      "&Scoate",IDC_REMOVE,161,32,60,14
    PUSHBUTTON      "Remove &Tot",IDC_REMOVEALL,161,51,60,14
    DEFPUSHBUTTON   "Inchide",IDOK,161,100,60,14
END

IDD_WAITFOR DIALOGEX 15, 24, 247, 139
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Asteapta Pentru"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Aceasta optiune iti da voie sa astepti alt proces specificat de tine in campul 'Comanda'. Dupa ce acest proces e terminat self-extractor scoate fisierle temporare si se inchide singur.",IDC_STATIC_1,12,9,224,24
    LTEXT           "",IDC_STATIC_2,12,41,224,32
    LTEXT           "&Nume fisier al executabilului:",IDC_STATIC_3,12,81,103,8
    EDITTEXT        IDC_FILENAME,12,91,220,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_STATIC_4,3,113,240,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,38,120,50,14
    PUSHBUTTON      "Anuleaza",IDCANCEL,98,120,50,14
    PUSHBUTTON      "Help",IDHELP,158,120,50,14
END

IDD_CHANGELANG DIALOGEX 6, 15, 248, 114
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Schimba Texte Self-Extractor"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Ati schimbat limba self-extractor, doriti textele paricularizate pe care le-ati introdus in caseta dialog 'Texte Self-Extractor' sa fie schimbate la valorile lor default corespunzatoare cu limba pe care ati selectat-o?",IDC_STATIC_1,11,8,214,32
    DEFPUSHBUTTON   "Da",IDOK,40,48,50,14
    PUSHBUTTON      "Nu",IDCANCEL,99,48,50,14
    PUSHBUTTON      "Help",IDHELP,158,48,50,14
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,3,70,242,1
    CONTROL         "&Intreaba intodeauna inainte de a schimba textele",IDC_ASK,"Button",BS_AUTORADIOBUTTON,11,74,178,12
    CONTROL         "I&nlocuieste automat textele cu valorile lor default pe viitor",IDC_REPLACE,
                    "Button",BS_AUTORADIOBUTTON,11,86,204,12
    CONTROL         "Nu intreba pe viitor si lasa intotdeauna textele n&eschimbate",IDC_LEAVE,
                    "Button",BS_AUTORADIOBUTTON,11,98,211,12
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SFXMENU MENU 
BEGIN
    POPUP "&Fisier"
    BEGIN
        MENUITEM "&Exporta Setari...\tCtrl+E", CM_SFX_EXPORT
        MENUITEM "&Importa Setari...\tCtrl+I", CM_SFX_IMPORT
    END
    POPUP "&Vizualizeaza"
    BEGIN
        MENUITEM "Pre&vizualizeaza Casuta Mesaje SFX...\tCtr+V", CM_SFX_PREVIEW
    END
    POPUP "&Optiuni"
    BEGIN
        MENUITEM "&Reseteaza Tot\tCtrl+Shift+R",    CM_SFX_RESETALL
        MENUITEM "Reseteaza &Valorile\tCtrl+R",       CM_SFX_RESETVALUES
        MENUITEM "Reseteaza &Textele\tCtrl+T",        CM_SFX_RESETTEXTS
        MENUITEM SEPARATOR
        MENUITEM "&Adauga la Favorite...\tCtrl+A", CM_SFX_ADD
        MENUITEM "&Favorite\tCtrl+F",          CM_SFX_FAVORITIES
        MENUITEM SEPARATOR
        MENUITEM "Folosit &UltimulLast Used\tCtrl+L",          CM_SFX_LASTUSED
    END
END

IDM_FAVMANMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Redenumeste",                     CM_FAVRENAME
        MENUITEM "&Sterge",                     CM_FAVDELETE
        MENUITEM SEPARATOR
        MENUITEM "Scoate &Tot",                 CM_FAVREMOVEALL
    END
END

IDM_COMMENTMENU MENU 
BEGIN
    POPUP "&Fisier"
    BEGIN
        MENUITEM "&Salveaza",                       CM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "&Inchide\tAlt+F4",              CM_CLOSE
    END
END

IDM_SPECDIR MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Director &Temporar",        CM_TEMP
        MENUITEM "&Program Files",              CM_PROGFILES
        MENUITEM "Director &Windows",          CM_WINDIR
        MENUITEM "Director &System",           CM_SYSDIR
        MENUITEM SEPARATOR
        MENUITEM "Variabila de &Mediu",       CM_ENVVAR
        MENUITEM "Intrare &Registry",             CM_REGENTRY
    END
END

