    PUSHBUTTON      "Con&figureaza...",IDC_CONFIG,153,180,65,14
    PUSHBUTTON      "Help",IDHELP,226,180,55,14
END

IDD_CONFIG DIALOGEX 50, 37, 323, 277
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
