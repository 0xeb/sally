    LTEXT           "Setari panou",IDC_STATIC_11,7,217,45,8
    LTEXT           "",IDC_STATIC_12,52,221,265,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "Arata coloana ""Ar&hivat"" cand listezi arhiva",IDC_CFG_LISTINFOPACKEDSIZE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,228,220,12
    LTEXT           "",IDC_STATIC_13,6,247,311,1,SS_ETCHEDHORZ | WS_GROUP
