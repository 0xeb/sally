STRINGTABLE
{
  IDS_SFX_COMMENT_HEAD1, ";Setari Self-Extractor\r\n\r\n;Acesta este fisierul de setari pentru Self-Extractor.\r\n;\r\n;Sintaxa formatului de fisier:\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD2, ";Liniile incep cu  ';' caracterele sunt tratate ca si comentarii si sunt\n;ignorate in timp ce proceseaza fisierul de setari.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD3, ";Toate variabilele cu exceptia versiunii sunt optionale. Daca variabila nu e\r\n;gasita in fisierul de setari,  e folosita valoarea sa default.\r\n;Valori default pentru variblie dependente de limba (dlg_text, dlg_title,\r\n;button_text) sunt luate din pachetul sfx.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD4, ";Toate valorile sirului, incluzand siruri nule, ar trebui sa fie incluse in\r\n;ghilimele duble. Pentru a introduce ghilimele duble in sir folositi doua\r\n;randuri consecvente de ghilimele duble.\r\n;\r\n;Numerele nu pot fi incluse in ghilimele duble.\r\n\r\n"
  IDS_SFX_COMMENT_VERSION, "\r\n;versiune a fisierului de setari, versiunea curenta este 2\r\n;aceasta este singura variabila imputernicita\r\n\r\n"
  IDS_SFX_COMMENT_TARGDIR1, "\r\n;specificafrea directorului tinta, poate fi ori calea absoluta\r\n;sau calea relativa; calea relativa este relativa la directorul curent\r\n;cand executabilul sfx e lansat\r\n"
  IDS_SFX_COMMENT_TARGDIR2, ";puteti de asemena folosi variabile predefinite la inceputul (!)\r\n;sirului 'target_dir':\r\n;\r\n"
  IDS_SFX_COMMENT_TARGDIR3, ";  $(Temp)      director temporar, ar trebui sa stea doar singur\r\n;               in campul target_dir neurmat de nici o cale\r\n;               portiune\r\n"
  IDS_SFX_COMMENT_TARGDIR4, ";  $(ProgFiles) directorul 'Program Files' al utilizatorului\r\n;  $(WinDir)   directorul windows\r\n;  $(SysDir)    directorul system\r\n"
  IDS_SFX_COMMENT_TARGDIR5, ";  $[variable]  valoarea variabilei de mediu descrisa de\r\n;               'variable'\r\n;  $<regkey>    valoarea cheii din registri valoare descrisa de 'regkey'\r\n;  ex. SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
  IDS_SFX_COMMENT_ALLOWCHANGE, "\r\n; specifica daca utilizatorul poate schimba directorul tinta cand\r\n;dezarhiveaza\r\n;setati valoarea la 1 daca doriti sa activati acest lucru\r\n\r\n"
  IDS_SFX_COMMENT_REMOVE1, "\r\n;specifica daca sa scoata fisierele extrase in director temporar\r\n;cand un program specificat de variabila 'command' e terminat\r\n"
  IDS_SFX_COMMENT_REMOVE2, ";setati valoarea la 1 daca doriti sa scoateti fisierele temporare\r\n;folosirea acestei variabile are sens doar daca 'target_dir' e setat in\r\n;""$(Temp)"", altfel valoarea e ignorata\r\n\r\n"
  IDS_SFX_COMMENT_AUTO, "\r\n;specifica daca sa porneasca extragerea automat cand un utilizator ruleaza\r\n;arhiva self-extracting\r\n;setati valoarea la 1 daca doriti extragerea sa inceapa automat\r\n\r\n"
  IDS_SFX_COMMENT_SUMMARY, "\r\n;specifica daca sa arate o casuta de dialog care sa dea mesaj despre operatiune\r\n;succes dupa ce au fost extrase fisierele\r\n;setati valoarea la 1 daca doriti sa apara sumarul operatiunii\r\n\r\n"
  IDS_SFX_COMMENT_HIDE, "\r\n;specifica daca sa arate dialogul principal al self-extractor\r\n;setati valoarea la 1 daca nu doriti sa arate dialogul principal sfx\r\n;folosirea acestei variabile are sens doar daca 'autostart' e setat la 1,\r\n;altfel valoarea e ignorata\r\n\r\n"
  IDS_SFX_COMMENT_OVERWRITE, "\r\n;specifica daca toate fisierele in directorul tinta sa fie suprascrise in mod automat\r\n;setati valoarea la 1 daca doriti ca fisierele sa fie suprascrise\r\n;automat\r\n\r\n"
  IDS_SFX_COMMENT_AUTODIR, "\r\n;specifica daca sa creeze automat directorul tinta fara permisiunea\r\n;utilizatorului\r\n;setati valoarea la 1 daca doriti  ca directorul tinta sa fie creat\r\n;automat\r\n\r\n"
  IDS_SFX_COMMENT_COMMAND, "\r\n;program, legatura http sau document sa fie rulat/deschis cand extragerea\r\n;fisierelor s-a terminat cu succes, calea e relativa cu\r\n;directorul tinta pentru extragere, daca ati specificat un program puteti de asemeni\r\n;sa introduceti si argumenteletype in its arguments\r\n\r\n"
  IDS_SFX_COMMENT_PACKAGE, "\r\n;pachetul sfx sa fie folosit cand cream arhiva self-extracting\r\n;calea relativa este relativa la directorul cu zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_MBUT, "\r\n;butoanele in caseta de mesaje optionala\r\n;pot fi unul din urmatoarele: ""ok"", ""ok_cancel"", ""yes_no"",\r\n;""agree_disagree""\r\n\r\n"
  IDS_SFX_COMMENT_MICO, "\r\n;tipul de casuta de mesaje optionala\r\n;poate fi una din urmatoarele: ""simple"", ""exclamation"", ""information"",\r\n;""question"", ""long_message""\r\n\r\n"
  IDS_SFX_COMMENT_MBOX, "\r\n;textul si titlul casutei optionale de dialog, care e aratata inainte\r\n;ca extragerea sa inceapa\r\n;daca nu doriti sa se arate nici un mesaj lasati ambele campuri\r\n;goale ("""")\r\n\r\n"
  IDS_SFX_COMMENT_TEXT, "\r\n;textul care va fi aratat in dialogul principal al self-extractor\r\n\r\n"
  IDS_SFX_COMMENT_TITLE, "\r\n;titlul dialogului principal al self-extractor\r\n\r\n"
  IDS_SFX_COMMENT_BUTTON, "\r\n;textul in butonul dialogului principal al sfx\r\n\r\n"
  IDS_SFX_COMMENT_VENDOR, "\r\n;numele vanzatorului in coltul stanga jos al dialogului principal al sfx\r\n\r\n"
  IDS_SFX_COMMENT_WWW, "\r\n;legatura www in coltul dreapta jos al dialogului principal al sfx\r\n\r\n"
  IDS_SFX_COMMENT_ICOFILE, "\r\n;fisierele contin icoane, pot fi ori un fisier ICO sau un PE\r\n;fisier executabil (cum ar fi win32 EXE sau DLL) care contin icoane\r\n;calea relativa este relativa cu directorul cu zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_ICOINDEX, "\r\n;valoare pozitiva inseamna indexul unei icoane in fisierul executabil\r\n;specificat de variabila 'icon_file'\r\n;negativa inseamna o resursa ID a icoanei\r\n;pentru fisierele ICO indexul este intotdeauna 0 si valoarea sa e ignorata\r\n\r\n"
  IDS_SFX_COMMENT_WAITFOR1, "\r\n;Aceasta optiune iti permite sa astepti alt proces altul decat procesul\r\n;pe care l-ai psecificat in campul 'Command'. Dupa ce acest proces e terminat\r\n;self-extractor scoate fisierele temporare si se inchide.\r\n"
  IDS_SFX_COMMENT_WAITFOR2, ";E necesar doar daca programul de instalare lanseaza alt\r\n;executabil care continua instalarea in timp ce programul original\r\n; de instalare e terminat.\r\n"
  IDS_SFX_COMMENT_WAITFOR3, ";In aceasta maniera se comporta ex. ca niste versiuni de Install Shield.\r\n;Aceasta optiune e ignoratadoar daca 'remove_temp' nu e setat la 1.\r\n\r\n"
  IDS_SFX_COMMENT_REQUIRESADMIN, "\r\n;cere privilegii administrative de a rula pe Windows Vista sau versiuni mai noi de Windows\r\n\r\n"
}
