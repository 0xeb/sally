  IDS_BADAES, "Soubor je zašifrovaný neznámou AES verzí."
  IDS_PWDTOOLONG, "Heslo je příliš dlouhé..\nMaximální délka hesla pro AES šifrování je 128 znaků."
  IDS_AESERROR, "AES chyba."
  IDS_MACERROR, "Autorizační kód není stejný. Soubor je buď poškozený nebo je neplatné heslo."
  IDS_ERRZIP64, "Požadovaná operace není podporována pro zip64 archivy. Zip64 archivy je možné jen prohlížet a extrahovat."
  IDS_ONLYFULLVERSION, " (dostupné jen v plné verzi)"
  IDS_ERRBZIP2 "Nastala chyb v BZIP2 streamu. Archiv může být poškozený."
  IDS_UNSUP_CD_ENCRYPTION "Centrální adresář tohoto archivu obsahuje šifrovaný nebo komprimovaný seznam souborů.\nToto není podporováno."
  IDS_LISTINFO_PAKEDSIZE      "Komprimovaná"
  IDS_LISTINFO_PAKEDSIZE_DESC "Komprimovaná velikost souboru"
  IDS_SIZE_KB, "KB"
  IDS_SIZE_MB, "MB"
  IDS_MODIFICATION_NOT_SUPPORTED, "Tento ZIP soubor používá formát dat, ve kterém aktuální verze pluginu ZIP neumí provádět změny"
  IDS_WAITFOR_INFO, "Je potřeba jen pokud, instalační program spustí další spustitelný soubor, který pokračuje v instalaci zatímco původní instalační program je ukončen.\nTakto se chovají např. některé verze Install Shield."
}

STRINGTABLE
{
  IDS_SFX_COMMENT_HEAD1, ";Volby pro Self-Extractor\r\n\r\n;Toto je soubor s nastavením pro Self-Extractor.\r\n;\r\n;Syntaxe souboru:\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD2, ";Řádky začínají středníkem jsou považovány za komentáře a jsou ignoro-\r\n;vány během zpracování souboru.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD3, ";Všechny proměnné kromě proměnné version jsou nepovinné. Není-li\r\n;proměnná v souboru s volbami nalezena, je použita její implicitní\r\n;hodnota. Implicitní hodnoty pro jazykově závislé proměnné (dlg_text,\r\n;dlg_title, button_text) jsou načteny z použitého sfx balíčku.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD4, ";Všechny hodnoty reprezentované řetězcem, včetně prázdných řetězců,\r\n;musejí být uzavřeny ve dvojitých uvozovkách. Pro zapsání uvozovek do\r\n;řetězce použijte dvě po sobě jdoucí dvojité uvozovky.\r\n;\r\n;Číselné hodnoty nesmějí být uzavřeny v uvozovkách.\r\n\r\n"
  IDS_SFX_COMMENT_VERSION, "\r\n;verze souboru s nastavením, současná verze je 2\r\n;toto je jediná povinná proměnná\r\n\r\n"
  IDS_SFX_COMMENT_TARGDIR1, "\r\n;specifikace cílového adresáře, může to být buď absolutní cesta\r\n;nebo relativní cesta; relativní cesta je relativní k aktuálnímu adre-\r\n;sáři, když je samorozbalitelný archív spuštěn\r\n"
  IDS_SFX_COMMENT_TARGDIR2, ";na začátku (!) řetězce 'target_dir' můžete také použít předdefinované\r\n;proměnné:\r\n;\r\n"
  IDS_SFX_COMMENT_TARGDIR3, ";  $(Temp)      dočasný adresář, nesmí být v proměnné target_dir nás-\r\n;               ledován žádným dalším textem\r\n"
  IDS_SFX_COMMENT_TARGDIR4, ";  $(ProgFiles) uživatelova složka 'Program Files'\r\n;  $(WinDir)    windows adresář\r\n;  $(SysDir)    systémový adresář\r\n"
  IDS_SFX_COMMENT_TARGDIR5, ";  $[variable]  hodnota systémové proměnné s názvem 'variable'\r\n;  $<regkey>    hodnota proměnné v registrech s názvem 'regkey'\r\n;  např. SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
  IDS_SFX_COMMENT_ALLOWCHANGE, "\r\n;určuje zda je uživatelovy povoleno změnit cílový adresář pro rozbalení\r\n;archivu\r\n;nastavte tuto hodnotu na 1, přejete-li si změnu povolit\r\n\r\n"
  IDS_SFX_COMMENT_REMOVE1, "\r\n;určuje zda se mají smazat soubory v dočasném adresáři, když\r\n;program specifikovaný proměnnou 'command' skončí\r\n"
  IDS_SFX_COMMENT_REMOVE2, ";nastavte tuto hodnotu na 1, přejete-li si smazat soubory v dočasném\r\n;adresáři\r\n;použití této volby má smysl pouze tehdy, je-li 'target_dir' nastavena\r\n;na ""$(Temp)"", v ostatních případech je hodnota ignorována\r\n\r\n"
  IDS_SFX_COMMENT_AUTO, "\r\n;určuje zda začít rozbalování automaticky po spuštění samorozba-\r\n;litelného archivu\r\n;nastavte tuto hodnotu na 1, přejete-li si, aby rozbalování začalo\r\n;automaticky\r\n\r\n"
  IDS_SFX_COMMENT_SUMMARY, "\r\n;určuje zda zobrazit dialogové okénko informující o úspěšnosti\r\n;rozbalování archivu\r\n;nastavte tuto hodnotu na 1, přejete-li si zobrazit toto okénko\r\n\r\n"
  IDS_SFX_COMMENT_HIDE, "\r\n;určuje zda zobrazit dialogové okénko programu\r\n;nastavte tuto hodnotu na 1, přejete-li si zobrazit toto okénko\r\n;použití této volby má smysl pouze tehdy, je-li 'autostart' nastavena\r\n;na 1, v ostatních případech je hodnota ignorována\r\n\r\n"
  IDS_SFX_COMMENT_OVERWRITE, "\r\n;určuje zda automaticky přepisovat soubory v cílovém adresáři\r\n;nastavte tuto hodnotu na 1, přejete-li si automatické přepisování\r\n;souborů\r\n\r\n"
  IDS_SFX_COMMENT_AUTODIR, "\r\n;určuje zda automaticky vytvořit cílový adresář bez dotazování uživatele\r\n;nastavte tuto hodnotu na 1, přejete-li si automatické vytváření cílového\r\n;adresáře\r\n\r\n"
  IDS_SFX_COMMENT_COMMAND, "\r\n;program, http odkaz nebo dokument, který má být spuštěn/otevřen\r\n;když je archiv úspěšně rozbalen, cesta je relativní k cílovému adre-\r\n;sáři, do kterého je archiv rozbalován, u programu můžete také uvést\r\n;jeho parametry pro spuštění\r\n\r\n"
  IDS_SFX_COMMENT_PACKAGE, "\r\n;sfx balíček, který má být použit pro tvorbu samorozbalitelného\r\n;archivu; relativní cesta je relativní k adresáři se zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_MBUT, "\r\n;tlačítka ve volitelném dialogovém okénku\r\n;může být jedna z následujících: ""ok"", ""ok_cancel"", ""yes_no"",\r\n;""agree_disagree""\r\n\r\n"
  IDS_SFX_COMMENT_MICO, "\r\n;typ volitelného dialogového okénka\r\n;může být jedna z následujících: ""simple"", ""exclamation"", ""information"",\r\n;""question"", ""long_message""\r\n\r\n"
  IDS_SFX_COMMENT_MBOX, "\r\n;text and titulek volitelného dialogového okénka, které je zobrazeno\r\n;než začne rozbalování archivu\r\n;nepřejete-li si zobrazit žádné okénko nechte hodnoty obou proměnných\r\n;prázdné("""")\r\n\r\n"
  IDS_SFX_COMMENT_TEXT, "\r\n;text, který bude zobrazen v hlavním dialogovém okénku\r\n\r\n"
  IDS_SFX_COMMENT_TITLE, "\r\n;titulek hlavního dialogového okénka\r\n\r\n"
  IDS_SFX_COMMENT_BUTTON, "\r\n;text tlačítka 'rozbalit' v hlavním dialogovém okénku\r\n\r\n"
  IDS_SFX_COMMENT_VENDOR, "\r\n;jméno firmy v levém dolním rohu dialogového okénka\r\n\r\n"
  IDS_SFX_COMMENT_WWW, "\r\n;www odkaz v pravém dolním rohu dialogového okénka\r\n\r\n"
  IDS_SFX_COMMENT_ICOFILE, "\r\n;soubor obsahující ikonu, může to být buď ICO soubor nebo PE spusti-\r\n;telný modul (jako jsou win32 EXE a DLL soubory) obsahující ikonu\r\n;relativní cesta je relativní k adresáři se zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_ICOINDEX, "\r\n;kladná hodnota znamená index ikony (pořadové číslo) ve spustitelném\r\n;souboru specifikovaném proměnnou 'icon_file'\r\n;záporná hodnota znamená resource ID ikony\r\n;pro ICO soubory je index vždy 0 a hodnota proměnné je ignorována\r\n\r\n"
  IDS_SFX_COMMENT_WAITFOR1, "\r\n;Tato volba umožňuje čekat před smazáním souborů v dočasném adresáři\r\n;na jiný program než program specifikovaný proměnnou 'Command'\r\n;Po zakončeni tohoto programu self-extractor smaže soubory v dočasném\r\n;adresáři a sám skončí.\r\n"
  IDS_SFX_COMMENT_WAITFOR2, ";Tato volba je nutná pouze v případě, že instalační program spustí\r\n;program, který pokračuje v instalaci, zatímco původní instalační\r\n;program skončí\r\n"
  IDS_SFX_COMMENT_WAITFOR3, ";Takto se chovají např. některé verze programu Install Shield.\r\n;Tato volba je ignorována pokud 'remove_temp' není nastaven na 1.\r\n\r\n"
  IDS_SFX_COMMENT_REQUIRESADMIN, "\r\n;požadovat práva administrátora na OS Windows Vista nebo pozdějším\r\n\r\n"
}
