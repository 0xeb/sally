IDD_MANFAVS DIALOGEX 59, 61, 225, 123
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Úprava oblíbených"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Oblíbené:",IDC_STATIC_1,9,4,60,8
    LISTBOX         IDC_FAVORITIES,9,14,142,100,LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Přejmenovat",IDC_RENAME,161,13,55,14,WS_GROUP
    PUSHBUTTON      "O&dstranit",IDC_REMOVE,161,32,55,14
    PUSHBUTTON      "Odstranit &vše",IDC_REMOVEALL,161,51,55,14
    DEFPUSHBUTTON   "Zavřít",IDOK,161,100,55,14
END

IDD_WAITFOR DIALOGEX 15, 24, 227, 147
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Počkat na"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Tato volba Vám umožní počkat na další proces než je proces, který jste určily v poli 'Příkaz'. Po ukončení tohoto procesu samorozbalitelný archiv odstraní dočasné soubory a ukončí se.",IDC_STATIC_1,12,9,200,32
    LTEXT           "",IDC_STATIC_2,12,49,200,32
    LTEXT           "&Název spustitelného souboru:",IDC_STATIC_3,12,89,103,8
    EDITTEXT        IDC_FILENAME,12,99,200,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_STATIC_4,3,121,220,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,28,128,50,14
    PUSHBUTTON      "Storno",IDCANCEL,88,128,50,14
    PUSHBUTTON      "Nápověda",IDHELP,148,128,50,14
END

IDD_CHANGELANG DIALOGEX 6, 15, 240, 114
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Změna textu Self-Extractoru"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Změnili jste jazyk Self-Extractoru, chcete uživatelské texty, které jste zadali v dialogovém okně 'Texty samorozbalitelného archivu' změnit na standardní hodnoty odpovídající jazyku, který jste vybraly?",IDC_STATIC_1,11,8,207,32
    DEFPUSHBUTTON   "Ano",IDOK,35,48,50,14
    PUSHBUTTON      "Ne",IDCANCEL,94,48,50,14
    PUSHBUTTON      "Nápověda",IDHELP,153,48,50,14
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,3,70,223,1
    CONTROL         "Vždy se ptát před změnou &textu",IDC_ASK,"Button",BS_AUTORADIOBUTTON,11,74,127,12
    CONTROL         "Automaticky nah&radit texty jejich standardními hodnotami",IDC_REPLACE,
                    "Button",BS_AUTORADIOBUTTON,11,86,220,12
    CONTROL         "Neptat se a vždy zanechat te&xty nezměněné",IDC_LEAVE,
                    "Button",BS_AUTORADIOBUTTON,11,98,203,12
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SFXMENU MENU 
BEGIN
    POPUP "&Soubor"
    BEGIN
        MENUITEM "&Exportovat nastavení...\tCtrl+E", CM_SFX_EXPORT
        MENUITEM "&Importovat nastavení...\tCtrl+I", CM_SFX_IMPORT
    END
    POPUP "&Zobrazení"
    BEGIN
        MENUITEM "&Náhled SFX Dialogového okna...\tCtr+V", CM_SFX_PREVIEW
    END
    POPUP "Nast&avení"
    BEGIN
        MENUITEM "&Resetovat vše\tCtrl+Shift+R",    CM_SFX_RESETALL
        MENUITEM "Resetovat &hodnoty\tCtrl+R",       CM_SFX_RESETVALUES
        MENUITEM "Resetovat &texty\tCtrl+T",        CM_SFX_RESETTEXTS
        MENUITEM SEPARATOR
        MENUITEM "&Přidat k oblíbeným...\tCtrl+A", CM_SFX_ADD
        MENUITEM "&Oblíbené\tCtrl+F",          CM_SFX_FAVORITIES
        MENUITEM SEPARATOR
        MENUITEM "&Naposledy použité\tCtrl+L",          CM_SFX_LASTUSED
    END
END

IDM_FAVMANMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Přejmenovat",                     CM_FAVRENAME
        MENUITEM "&Odstranit",                     CM_FAVDELETE
        MENUITEM SEPARATOR
        MENUITEM "Odstranit &vše",                 CM_FAVREMOVEALL
    END
END

IDM_COMMENTMENU MENU 
BEGIN
    POPUP "&Soubor"
    BEGIN
        MENUITEM "&Uložit",                       CM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "&Zavřít\tAlt+F4",              CM_CLOSE
    END
END

IDM_SPECDIR MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Dočasného adresáře",        CM_TEMP
        MENUITEM "&Program Files",              CM_PROGFILES
        MENUITEM "Adresáře &Windows",          CM_WINDIR
        MENUITEM "Adresáře &System",           CM_SYSDIR
        MENUITEM SEPARATOR
        MENUITEM "Proměnné pros&tředí",       CM_ENVVAR
        MENUITEM "Hodnoty z &registru",             CM_REGENTRY
    END
END

