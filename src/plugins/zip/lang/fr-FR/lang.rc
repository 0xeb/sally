CAPTION "Gestion des favoris"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Favoris:",IDC_STATIC_1,9,4,60,8
    LISTBOX         IDC_FAVORITIES,9,14,142,100,LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "Re&nommer",IDC_RENAME,161,13,60,14,WS_GROUP
    PUSHBUTTON      "&Supprimer",IDC_REMOVE,161,32,60,14
    PUSHBUTTON      "&Tout supprimer",IDC_REMOVEALL,161,51,60,14
    DEFPUSHBUTTON   "Fermer",IDOK,161,100,60,14
END

IDD_WAITFOR DIALOGEX 15, 24, 303, 131
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "En attente de"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Cette option vous permet d'attendre un autre traitement que celui que vous avez spécifié dans le champ 'Commande'. Une fois ce traitement achevé, l'auto-extracteur supprime les fichiers temporaires et se termine.",IDC_STATIC_1,12,9,278,24
    LTEXT           "",IDC_STATIC_2,12,41,278,24
    LTEXT           "&Nom de fichier de l'exécutable:",IDC_STATIC_3,12,73,107,8
    EDITTEXT        IDC_FILENAME,12,83,278,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_STATIC_4,3,105,297,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,66,112,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,126,112,50,14
    PUSHBUTTON      "Aide",IDHELP,186,112,50,14
END

IDD_CHANGELANG DIALOGEX 6, 15, 292, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Modifier les textes d'auto-extracteur"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Vous avez modifié la langue de l'auto-extracteur; voulez-vous que les textes personnalisés saisis dan la boîte de dialogue 'Textes d'auto-extracteur' soient passés à leurs valeurs par défaut correspondant à la langue sélectionnée?",IDC_STATIC_1,11,8,263,24
    DEFPUSHBUTTON   "Oui",IDOK,62,40,50,14
    PUSHBUTTON      "Non",IDCANCEL,121,40,50,14
    PUSHBUTTON      "Aide",IDHELP,180,40,50,14
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,3,62,286,1
    CONTROL         "Toujours &demander avant de changer les textes",IDC_ASK,"Button",BS_AUTORADIOBUTTON,11,66,173,12
    CONTROL         "&Remplacer désormais automatiquement les textes par leurs valeurs par défaut",IDC_REPLACE,
                    "Button",BS_AUTORADIOBUTTON,11,78,274,12
    CONTROL         "Ne plus demander et toujours laisser les textes &inchangés",IDC_LEAVE,
                    "Button",BS_AUTORADIOBUTTON,11,90,205,12
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SFXMENU MENU 
BEGIN
    POPUP "&Fchier"
    BEGIN
        MENUITEM "Réglages &Export...\tCtrl+E", CM_SFX_EXPORT
        MENUITEM "Réglages &Import...\tCtrl+I", CM_SFX_IMPORT
    END
    POPUP "&Visualiser"
    BEGIN
        MENUITEM "Pré&visualiser la Boîte e dialogue SFX...\tCtr+V", CM_SFX_PREVIEW
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Tout réinitialiser\tCtrl+Shift+R",    CM_SFX_RESETALL
        MENUITEM "Réinitialiser les &valeurs\tCtrl+R",       CM_SFX_RESETVALUES
        MENUITEM "&Réinitialiser les textes\tCtrl+T",        CM_SFX_RESETTEXTS
        MENUITEM SEPARATOR
        MENUITEM "&Ajouter aux favoris...\tCtrl+A", CM_SFX_ADD
        MENUITEM "&Favoris\tCtrl+F",          CM_SFX_FAVORITIES
        MENUITEM SEPARATOR
        MENUITEM "&Dernier utilisé\tCtrl+L",          CM_SFX_LASTUSED
    END
END

IDM_FAVMANMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Renommer",                     CM_FAVRENAME
        MENUITEM "&Supprimer",                     CM_FAVDELETE
        MENUITEM SEPARATOR
        MENUITEM "&Tout supprimer",                 CM_FAVREMOVEALL
    END
END

IDM_COMMENTMENU MENU 
BEGIN
    POPUP "&Fichier"
    BEGIN
        MENUITEM "&Enregistrer",                       CM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "&Fermer\tAlt+F4",              CM_CLOSE
    END
END

IDM_SPECDIR MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Répertoire &temporaire",        CM_TEMP
        MENUITEM "Fichiers &programme",              CM_PROGFILES
        MENUITEM "Répertoire &Windows",          CM_WINDIR
        MENUITEM "Répertoire &Système",           CM_SYSDIR
        MENUITEM SEPARATOR
        MENUITEM "&Variable d'environnement",       CM_ENVVAR
        MENUITEM "Entrée de &registre",             CM_REGENTRY
    END
END

