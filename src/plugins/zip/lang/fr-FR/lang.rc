STRINGTABLE
{
  IDS_SFX_COMMENT_HEAD1, ";Configuration de l'Auto-extracteur\r\n\r\n;Il s'agit du fichier de configuration de l'Auto-extracteur.\r\n;\r\n;Syntaxe du format de fichier:\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD2, ";Les lignes commençant par le caractère ';' sont traitées comme des commentaires et sont\r\n;ignorées lors du traitement du fichier de configuration.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD3, ";Toutes les variables sauf version sont en option. Si la variable n'est\r\n;pas trouvée dans le fichier de configuration, sa valeur par défaut est utilisée.\r\n;Les valeurs par défaut des variables dépendant de la langue (dlg_text, dlg_title,\r\n;button_text) proviennent du package sfx.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD4, ";Toutes les valeurs de chaîne, y compris les chaînes nulles, doivent être mises entre\r\n;guillemetss. Pour saisir des guillements dans la chaîne, utilisez deux\r\n;guillements à la suite.\r\n;\r\n;Les nombres ne peuvent pas être entre guillemets.\r\n\r\n"
  IDS_SFX_COMMENT_VERSION, "\r\n;version du fichier de configuration, la version actuelle est 2\r\n;c'est la seule variable obligatoire\r\n\r\n"
  IDS_SFX_COMMENT_TARGDIR1, "\r\n;la spécification du répertoire cible peut être soit un chemin absolu\r\n;ou relatif; le chemin relatif est relatif au répertoire courant\r\n;lorsque l'exécutable sfx est lancé\r\n"
  IDS_SFX_COMMENT_TARGDIR2, ";vous pouvez également utiliser des variables prédéfinies au début (!)\r\n;de la chaîne 'target_dir':\r\n;\r\n"
  IDS_SFX_COMMENT_TARGDIR3, ";  $(Temp)      répertoire temporaire, doit être seul\r\n;               dans le champ target_dir field non suivi par un chemin\r\n;               portion\r\n"
  IDS_SFX_COMMENT_TARGDIR4, ";  $(ProgFiles) dossier 'Program Files' de sl'utilisateur\r\n;  $(WinDir)    répertoire Windows\r\n;  $(SysDir)    répertoire système\r\n"
  IDS_SFX_COMMENT_TARGDIR5, ";  $[variable]  valeur d'une variable d'environnement décrite par\r\n;               'variable'\r\n;  $<regkey>    valeur de la clé de registre valeur décrite par'regkey'\r\n;  ex SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
  IDS_SFX_COMMENT_ALLOWCHANGE, "\r\n;spécifier si l'utilisateur peut modifier un répertoire cible lors de la\r\n;décompression\r\n;mettre sa valeur à 1 si vous voulez l'activer\r\n\r\n"
  IDS_SFX_COMMENT_REMOVE1, "\r\n;précisez s'il faut supprimer les fichiers extraits dans le répertoire temporaire\r\n;lorsqu'un programme spécifié par la varialbe 'command' est terminée\r\n"
  IDS_SFX_COMMENT_REMOVE2, ";mettez cette valeur à 1 si vous voulez supprimer les fichiers temporaires\r\n;l'utilisation de cette variable ne sert que si 'target_dir' est mis à \r\n;""$(Temp)"", sinon la valeur est ignorée\r\n\r\n"
  IDS_SFX_COMMENT_AUTO, "\r\n;précisez s'il faut commencer automatiquement l'extraction lorsqu'un utilisateur lance\r\n;l'archive auto-extractible\r\n;mettez sa valeur à 1 si vous voulez que l'extraction commence automatiquement\r\n\r\n"
  IDS_SFX_COMMENT_SUMMARY, "\r\n;précisez s'il faut montrer une boîte de message notifiant l'opération\r\n;réussie une fois l'extraction des fichiers est terminée\r\n;mettez cette valeur à 1 si voulez afficher le résumé de l'opération\r\n\r\n"
  IDS_SFX_COMMENT_HIDE, "\r\n;précisez s'il faut montrer le dialogue principal de l'auto-extracteur\r\n;mettez cette valeur à 1 si vous ne voulez pas afficher la boîte de dialogue principale sfx\r\n;l'utilisation de cette variable ne sert que si 'autostart' est défini à 1,\r\n;sinon la valeur est ignorée\r\n\r\n"
  IDS_SFX_COMMENT_OVERWRITE, "\r\n;précisez s'il faut écraser automatiquement tous les fichiers dans le répertoire\r\n;cible\r\n;mettez cette valeur à 1 si vous désirez que les fichiers soient écrasés\r\n;automatiquement\r\n\r\n"
  IDS_SFX_COMMENT_AUTODIR, "\r\n;précisez s'il faut créer automatiquement un répertoire cible sans demander\r\n;user\r\n;mettez cette valeur à 1 si vous voulez que le répertoire cible soit créé\r\n;automatiquement\r\n\r\n"
  IDS_SFX_COMMENT_COMMAND, "\r\n;programme, http link ou document à lancer/ouvrir lorsque l'extraction\r\n;des fichiers est réussie, le chemin est relatif au\r\n;répertoire cible d'extraction, si vous spécifiez un programme, vous pouvez aussi\r\n;saisir ses arguments\r\n\r\n"
  IDS_SFX_COMMENT_PACKAGE, "\r\n;package sfx à utiliser lors de la création d'une archive auto-extratible\r\n;le chemin relatif est relatif au répertoire avec zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_MBUT, "\r\n;boutons dans la boîte de message optionnelle\r\n;peut être un des suivants: ""ok"", ""ok_cancel"", ""yes_no"",\r\n;""agree_disagree""\r\n\r\n"
  IDS_SFX_COMMENT_MICO, "\r\n;type de boîte de message optionnel\r\n;peut être un des suivants: ""simple"", ""exclamation"", ""information"",\r\n;""question"", ""long_message""\r\n\r\n"
  IDS_SFX_COMMENT_MBOX, "\r\n;texte et titre de la boîte de message optionnelle, affichée précédemment\r\n;l'extraction commence\r\n;si vous ne voulez pas afficher de boîte de message laissez les deux champs\r\n;vides ("""")\r\n\r\n"
  IDS_SFX_COMMENT_TEXT, "\r\n;texte à afficher dans la boîte de dialogue principale de l'auto-extracteur\r\n\r\n"
  IDS_SFX_COMMENT_TITLE, "\r\n;titre de la boîte de dialogue principale de l'auto-extracteur\r\n\r\n"
  IDS_SFX_COMMENT_BUTTON, "\r\n;texte du bouton extraction de la boîte de dialogue principale sfx\r\n\r\n"
  IDS_SFX_COMMENT_VENDOR, "\r\n;nom du vendeur dans le coin inférieur gauche de la boîte de dialogue principale sfx\r\n\r\n"
  IDS_SFX_COMMENT_WWW, "\r\n;lien www dans le coin inférieur droit de la boîte de dialogue principale sfx\r\n\r\n"
  IDS_SFX_COMMENT_ICOFILE, "\r\n;fichiers contenant les données d'icône, cela peut être soit un fichier ICO ou un\r\n;fichier exécutable PE (comme win32 EXE ou DLL) contenant l'icône\r\n;le chemin relatif est relatif au répertoire avec zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_ICOINDEX, "\r\n;une valeur positive signifie l'index d'un icône dans le fichier exécutable\r\n;spécifié par la variable 'icon_file'\r\n;une valeur négative signifie un ID de ressource de l'icône\r\n;pour les fichiers ICO l'index est toujours à 0 et sa valeur est ignorée\r\n\r\n"
  IDS_SFX_COMMENT_WAITFOR1, "\r\n;Cette option vous permet d'attendre un autre processus than que celui que\r\n;vous avez spécifié dans le champ 'Command'. Une fois ce processus terminé\r\n;l'auto-extracteur supprime les fichiers temporaires puis se termine.\r\n"
  IDS_SFX_COMMENT_WAITFOR2, ";Il n'est nécessaire que si le programme d'installation lance un autre\r\n;exécutable qui poursuit l'installation tandis que le programme d'installation\r\n;original se termine.\r\n"
  IDS_SFX_COMMENT_WAITFOR3, ";Certaines versions, comme Install Shield, se comportent de cette manière.\r\n;Cette option est ignorée sauf si 'remove_temp' est mis à 1.\r\n\r\n"
  IDS_SFX_COMMENT_REQUIRESADMIN, "\r\n;nécessite des privilèges d'administrateur pour fonctionner sur Windows Vista ou ultérieur\r\n\r\n"
}
