IDD_EXPACKOPTIONS DIALOGEX 41, 41, 339, 201
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Options étendues de compression"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Archive:",IDC_STATIC_1,17,9,30,8
    CONTROL         "",IDC_ARCHIVE,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,50,9,281,8
    LTEXT           "",IDC_STATIC_2,8,24,323,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "Créer une archive &multi-volume",IDC_MULTIVOL,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,17,31,118,12
    LTEXT           "Taille du &volume:",IDC_STATIC_3,177,33,60,8,NOT WS_GROUP
    COMBOBOX        IDC_VOLSIZE,238,31,60,110,CBS_DROPDOWN | WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_UNITS,303,31,27,34,CBS_DROPDOWNLIST | WS_DISABLED | WS_TABSTOP
    CONTROL         "Nomm&er les fichiers en séquence",IDC_SEQNAME,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,17,45,124,12
    LTEXT           "",IDC_STATIC_4,8,63,323,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "Créer une archive a&uto-extractible",IDC_SELFEXTR,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,17,70,126,12
    PUSHBUTTON      "&Avancé...",IDC_ADVANCED,275,70,55,14,WS_DISABLED
    LTEXT           "",IDC_STATIC_5,8,90,323,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "C&rypter les fichiers",IDC_ENCRYPT,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,17,97,75,12
    LTEXT           "Mot de &passe:",IDC_STATIC_6,28,113,60,8,NOT WS_GROUP
    EDITTEXT        IDC_PASSWORD1,122,111,85,12,ES_PASSWORD | ES_AUTOHSCROLL | WS_DISABLED
    LTEXT           "C&onfirmer le mot de passe:",IDC_STATIC_7,28,129,93,8,NOT WS_GROUP
    EDITTEXT        IDC_PASSWORD2,122,127,85,12,ES_PASSWORD | ES_AUTOHSCROLL | WS_DISABLED
    GROUPBOX        " Méthode de cryptage ",IDC_STATIC_8,219,97,111,50
    CONTROL         "compatible &ZIP 2.0 (faible)",IDC_ENC_ZIP20,"Button",BS_AUTORADIOBUTTON | WS_DISABLED | WS_GROUP,224,108,101,12
    CONTROL         "&128-bit AES",IDC_ENC_AES128,"Button",BS_AUTORADIOBUTTON | WS_DISABLED,224,120,53,12
    CONTROL         "&256-bit AES",IDC_ENC_AES256,"Button",BS_AUTORADIOBUTTON | WS_DISABLED,224,132,55,12
    LTEXT           "",IDC_STATIC_9,8,154,323,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "&Ne plus afficher cette boîte de dialogue (modificable dans configuration)",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,17,161,260,12
    DEFPUSHBUTTON   "OK",IDOK,47,180,55,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,110,180,55,14
    PUSHBUTTON      "&Configurer...",IDC_CONFIG,173,180,55,14
    PUSHBUTTON      "Aide",IDHELP,236,180,55,14
END

IDD_CONFIG DIALOGEX 50, 37, 352, 277
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration ZIP"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Décompression",IDC_STATIC_1,7,6,53,8
    LTEXT           "",IDC_STATIC_2,62,10,285,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "Décompresse a&utomatiquement les archives multi-volume stockées sur disque fixe",IDC_AUTOEXPANDMV,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,17,287,12
    LTEXT           "Compression",IDC_STATIC_3,7,35,45,8
    LTEXT           "",IDC_STATIC_4,54,39,293,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "Utilise une copie &temporaire de l'archive pour les modifications (recommandé, évite un crash)",IDC_BACKUP,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,46,325,12
    CONTROL         "Ne pas stocker les répertoires &vides dans l'archive ZIP",IDC_NOEMPTYDIRS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,58,192,12
    CONTROL         "Dé&finit l'heure de l'archive à celle du fichier le plus récent lors de sa modification",IDC_SETFILETIME,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,70,282,12
    CONTROL         "Utilise des noms de fichier compatibles WinZip pour les archives multi-volume (sauf pour",IDC_WINZIPNAMES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,82,309,12
    LTEXT           "les archives auto-extractibles, toujours nommés selon les conventions Sally)",IDC_STATIC_5,26,94,298,8
    LTEXT           "&Niveau de compression (0 - 9, 9 meilleure compression, plus lent):",IDC_STATIC_6,14,107,225,8
    EDITTEXT        IDC_LEVEL,240,105,16,12
    LTEXT           "Langue d'&auto-extraction par défaut:",IDC_STATIC_7,14,120,126,8
    COMBOBOX        IDC_LANGUAGE,141,118,64,57,CBS_DROPDOWNLIST | CBS_SORT | WS_TABSTOP
    LTEXT           "Confirmations",IDC_STATIC_8,7,136,48,8
    LTEXT           "",IDC_STATIC_9,57,140,290,1,SS_ETCHEDHORZ | WS_GROUP
    GROUPBOX        "Lorsque la langue SFX change",IDC_STATIC_10,14,148,259,49
    CONTROL         "Toujours d&emander avant de modifier les textes",IDC_ASK,"Button",BS_AUTORADIOBUTTON | WS_GROUP,20,158,173,12
    CONTROL         "&Remplace automatiquement les textes par leurs valeurs par défaut",IDC_REPLACE,
                    "Button",BS_AUTORADIOBUTTON,20,170,236,12
    CONTROL         "Ne pas demander et ne jamais &modifier les textes",IDC_LEAVE,
                    "Button",BS_AUTORADIOBUTTON,20,182,200,12
    CONTROL         "Afficher la boîte de dialogue avec les &options étendues avant compression",IDC_SHOWEXOPTIONS,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,200,260,12
    LTEXT           "Réglages du panneau",IDC_STATIC_11,7,217,76,8
    LTEXT           "",IDC_STATIC_12,85,221,262,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "Montrer la colonne ""&Compressé"" lors du listage d'archive",IDC_CFG_LISTINFOPACKEDSIZE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,228,220,12
    LTEXT           "",IDC_STATIC_13,6,247,341,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,47,256,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,106,256,50,14
    PUSHBUTTON      "Réglages par &défaut",IDC_DEFAULT,165,256,80,14
    PUSHBUTTON      "Aide",IDHELP,254,256,50,14
END

