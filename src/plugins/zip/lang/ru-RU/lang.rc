    CONTROL         "За&менять файлы без запроса подтверждения",IDC_OVEWRITE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,206,246,174,12
    CONTROL         "Тр&ебуются административные привилегии ",IDC_REQSADMIN,
