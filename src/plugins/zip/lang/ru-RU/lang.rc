    CONTROL         "Создать &самораспаковывающийся архив",IDC_SELFEXTR,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,17,71,154,12
    PUSHBUTTON      "&Дополнительно...",IDC_ADVANCED,226,70,75,14,WS_DISABLED
    LTEXT           "",IDC_STATIC_5,8,90,293,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "&Шифрование файлов",IDC_ENCRYPT,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,17,97,88,12
    LTEXT           "&Пароль:",IDC_STATIC_6,28,113,60,8,NOT WS_GROUP
    EDITTEXT        IDC_PASSWORD1,95,111,96,12,ES_PASSWORD | ES_AUTOHSCROLL | WS_DISABLED
    LTEXT           "П&ароль повторно:",IDC_STATIC_7,28,129,66,8,NOT WS_GROUP
    EDITTEXT        IDC_PASSWORD2,95,127,96,12,ES_PASSWORD | ES_AUTOHSCROLL | WS_DISABLED
    GROUPBOX        " Метод шифрования ",IDC_STATIC_8,202,97,99,50
    CONTROL         "ZIP 2.&0 (слабый)",IDC_ENC_ZIP20,"Button",BS_AUTORADIOBUTTON | WS_DISABLED | WS_GROUP,207,108,71,12
    CONTROL         "AES &128 бит",IDC_ENC_AES128,"Button",BS_AUTORADIOBUTTON | WS_DISABLED,207,120,55,12
    CONTROL         "AES &256 бит",IDC_ENC_AES256,"Button",BS_AUTORADIOBUTTON | WS_DISABLED,207,132,55,12
    LTEXT           "",IDC_STATIC_9,8,154,293,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "&Больше не показывать это окно (см. настройки)",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,17,161,280,12
    DEFPUSHBUTTON   "ОК",IDOK,33,180,55,14,WS_GROUP
    PUSHBUTTON      "Отмена",IDCANCEL,96,180,55,14
    PUSHBUTTON      "Нас&тройка...",IDC_CONFIG,159,180,55,14
    PUSHBUTTON      "Справка",IDHELP,222,180,55,14
END

IDD_CONFIG DIALOGEX 50, 37, 308, 277
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
