END

IDD_WAITFOR DIALOGEX 15, 24, 257, 155
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ожидание процесса"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Эта настройка позволяет ожидать завершения другого процесса, кроме указанного в поле команды. После завершения ожидаемого процесса удаляются все временные файлы, работа самораспаковывающегося архива завершается.",IDC_STATIC_1,12,9,233,32
    LTEXT           "",IDC_STATIC_2,12,49,233,40
    LTEXT           "&Имя исполняемого файла:",IDC_STATIC_3,12,97,103,8
    EDITTEXT        IDC_FILENAME,12,107,233,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_STATIC_4,3,129,250,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "ОК",IDOK,43,136,50,14
    PUSHBUTTON      "Отмена",IDCANCEL,103,136,50,14
    PUSHBUTTON      "Справка",IDHELP,163,136,50,14
END

IDD_CHANGELANG DIALOGEX 6, 15, 280, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Изменение языка интерфейса"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Вы изменили язык интерфейса самораспаковывающегося архива. Вы хотите заменить текстовые подписи, введенные в окне ""Текст сообщений"", значениями по умолчанию для выбранного языка?",IDC_STATIC_1,11,8,258,24
    DEFPUSHBUTTON   "Да",IDOK,55,40,50,14
    PUSHBUTTON      "Нет",IDCANCEL,114,40,50,14
    PUSHBUTTON      "Справка",IDHELP,173,40,50,14
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,3,62,274,1
    CONTROL         "Всегда &запрашивать подтверждение перед сменой текстов",IDC_ASK,"Button",BS_AUTORADIOBUTTON,11,66,223,12
    CONTROL         "За&менять тексты значениями по умолчанию в дальнейшем",IDC_REPLACE,
                    "Button",BS_AUTORADIOBUTTON,11,78,221,12
    CONTROL         "Н&е запрашивать подтверждение и не изменять тексты в дальнейшем",IDC_LEAVE,
                    "Button",BS_AUTORADIOBUTTON,11,90,260,12
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SFXMENU MENU 
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Экспорт настроек...\tCtrl+E", CM_SFX_EXPORT
        MENUITEM "&Импорт настроек...\tCtrl+I", CM_SFX_IMPORT
    END
    POPUP "&Вид"
    BEGIN
        MENUITEM "&Предпросмотр окна самораспаковывающегося архива...\tCtr+V", CM_SFX_PREVIEW
    END
    POPUP "&Настройки"
    BEGIN
        MENUITEM "&Очистить все\tCtrl+Shift+R",    CM_SFX_RESETALL
        MENUITEM "Очистить &значения\tCtrl+R",       CM_SFX_RESETVALUES
        MENUITEM "Очистить &тексты\tCtrl+T",        CM_SFX_RESETTEXTS
        MENUITEM SEPARATOR
        MENUITEM "&Сохранить профиль...\tCtrl+A", CM_SFX_ADD
        MENUITEM "&Профили\tCtrl+F",          CM_SFX_FAVORITIES
        MENUITEM SEPARATOR
        MENUITEM "Последний &использованный\tCtrl+L",          CM_SFX_LASTUSED
    END
END

IDM_FAVMANMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Пере&именовать",                     CM_FAVRENAME
        MENUITEM "&Удалить",                     CM_FAVDELETE
        MENUITEM SEPARATOR
        MENUITEM "Удалить &все",                 CM_FAVREMOVEALL
    END
END

IDM_COMMENTMENU MENU 
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Сохранить",                       CM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "&Закрыть\tAlt+F4",              CM_CLOSE
    END
END

IDM_SPECDIR MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Временная папка",        CM_TEMP
        MENUITEM "&Папка Program Files",              CM_PROGFILES
        MENUITEM "П&апка Windows",          CM_WINDIR
        MENUITEM "Пап&ка System",           CM_SYSDIR
        MENUITEM SEPARATOR
        MENUITEM "П&еременная окружения",       CM_ENVVAR
        MENUITEM "Па&раметр системного реестра",             CM_REGENTRY
    END
END

