    GROUPBOX        "界面",IDC_STATIC_6,7,155,292,53,WS_GROUP
    PUSHBUTTON      "文本(&T)...",IDC_TEXTS,20,169,50,14
    LTEXT           "语言(&L):",IDC_STATIC_7,20,190,32,8,NOT WS_GROUP
    COMBOBOX        IDC_LANGUAGE,74,188,64,57,CBS_DROPDOWNLIST | CBS_SORT | WS_TABSTOP
    LTEXT           "图标:",IDC_STATIC_8,170,190,22,8,NOT WS_GROUP
    LTEXT           "",IDC_EXEICON,193,186,19,18,NOT WS_GROUP
    PUSHBUTTON      "更改图标(&I)...",IDC_CHANGEICON,220,188,64,14
    GROUPBOX        "确定和其他选项",IDC_STATIC_9,7,213,292,57
    CONTROL         "自动开始解压(&O)",IDC_AUTO,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,20,226,76,12
    CONTROL         "隐藏自解压程序主对话框(&H)",IDC_HIDEMAINDLG,
