    LTEXT           "消息(&M):",IDC_STATIC_7,20,101,34,8,NOT WS_GROUP
    EDITTEXT        IDC_MBOXTEXT,20,111,221,29,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    GROUPBOX        "主对话框",IDC_STATIC_8,8,153,245,158
    LTEXT           "标题(&E):",IDC_STATIC_9,20,163,32,8
    EDITTEXT        IDC_TITLE,20,173,221,12,ES_AUTOHSCROLL
    LTEXT           "显示在主对话框中的文本(&D):",IDC_STATIC_10,20,189,112,8,NOT WS_GROUP
    EDITTEXT        IDC_TEXT,20,199,221,29,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           """解压""按钮上的文本(&X):",IDC_STATIC_11,20,231,94,8,NOT WS_GROUP
    EDITTEXT        IDC_BUTTONTEXT,20,241,68,12,ES_AUTOHSCROLL
    LTEXT           "供应商名(&V):",IDS_VENDOR,20,256,174,8
