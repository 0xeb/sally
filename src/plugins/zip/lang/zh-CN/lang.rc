IDD_EXPACKOPTIONS DIALOGEX 41, 41, 308, 201
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "扩展的压缩选项"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "压缩包:",IDC_STATIC_1,17,9,30,8
    CONTROL         "",IDC_ARCHIVE,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,50,9,250,8
    LTEXT           "",IDC_STATIC_2,8,24,292,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "创建多卷压缩包(&M)",IDC_MULTIVOL,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,17,31,106,12
    LTEXT           "卷大小(&V):",IDC_STATIC_3,172,33,41,8,NOT WS_GROUP
    COMBOBOX        IDC_VOLSIZE,216,31,51,110,CBS_DROPDOWN | WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_UNITS,272,31,27,34,CBS_DROPDOWNLIST | WS_DISABLED | WS_TABSTOP
    CONTROL         "按顺序命名文件(&N)",IDC_SEQNAME,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,17,45,90,12
    LTEXT           "",IDC_STATIC_4,8,63,292,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "创建自解压压缩包(&S)",IDC_SELFEXTR,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,17,70,110,12
    PUSHBUTTON      "高级(&A)...",IDC_ADVANCED,244,70,55,14,WS_DISABLED
    LTEXT           "",IDC_STATIC_5,8,90,292,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "加密文件(&E)",IDC_ENCRYPT,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,17,97,58,12
    LTEXT           "密码(&P):",IDC_STATIC_6,28,113,32,8,NOT WS_GROUP
    EDITTEXT        IDC_PASSWORD1,79,111,125,12,ES_PASSWORD | ES_AUTOHSCROLL | WS_DISABLED
    LTEXT           "确认密码(&O):",IDC_STATIC_7,28,129,50,8,NOT WS_GROUP
    EDITTEXT        IDC_PASSWORD2,79,127,125,12,ES_PASSWORD | ES_AUTOHSCROLL | WS_DISABLED
    GROUPBOX        " 加密方法 ",IDC_STATIC_8,213,97,86,50
    CONTROL         "&ZIP 2.0 兼容(弱)",IDC_ENC_ZIP20,"Button",BS_AUTORADIOBUTTON | WS_DISABLED | WS_GROUP,218,108,70,12
    CONTROL         "&128-位 AES",IDC_ENC_AES128,"Button",BS_AUTORADIOBUTTON | WS_DISABLED,218,120,53,12
    CONTROL         "&256-位 AES",IDC_ENC_AES256,"Button",BS_AUTORADIOBUTTON | WS_DISABLED,218,132,55,12
    LTEXT           "",IDC_STATIC_9,8,154,292,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "不要再次显示此对话框(以后你可以在配置对话框中更改此选项)(&D)",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,17,161,260,12
    DEFPUSHBUTTON   "确定",IDOK,32,180,55,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,95,180,55,14
    PUSHBUTTON      "配置(&C)...",IDC_CONFIG,158,180,55,14
    PUSHBUTTON      "帮助",IDHELP,221,180,55,14
END

IDD_CONFIG DIALOGEX 50, 37, 312, 277
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "ZIP 配置"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "解压缩",IDC_STATIC_1,7,6,28,8
    LTEXT           "",IDC_STATIC_2,37,10,270,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "自动扩展固定磁盘上存储的多卷压缩包(&A)",IDC_AUTOEXPANDMV,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,17,170,12
    LTEXT           "压缩",IDC_STATIC_3,7,35,20,8
    LTEXT           "",IDC_STATIC_4,29,39,278,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "修改压缩包时使用它的临时副本(推荐, 免除崩溃)(&T)",IDC_BACKUP,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,46,206,12
    CONTROL         "不要在 ZIP 压缩包中存储空目录(&E)",IDC_NOEMPTYDIRS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,58,141,12
    CONTROL         "修改压缩包时设置压缩包的时间为最新的文件时间(&N)",IDC_SETFILETIME,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,70,213,12
    CONTROL         "为多卷压缩包使用 WinZip 兼容的文件名(除了自解压",IDC_WINZIPNAMES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,82,206,12
    LTEXT           "压缩包以外，自解压包总是使用 Sally 命名规则)",IDC_STATIC_5,26,94,230,8
    LTEXT           "压缩等级(0 - 9, 9 最佳压缩，最长时间)(&L):",IDC_STATIC_6,14,107,158,8
    EDITTEXT        IDC_LEVEL,173,105,16,12
    LTEXT           "默认自解压语言(&S):",IDC_STATIC_7,14,120,76,8
    COMBOBOX        IDC_LANGUAGE,91,118,64,57,CBS_DROPDOWNLIST | CBS_SORT | WS_TABSTOP
    LTEXT           "确认",IDC_STATIC_8,7,136,20,8
    LTEXT           "",IDC_STATIC_9,29,140,278,1,SS_ETCHEDHORZ | WS_GROUP
    GROUPBOX        "当 SFX 语言改变时",IDC_STATIC_10,14,148,179,49
    CONTROL         "改变文本前总是询问(&W)",IDC_ASK,"Button",BS_AUTORADIOBUTTON | WS_GROUP,20,158,104,12
    CONTROL         "自动替换文本为它们的默认值(&R)",IDC_REPLACE,
                    "Button",BS_AUTORADIOBUTTON,20,170,136,12
    CONTROL         "不询问并总是保留文本不改变(&U)",IDC_LEAVE,
                    "Button",BS_AUTORADIOBUTTON,20,182,136,12
    CONTROL         "压缩前显示扩展选项对话框(&O)",IDC_SHOWEXOPTIONS,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,200,128,12
    LTEXT           "面板设置",IDC_STATIC_11,7,217,37,8
    LTEXT           "",IDC_STATIC_12,46,221,261,1,SS_ETCHEDHORZ | WS_GROUP
    CONTROL         "当列表压缩包时显示""压缩""列(&P)",IDC_CFG_LISTINFOPACKEDSIZE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,228,132,12
    LTEXT           "",IDC_STATIC_13,6,247,301,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "确定",IDOK,21,256,63,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,90,256,63,14
    PUSHBUTTON      "设置默认值(&D)",IDC_DEFAULT,159,256,63,14
    PUSHBUTTON      "帮助",IDHELP,228,256,63,14
END

IDD_PASSWORD DIALOGEX 6, 15, 271, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "输入 ZIP 密码"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
