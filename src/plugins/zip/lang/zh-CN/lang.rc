    CONTROL         "自动创建目标目录(&C)",IDC_AUTODIR,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,250,93,12
    CONTROL         "显示操作摘要对话框(&S)",IDC_SUMDLG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,226,101,12
    CONTROL         "自动覆盖文件(&A)",IDC_OVEWRITE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,238,76,12
    CONTROL         "需要管理员权限(&P) ",IDC_REQSADMIN,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,250,86,12
    DEFPUSHBUTTON   "确定",IDOK,66,275,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,127,275,50,14
    PUSHBUTTON      "帮助",IDHELP,188,275,50,14
