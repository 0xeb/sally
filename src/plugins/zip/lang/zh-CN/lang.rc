END

IDD_WAITFOR DIALOGEX 15, 24, 227, 131
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "等待"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "此选项让你能够等待除了你在""命令""栏中指定的进程以外的另一个进程。在此进程完成后，自解压程序移除临时文件然后结束它自己。",IDC_STATIC_1,12,9,200,24
    LTEXT           "",IDC_STATIC_2,12,41,200,24
