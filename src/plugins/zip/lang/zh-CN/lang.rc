    PUSHBUTTON      "取消",IDCANCEL,88,112,50,14
    PUSHBUTTON      "帮助",IDHELP,148,112,50,14
END

IDD_CHANGELANG DIALOGEX 6, 15, 248, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "更改自解压程序文本"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "你更改了自解压程序语言，你希望你在""自解压程序文本""对话框中输入的自定义文本被更改为您选择的语言对应的它们的默认值吗？",IDC_STATIC_1,11,8,214,24
    DEFPUSHBUTTON   "是",IDOK,40,40,50,14
    PUSHBUTTON      "否",IDCANCEL,99,40,50,14
    PUSHBUTTON      "帮助",IDHELP,158,40,50,14
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,3,62,242,1
    CONTROL         "更改文本前问题询问(&A)",IDC_ASK,"Button",BS_AUTORADIOBUTTON,11,66,127,12
    CONTROL         "将来自动用它们的默认值替换文本(&R)",IDC_REPLACE,
                    "Button",BS_AUTORADIOBUTTON,11,78,228,12
    CONTROL         "将来不再询问并总是保持文本不更改(&U)",IDC_LEAVE,
                    "Button",BS_AUTORADIOBUTTON,11,90,205,12
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SFXMENU MENU 
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "导出设置(&E)...\tCtrl+E", CM_SFX_EXPORT
        MENUITEM "导入设置(&I)...\tCtrl+I", CM_SFX_IMPORT
    END
    POPUP "查看(&V)"
    BEGIN
        MENUITEM "预览 SFX 对话框(&V)...\tCtr+V", CM_SFX_PREVIEW
    END
    POPUP "选项(&O)"
    BEGIN
        MENUITEM "重置全部(&R)\tCtrl+Shift+R",    CM_SFX_RESETALL
        MENUITEM "重置值(&V)\tCtrl+R",       CM_SFX_RESETVALUES
        MENUITEM "重置文本(&T)\tCtrl+T",        CM_SFX_RESETTEXTS
        MENUITEM SEPARATOR
        MENUITEM "添加到收藏夹(&A)...\tCtrl+A", CM_SFX_ADD
        MENUITEM "收藏夹(&F)\tCtrl+F",          CM_SFX_FAVORITIES
        MENUITEM SEPARATOR
        MENUITEM "上次使用的(&L)\tCtrl+L",          CM_SFX_LASTUSED
    END
END

IDM_FAVMANMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "重命名(&R)",                     CM_FAVRENAME
        MENUITEM "删除(&D)",                     CM_FAVDELETE
        MENUITEM SEPARATOR
        MENUITEM "移除全部(&A)",                 CM_FAVREMOVEALL
    END
END

IDM_COMMENTMENU MENU 
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "保存(&S)",                       CM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "关闭(&C)\tAlt+F4",              CM_CLOSE
    END
END

IDM_SPECDIR MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "临时目录(&T)",        CM_TEMP
        MENUITEM "&Program Files",              CM_PROGFILES
        MENUITEM "&Windows 目录",          CM_WINDIR
        MENUITEM "&System 目录",           CM_SYSDIR
        MENUITEM SEPARATOR
        MENUITEM "环境变量(&E)",       CM_ENVVAR
        MENUITEM "注册表条目(&R)",             CM_REGENTRY
    END
END

