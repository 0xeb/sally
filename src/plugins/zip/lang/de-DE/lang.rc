STRINGTABLE
{
  IDS_SFX_COMMENT_HEAD1, ";Self-Extractor Einstellungen\r\n\r\n;Das ist die Einstellungsdatei für den Self-Extractor.\r\n;\r\n;Dateiformat Syntax:\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD2, ";Zeilen die mit ';' beginnen werden als Kommentar behandelt und beim\r\n;Auslesen der Einstellungen ignoriert.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD3, ";Alle Variablen außer 'Version' sind optional. Wird die Variable in der\r\n;Datei nicht gefunden, wird der Standardwert benutzt.\r\n;Standardwerte für sprachabhängige Variablen (dlg_text, dlg_title,\r\n;button_text) sind aus dem SFX-Paket entnommen.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD4, ";Alle Zeichenketten, einschließlich leere (Nullstrings), müssen in\r\n;doppelten Anführungszeichen eingeschlossen werden. Um doppelte\r\n;Anführungsszeichen einzugeben, schreiben Sie 2 hintereinander.\r\n;\r\n;Mit doppelten Anführungszeichen können keine Zahlen eingeschlossen werden.\r\n\r\n"
  IDS_SFX_COMMENT_VERSION, "\r\n;Version der Einstellungsdatei, aktuelle Version ist 2\r\n;das ist die einzige verbindliche Variable\r\n\r\n"
  IDS_SFX_COMMENT_TARGDIR1, "\r\n;Zielverzeichnis-Vorgabe, es kann entweder ein absoluter Pfad\r\n;oder ein relativer Pfad sein; ein relativer Pfad ist relativ\r\n;zum aktuellen Verzeichnis wenn SFX gestartet wird\r\n"
  IDS_SFX_COMMENT_TARGDIR2, ";Sie können auch vordefinierte Variablen am Anfang (!)\r\n;der 'target_dir'-Zeichenkette verwenden:\r\n;\r\n"
  IDS_SFX_COMMENT_TARGDIR3, ";  $(Temp)      temporäres Verzeichnis, sollte immer alleine\r\n;               im 'target_dir' Feld stehen, ohne weitere Pfadangaben\r\n"
  IDS_SFX_COMMENT_TARGDIR4, ";  $(ProgFiles) Programmverzeichnis\r\n;  $(WinDir)    Windowsverzeichnis\r\n;  $(SysDir)    Systemverzeichnis\r\n"
  IDS_SFX_COMMENT_TARGDIR5, ";  $[variable]  Wert der Umgebungsvariable 'variable'\r\n;  $<regkey>    Wert des Registrierungsschlüssels 'regkey'\r\n;  z.B. SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
  IDS_SFX_COMMENT_ALLOWCHANGE, "\r\n;Bestimmt, ob der Benutzer beim Entpacken das Zielverzeichnis ändern darf\r\n;Setzen Sie den Wert auf 1 um es zuzulassen\r\n\r\n"
  IDS_SFX_COMMENT_REMOVE1, "\r\n;Bestimmt, ob entpackte Dateien aus dem temporären Verzeichnis gelöscht werden\r\n;sollen, wenn das durch die Variable 'command' angegebene Programm beendet wird\r\n"
  IDS_SFX_COMMENT_REMOVE2, ";Setzen Sie den Wert auf 1 wenn die Temporärdateien entfernt werden sollen\r\n;Die Verwendung dieser Variablen macht nur Sinn, wenn 'target_dir' auf\r\n;'$(Temp)' gesetzt wurde, ansonsten wird sie ignoriert\r\n\r\n"
  IDS_SFX_COMMENT_AUTO, "\r\n;Bestimmt, ob das Entpacken automatisch gestartet werden soll, wenn der\r\n;Anwender das selbstentpackende Archiv aufruft\r\n;Setzen Sie den Wert auf 1 wenn das Entpacken automatisch gestartet werden soll\r\n\r\n"
  IDS_SFX_COMMENT_SUMMARY, "\r\n;Bestimmt, ob ein Hinweis gezeigt werden soll nachdem das Entpacken der\r\n;Dateien erfolgreich beendet wurde\r\n;Setzen sie den Wert auf 1 wenn der Hinweis gezeigt werden soll\r\n\r\n"
  IDS_SFX_COMMENT_HIDE, "\r\n;Bestimmt, ob das Hauptfenster des Self-Extractors gezeigt werden soll\r\n;Setzen Sie den Wert auf 1 wenn das SFX-Hauptfenster nicht gezeigt werden soll\r\n;Die Verwendung dieser Variablen macht nur Sinn wenn 'autostart' auf 1 gesetzt\r\n;wurde, ansonsten wird sie ignoriert\r\n\r\n"
  IDS_SFX_COMMENT_OVERWRITE, "\r\n;Bestimmt, ob im Zielverzeichnis alle Dateien automatisch überschrieben\r\n;werden sollen\r\n;Setzen Sie den Wert auf 1 wenn alle Dateien automatisch überschrieben\r\nwerden sollen\r\n\r\n;"
  IDS_SFX_COMMENT_AUTODIR, "\r\n;Bestimmt, ob das Zielverzeichnis ohne den Benutzer zu fragen automatisch\r\n;angelegt werden soll\r\n;Setzen Sie den Wert auf 1 wenn das Zielverzeichnis automatisch\r\n;angelegt werden soll\r\n\r\n"
  IDS_SFX_COMMENT_COMMAND, "\r\n;Programm, HTTP-Link oder Dokument, das nach dem erfolgreichen Entpacken\r\n;gestartet/aufgerufen werden soll.Der Pfad ist relativ zum Zielverzeichnis\r\n;des Entpackens.\r\n;Wenn Sie ein Programm angeben, können Sie auch Parameter verwenden\r\n\r\n"
  IDS_SFX_COMMENT_PACKAGE, "\r\n;SFX-Paket das beim Erstellen eines selbstentpackenden Archivs verwendet wird\r\n;relativer Pfad ist relativ zu dem Verzeichnis mit zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_MBUT, "\r\n;Schaltflächen im optionalen Hinweisfenster können folgende sein:\r\n; 'ok', 'ok_cancel', 'yes_no', oder 'agree_disagree'\r\n\r\n"
  IDS_SFX_COMMENT_MICO, "\r\n;Typ des optionalen Hinweisfensters kann eines der folgenden sein:\r\n;'simple', 'exclamation', 'information', 'question', oder 'long_message'\r\n\r\n"
  IDS_SFX_COMMENT_MBOX, "\r\n;Text und Titel im optionalen Hinweisfenster, das vor dem Entpacken\r\n;angezeigt werdens soll\r\n;Wenn kein Hinweisfenster anzeigt werden soll, lassen Sie beide Felder\r\n;leer. ("""")\r\n\r\n"
  IDS_SFX_COMMENT_TEXT, "\r\n;Text der in dem SFX-Hauptdialogfenster angezeigt werden soll\r\n\r\n"
  IDS_SFX_COMMENT_TITLE, "\r\n;Titel des SFX-Hauptdialogfensters\r\n\r\n"
  IDS_SFX_COMMENT_BUTTON, "\r\n;Text für die Schaltfläche 'Entpacken' im SFX-Hauptdialogfenster\r\n\r\n"
  IDS_SFX_COMMENT_VENDOR, "\r\n;Herstellername in der linken unteren Ecke des SFX-Hauptdialogfensters\r\n\r\n"
  IDS_SFX_COMMENT_WWW, "\r\n;Weblink in der rechten unteren Ecke des SFX-Hauptdialogfensters\r\n\r\n"
  IDS_SFX_COMMENT_ICOFILE, "\r\n;Dateien mit Symbolen, es kann entweder eine ICO-Datei oder eine\r\n;ausführbare Datei PE (wie Win32 EXEs oder DLLs) das Symbol enthalten\r\n;relativer Pfad ist relativ zu dem Verzeichnis mit zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_ICOINDEX, "\r\n;Positiver Wert bedeutet der Index eines Symbols aus der in der\r\n;'icon_file'-Variablen angegebenen Datei\r\n;Negativer Wert bedeutet eine Ressourcen-ID des Symbols\r\nn;Bei ICO-Dateien ist der Index immer 0 und der Wert wird ignoriert\r\n\r\n"
  IDS_SFX_COMMENT_WAITFOR1, "\r\n;Diese Option ermöglicht es Ihnen, auf einen anderen Prozess als den,\r\n;den Sie im Feld 'Befehl' angegeben haben, zu warten.\r\n;Nachdem dieser Prozess beendet wurde entfernt der Self-Extractor\r\n;temporäre Dateien und beendet sich schließlich selbst.\r\n"
  IDS_SFX_COMMENT_WAITFOR2, ";Das ist nur notwendig, wenn das Installationsprogramm eine andere\r\n;ausführbare Datei startet, die die Installation fortsetzt, während das\r\n;ursprüngliche Installationsprogramm beendet wird.\r\n"
  IDS_SFX_COMMENT_WAITFOR3, ";Es arbeiten z.B. einige Versionen von InstallShield so.\r\n;Diese Option wird ignoriert, es sei denn 'remove_temp' ist auf 1 gesetzt.\r\n\r\n"
  IDS_SFX_COMMENT_REQUIRESADMIN, "\r\n;Benötigt Administratorrechte um auf Windows Vista oder höher ausgeführt\r\n;werden zu können\r\n\r\n"
}
