STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Favoriten verwalten"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Favoriten:",IDC_STATIC_1,9,4,60,8
    LISTBOX         IDC_FAVORITIES,9,14,142,100,LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Umbenennen",IDC_RENAME,161,13,60,14,WS_GROUP
    PUSHBUTTON      "&Entfernen",IDC_REMOVE,161,32,60,14
    PUSHBUTTON      "&Alle entfernen",IDC_REMOVEALL,161,51,60,14
    DEFPUSHBUTTON   "Schließen",IDOK,161,100,60,14
END

IDD_WAITFOR DIALOGEX 15, 24, 254, 147
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Warten auf"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Diese Option ermöglicht es Ihnen, auf einen anderen Prozess als den, den Sie im Feld 'Befehl' angegeben haben, zu warten. Nachdem dieser Prozess beendet wurde entfernt der Self-Extractor temporäre Dateien und beendet sich selbst.",IDC_STATIC_1,12,9,228,32
    LTEXT           "",IDC_STATIC_2,12,49,228,32
    LTEXT           "&Dateiname der ausführbaren Datei:",IDC_STATIC_3,12,89,122,8
    EDITTEXT        IDC_FILENAME,12,99,227,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_STATIC_4,3,121,247,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,42,128,50,14
    PUSHBUTTON      "Abbrechen",IDCANCEL,102,128,50,14
    PUSHBUTTON      "Hilfe",IDHELP,162,128,50,14
END

IDD_CHANGELANG DIALOGEX 6, 15, 240, 114
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Self-Extractor Texte ändern"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Sie haben die Self-Extractor Sprache geändert, möchten Sie die Texte in der Dialogbox 'Self-Extractor Texte' ändern oder die Standardtexte der ausgewählten Sprache benutzen?",IDC_STATIC_1,11,8,217,32
    DEFPUSHBUTTON   "Ja",IDOK,35,48,50,14
    PUSHBUTTON      "Nein",IDCANCEL,94,48,50,14
    PUSHBUTTON      "Hilfe",IDHELP,153,48,50,14
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,3,70,223,1
    CONTROL         "&Immer nachfragen bevor Texte geändert werden",IDC_ASK,"Button",BS_AUTORADIOBUTTON,11,74,178,12
    CONTROL         "&Texte automatisch durch ihre Standardwerte ersetzen",IDC_REPLACE,
                    "Button",BS_AUTORADIOBUTTON,11,86,193,12
    CONTROL         "&Nicht wieder fragen und Texte immer unverändert lassen",IDC_LEAVE,
                    "Button",BS_AUTORADIOBUTTON,11,98,205,12
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SFXMENU MENU 
BEGIN
    POPUP "&Datei"
    BEGIN
        MENUITEM "&Einstellungen exportieren...\tStrg+E", CM_SFX_EXPORT
        MENUITEM "Einstellungen &importieren...\tStrg+I", CM_SFX_IMPORT
    END
    POPUP "&Anzeigen"
    BEGIN
        MENUITEM "&Vorschau SFX-Fenster...\tStrg+V", CM_SFX_PREVIEW
    END
    POPUP "&Optionen"
    BEGIN
        MENUITEM "Alles zu&rücksetzen\tStrg+Umschalt+R",    CM_SFX_RESETALL
        MENUITEM "Werte &zurücksetzen\tStrg+R",       CM_SFX_RESETVALUES
        MENUITEM "&Texte zurücksetzen\tStrg+T",        CM_SFX_RESETTEXTS
        MENUITEM SEPARATOR
        MENUITEM "Zu F&avoriten hinzufügen...\tStrg+A", CM_SFX_ADD
        MENUITEM "&Favoriten\tStrg+F",          CM_SFX_FAVORITIES
        MENUITEM SEPARATOR
        MENUITEM "Zu&letzt verwendet\tStrg+L",          CM_SFX_LASTUSED
    END
END

IDM_FAVMANMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Umbenennen",                     CM_FAVRENAME
        MENUITEM "&Löschen",                     CM_FAVDELETE
        MENUITEM SEPARATOR
        MENUITEM "&Alles entfernen",                 CM_FAVREMOVEALL
    END
END

IDM_COMMENTMENU MENU 
BEGIN
    POPUP "&Datei"
    BEGIN
        MENUITEM "&Speichern",                       CM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "&Beenden\tAlt+F4",              CM_CLOSE
    END
END

IDM_SPECDIR MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Temporäres Verzeichnis",        CM_TEMP
        MENUITEM "&Programme",              CM_PROGFILES
        MENUITEM "&Windows Verzeichnis",          CM_WINDIR
        MENUITEM "&System Verzeichnis",           CM_SYSDIR
        MENUITEM SEPARATOR
        MENUITEM "&Umgebungsvariable",       CM_ENVVAR
        MENUITEM "&Registry Eintrag",             CM_REGENTRY
    END
END

