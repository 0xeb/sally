BEGIN
    LTEXT           "&Preferidos:",IDC_STATIC_1,9,4,60,8
    LISTBOX         IDC_FAVORITIES,9,14,142,100,LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "Cambiar &nombre",IDC_RENAME,161,13,65,14,WS_GROUP
    PUSHBUTTON      "&Quitar",IDC_REMOVE,161,32,65,14
    PUSHBUTTON      "Quitar &todos",IDC_REMOVEALL,161,51,65,14
    DEFPUSHBUTTON   "Cerrar",IDOK,161,100,65,14
END

IDD_WAITFOR DIALOGEX 15, 24, 227, 147
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Esperar"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Esta opción le permite esperar por otro proceso que el especificado en el campo 'Comando'. Después que termine este proceso el autoextractor elimina ficheros temporales y finaliza él mismo.",IDC_STATIC_1,12,9,200,32
    LTEXT           "",IDC_STATIC_2,12,49,200,32
    LTEXT           "&Nombre del ejecutable:",IDC_STATIC_3,12,89,103,8
    EDITTEXT        IDC_FILENAME,12,99,200,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_STATIC_4,3,121,220,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "Aceptar",IDOK,28,128,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,88,128,50,14
    PUSHBUTTON      "Ayuda",IDHELP,148,128,50,14
END

IDD_CHANGELANG DIALOGEX 6, 15, 250, 114
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Cambiar textos del autoextractor"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Ha cambiado el idioma del autoextractor; ¿desea que los textos personalizados que escribió en el cuadro de diálogo 'Textos del autoextractor' cambien a los valores por defecto correspondientes al idioma que ha seleccionado?",IDC_STATIC_1,11,8,219,32
    DEFPUSHBUTTON   "Sí",IDOK,41,48,50,14
    PUSHBUTTON      "No",IDCANCEL,100,48,50,14
    PUSHBUTTON      "Ayuda",IDHELP,159,48,50,14
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,3,70,244,1
    CONTROL         "&Preguntar siempre antes de cambiar textos",IDC_ASK,"Button",BS_AUTORADIOBUTTON,11,74,157,12
    CONTROL         "&Reemplazar automáticamente textos con sus valores por defecto",IDC_REPLACE,
                    "Button",BS_AUTORADIOBUTTON,11,86,228,12
    CONTROL         "&No preguntar en lo sucesivo y dehar los textos sin cambiar",IDC_LEAVE,
                    "Button",BS_AUTORADIOBUTTON,11,98,208,12
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SFXMENU MENU 
BEGIN
    POPUP "&Fichero"
    BEGIN
        MENUITEM "&Exportar ajustes...\tCtrl+E", CM_SFX_EXPORT
        MENUITEM "&Importar ajustes...\tCtrl+I", CM_SFX_IMPORT
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "Pre&visualización de diálogo SFX...\tCtr+V", CM_SFX_PREVIEW
    END
    POPUP "&Opciones"
    BEGIN
        MENUITEM "&Reiniciar todo\tCtrl+Mays+R",    CM_SFX_RESETALL
        MENUITEM "Reiniciar &valores\tCtrl+R",       CM_SFX_RESETVALUES
        MENUITEM "Reiniciar &textos\tCtrl+T",        CM_SFX_RESETTEXTS
        MENUITEM SEPARATOR
        MENUITEM "&Añadir a preferidos...\tCtrl+A", CM_SFX_ADD
        MENUITEM "&Preferidos\tCtrl+F",          CM_SFX_FAVORITIES
        MENUITEM SEPARATOR
        MENUITEM "&Ultimo usado\tCtrl+L",          CM_SFX_LASTUSED
    END
END

IDM_FAVMANMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Cambiar nombre",                     CM_FAVRENAME
        MENUITEM "&Borrar",                     CM_FAVDELETE
        MENUITEM SEPARATOR
        MENUITEM "Quitar &todos",                 CM_FAVREMOVEALL
    END
END

IDM_COMMENTMENU MENU 
BEGIN
    POPUP "&Fichero"
    BEGIN
        MENUITEM "&Guardar",                       CM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "&Cerrar\tAlt+F4",              CM_CLOSE
    END
END

IDM_SPECDIR MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Directorio &temporal",        CM_TEMP
        MENUITEM "Ficheros de &programas",              CM_PROGFILES
        MENUITEM "Directorio de &Windows",          CM_WINDIR
        MENUITEM "Directorio de &sistema",           CM_SYSDIR
        MENUITEM SEPARATOR
        MENUITEM "&Variable de entorno",       CM_ENVVAR
        MENUITEM "Entrada del &registro",             CM_REGENTRY
    END
END

