STRINGTABLE
{
  IDS_SFX_COMMENT_HEAD1, ";Ajustes del autoextractor\r\n\r\n;Este es el fichero de ajustes del autoextractor.\r\n;\r\n;Sintaxis del formato del fichero:\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD2, ";Líneas que empiezan por el caracter ';' se tratan como comentarios\r\n;y se ignoran al procesar el fichero de ajustes.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD3, ";Todas las variables salvo versión son opcionales. Si la variable\r\n;no está en el fichero de ajustes, se usará su valor por omisión.\r\n;Los valores por omisión para variables dependientes del idioma (dlg_text, dlg_title,\r\n;button_text) se recogen del paquete sfx.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD4, ";Todos los valores de cadenas, incluyendo nulas, deben ir incluidas en\r\n;comillas dobles. Para escribir comillas dobles en la cadena use\r\n;dos comillas dobles sucesivas.\r\n;\r\n;No pueden incluirse números entre comilas dobles.\r\n\r\n"
  IDS_SFX_COMMENT_VERSION, "\r\n;versión del fichero de ajustes, la versión actual es 2\r\n;esta es la única variable obligatoria\r\n\r\n"
  IDS_SFX_COMMENT_TARGDIR1, "\r\n;especificación de directorio destino, puede ser una ruta absoluta\r\n;o relativa; la ruta relativa lo es respecto al directorio actual\r\n;cuando se lanza el ejecutable sfx\r\n"
  IDS_SFX_COMMENT_TARGDIR2, ";también seríá posible usar variables predefinidas al comienzo (!)\r\n;de la cadena 'target_dir' :\r\n;\r\n"
  IDS_SFX_COMMENT_TARGDIR3, ";  $(Temp)      directorio temporal, debería dejarse solo\r\n;               en el campo target_dir field sin continuar\r\n;               con ninguna parte de ruta\r\n"
  IDS_SFX_COMMENT_TARGDIR4, ";  $(ProgFiles) carpeta 'Archivos de programa' del usuario\r\n;  $(WinDir)    directorio de windows\r\n;  $(SysDir)    directorio system\r\n"
  IDS_SFX_COMMENT_TARGDIR5, ";  $[variable]  valor de una variable de entorno descrita por\r\n;               'variable'\r\n;  $<regkey>    valor de la clave del registro descrita por 'regkey'\r\n;  p.ej. SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
  IDS_SFX_COMMENT_ALLOWCHANGE, "\r\n;especifica si el usuario puede cambiar un directorio destino cuando \r\n;se descomprime\r\n;poner su valor a 1 si se quiere habilitar esto\r\n\r\n"
  IDS_SFX_COMMENT_REMOVE1, "\r\n;especifica si eliminar los ficheros extraidos a la carpeta temporal\r\n;cuando termina un programa especificado por la variable 'command'\r\n"
  IDS_SFX_COMMENT_REMOVE2, ";poner su valor a 1 si se quieren quitar los ficheros temporales\r\n;el uso de esta variable solo tiene sentido si 'target_dir' se ajusta a\r\n;""$(Temp)"", si no, el valor se ignora\r\n\r\n"
  IDS_SFX_COMMENT_AUTO, "\r\n;especifica si empezar la extracción automáticaemte cuando el usuario ejecuta\r\n;el archivo autoextraíble\r\n;poner este valor a 1 si se quiere que la extracción empiece automáticamente\r\n\r\n"
  IDS_SFX_COMMENT_SUMMARY, "\r\n;especifica si mostrar un cuadro de mensaje notificando el éxito\r\n;de la operación tras terminar de extraer ficheros\r\n;poner su valor a 1 si se quiere ver el resumen de la operación\r\n\r\n"
  IDS_SFX_COMMENT_HIDE, "\r\n;especifica si presentar el diálogo principal de autoextractor\r\n;poner este valor a 1 no se quiere ver el diálogo principal del sfx\r\n;el uso de esta variable sólo tiene sentido si se ajusta 'autostart' a 1,\r\n;si no, el valor se ignora\r\n\r\n"
  IDS_SFX_COMMENT_OVERWRITE, "\r\n;especifica si sobreescribir automáticamente todos los ficheros en \r\n;directorio destino\r\n;poner este valor a 1 si se quiere que los ficheros sean sobreescritos\r\n;automáticamente\r\n\r\n"
  IDS_SFX_COMMENT_AUTODIR, "\r\n;especifica si crear automáticamente el directorio destino sin preguntar\r\n;al usuario\r\n;poner su valor a 1 si se quiere que el directorio destino sea creado\r\n;automáticamente\r\n\r\n"
  IDS_SFX_COMMENT_COMMAND, "\r\n;programa, enlace http o documento que debe ejecutarse/abrirse\r\n;cuando termina bien la extracción, la ruta es relativa al\r\n;directorio destino de la extracción, si se especifica un programa también\r\n;se pueden escribir sus argumentos\r\n\r\n"
  IDS_SFX_COMMENT_PACKAGE, "\r\n;paquete sfx que se usará cuando se crea el archivo autoextraible\r\n;la ruta relativa es relativa al directorio con zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_MBUT, "\r\n;botones en el cuadro de mensaje opcional\r\n;podria ser uno de los siguientes: ""ok"", ""ok_cancel"", ""yes_no"",\r\n;""agree_disagree""\r\n\r\n"
  IDS_SFX_COMMENT_MICO, "\r\n;tipo de cuadro de mensaje opcional\r\n;podria ser uno de los siguientes: ""simple"", ""exclamation"", ""information"",\r\n;""question"", ""long_message""\r\n\r\n"
  IDS_SFX_COMMENT_MBOX, "\r\n;texto y título del cuadro de mensaje opcional, que aparece antes\r\n;de comenzar la extracción\r\n;si no desea presentar ningún cuadro de mensaje deje ambos\r\n;campos vacíos ("""")\r\n\r\n"
  IDS_SFX_COMMENT_TEXT, "\r\n;texto que aparecerá en el diálogo principal del autoextractor\r\n\r\n"
  IDS_SFX_COMMENT_TITLE, "\r\n;título del diálogo principal del autoextractor\r\n\r\n"
  IDS_SFX_COMMENT_BUTTON, "\r\n;texto en el botón de extracción del diálogo principal del sfx\r\n\r\n"
  IDS_SFX_COMMENT_VENDOR, "\r\n;nombre del vendedor en la esquina inferior izquierda del diálogo sfx\r\n\r\n"
  IDS_SFX_COMMENT_WWW, "\r\n;enlace www en la esquina inferior derecha del diálogo sfx\r\n\r\n"
  IDS_SFX_COMMENT_ICOFILE, "\r\n;ficheros con datos de iconos, pueden ser un fichero ICO o un PE\r\n;ejecutable (como EXEs o DLLs win32) con el icono\r\n;la ruta relativa es relativa al directorio con zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_ICOINDEX, "\r\n;un valor positivo significa el índice de un icono en el ejecutable\r\n;especificado por la variable 'icon_file'\r\n;un valor negativo significa la ID de recurso del icono\r\n;para ficheros  ICO el índice siempre es 0 y su valor se ignora\r\n\r\n"
  IDS_SFX_COMMENT_WAITFOR1, "\r\n;Esta opción le hace esperar por otro proceso distinto del proceso que fue\r\n;especificado en el campo 'Command'. Tras terminar este proces\r\n;el autoextractor elimina ficheros temporales y luego se termina a sí mismo.\r\n"
  IDS_SFX_COMMENT_WAITFOR2, ";Sólo es necesario si el programa de instalación lanza otro\r\n;ejecutable que continúa la  instalación mientras el programa original\r\n;de instalación termina.\r\n"
  IDS_SFX_COMMENT_WAITFOR3, ";Se este modo se comporta como p.ej. algunas versiones de Install Shield.\r\n;Esta opción se ignora a menos que 'remove_temp' se ponga a 1.\r\n\r\n"
  IDS_SFX_COMMENT_REQUIRESADMIN, "\r\n;requiere privilegios administrativos para ejecutarse en Windows Vista o posterior\r\n\r\n"
}
