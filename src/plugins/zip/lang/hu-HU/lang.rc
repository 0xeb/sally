FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Megváltoztatta az önkitömörítő nyelvét. Szeretne egyéni szöveget megadni az 'Önkitömörítő szövegei' ablakban, hogy lecserélje a kiválasztott nyelvhez tartozó alapértelmezett szövegeket?",IDC_STATIC_1,11,8,225,32
    DEFPUSHBUTTON   "Igen",IDOK,40,48,50,14
    PUSHBUTTON      "Nem",IDCANCEL,99,48,50,14
    PUSHBUTTON      "Súgó",IDHELP,158,48,50,14
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,3,70,242,1
