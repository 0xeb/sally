  IDS_NOTFOUND, "A fájl nem található."
  IDS_BADMSGBOXTYPE, """Elfogadom + Elutasítom"" gombok csak a ""Hosszú üzenet"" típusú ablaknál használhatók."
  IDS_LOTFILES, "Olyan ZIP archívumot készül létrehozni, mely 65535-nél több bejegyzést tartalmazna. Az ilyen archívum nem kompatibilis az eredeti ZIP formátummal és néhány tömörítő nem lesz képes kibontani.\n\nFolytatni szeretné?"
  IDS_LOTFILESSFX, "Nem hozható létre 65535-nél több bejegyzést tartalmazó önkitömörítő ZIP archívum."
  IDS_BADAES, "A fájl ismeretlen AES verzióval van titkosítva."
  IDS_PWDTOOLONG, "Túl hosszú jelszó.\nAz AES titkosítás maximális jelszómérete 128 karakter."
  IDS_AESERROR, "AES hiba."
  IDS_MACERROR, "A hitelesítő kód nem egyezik. A vagy sérült vagy rossz a jelszó."
  IDS_ERRZIP64, "A kért művelet nem támogatott zip64 archívumoknál. A zip64 archívumok csak listázhatók és kibonthatók."
  IDS_ONLYFULLVERSION, " (csak a teljes verzióban érhető el)"
  IDS_ERRBZIP2 "Hiba lépett fel a BZIP2 adatfolyamban. Az archívum talán sérült."
  IDS_UNSUP_CD_ENCRYPTION "Az archívum központi mappájában tárolt fájlok listája titkosított vagy tömörített.\nNem támogatott funkció."
  IDS_LISTINFO_PAKEDSIZE      "Tömörített"
  IDS_LISTINFO_PAKEDSIZE_DESC "Tömörített fájlméret"
  IDS_SIZE_KB, "KB"
  IDS_SIZE_MB, "MB"
  IDS_MODIFICATION_NOT_SUPPORTED, "A ZIP fájl által használd adatformátum módosítását nem támogatja a jelenlegi ZIP plugin verzió"
  IDS_WAITFOR_INFO, "Ez csak akkor szükséges, ha a telepítő program egy másik programot indít, amely folytatja a telepítést, amíg az eredeti telepítő program befejeződik.\nÍgy viselkedik pl. néhány Install Shield verzió."
}

STRINGTABLE
{
  IDS_SFX_COMMENT_HEAD1, ";Önkitömörítő beállítások\r\n\r\n;Ez az Önkitömörítő beállítási fájlja.\r\n;\r\n;Fájlformátum szintaktika:\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD2, ";A ';' karakterrel kezdődő sorok megjegyzésnek minősülnek\r\n;és kimaradnak a beállítási fájl feldolgozása során.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD3, ";A verzió kivételével minden változó elhagyható. Ha egy változó nem található\r\n;a beállítási fájlban, az alapértelmezett értéke lesz használva.\r\n;A nyelvhez tartozó értékek (dlg_text, dlg_title,\r\n;button_text) az sfx csomagból lesznek beolvasva.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD4, ";Minden sztring értéket, beleértve az üres sztringeket is, dupla\r\n;idézőjelbe kell zárni. A sztringben dupla idézőjel megadásához\r\n;használjon két egymást követő dupla idézőjelet.\r\n;\r\n;A számok nem zárhatók dupla idézőjelbe.\r\n\r\n"
  IDS_SFX_COMMENT_VERSION, "\r\n;a beállítási fájl verziója, a jelenlegi verzió 2\r\n;ez az egyetlen kötelező változó\r\n\r\n"
  IDS_SFX_COMMENT_TARGDIR1, "\r\n;a célkönyvtár megadása, lehet abszolút útvonal\r\n;vagy relatív útvonal; a relatív útvonal az aktuális könyvtárhoz képest értendő,\r\n;amikor az sfx végrehajtható fájl elindul\r\n"
  IDS_SFX_COMMENT_TARGDIR2, ";a 'target_dir' sztring elején előre definiált változókat is\r\n;használhat (!):\r\n;\r\n"
  IDS_SFX_COMMENT_TARGDIR3, ";  $(Temp)      ideiglenes könyvtár, csak önállóan szerepelhet\r\n;               a target_dir mezőben, nem követheti\r\n;               semmilyen útvonalrész\r\n"
  IDS_SFX_COMMENT_TARGDIR4, ";  $(ProgFiles) a felhasználó 'Program Files' mappája\r\n;  $(WinDir)    windows könyvtár\r\n;  $(SysDir)    rendszerkönyvtár\r\n"
  IDS_SFX_COMMENT_TARGDIR5, ";  $[variable]  a 'variable' által meghatározott\r\n;               környezeti változó értéke\r\n;  $<regkey>    a 'regkey' által meghatározott registry kulcsérték\r\n;  pl. SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
  IDS_SFX_COMMENT_ALLOWCHANGE, "\r\n;megadja, hogy a felhasználó megváltoztathatja-e a célkönyvtárat\r\n;kitömörítés közben\r\n;állítsa 1-re, ha engedélyezni kívánja ezt\r\n\r\n"
  IDS_SFX_COMMENT_REMOVE1, "\r\n;megadja, hogy eltávolítsa-e a kibontott fájlokat az ideiglenes mappából,\r\n;amikor a 'command' változóban megadott program befejeződött\r\n"
  IDS_SFX_COMMENT_REMOVE2, ";állítsa 1-re, ha el szeretné távolítani az ideiglenes fájlokat\r\n;ennek a változónak csak akkor van értelme, ha a 'target_dir' értéke\r\n;""$(Temp)"", különben az értékét figyelmen kívül hagyja\r\n\r\n"
  IDS_SFX_COMMENT_AUTO, "\r\n;megadja, hogy a kitömörítés automatikusan induljon-e el, amikor a felhasználó\r\n;futtatja az önkitömörítő archívumot\r\n;állítsa 1-re, ha azt szeretné, hogy a kitömörítés automatikusan kezdődjön\r\n\r\n"
  IDS_SFX_COMMENT_SUMMARY, "\r\n;megadja, hogy megjelenjen-e egy üzenetpanel a művelet sikerességéről\r\n;értesítve a fájlok kitömörítésének befejezése után\r\n;állítsa 1-re, ha meg szeretné jeleníteni a művelet összefoglalóját\r\n\r\n"
  IDS_SFX_COMMENT_HIDE, "\r\n;megadja, hogy megjelenjen-e az önkitömörítő fő párbeszédablaka\r\n;állítsa 1-re, ha nem szeretné megjeleníteni a fő sfx párbeszédablakot\r\n;ennek a változónak csak akkor van értelme, ha az 'autostart' értéke 1,\r\n;különben az értékét figyelmen kívül hagyja\r\n\r\n"
  IDS_SFX_COMMENT_OVERWRITE, "\r\n;megadja, hogy automatikusan felülírja-e a célkönyvtárban lévő\r\n;összes fájlt\r\n;állítsa 1-re, ha azt szeretné, hogy a fájlok automatikusan\r\n;felülíródjanak\r\n\r\n"
  IDS_SFX_COMMENT_AUTODIR, "\r\n;megadja, hogy automatikusan, a felhasználó megkérdezése nélkül\r\n;hozza-e létre a célkönyvtárat\r\n;állítsa 1-re, ha azt szeretné, hogy a célkönyvtár automatikusan\r\n;jöjjön létre\r\n\r\n"
  IDS_SFX_COMMENT_COMMAND, "\r\n;a fájlok sikeres kibontása után futtatandó/megnyitandó program,\r\n;http hivatkozás vagy dokumentum; az útvonal a kibontás célkönyvtárához\r\n;képest relatív; ha programot ad meg, argumentumait is megadhatja\r\n\r\n"
  IDS_SFX_COMMENT_PACKAGE, "\r\n;az önkitömörítő archívum létrehozásakor használandó sfx csomag\r\n;a relatív útvonal a zip2sfx.exe könyvtárához képest értendő\r\n\r\n"
  IDS_SFX_COMMENT_MBUT, "\r\n;az opcionális üzenetpanel gombjai\r\n;a következők egyike lehet: ""ok"", ""ok_cancel"", ""yes_no"",\r\n;""agree_disagree""\r\n\r\n"
  IDS_SFX_COMMENT_MICO, "\r\n;az opcionális üzenetpanel típusa\r\n;a következők egyike lehet: ""simple"", ""exclamation"", ""information"",\r\n;""question"", ""long_message""\r\n\r\n"
  IDS_SFX_COMMENT_MBOX, "\r\n;az opcionális üzenetpanel szövege és címe, amely a kitömörítés\r\n;megkezdése előtt jelenik meg\r\n;ha nem szeretne üzenetpanelt megjeleníteni, hagyja mindkét mezőt\r\n;üresen ("""")\r\n\r\n"
  IDS_SFX_COMMENT_TEXT, "\r\n;a fő önkitömörítő párbeszédablakban megjelenő szöveg\r\n\r\n"
  IDS_SFX_COMMENT_TITLE, "\r\n;a fő önkitömörítő párbeszédablak címe\r\n\r\n"
  IDS_SFX_COMMENT_BUTTON, "\r\n;a fő sfx párbeszédablak kibontás gombjának szövege\r\n\r\n"
  IDS_SFX_COMMENT_VENDOR, "\r\n;szállító neve a fő sfx párbeszédablak bal alsó sarkában\r\n\r\n"
  IDS_SFX_COMMENT_WWW, "\r\n;www hivatkozás a fő sfx párbeszédablak jobb alsó sarkában\r\n\r\n"
  IDS_SFX_COMMENT_ICOFILE, "\r\n;ikondatát tartalmazó fájlok; lehet ICO fájl vagy PE\r\n;végrehajtható fájl (pl. win32 EXE vagy DLL), amely tartalmazza az ikont\r\n;a relatív útvonal a zip2sfx.exe könyvtárához képest értendő\r\n\r\n"
  IDS_SFX_COMMENT_ICOINDEX, "\r\n;pozitív érték az 'icon_file' változóban megadott végrehajtható fájlban lévő\r\n;ikon indexét jelenti\r\n;negatív érték az ikon erőforrás-azonosítóját jelenti\r\n;ICO fájlok esetén az index mindig 0, és az értékét figyelmen kívül hagyja\r\n\r\n"
  IDS_SFX_COMMENT_WAITFOR1, "\r\n;Ez a beállítás lehetővé teszi, hogy egy másik folyamatra várakozzon,\r\n;nem arra, amelyet a 'Command' mezőben megadott. Miután ez a folyamat\r\n;befejeződött, az önkitömörítő eltávolítja az ideiglenes fájlokat,\r\n;majd maga is befejeződik.\r\n"
  IDS_SFX_COMMENT_WAITFOR2, ";Csak akkor szükséges, ha a telepítőprogram egy másik végrehajtható\r\n;fájlt indít el, amely folytatja a telepítést, miközben az eredeti\r\n;telepítőprogram már befejeződött.\r\n"
  IDS_SFX_COMMENT_WAITFOR3, ";Ilyen módon viselkedik például az Install Shield egyes verziója.\r\n;Ezt a beállítást a rendszer figyelmen kívül hagyja, hacsak a 'remove_temp'\r\n;értéke nem 1.\r\n\r\n"
  IDS_SFX_COMMENT_REQUIRESADMIN, "\r\n;Windows Vista vagy újabb rendszeren futtatáshoz rendszergazdai jogosultságot igényel\r\n\r\n"
}
