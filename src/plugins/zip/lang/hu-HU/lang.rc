                    "Button",BS_AUTORADIOBUTTON,11,98,215,12
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SFXMENU MENU 
BEGIN
    POPUP "&Fájl"
    BEGIN
        MENUITEM "&Exportálási beállítások...\tCtrl+E", CM_SFX_EXPORT
        MENUITEM "&Importálási beállítások...\tCtrl+I", CM_SFX_IMPORT
    END
    POPUP "&Nézet"
    BEGIN
        MENUITEM "&SFX ablak előnézete...\tCtr+V", CM_SFX_PREVIEW
    END
    POPUP "Beállítás&ok"
    BEGIN
        MENUITEM "&Mind visszaállít\tCtrl+Shift+R",    CM_SFX_RESETALL
        MENUITEM "Ala&p értékek\tCtrl+R",       CM_SFX_RESETVALUES
        MENUITEM "Alap &szövegek\tCtrl+T",        CM_SFX_RESETTEXTS
        MENUITEM SEPARATOR
        MENUITEM "Hozzá&adás a Kedvencekhez...\tCtrl+A", CM_SFX_ADD
        MENUITEM "&Kedvencek\tCtrl+F",          CM_SFX_FAVORITIES
        MENUITEM SEPARATOR
        MENUITEM "Uto&ljára használt\tCtrl+L",          CM_SFX_LASTUSED
    END
END

IDM_FAVMANMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Á&tnevezés",                     CM_FAVRENAME
        MENUITEM "Tö&rlés",                     CM_FAVDELETE
        MENUITEM SEPARATOR
        MENUITEM "&Mind töröl",                 CM_FAVREMOVEALL
    END
END

IDM_COMMENTMENU MENU 
BEGIN
    POPUP "&Fájl"
    BEGIN
        MENUITEM "Menté&s",                       CM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "&Bezárás\tAlt+F4",              CM_CLOSE
    END
END

IDM_SPECDIR MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Ideiglenes mappa",        CM_TEMP
        MENUITEM "&Program Files",              CM_PROGFILES
        MENUITEM "&Windows mappa",          CM_WINDIR
        MENUITEM "&System mappa",           CM_SYSDIR
        MENUITEM SEPARATOR
        MENUITEM "Körny&ezeti változó",       CM_ENVVAR
        MENUITEM "&Regisztrációs érték",             CM_REGENTRY
    END
END

