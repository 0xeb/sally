IDD_WAITFOR DIALOGEX 15, 24, 232, 155
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Wachten op"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Deze optie geeft u de mogelijkheid te wachten op een ander proces dan hetgeen door uzelf is gedefineerd onder het veld 'Commando'. Nadien het gehele proces is voltooid zal de zelfuitpakker de tijdelijke bestanden verwijderen en zichzelf afronden.",IDC_STATIC_1,12,9,205,40
    LTEXT           "",IDC_STATIC_2,12,57,205,32
    LTEXT           "&Bestandsnaam van het uitvoerbaar bestand:",IDC_STATIC_3,12,97,151,8
    EDITTEXT        IDC_FILENAME,12,107,205,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_STATIC_4,3,129,225,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,31,136,50,14
    PUSHBUTTON      "Annuleren",IDCANCEL,91,136,50,14
    PUSHBUTTON      "Help",IDHELP,151,136,50,14
END

IDD_CHANGELANG DIALOGEX 6, 15, 248, 114
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Verander Zelf-Extractor teksten"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "U hebt de zelf-extractor taal verandert, wilt u de aangepaste teksten die u hebt verandert in het dialoogvenster 'Zelf-Extractor teksten' laten wijzigigen naar hun standaardwaarden die corresponderen met de taal die u geselecteerd hebt?",IDC_STATIC_1,11,8,227,32
    DEFPUSHBUTTON   "Ja",IDOK,40,48,50,14
    PUSHBUTTON      "Nee",IDCANCEL,99,48,50,14
    PUSHBUTTON      "Help",IDHELP,158,48,50,14
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,3,70,242,1
    CONTROL         "&Altijd navragen voordat er tekst veranderd wordt",IDC_ASK,"Button",BS_AUTORADIOBUTTON,11,74,176,12
    CONTROL         "Tekst automatisch &vervangen met hun standaardwaarden",IDC_REPLACE,
                    "Button",BS_AUTORADIOBUTTON,11,86,206,12
    CONTROL         "Niet opnieuw vragen en laat tekst &onveranderd",IDC_LEAVE,
                    "Button",BS_AUTORADIOBUTTON,11,98,170,12
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SFXMENU MENU 
BEGIN
    POPUP "&Bestand"
    BEGIN
        MENUITEM "&Instellingen exporteren...\tCtrl+E", CM_SFX_EXPORT
        MENUITEM "I&nstellingen importeren...\tCtrl+I", CM_SFX_IMPORT
    END
    POPUP "&Tonen"
    BEGIN
        MENUITEM "&Voorvertoning SFX-dialoogvenster...\tCtrl+V", CM_SFX_PREVIEW
    END
    POPUP "&Opties"
    BEGIN
        MENUITEM "Alles &resetten\tCtrl+Shift+R",    CM_SFX_RESETALL
        MENUITEM "Reset &waarden\tCtrl+R",       CM_SFX_RESETVALUES
        MENUITEM "Reset &teksten\tCtrl+T",        CM_SFX_RESETTEXTS
        MENUITEM SEPARATOR
        MENUITEM "T&oevoegen aan favorieten...\tCtrl+A", CM_SFX_ADD
        MENUITEM "&Favorieten\tCtrl+F",          CM_SFX_FAVORITIES
        MENUITEM SEPARATOR
        MENUITEM "&Laatst gebruikt\tCtrl+L",          CM_SFX_LASTUSED
    END
END

IDM_FAVMANMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Hernoemen",                     CM_FAVRENAME
        MENUITEM "&Verwijderen",                     CM_FAVDELETE
        MENUITEM SEPARATOR
        MENUITEM "&Alles verwijderen",                 CM_FAVREMOVEALL
    END
END

IDM_COMMENTMENU MENU 
BEGIN
    POPUP "&Bestand"
    BEGIN
        MENUITEM "&Opslaan",                       CM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "&Sluiten\tAlt+F4",              CM_CLOSE
    END
END

IDM_SPECDIR MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Tijdelijke directory",        CM_TEMP
        MENUITEM "&Programma bestanden",              CM_PROGFILES
        MENUITEM "&Windows directory",          CM_WINDIR
        MENUITEM "&Systeem directory",           CM_SYSDIR
        MENUITEM SEPARATOR
        MENUITEM "&Omgevingsvariabelen",       CM_ENVVAR
        MENUITEM "&Register items",             CM_REGENTRY
    END
END

