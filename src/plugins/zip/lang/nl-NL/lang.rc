STRINGTABLE
{
  IDS_SFX_COMMENT_HEAD1, ";Zelf-Extractor Instellingen\r\n\r\n;Dit is een bestand met instellingen voor Zelf-Extractor.\r\n;\r\n;Bestandsformaat syntax:\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD2, ";Regels die beginnen met een ';' karakter worden behandeld als commentaar en worden\r\n;genegeerd bij het verwerken van het instellingen-bestand.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD3, ";Alle variabelen zijn optioneel, behalve versie. Als de variabel niet \r\n;gevonden wordt in het instellings-bestand, wordt de standaardwaarde gebruikt.\r\n;Standaardwaarden voor taal afhankelijke variabelen (dlg_text, dlg_title,\r\n;button_text) zijn afkomstig uit het SFX pakket.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD4, ";Alle String-waarden, met inbegrip van null strings, dient te worden ingesloten in\r\n;dubbele aanhalingstekens. Voor het invoeren van dubbele aanhalingstekens in een string gebruik twee\r\n;daaropvolgende dubbele aanhalingstekens.\r\n;\r\n;Nummers kunnen niet worden ingesloten in dubbele aanhalingstekens.\r\n\r\n"
  IDS_SFX_COMMENT_VERSION, "\r\n;versie van het instelling-bestand, de huidige versie is 2\r\n;dit is de enige verplichte variabel\r\n\r\n"
  IDS_SFX_COMMENT_TARGDIR1, "\r\n;bestemmings-directory specificatie, het kan een absoluut pad zijn\r\n; ofwel een ralatief pad; een relatief pad is in relatie met de huidige directory\r\n;als een SFX uitvoerbaar bestand wordt uitgevoerd\r\n"
  IDS_SFX_COMMENT_TARGDIR2, ";u kunt ook voorgedefineerde variabelen gebruiken in het begin (!)\r\n;van de 'target_dir' string:\r\n;\r\n"
  IDS_SFX_COMMENT_TARGDIR3, ";  $(Temp)      tijdelijke directory, mag alleen zelf bestaan\r\n;               in het 'target_dir' veld niet gevolgd worden door welk pad\r\n;               deel ook\r\n"
  IDS_SFX_COMMENT_TARGDIR4, ";  $(ProgFiles) gebruikers 'Programma bestanden'\r\n;  $(WinDir)    Windows bestanden\r\n;  $(SysDir)    Systeem bestanden\r\n"
  IDS_SFX_COMMENT_TARGDIR5, ";  $[variable]  waarde van een omgevingsvariabele beschreven door\r\n;               'variable'\r\n;  $<regkey>    waarde van de registersleutel beschreven door 'regkey'\r\n;  bijv. SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
  IDS_SFX_COMMENT_ALLOWCHANGE, "\r\n;bepaalt of de gebruiker de bestemming voor het uitpakken van directory kan veranderen\r\n;stel de waarde op 1 als u het wilt toestaan\r\n\r\n"
  IDS_SFX_COMMENT_REMOVE1, "\r\n;bepaalt of de uitgepakte bestanden na extractie wilt verwijderen uit de tijdelijke directory\r\n;als een programma aangegeven door een 'command' variabel is voltooid\r\n"
  IDS_SFX_COMMENT_REMOVE2, ";zet deze waarde naar 1 als u wilt dat de tijdelijke bestanden worden verwijderd\r\n;gebruik maken van deze variabel is alleen zinvol als 'target_dir' is ingesteld op\r\n;""$(Temp)"", anders wordt de waarde genegeerd\r\n\r\n"
  IDS_SFX_COMMENT_AUTO, "\r\n;bepaalt of de extractie automatisch wordt uitgevoerd\r\n;bij een zelfuitpakkend archiefbestand\r\n;zet deze waarde naar 1 als u wilt dat deze extractie automatisch geschied\r\n\r\n"
  IDS_SFX_COMMENT_SUMMARY, "\r\n;bepaalt of een berichten dialoogvenster wordt weergegeven (voortgang)\r\n;bij het succesvol uitpakken van bestanden\r\n;zet deze waarde naar 1 als u wilt dat deze berichten weergegeven worden\r\n\r\n"
  IDS_SFX_COMMENT_HIDE, "\r\n;bepaalt of het hoofd-dialoogvenster van de Zelf-Extractor wordt weergegeven\r\n;zet deze waarde naar 1 als u niet wilt dat deze weergegeven wordt\r\n;gebruik maken van deze variabel is alleen zinvol als 'autostart' ingesteld staat op 1,\r\n;anders wordt deze waarde genegeerd\r\n\r\n"
  IDS_SFX_COMMENT_OVERWRITE, "\r\n;bepaalt automatisch of alle bestanden worden overschreven in de bestemmings-\r\n;directory\r\n;zet deze waarde naar 1 als u wilt dat al deze automatisch worden\r\n;overschreven\r\n\r\n"
  IDS_SFX_COMMENT_AUTODIR, "\r\n;bepaalt of een nieuwe directory automatisch gecreëerd dient te worden zonder navraag bij de\r\n;gebruiker\r\n;zet deze waarde naar 1 als u wilt dat deze automatisch worden\r\n;gecreëerd\r\n\r\n"
  IDS_SFX_COMMENT_COMMAND, "\r\n;programma, HTTP link of het document dat uitgevoerd/geopend wordt als de bestanden\r\n;succesvol zijn uitgepakt, het pad is verwant aan de\r\n;uitgepakte bestemmings-directory, als u een programma hebt gedefineerd kunt u ook\r\n;zijn argumenten opgeven\r\n\r\n"
  IDS_SFX_COMMENT_PACKAGE, "\r\n;SFX pakket wordt gebruikt bij het creëren van zelfuitpakkende archiefbestanden\r\n;het relatieve pad is verwant aan de directory van zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_MBUT, "\r\n;knoppen in het optionele berichten dialoogvenster\r\n;kunnen één van de volgende zijn: ""ok"", ""ok_cancel"", ""yes_no"",\r\n;""agree_disagree""\r\n\r\n"
  IDS_SFX_COMMENT_MICO, "\r\n;type van het optionele berichten dialoogvenster\r\n;kunnen één van de volgende zijn: ""simple"", ""exclamation"", ""information"",\r\n;""question"", ""long_message""\r\n\r\n"
  IDS_SFX_COMMENT_MBOX, "\r\n;tekst en titel van de optionele berichten dialoogvenster, welke wordt weergegeven voordat\r\n;het uitpakken begint\r\n;als u niet wilt dat er berichten dialoogvensters worden weergegeven laat u beide velden\r\n;leeg ("""")\r\n\r\n"
  IDS_SFX_COMMENT_TEXT, "\r\n;tekst welke wordt weergegeven in het hoofd-dialoogvenster van de zelf-extractor\r\n\r\n"
  IDS_SFX_COMMENT_TITLE, "\r\n;titel van het hoofd-dialoogvenster van de zelf-extractor\r\n\r\n"
  IDS_SFX_COMMENT_BUTTON, "\r\n;tekst in de uitpak-knop van het hoofd-dialoogvenster van de zelf-extractor\r\n\r\n"
  IDS_SFX_COMMENT_VENDOR, "\r\n;naam van de verkoper in de linker-onderhoek van het hoofd-dialoogvenster van de zelf-extractor\r\n\r\n"
  IDS_SFX_COMMENT_WWW, "\r\n;WWW-adres in de rechter-onderhoek van het hoofd-dialoogvenster van de zelf-extractor\r\n\r\n"
  IDS_SFX_COMMENT_ICOFILE, "\r\n;bestanden welke pictogrammen bevatten, kunnen zowel ICO-bestanden zijn als PE-\r\n;uitvoerbaar bestanden (zoals win32 EXEs of DLLs) bevatten het pictogram\r\n;het relatieve pad is verwant aan de directory van zip2sfx.exe\r\n\r\n"
  IDS_SFX_COMMENT_ICOINDEX, "\r\n;positieve waarden in de index van een pictogram vanuit een uitvoerbaar bestand betekent\r\n;gedefineerd uit het 'icon_file' variabel\r\n;een negatieve waarden betekent een hulpbron ID van een pictogram\r\n;voor ICO-bestanden is de waarde altijd 0 en zijn waarde wordt genegeerd\r\n\r\n"
  IDS_SFX_COMMENT_WAITFOR1, "\r\n;deze optie geeft u de mogelijkheid te wachten op een ander proces dan hetgeen\r\n;door uzelf is gedefineerd onder het veld 'Commando'. Nadien het gehele proces is voltooid\r\n;zal de zelfuitpakker de tijdelijke bestanden verwijderen en zichzelf afronden.\r\n"
  IDS_SFX_COMMENT_WAITFOR2, ";dit is alleen noodzakelijk als de originele installatie een ander uitvoerbaar bestand\r\n;uitvoert, terwijl de originale installatie\r\n;reeds is voltooid\r\n"
  IDS_SFX_COMMENT_WAITFOR3, ";dit is van toepassing op sommige versies van Install Shield.\r\n;deze optie wordt genegeerd tenzij 'remove_temp' is ingesteld op de waarde 1.\r\n\r\n"
  IDS_SFX_COMMENT_REQUIRESADMIN, "\r\n;vereist beheerdersbevoegdheden om te draaien op Windows Vista of later\r\n\r\n"
}
