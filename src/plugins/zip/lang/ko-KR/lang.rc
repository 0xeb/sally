  IDS_BADMSGBOXTYPE, """동의함 + 동의하지 않음"" 단추는 ""긴 메시지"" 메시지 상자 종류와 함께만 사용할 수 있습니다."
  IDS_LOTFILES, "항목이 65535개를 넘는 ZIP 압축 파일을 만들려고 합니다. 이러한 압축 파일은 원래 ZIP 형식과 호환되지 않으며 일부 압축 프로그램에서는 압축을 풀지 못할 수 있습니다.\n\n계속하시겠습니까?"
  IDS_LOTFILESSFX, "항목이 65535개를 넘는 자동 압축 풀림 ZIP 파일은 만들 수 없습니다."
  IDS_BADAES, "알 수 없는 AES 버전으로 암호화된 파일입니다."
  IDS_PWDTOOLONG, "암호가 너무 깁니다.\nAES 암호화의 최대 암호 길이는 128자입니다."
  IDS_AESERROR, "AES 오류입니다."
  IDS_MACERROR, "인증 코드가 일치하지 않습니다. 파일이 손상되었거나 암호가 잘못되었습니다."
  IDS_ERRZIP64, "zip64 압축 파일에서는 지원되지 않는 작업입니다. zip64 압축 파일은 목록 보기와 압축 풀기만 가능합니다."
  IDS_ONLYFULLVERSION, " (정식 버전에서만 사용 가능)"
  IDS_ERRBZIP2 "BZIP2 스트림에서 오류가 발생했습니다. 압축 파일이 손상되었을 수 있습니다."
  IDS_UNSUP_CD_ENCRYPTION "파일 목록이 들어 있는 이 압축 파일의 중앙 디렉터리가 암호화되었거나 압축되어 있습니다.\n이 형식은 지원되지 않습니다."
  IDS_LISTINFO_PAKEDSIZE      "압축 크기"
  IDS_LISTINFO_PAKEDSIZE_DESC "파일의 압축 크기"
  IDS_SIZE_KB, "KB"
  IDS_SIZE_MB, "MB"
  IDS_MODIFICATION_NOT_SUPPORTED, "이 ZIP 파일은 현재 버전의 ZIP 플러그인에서 수정을 지원하지 않는 데이터 형식을 사용합니다."
  IDS_WAITFOR_INFO, "설치 프로그램이 다른 실행 파일을 실행하고, 원래 설치 프로그램이 끝난 뒤에도 그 실행 파일이 설치를 계속하는 경우에만 필요합니다.\n예를 들어 일부 버전의 Install Shield가 이렇게 동작합니다."
}

STRINGTABLE
{
  IDS_SFX_COMMENT_HEAD1, ";자동 압축 풀림 설정\r\n\r\n;자동 압축 풀림 프로그램의 설정 파일입니다.\r\n;\r\n;파일 형식 구문:\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD2, ";';' 문자로 시작하는 줄은 주석으로 처리되며\r\n;설정 파일을 처리할 때 무시됩니다.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD3, ";version을 제외한 모든 변수는 선택 사항입니다. 설정 파일에\r\n;변수가 없으면 기본값이 사용됩니다.\r\n;언어에 따라 달라지는 변수(dlg_text, dlg_title,\r\n;button_text)의 기본값은 sfx 패키지에서 가져옵니다.\r\n;\r\n"
  IDS_SFX_COMMENT_HEAD4, ";빈 문자열을 포함한 모든 문자열 값은 큰따옴표로\r\n;묶어야 합니다. 문자열에 큰따옴표를 넣으려면 큰따옴표를\r\n;두 번 연속으로 입력하십시오.\r\n;\r\n;숫자는 큰따옴표로 묶을 수 없습니다.\r\n\r\n"
  IDS_SFX_COMMENT_VERSION, "\r\n;설정 파일의 버전, 현재 버전은 2입니다\r\n;유일한 필수 변수입니다\r\n\r\n"
  IDS_SFX_COMMENT_TARGDIR1, "\r\n;대상 디렉터리 지정, 절대 경로 또는 상대 경로를\r\n;사용할 수 있습니다. 상대 경로는 sfx 실행 파일을 실행할 때의\r\n;현재 디렉터리를 기준으로 합니다\r\n"
  IDS_SFX_COMMENT_TARGDIR2, ";'target_dir' 문자열의 시작 부분(!)에 미리 정의된\r\n;변수를 사용할 수도 있습니다:\r\n;\r\n"
  IDS_SFX_COMMENT_TARGDIR3, ";  $(Temp)      임시 디렉터리, target_dir 필드에 단독으로만\r\n;               사용해야 하며 뒤에 경로를 붙일 수\r\n;               없습니다\r\n"
  IDS_SFX_COMMENT_TARGDIR4, ";  $(ProgFiles) 사용자의 'Program Files' 폴더\r\n;  $(WinDir)    Windows 디렉터리\r\n;  $(SysDir)    시스템 디렉터리\r\n"
  IDS_SFX_COMMENT_TARGDIR5, ";  $[variable]  'variable'로 지정한 환경 변수의\r\n;               값\r\n;  $<regkey>    'regkey'로 지정한 레지스트리 키 값\r\n;  예: SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
  IDS_SFX_COMMENT_ALLOWCHANGE, "\r\n;압축을 풀 때 사용자가 대상 디렉터리를 변경할 수 있는지\r\n;지정합니다\r\n;허용하려면 값을 1로 설정하십시오\r\n\r\n"
  IDS_SFX_COMMENT_REMOVE1, "\r\n;'command' 변수로 지정한 프로그램이 끝나면\r\n;임시 폴더에 추출한 파일을 제거할지 지정합니다\r\n"
  IDS_SFX_COMMENT_REMOVE2, ";임시 파일을 제거하려면 값을 1로 설정하십시오\r\n;이 변수는 'target_dir'이 ""$(Temp)""로 설정된 경우에만\r\n;의미가 있으며, 그렇지 않으면 값이 무시됩니다\r\n\r\n"
  IDS_SFX_COMMENT_AUTO, "\r\n;사용자가 자동 압축 풀림 파일을 실행할 때 추출을\r\n;자동으로 시작할지 지정합니다\r\n;추출을 자동으로 시작하려면 값을 1로 설정하십시오\r\n\r\n"
  IDS_SFX_COMMENT_SUMMARY, "\r\n;파일 추출이 끝난 후 작업 성공을 알리는 메시지 상자를\r\n;표시할지 지정합니다\r\n;작업 요약을 표시하려면 값을 1로 설정하십시오\r\n\r\n"
  IDS_SFX_COMMENT_HIDE, "\r\n;자동 압축 풀림 프로그램의 기본 대화 상자를 표시할지 지정합니다\r\n;기본 sfx 대화 상자를 표시하지 않으려면 값을 1로 설정하십시오\r\n;이 변수는 'autostart'가 1로 설정된 경우에만 의미가 있으며,\r\n;그렇지 않으면 값이 무시됩니다\r\n\r\n"
  IDS_SFX_COMMENT_OVERWRITE, "\r\n;대상 디렉터리의 모든 파일을 자동으로 덮어쓸지\r\n;지정합니다\r\n;파일을 자동으로 덮어쓰려면 값을 1로\r\n;설정하십시오\r\n\r\n"
  IDS_SFX_COMMENT_AUTODIR, "\r\n;사용자에게 묻지 않고 대상 디렉터리를 자동으로 만들지\r\n;지정합니다\r\n;대상 디렉터리를 자동으로 만들려면 값을 1로\r\n;설정하십시오\r\n\r\n"
  IDS_SFX_COMMENT_COMMAND, "\r\n;파일 추출이 성공적으로 끝나면 실행하거나 열 프로그램,\r\n;http 링크 또는 문서, 경로는 추출 대상 디렉터리를\r\n;기준으로 하며, 프로그램을 지정하는 경우\r\n;인수도 입력할 수 있습니다\r\n\r\n"
  IDS_SFX_COMMENT_PACKAGE, "\r\n;자동 압축 풀림 파일을 만들 때 사용할 sfx 패키지\r\n;상대 경로는 zip2sfx.exe가 있는 디렉터리를 기준으로 합니다\r\n\r\n"
  IDS_SFX_COMMENT_MBUT, "\r\n;선택적 메시지 상자의 단추\r\n;다음 중 하나를 사용할 수 있습니다: ""ok"", ""ok_cancel"", ""yes_no"",\r\n;""agree_disagree""\r\n\r\n"
  IDS_SFX_COMMENT_MICO, "\r\n;선택적 메시지 상자의 종류\r\n;다음 중 하나를 사용할 수 있습니다: ""simple"", ""exclamation"", ""information"",\r\n;""question"", ""long_message""\r\n\r\n"
  IDS_SFX_COMMENT_MBOX, "\r\n;추출을 시작하기 전에 표시되는 선택적 메시지 상자의\r\n;텍스트와 제목\r\n;메시지 상자를 표시하지 않으려면 두 필드를 모두\r\n;비워 두십시오("""")\r\n\r\n"
  IDS_SFX_COMMENT_TEXT, "\r\n;자동 압축 풀림 프로그램의 기본 대화 상자에 표시할 텍스트\r\n\r\n"
  IDS_SFX_COMMENT_TITLE, "\r\n;자동 압축 풀림 프로그램의 기본 대화 상자 제목\r\n\r\n"
  IDS_SFX_COMMENT_BUTTON, "\r\n;기본 sfx 대화 상자의 추출 단추에 표시할 텍스트\r\n\r\n"
  IDS_SFX_COMMENT_VENDOR, "\r\n;기본 sfx 대화 상자 왼쪽 아래에 표시할 공급업체 이름\r\n\r\n"
  IDS_SFX_COMMENT_WWW, "\r\n;기본 sfx 대화 상자 오른쪽 아래에 표시할 www 링크\r\n\r\n"
  IDS_SFX_COMMENT_ICOFILE, "\r\n;아이콘 데이터가 들어 있는 파일, ICO 파일 또는 아이콘이 들어 있는\r\n;PE 실행 파일(win32 EXE 또는 DLL 등)일 수 있습니다\r\n;상대 경로는 zip2sfx.exe가 있는 디렉터리를 기준으로 합니다\r\n\r\n"
  IDS_SFX_COMMENT_ICOINDEX, "\r\n;양수 값은 'icon_file' 변수로 지정한 실행 파일에서\r\n;아이콘의 인덱스를 의미합니다\r\n;음수 값은 아이콘의 리소스 ID를 의미합니다\r\n;ICO 파일에서는 인덱스가 항상 0이며 값이 무시됩니다\r\n\r\n"
  IDS_SFX_COMMENT_WAITFOR1, "\r\n;이 옵션을 사용하면 '명령' 필드에 지정한 프로세스가 아닌\r\n;다른 프로세스를 기다릴 수 있습니다. 이 프로세스가 끝나면\r\n;자동 압축 풀림 프로그램이 임시 파일을 제거한 후 종료합니다.\r\n"
  IDS_SFX_COMMENT_WAITFOR2, ";설치 프로그램이 다른 실행 파일을 실행하고, 원래 설치 프로그램이\r\n;끝난 뒤에도 그 실행 파일이 설치를 계속하는 경우에만\r\n;필요합니다.\r\n"
  IDS_SFX_COMMENT_WAITFOR3, ";예를 들어 일부 버전의 Install Shield가 이렇게 동작합니다.\r\n;'remove_temp'가 1로 설정되지 않으면 이 옵션은 무시됩니다.\r\n\r\n"
  IDS_SFX_COMMENT_REQUIRESADMIN, "\r\n;Windows Vista 이상에서 실행하려면 관리자 권한이 필요합니다\r\n\r\n"
}
