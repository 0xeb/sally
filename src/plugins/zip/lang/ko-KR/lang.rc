/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SFXMENU MENU 
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "설정 내보내기(&E)...\tCtrl+E", CM_SFX_EXPORT
        MENUITEM "설정 가져오기(&I)...\tCtrl+I", CM_SFX_IMPORT
    END
    POPUP "보기(&V)"
    BEGIN
        MENUITEM "SFX 대화 상자 미리 보기(&V)...\tCtr+V", CM_SFX_PREVIEW
    END
    POPUP "옵션(&O)"
    BEGIN
        MENUITEM "모두 다시 설정(&R)\tCtrl+Shift+R",    CM_SFX_RESETALL
        MENUITEM "값 다시 설정(&V)\tCtrl+R",       CM_SFX_RESETVALUES
        MENUITEM "텍스트 다시 설정(&T)\tCtrl+T",        CM_SFX_RESETTEXTS
        MENUITEM SEPARATOR
        MENUITEM "즐겨찾기에 추가(&A)...\tCtrl+A", CM_SFX_ADD
        MENUITEM "즐겨찾기(&F)\tCtrl+F",          CM_SFX_FAVORITIES
        MENUITEM SEPARATOR
        MENUITEM "마지막 사용(&L)\tCtrl+L",          CM_SFX_LASTUSED
    END
END

IDM_FAVMANMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "이름 바꾸기(&R)",                     CM_FAVRENAME
        MENUITEM "삭제(&D)",                     CM_FAVDELETE
        MENUITEM SEPARATOR
        MENUITEM "모두 제거(&A)",                 CM_FAVREMOVEALL
    END
END

IDM_COMMENTMENU MENU 
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "저장(&S)",                       CM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "닫기(&C)\tAlt+F4",              CM_CLOSE
    END
END

IDM_SPECDIR MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "임시 디렉터리(&T)",        CM_TEMP
        MENUITEM "Program Files(&P)",              CM_PROGFILES
        MENUITEM "Windows 디렉터리(&W)",          CM_WINDIR
        MENUITEM "시스템 디렉터리(&S)",           CM_SYSDIR
        MENUITEM SEPARATOR
        MENUITEM "환경 변수(&E)",       CM_ENVVAR
        MENUITEM "레지스트리 항목(&R)",             CM_REGENTRY
    END
END

