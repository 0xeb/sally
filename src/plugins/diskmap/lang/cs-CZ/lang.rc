// Czech (cs-CZ) resources for diskmap. Translation: Hynek Mikulič.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/diskmap/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#define SALAMANDER
#include "..\..\DiskMap\Resources\DiskMap.rh2"

LANGUAGE LANG_CZECH, SUBLANG_CZECH_CZECH_REPUBLIC

/////////////////////////////////////////////////////////////////////////////
// Menus

IDC_ZAREVAKDISKMAP MENU 
BEGIN
    POPUP "&Soubor"
    BEGIN
        MENUITEM "&Otevřít soubor",                       IDM_FILE_OPEN
        MENUITEM "&Ukázat v panelu\tF",        IDM_FILE_FOCUSINSALAMANDER
        MENUITEM SEPARATOR
        MENUITEM "&Přerušit\tEsc",                      IDM_FILE_ABORT
        MENUITEM "O&bnovit\tCtrl+R",            IDM_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "Z&avřít\tAlt+F4",                      IDM_FILE_EXIT
    END
    POPUP "&Zobrazení"
    BEGIN
        MENUITEM "Zvě&tšit\t+",                 IDM_VIEW_ZOOMIN
        MENUITEM "Zm&enšit\t -",                IDM_VIEW_ZOOMOUT
        MENUITEM "&Zrušit lupu\t Shift+Backspace",   IDM_VIEW_GOTOROOT
        MENUITEM SEPARATOR
        MENUITEM "&Log okno...\tCtrl+L",              IDM_VIEW_LOG
    END

    POPUP "N&astavení"
    BEGIN
	MENUITEM "&Zvýraznit adresáře",          IDM_OPTIONS_SHOWFOLDERS, CHECKED
	MENUITEM "Zobrazit &Tooltip\tCtrl+D",    IDM_OPTIONS_SHOWTOOLTIP, CHECKED
        POPUP "Tooltip &formát cesty"
        BEGIN
            MENUITEM "&Název souboru",            IDM_PATHFORMAT_FILENAME
            MENUITEM "&Relativní",            IDM_PATHFORMAT_RELATIVEVIEW
//            MENUITEM "&Relative to Root",  IDM_PATHFORMAT_RELATIVEROOT
            MENUITEM "&Absolutní",            IDM_PATHFORMAT_ABSOLUTE
        END
        MENUITEM SEPARATOR
        MENUITEM "&Potvrdit zavření přes Esc",       IDM_OPTIONS_CONSFIRMCLOSE, CHECKED
    END
    POPUP "&Nápověda"
    BEGIN
//        POPUP "&Debug"
//        BEGIN
//            MENUITEM "&Export Directory Structure...", IDM_DEBUG_EXPORTDIR
//        END
//        MENUITEM SEPARATOR
        MENUITEM "&O pluginu...",                  IDM_HELP_ABOUT
    END
END

