// Slovak (sk-SK) resources for diskmap. Translation: Roman Paholík.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/diskmap/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#define SALAMANDER
#include "..\..\DiskMap\Resources\DiskMap.rh2"

LANGUAGE LANG_SLOVAK, SUBLANG_SLOVAK_SLOVAKIA

/////////////////////////////////////////////////////////////////////////////
// Menus

IDC_ZAREVAKDISKMAP MENU 
BEGIN
    POPUP "&Súbor"
    BEGIN
        MENUITEM "&Otvoriť súbor",                       IDM_FILE_OPEN
        MENUITEM "&Ukázať v paneli\tF",        IDM_FILE_FOCUSINSALAMANDER
        MENUITEM SEPARATOR
        MENUITEM "&Prerušiť\tEsc",                      IDM_FILE_ABORT
        MENUITEM "O&bnoviť\tCtrl+R",            IDM_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "Z&atvoriť\tAlt+F4",                      IDM_FILE_EXIT
    END
    POPUP "&Zobrazenie"
    BEGIN
        MENUITEM "Zvä&čšiť\t+",                 IDM_VIEW_ZOOMIN
        MENUITEM "Zm&enšiť\t -",                IDM_VIEW_ZOOMOUT
        MENUITEM "&Zrušiť lupu\t Shift+Backspace",   IDM_VIEW_GOTOROOT
        MENUITEM SEPARATOR
        MENUITEM "&Log okno...\tCtrl+L",              IDM_VIEW_LOG
    END

    POPUP "N&astavenie"
    BEGIN
	MENUITEM "&Zvýrazniť adresáre",          IDM_OPTIONS_SHOWFOLDERS, CHECKED
	MENUITEM "Zobraziť &Tooltip\tCtrl+D",    IDM_OPTIONS_SHOWTOOLTIP, CHECKED
        POPUP "Tooltip &formát cesty"
        BEGIN
            MENUITEM "&Názov súboru",            IDM_PATHFORMAT_FILENAME
            MENUITEM "&Relatívny",            IDM_PATHFORMAT_RELATIVEVIEW
//            MENUITEM "&Relative to Root",  IDM_PATHFORMAT_RELATIVEROOT
            MENUITEM "&Absolútny",            IDM_PATHFORMAT_ABSOLUTE
        END
        MENUITEM SEPARATOR
        MENUITEM "&Potvrdiť zatvorenie cez Esc",       IDM_OPTIONS_CONSFIRMCLOSE, CHECKED
    END
    POPUP "&Nápoveda"
    BEGIN
//        POPUP "&Debug"
//        BEGIN
//            MENUITEM "&Export Directory Structure...", IDM_DEBUG_EXPORTDIR
//        END
//        MENUITEM SEPARATOR
        MENUITEM "&O plugine...",                  IDM_HELP_ABOUT
    END
END

