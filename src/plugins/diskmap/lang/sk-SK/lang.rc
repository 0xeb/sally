    IDS_CLOSE_CONFIRMATION,     "Chcete zatvoriť Mapu disku?"
    IDS_CLOSE_CONFIRMATION_CHECKBOX, "Nabudúce nezobrazovať a zatvoriť mapu disku bez opýtania"

    IDS_DISKMAP_TITLE,               "Mapa disku"
    IDS_DISKMAP_TITLEPREFIX,         "Mapa disku - "

