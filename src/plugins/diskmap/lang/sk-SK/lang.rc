    IDS_DISKMAP_SHELL_FOCUS,         "&Ukázať v paneli"
    IDS_DISKMAP_SHELL_ZOOMIN,        "Zvä&čšiť"
    IDS_DISKMAP_SHELL_ZOOMOUT,       "Z&menšiť"
    IDS_DISKMAP_SHELL_DIROPEN,       "&Otvoriť v paneli"
