// Korean (ko-KR) resources for diskmap. Translation: Sally contributors (AI-assisted).
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/diskmap/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#define SALAMANDER
#include "..\..\DiskMap\Resources\DiskMap.rh2"

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

/////////////////////////////////////////////////////////////////////////////
// Menus

IDC_ZAREVAKDISKMAP MENU 
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "파일 열기(&O)",                       IDM_FILE_OPEN
        MENUITEM "패널에서 포커스(&F)\tF",        IDM_FILE_FOCUSINSALAMANDER
        MENUITEM SEPARATOR
        MENUITEM "중단(&A)\tEsc",                      IDM_FILE_ABORT
        MENUITEM "새로 고침(&R)\tCtrl+R",            IDM_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "닫기(&C)\tAlt+F4",                      IDM_FILE_EXIT
    END
    POPUP "보기(&V)"
    BEGIN
        MENUITEM "확대(&I)\t+",                 IDM_VIEW_ZOOMIN
        MENUITEM "축소(&O)\t -",                IDM_VIEW_ZOOMOUT
        MENUITEM "확대 해제(&U)\t Shift+Backspace",   IDM_VIEW_GOTOROOT
        MENUITEM SEPARATOR
        MENUITEM "로그 창(&L)...\tCtrl+L",              IDM_VIEW_LOG
    END

    POPUP "옵션(&O)"
    BEGIN
	MENUITEM "폴더 강조 표시(&H)",          IDM_OPTIONS_SHOWFOLDERS, CHECKED
	MENUITEM "도구 설명 표시(&D)\tCtrl+D",    IDM_OPTIONS_SHOWTOOLTIP, CHECKED
        POPUP "도구 설명 경로 형식(&F)"
        BEGIN
            MENUITEM "파일 이름(&F)",            IDM_PATHFORMAT_FILENAME
            MENUITEM "상대 경로(&R)",            IDM_PATHFORMAT_RELATIVEVIEW
//            MENUITEM "&Relative to Root",  IDM_PATHFORMAT_RELATIVEROOT
            MENUITEM "절대 경로(&A)",            IDM_PATHFORMAT_ABSOLUTE
        END
        MENUITEM SEPARATOR
        MENUITEM "Esc로 닫을 때 확인(&C)",       IDM_OPTIONS_CONSFIRMCLOSE, CHECKED
    END
    POPUP "도움말(&H)"
    BEGIN
//        POPUP "&Debug"
//        BEGIN
//            MENUITEM "&Export Directory Structure...", IDM_DEBUG_EXPORTDIR
//        END
//        MENUITEM SEPARATOR
        MENUITEM "정보(&A)...",                  IDM_HELP_ABOUT
    END
END

