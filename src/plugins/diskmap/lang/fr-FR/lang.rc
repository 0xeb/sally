// French (fr-FR) resources for diskmap. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/diskmap/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#define SALAMANDER
#include "..\..\DiskMap\Resources\DiskMap.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Menus

IDC_ZAREVAKDISKMAP MENU 
BEGIN
    POPUP "&Fichier"
    BEGIN
        MENUITEM "&Ouvrir le fichier",                       IDM_FILE_OPEN
        MENUITEM "&Cibler dans le panneau\tF",        IDM_FILE_FOCUSINSALAMANDER
        MENUITEM SEPARATOR
        MENUITEM "&Annuler\tEchap",                      IDM_FILE_ABORT
        MENUITEM "&Rafraîchir\tCtrl+R",            IDM_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Fermer\tAlt+F4",                      IDM_FILE_EXIT
    END
    POPUP "&Visualiser"
    BEGIN
        MENUITEM "&Zoomer\t+",                 IDM_VIEW_ZOOMIN
        MENUITEM "&Dézoomer\t -",                IDM_VIEW_ZOOMOUT
        MENUITEM "&Vue initiale\t Maj+Retour arrière",   IDM_VIEW_GOTOROOT
        MENUITEM SEPARATOR
        MENUITEM "&Fenêtre de journalisation...\tCtrl+L",              IDM_VIEW_LOG
    END

    POPUP "&Options"
    BEGIN
	MENUITEM "&Surligner les dossiers",          IDM_OPTIONS_SHOWFOLDERS, CHECKED
	MENUITEM "&Afficher l'infobulle\tCtrl+D",    IDM_OPTIONS_SHOWTOOLTIP, CHECKED
        POPUP "&Format du chemin dans l'infobulle"
        BEGIN
            MENUITEM "&Nom de fichier",            IDM_PATHFORMAT_FILENAME
            MENUITEM "&Relatif",            IDM_PATHFORMAT_RELATIVEVIEW
//            MENUITEM "&Relative to Root",  IDM_PATHFORMAT_RELATIVEROOT
            MENUITEM "&Absolu",            IDM_PATHFORMAT_ABSOLUTE
        END
        MENUITEM SEPARATOR
        MENUITEM "&Confirmer la fermeture par Echap",       IDM_OPTIONS_CONSFIRMCLOSE, CHECKED
    END
    POPUP "&Aide"
    BEGIN
//        POPUP "&Debug"
//        BEGIN
//            MENUITEM "&Export Directory Structure...", IDM_DEBUG_EXPORTDIR
//        END
//        MENUITEM SEPARATOR
        MENUITEM "&A propos...",                  IDM_HELP_ABOUT
    END
END

