// Hungarian (hu-HU) resources for diskmap. Translation: Török József.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/diskmap/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#define SALAMANDER
#include "..\..\DiskMap\Resources\DiskMap.rh2"

LANGUAGE LANG_HUNGARIAN, SUBLANG_HUNGARIAN_HUNGARY

/////////////////////////////////////////////////////////////////////////////
// Menus

IDC_ZAREVAKDISKMAP MENU 
BEGIN
    POPUP "&Fájl"
    BEGIN
        MENUITEM "&Fájl megnyitása",                       IDM_FILE_OPEN
        MENUITEM "&Kikeresés a panelen\tF",        IDM_FILE_FOCUSINSALAMANDER
        MENUITEM SEPARATOR
        MENUITEM "Megsz&akítás\tEsc",                      IDM_FILE_ABORT
        MENUITEM "F&rissítés\tCtrl+R",            IDM_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Bezárás\tAlt+F4",                      IDM_FILE_EXIT
    END
    POPUP "&Nézet"
    BEGIN
        MENUITEM "&Nagyítás\t+",                 IDM_VIEW_ZOOMIN
        MENUITEM "&Kicsinyítés\t -",                IDM_VIEW_ZOOMOUT
        MENUITEM "&Alaphelyzet\t Shift+Backspace",   IDM_VIEW_GOTOROOT
        MENUITEM SEPARATOR
        MENUITEM "Nap&lózási ablak...\tCtrl+L",              IDM_VIEW_LOG
    END

    POPUP "Beállítás&ok"
    BEGIN
	MENUITEM "&Mappák kiemelése",          IDM_OPTIONS_SHOWFOLDERS, CHECKED
	MENUITEM "Esz&köztipp mutatása\tCtrl+D",    IDM_OPTIONS_SHOWTOOLTIP, CHECKED
        POPUP "Eszköztipp &elérési útja"
        BEGIN
            MENUITEM "&Fájlnév",            IDM_PATHFORMAT_FILENAME
            MENUITEM "&Relatív",            IDM_PATHFORMAT_RELATIVEVIEW
//            MENUITEM "&Relative to Root",  IDM_PATHFORMAT_RELATIVEROOT
            MENUITEM "&Abszolút",            IDM_PATHFORMAT_ABSOLUTE
        END
        MENUITEM SEPARATOR
        MENUITEM "ES&C gombos bezárás megerősítése",       IDM_OPTIONS_CONSFIRMCLOSE, CHECKED
    END
    POPUP "&Súgó"
    BEGIN
//        POPUP "&Debug"
//        BEGIN
//            MENUITEM "&Export Directory Structure...", IDM_DEBUG_EXPORTDIR
//        END
//        MENUITEM SEPARATOR
        MENUITEM "&Névjegy...",                  IDM_HELP_ABOUT
    END
END

