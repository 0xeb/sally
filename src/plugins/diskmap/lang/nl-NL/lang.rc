// Dutch (nl-NL) resources for diskmap. Translation: Cor van der Smissen, Marco Fung, Patrick Vijgeboom, S.V. (Stephan) Rietveld.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/diskmap/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#define SALAMANDER
#include "..\..\DiskMap\Resources\DiskMap.rh2"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH

/////////////////////////////////////////////////////////////////////////////
// Menus

IDC_ZAREVAKDISKMAP MENU 
BEGIN
    POPUP "&Bestand"
    BEGIN
        MENUITEM "Bestand &openen",                       IDM_FILE_OPEN
        MENUITEM "&Selectie in paneel\tF",        IDM_FILE_FOCUSINSALAMANDER
        MENUITEM SEPARATOR
        MENUITEM "S&toppen\tEsc",                      IDM_FILE_ABORT
        MENUITEM "Ve&rnieuwen\tCtrl+R",            IDM_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Afsluiten\tAlt+F4",                      IDM_FILE_EXIT
    END
    POPUP "Beel&d"
    BEGIN
        MENUITEM "&Inzoomen\t+",                 IDM_VIEW_ZOOMIN
        MENUITEM "&Uitzooment\t -",                IDM_VIEW_ZOOMOUT
        MENUITEM "Un&zoom\t Shift+Backspace",   IDM_VIEW_GOTOROOT
        MENUITEM SEPARATOR
        MENUITEM "&Log venster...\tCtrl+L",              IDM_VIEW_LOG
    END

    POPUP "&Opties"
    BEGIN
	MENUITEM "&Markeer mappen",          IDM_OPTIONS_SHOWFOLDERS, CHECKED
	MENUITEM "&Toon tooltip\tCtrl+D",    IDM_OPTIONS_SHOWTOOLTIP, CHECKED
        POPUP "Tooltip pad &formaat"
        BEGIN
            MENUITEM "&Bestandsnaam",            IDM_PATHFORMAT_FILENAME
            MENUITEM "&Relatief",            IDM_PATHFORMAT_RELATIVEVIEW
//            MENUITEM "&Relative to Root",  IDM_PATHFORMAT_RELATIVEROOT
            MENUITEM "&Absoluut",            IDM_PATHFORMAT_ABSOLUTE
        END
        MENUITEM SEPARATOR
        MENUITEM "Bevestig sluiten met &Esc",       IDM_OPTIONS_CONSFIRMCLOSE, CHECKED
    END
    POPUP "&Help"
    BEGIN
//        POPUP "&Debug"
//        BEGIN
//            MENUITEM "&Export Directory Structure...", IDM_DEBUG_EXPORTDIR
//        END
//        MENUITEM SEPARATOR
        MENUITEM "&Over...",                  IDM_HELP_ABOUT
    END
END

