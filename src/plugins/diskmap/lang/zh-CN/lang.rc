// Chinese (Simplified) (zh-CN) resources for diskmap. Translation: Michael Lu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/diskmap/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#define SALAMANDER
#include "..\..\DiskMap\Resources\DiskMap.rh2"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// Menus

IDC_ZAREVAKDISKMAP MENU 
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "打开文件(&O)",                       IDM_FILE_OPEN
        MENUITEM "在面板中获得焦点(&F)\tF",        IDM_FILE_FOCUSINSALAMANDER
        MENUITEM SEPARATOR
        MENUITEM "关于(&A)\tEsc",                      IDM_FILE_ABORT
        MENUITEM "刷新(&R)\tCtrl+R",            IDM_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "关闭(&C)\tAlt+F4",                      IDM_FILE_EXIT
    END
    POPUP "查看(&V)"
    BEGIN
        MENUITEM "放大(&I)\t+",                 IDM_VIEW_ZOOMIN
        MENUITEM "缩小(&O)\t -",                IDM_VIEW_ZOOMOUT
        MENUITEM "取消缩放(&U)\t Shift+Backspace",   IDM_VIEW_GOTOROOT
        MENUITEM SEPARATOR
        MENUITEM "日志窗口(&L)...\tCtrl+L",              IDM_VIEW_LOG
    END

    POPUP "选项(&O)"
    BEGIN
	MENUITEM "高亮文件夹(&H)",          IDM_OPTIONS_SHOWFOLDERS, CHECKED
	MENUITEM "显示工具提示(&D)\tCtrl+D",    IDM_OPTIONS_SHOWTOOLTIP, CHECKED
        POPUP "工具提示路径格式(&F)"
        BEGIN
            MENUITEM "文件名(&F)",            IDM_PATHFORMAT_FILENAME
            MENUITEM "相对的(&R)",            IDM_PATHFORMAT_RELATIVEVIEW
//            MENUITEM "&Relative to Root",  IDM_PATHFORMAT_RELATIVEROOT
            MENUITEM "绝对的(&A)",            IDM_PATHFORMAT_ABSOLUTE
        END
        MENUITEM SEPARATOR
        MENUITEM "按 ESC 时确认退出(&C)",       IDM_OPTIONS_CONSFIRMCLOSE, CHECKED
    END
    POPUP "帮助(&H)"
    BEGIN
//        POPUP "&Debug"
//        BEGIN
//            MENUITEM "&Export Directory Structure...", IDM_DEBUG_EXPORTDIR
//        END
//        MENUITEM SEPARATOR
        MENUITEM "关于(&A)...",                  IDM_HELP_ABOUT
    END
END

