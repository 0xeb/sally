// German (de-DE) resources for diskmap. Translation: Dirk Bornhütter, Thomas Kelso, Thomas Pagels, Thomas Wölk, Marko Meister und Mick Weiss.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/diskmap/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#define SALAMANDER
#include "..\..\DiskMap\Resources\DiskMap.rh2"

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

/////////////////////////////////////////////////////////////////////////////
// Menus

IDC_ZAREVAKDISKMAP MENU 
BEGIN
    POPUP "&Datei"
    BEGIN
        MENUITEM "&Datei öffnen",                       IDM_FILE_OPEN
        MENUITEM "&Fokus im Dateifenster\tF",        IDM_FILE_FOCUSINSALAMANDER
        MENUITEM SEPARATOR
        MENUITEM "&Abbrechen\tEsc",                      IDM_FILE_ABORT
        MENUITEM "Aktualisie&ren\tStrg+R",            IDM_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Beenden\tAlt+F4",                      IDM_FILE_EXIT
    END
    POPUP "&Ansicht"
    BEGIN
        MENUITEM "&Vergrößern\t+",                 IDM_VIEW_ZOOMIN
        MENUITEM "Ver&kleinern\t -",                IDM_VIEW_ZOOMOUT
        MENUITEM "&Originalgröße\t Umschalt+Rücktaste",   IDM_VIEW_GOTOROOT
        MENUITEM SEPARATOR
        MENUITEM "&Protokollfenster...\tStrg+L",              IDM_VIEW_LOG
    END

    POPUP "&Optionen"
    BEGIN
	MENUITEM "&Verzeichnisse hervorheben",          IDM_OPTIONS_SHOWFOLDERS, CHECKED
	MENUITEM "&QuickInfo anzeigen\tStrg+D",    IDM_OPTIONS_SHOWTOOLTIP, CHECKED
        POPUP "QuickInfo Pfad&format"
        BEGIN
            MENUITEM "&Dateiname",            IDM_PATHFORMAT_FILENAME
            MENUITEM "&Relativer Pfad",            IDM_PATHFORMAT_RELATIVEVIEW
//            MENUITEM "&Relative to Root",  IDM_PATHFORMAT_RELATIVEROOT
            MENUITEM "&Absoluter Pfad",            IDM_PATHFORMAT_ABSOLUTE
        END
        MENUITEM SEPARATOR
        MENUITEM "&Bestätigung beim Beenden mit ESC-Taste",       IDM_OPTIONS_CONSFIRMCLOSE, CHECKED
    END
    POPUP "&Hilfe"
    BEGIN
//        POPUP "&Debug"
//        BEGIN
//            MENUITEM "&Export Directory Structure...", IDM_DEBUG_EXPORTDIR
//        END
//        MENUITEM SEPARATOR
        MENUITEM "&Über...",                  IDM_HELP_ABOUT
    END
END

