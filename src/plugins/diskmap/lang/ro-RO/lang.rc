//
// Romanian (ro-RO) resources for diskmap. Translation: Ioan Stefancu, Donca Radu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/diskmap/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#define SALAMANDER
#include "..\..\DiskMap\Resources\DiskMap.rh2"

LANGUAGE LANG_ROMANIAN, SUBLANG_ROMANIAN_ROMANIA

/////////////////////////////////////////////////////////////////////////////
// Menus

IDC_ZAREVAKDISKMAP MENU 
BEGIN
    POPUP "&Fisier"
    BEGIN
        MENUITEM "&Deschid fisier",                       IDM_FILE_OPEN
        MENUITEM "&Focus in Panou\tF",        IDM_FILE_FOCUSINSALAMANDER
        MENUITEM SEPARATOR
        MENUITEM "Re&nunt\tEsc",                      IDM_FILE_ABORT
        MENUITEM "Rei&mprospatare\tCtrl+R",            IDM_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Inchid\tAlt+F4",                      IDM_FILE_EXIT
    END
    POPUP "&Vizualizare"
    BEGIN
        MENUITEM "Zoom &In\t+",                 IDM_VIEW_ZOOMIN
        MENUITEM "Zoom &Out\t -",                IDM_VIEW_ZOOMOUT
        MENUITEM "&Unzoom\t Shift+Backspace",   IDM_VIEW_GOTOROOT
        MENUITEM SEPARATOR
        MENUITEM "&Log Fereastra...\tCtrl+L",              IDM_VIEW_LOG
    END

    POPUP "&Optiuni"
    BEGIN
	MENUITEM "&Directoare iesite in evidenta",          IDM_OPTIONS_SHOWFOLDERS, CHECKED
	MENUITEM "&Afiseaza Tooltip\tCtrl+D",    IDM_OPTIONS_SHOWTOOLTIP, CHECKED
        POPUP "Tooltip Cale &Format"
        BEGIN
            MENUITEM "&Nume fisier",            IDM_PATHFORMAT_FILENAME
            MENUITEM "&Relativ",            IDM_PATHFORMAT_RELATIVEVIEW
//            MENUITEM "&Relative to Root",  IDM_PATHFORMAT_RELATIVEROOT
            MENUITEM "&Absolut",            IDM_PATHFORMAT_ABSOLUTE
        END
        MENUITEM SEPARATOR
        MENUITEM "&Confirm Inchid la Esc",       IDM_OPTIONS_CONSFIRMCLOSE, CHECKED
    END
    POPUP "&Help"
    BEGIN
//        POPUP "&Debug"
//        BEGIN
//            MENUITEM "&Export Directory Structure...", IDM_DEBUG_EXPORTDIR
//        END
//        MENUITEM SEPARATOR
        MENUITEM "&Despre...",                  IDM_HELP_ABOUT
    END
END

