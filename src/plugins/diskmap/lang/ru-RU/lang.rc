// Russian (ru-RU) resources for diskmap. Translation: Ален Хайруллин, Vasiliy, Игорь Полякофф, Neutron16.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/diskmap/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#define SALAMANDER
#include "..\..\DiskMap\Resources\DiskMap.rh2"

LANGUAGE LANG_RUSSIAN, SUBLANG_RUSSIAN_RUSSIA

/////////////////////////////////////////////////////////////////////////////
// Menus

IDC_ZAREVAKDISKMAP MENU 
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "&Открыть файл",                       IDM_FILE_OPEN
        MENUITEM "&Показать на панели\tF",        IDM_FILE_FOCUSINSALAMANDER
        MENUITEM SEPARATOR
        MENUITEM "О&тмена\tEsc",                      IDM_FILE_ABORT
        MENUITEM "О&бновить\tCtrl+R",            IDM_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Закрыть\tAlt+F4",                      IDM_FILE_EXIT
    END
    POPUP "&Вид"
    BEGIN
        MENUITEM "У&величить \t+",                 IDM_VIEW_ZOOMIN
        MENUITEM "У&меньшить\t -",                IDM_VIEW_ZOOMOUT
        MENUITEM "&Нормальный\t Shift+Backspace",   IDM_VIEW_GOTOROOT
        MENUITEM SEPARATOR
        MENUITEM "&Журнал...\tCtrl+L",              IDM_VIEW_LOG
    END

    POPUP "&Параметры"
    BEGIN
	MENUITEM "&Выделять папки",          IDM_OPTIONS_SHOWFOLDERS, CHECKED
	MENUITEM "П&оказывать подсказку\tCtrl+D",    IDM_OPTIONS_SHOWTOOLTIP, CHECKED
        POPUP "&Формат пути в подсказке"
        BEGIN
            MENUITEM "&Имя файла",            IDM_PATHFORMAT_FILENAME
            MENUITEM "&Относительный",            IDM_PATHFORMAT_RELATIVEVIEW
//            MENUITEM "&Relative to Root",  IDM_PATHFORMAT_RELATIVEROOT
            MENUITEM "&Абсолютный",            IDM_PATHFORMAT_ABSOLUTE
        END
        MENUITEM SEPARATOR
        MENUITEM "&Подтверждение при выходе по Esc",       IDM_OPTIONS_CONSFIRMCLOSE, CHECKED
    END
    POPUP "&Справка"
    BEGIN
//        POPUP "&Debug"
//        BEGIN
//            MENUITEM "&Export Directory Structure...", IDM_DEBUG_EXPORTDIR
//        END
//        MENUITEM SEPARATOR
        MENUITEM "&О модуле...",                  IDM_HELP_ABOUT
    END
END

