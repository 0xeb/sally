    IDS_DISKMAP_LOG_TITLE,           "Registro"
    IDS_DISKMAP_LOG_HTYPE,           "Tipo"
    IDS_DISKMAP_LOG_HTEXT,           "Texto"
    IDS_DISKMAP_LOG_HFILE,           "Fichero o directorio"
    IDS_DISKMAP_LOG_LINFO,           "Información"
    IDS_DISKMAP_LOG_LWARN,           "Aviso"
    IDS_DISKMAP_LOG_LERROR,          "Error"

    IDS_DISKMAP_SHELL_FOCUS,         "&Enfocar en el panel"
    IDS_DISKMAP_SHELL_ZOOMIN,        "&Agrandar"
    IDS_DISKMAP_SHELL_ZOOMOUT,       "&Disminuir"
    IDS_DISKMAP_SHELL_DIROPEN,       "A&brir en el panel"
    IDS_DISKMAP_SHELL_DIRCHANGE,     "Cambiar &directorio"

    IDS_DISKMAP_TTIP_TIMECREATE,     "Creado:"
    IDS_DISKMAP_TTIP_TIMEMODIFY,     "Modificado:"
    IDS_DISKMAP_TTIP_TIMEACCESS,     "Accedido:"
    IDS_DISKMAP_TTIP_SIZEDATA,       "Tamaño de datos:"
    IDS_DISKMAP_TTIP_SIZEREAL,       "Tamaño real:"
