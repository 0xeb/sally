// Spanish (es-ES) resources for diskmap. Translation: Juan Pablo Barrio Lera.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/diskmap/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#define SALAMANDER
#include "..\..\DiskMap\Resources\DiskMap.rh2"

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN

/////////////////////////////////////////////////////////////////////////////
// Menus

IDC_ZAREVAKDISKMAP MENU 
BEGIN
    POPUP "&Fichero"
    BEGIN
        MENUITEM "Abrir &fichero",                       IDM_FILE_OPEN
        MENUITEM "&Enfocar en el panel\tF",        IDM_FILE_FOCUSINSALAMANDER
        MENUITEM SEPARATOR
        MENUITEM "&Anular\tEsc",                      IDM_FILE_ABORT
        MENUITEM "&Regenerar\tCtrl+R",            IDM_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Cerrar\tAlt+F4",                      IDM_FILE_EXIT
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Agrandar\t+",                 IDM_VIEW_ZOOMIN
        MENUITEM "&Disminuir\t -",                IDM_VIEW_ZOOMOUT
        MENUITEM "&Tamaño visible normal\t Mays+Retroceso",   IDM_VIEW_GOTOROOT
        MENUITEM SEPARATOR
        MENUITEM "&Ventana de registro...\tCtrl+L",              IDM_VIEW_LOG
    END

    POPUP "&Opciones"
    BEGIN
	MENUITEM "&Resaltar carpetas",          IDM_OPTIONS_SHOWFOLDERS, CHECKED
	MENUITEM "&Mostrar texto de ayuda\tCtrl+D",    IDM_OPTIONS_SHOWTOOLTIP, CHECKED
        POPUP "&Formato del texto de ayuda"
        BEGIN
            MENUITEM "&Nombre de fichero",            IDM_PATHFORMAT_FILENAME
            MENUITEM "&Relativo",            IDM_PATHFORMAT_RELATIVEVIEW
//            MENUITEM "&Relative to Root",  IDM_PATHFORMAT_RELATIVEROOT
            MENUITEM "&Absoluto",            IDM_PATHFORMAT_ABSOLUTE
        END
        MENUITEM SEPARATOR
        MENUITEM "&Confirmar Cerrar con Esc",       IDM_OPTIONS_CONSFIRMCLOSE, CHECKED
    END
    POPUP "&Ayuda"
    BEGIN
//        POPUP "&Debug"
//        BEGIN
//            MENUITEM "&Export Directory Structure...", IDM_DEBUG_EXPORTDIR
//        END
//        MENUITEM SEPARATOR
        MENUITEM "&Acerca de...",                  IDM_HELP_ABOUT
    END
END

