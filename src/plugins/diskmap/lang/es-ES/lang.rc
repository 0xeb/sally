    IDS_PLUGIN_MENU,            "Mostrar &Mapa del disco"
    IDS_CLOSE_CONFIRMATION,     "¿Desea cerrar el Mapa del disco?"
    IDS_CLOSE_CONFIRMATION_CHECKBOX, "No mostrar este mensaje de nuevo y cerrar Mapa del disco sin preguntar"

    IDS_DISKMAP_TITLE,               "Mapa del disco"
    IDS_DISKMAP_TITLEPREFIX,         "Mapa del disco - "

    IDS_DISKMAP_LOAD_TITLE,          "Buscando ficheros..."
    IDS_DISKMAP_LOAD_FOOTER,         "...pulse ESC para anular"
