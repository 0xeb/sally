// French (fr-FR) resources for uniso. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/uniso/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\uniso.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIGURATION DIALOGEX 22, 38, 305, 83
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration de UnISO"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "&Supprimer l'attribut Lecture seule lorsqu'une copie est réalisée à partir de l'archive",IDC_CFG_READONLY,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,8,11,288,10
    CONTROL         "&Afficher une session en tant que dossier (permet d'accéder à toutes les sessions)",IDC_CFG_SESSIONASDIR,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,23,283,10
    CONTROL         "A&fficher l'image disque de démarrage en tant que fichier",IDC_CFG_BOOTIMAGEASFILE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,35,203,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,2,58,301,1
    DEFPUSHBUTTON   "OK",IDOK,193,64,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,248,64,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE DISCARDABLE
{
    IDS_PLUGINNAME              "UnISO"
    IDS_CANT_OPEN               "Impossible d'ouvrir le fichier."
    IDS_UNKNOW_ERROR            "Erreur non spécifiée."
    IDS_UNPACKING_ARCHIVE       "Décompression de l'archive ISO"
    IDS_ERROR_UNPACKING         "Erreur lors de la décompression de l'archive."
    IDS_CANT_HANDLE_FILE        "Impossible de prendre en charge ce fichier."
    IDS_INSUFFICIENT_MEMORY     "Mémoire insuffisante."
    IDS_ERR_TOO_LONG_NAME       "Impossible de terminer l'opération en raison d'un nom de fichier trop long."
    IDS_ABOUT                   "A propos du module"
    IDS_PLUGIN_DESCRIPTION      "Parcourir et extraire le contenu d'images CD/DVD au format ISO."
    IDS_CANT_CREATE_TEMP        "Impossible de créer le dossier temporaire."
    IDS_CANT_DELETE_TEMP_FILE   "Impossible de supprimer le fichier temporaire."
    IDS_UNKNOWN_FILE_FORMAT     "Format de fichier inconnu ou image ISO invalide.\n\nSi vous êtes certain(e) qu'il s'agit d'une image ISO valide, veuillez ouvrir un ticket sur https://github.com/0xeb/sally/issues pour nous aider à prendre en charge ce format."
    IDS_CANT_OPEN_FILE          "Impossible d'ouvrir le fichier '%s'."
    IDS_ERR_TMP                 "La création du fichier temporaire a échoué."
    IDS_CANT_SET_ATTRS          "Impossible de paramétrer les attributs du fichier."
    IDS_CANT_CREATE_DIR         "Impossible de créer le dossier '%s'."
    IDS_YES                     "Oui"
    IDS_NO                      "Non"
    IDS_ERROR                   "Erreur"
    IDS_WARNING                 "Avertissement"
    IDS_ERROR_OPENING_MULTISESSION  "Une ou plusieurs erreur(s) sont survenues lors de la lecture d'une image multisession.\n\nSeules les sessions lues avec succès seront affichées."
    IDS_UNKNOWN_TRACK_TYPE      "Type de piste inconnu."
    IDS_READERROR               "Erreur de lecture"
    IDS_WRITEERROR              "Erreur d'écriture"
    IDS_CCD_BAD_FORMAT          "Mauvais format de fichier .CCD.\n\nL'image affichée pourrait être incomplète."
    IDS_CCD_MISSING             "Le fichier .CCD est manquant.\n\nL'image affichée pourrait être incomplète."
    IDS_ERROR_READING_SECTOR    "Impossible de lire le secteur n°%08X."
    IDS_ERROR_LISTING_IMAGE     "Une erreur est survenue lors de la lecture de la structure du dossier situé sur le secteur n°%08X.\n\nLe contenu de l'image ISO est incomplet."
    IDS_INTERNAL_PLUGIN_ERROR   "Erreur interne au sein du module."
    IDS_UDF_UNKNOWN_ALLOCATION_STRATEGY  "Stratégie d'allocation inconnue (%d).\n\nVeuillez ouvrir un ticket sur https://github.com/0xeb/sally/issues pour nous aider à corriger ce problème."
    IDS_UDF_INVALID_TAG_ID      "Identifiant de Tag UDF invalide."
    IDS_UDF_ERROR_READING_VAT   "Erreur lors de la lecture de la table d'allocation virtuelle sur le secteur n°%08X."
    IDS_UDF_MISSING_VAT         "La table d'allocation virtuelle est manquante."
    IDS_UDF_BAD_ROOT_ICB        "L'ICB (Information Control Block) racine est endommagé.\n\nImpossible de lire la structure de dossiers."
    IDS_UDF_ICB_AND_FILESIZE_MISMATCH "Le fichier ""%s"" ne peut pas être extrait.\n\nIl y a un conflit entre la taille du fichier et les blocs ICB."
    IDS_CANT_OPEN_TRACK         "Impossible d'ouvrir la piste n°%d."
    IDS_BOOT_OR_MBR             "Ce fichier semble être une image de disquette, disque dur ou partition de disque dur.\nEssayez de renommer le fichier avec l'extension .ima pour l'ouvrir avec le module UnFAT."
    IDS_UNSUPPORTED_APFS        "Cette image disque contient le système de fichiers APFS.\nCe système de fichiers n'est pas encore pris en charge."

    IDS_ERR_HFS_READ            "Impossible de lire l'entête de la partition. Le fichier est trop petit."
    IDS_ERR_HFS_INVALID_PARTITION "Les structures du Gestionnaire de Partition sont corrompues."
    IDS_ERR_HFS_UNRECOGNIZED    "L'image disque ne contient pas de partition HFS Plus."
    IDS_ERR_HFS_ORIGINAL_HFS    "L'image disque contient un système de fichiers au format HFS et non HFS Plus.\nHFS n'est pas pris en charge."
    IDS_ERR_HFS_SEEK_BLOCK_EXTR "Impossible de se positionner sur le bloc n°%08X.\nLe fichier %s ne sera pas extrait."
    IDS_ERR_HFS_SEEK            "Impossible de se positionner sur le bloc n°%08X."
    IDS_ERR_HFS_BTREE_NODETYPE  "Le type de noeud racine BTree du fichier Catalogue n'est pas pris en charge."
    IDS_ERR_HFS_BTREE_FRAGMENTED "Le fichier Catalogue est fragmenté en plus de 8 fragments, ce qui n'est pas pris en charge."
    IDS_ERR_HFS_FILE_FRAGMENTED "Le fichier '%s' est fragmenté en plus de 8 fragments, ce qui n'est pas pris en charge.\nLe fichier ne sera pas extrait."

    IDS_ERR_TOO_LONG_PATH       "L'image disque contient un nom de chemin trop long, qu'Sally ne peut pas prendre en charge."

    IDS_ERR_DMG_READ_HDR        "Impossible de lire l'entête du paquet. Le fichier est trop petit."
    IDS_ERR_DMG_ENCRYPTED       "Le paquet est chiffré.\nLes paquets chiffrés ne sont pas pris en charge."
    IDS_ERR_DMG_NO_FOOTER       "Ce fichier ne semble pas être un paquet DMG, ou est incomplet.\nIl ne contient pas de pied valide au format DMG."
    IDS_ERR_DMG_PLIST           "Ce fichier ne semble pas être un paquet DMG, ou est incomplet.\nIl ne contient pas de Liste de Propriétés valide."
    IDS_ERR_DMG_BLOCK_UNDEFINED "Ce paquet ne contient pas de bloc de données de partition HFS Plus démarrant à %I64u.\nLe bloc est requis pour charger correctement le paquet."

    IDS_ERR_BF_READ             "Impossible de lire les données à la position %I64u depuis l'image disque."
    IDS_ERR_BF_SEEK             "Impossible de se positionner au sein de l'image disque à la position %I64u."
    IDS_ERR_BF_UNSUPPORTED_SEEK_METHOD "Erreur interne. Méthode de positionnement non prise en charge."
    IDS_ERR_BF_BLOCK_UNK_TYPE   "L'image disque comporte un bloc compressé avec une méthode inconnue.\nCe type d'images disque n'est pas pris en charge."
    IDS_ERR_BF_ZLIB             "La décompression d'un bloc compressé avec ZLIB a échoué. L'image disque semble corrompue."
    IDS_ERR_BF_BZIP2            "La décompression d'un bloc compressé avec BZIP2 a échoué. L'image disque semble corrompue."

    IDS_ERR_ISZ_NO_HEADER       "Ce fichier ne semble pas être une image ISZ compressée, ou est incomplet.\nIl ne contient pas d'entête ISZ valide."
    IDS_ERR_ISZ_READ_HDR        "Impossible de lire l'entête de l'image compressée. Le fichier est trop petit."
    IDS_ERR_ISZ_SEGMENTED       "L'image est segmentée.\nLes images segmentées ne sont pas prises en charge."
    IDS_ERR_ISZ_ENCRYPTED       "L'image est chiffrée.\nLes images chiffrées ne sont pas prises en charge."

    IDS_AUDIO_NOT_EXTRACTABLE   "Les pistes audio ne peuvent pas être extraites."

    IDS_CANCELING_OPERATION     "Annulation de l'opération, veuillez patienter..."

    IDS_INFO_LABEL              "Informations sur l'image\n\n"
    IDS_INFO_LABEL_LABEL        "Informations sur l'image ""%s""\n\n"
    IDS_INFO_CNT_SESSIONS       "Nombre de sessions : %d"
    IDS_INFO_SESSION_NUM        "\nSession %d\n"
    IDS_INFO_CNT_TRACKS         "  Nombre de pistes : %d\n"
    IDS_INFO_TRACK_TYPE_SIZE    "  Piste : %d, %s, Taille : %d Ko\n"
    IDS_INFO_TRACK_TYPE_SIZE_LABEL "  Piste : %d, %s, Taille : %d Ko - ""%s""\n"
}
