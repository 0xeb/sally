/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_MENU MENU 
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "比较...\tCtrl+O",          CM_COMPARE
        MENUITEM "重新比较\tCtrl+R",           CM_RECOMPARE
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)\tAlt+F4",               CM_EXIT
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "复制\tCtrl+C",                CM_COPY
    END
    POPUP "查看(&V)"
    BEGIN
        MENUITEM "显示空白(&W)\tCtrl+W",   CM_SHOWWHITESPACE
        MENUITEM "只显示差异(&D)\tCtrl+D", CM_ONLYDIFFERENCES
        MENUITEM "详细差异(&E)\tF4",   CM_DETAILDIFF
        MENUITEM SEPARATOR
        MENUITEM "第一个差异(&F)\tAlt+Home", CM_FIRSTDIFF
        MENUITEM "上一个差异(&P)\tAlt+上箭头", CM_PREVDIFF
        MENUITEM "下一个差异(&N)\tAlt+下箭头", CM_NEXTDIFF
        MENUITEM "最后一个差异(&L)\tAlt+End",   CM_LASTDIFF
        MENUITEM SEPARATOR
        MENUITEM "显示插入符(&S)\tF2",             CM_SHOWCARET
        MENUITEM SEPARATOR
        MENUITEM "最大化左边文件视图(&V)\tCtrl+,", CM_MAXLEFTVIEW
        MENUITEM "最大化右边文件视图(&G)\tCtrl+.", CM_MAXRIGHTVIEW
        MENUITEM "平均文件视图(&Z)\tCtrl+E", CM_SAMESIZEVIEW
        MENUITEM "切换全屏(&T)\tF11",    CM_MAXIMIZE
        MENUITEM "水平视图(&H)\tCtrl+H",    CM_VIEW_HORIZONTAL
    END
    POPUP "选项(&O)"
    BEGIN
        MENUITEM "自动复制选择到剪贴板(&A)", CM_AUTOCOPY
        MENUITEM SEPARATOR
        MENUITEM "配置(&C)...",           CM_OPTIONS
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "内容(&C)\tF1",               CM_HELP
        MENUITEM "键盘快捷键(&K)",         CM_HELPKEYBOARD
        MENUITEM SEPARATOR
        MENUITEM "关于(&A)",                      CM_ABOUT
    END
END

IDM_CTX_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "选择全部(&A)",                 CM_SELECTALL
        MENUITEM "复制(&C)",                       CM_COPY
    END
END

IDM_CTX_1COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "自定义颜色...",             CM_CUSTOMBACKGROUND
        MENUITEM "自动颜色",             CM_AUTOBACKGROUND
    END
END

IDM_CTX_2COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "自定义文本颜色...",     CM_CUSTOMTEXT
        MENUITEM "自动文本颜色",     CM_AUTOTEXT
        MENUITEM SEPARATOR
        MENUITEM "自定义背景色...", CM_CUSTOMBACKGROUND
        MENUITEM "自动背景色", CM_AUTOBACKGROUND
    END
END

IDM_CTX_FONT_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "自定义字体...",              CM_CUSTOMFONT
        MENUITEM "自动字体",              CM_AUTOFONT
    END
END

