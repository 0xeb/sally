/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_MENU MENU 
BEGIN
    POPUP "&Fichier"
    BEGIN
        MENUITEM "Comparer...\tCtrl+O",          CM_COMPARE
        MENUITEM "Recomparer\tCtrl+R",           CM_RECOMPARE
        MENUITEM SEPARATOR
        MENUITEM "&Quitter\tAlt+F4",               CM_EXIT
    END
    POPUP "&Editer"
    BEGIN
        MENUITEM "Copier\tCtrl+C",                CM_COPY
    END
    POPUP "&Visualiser"
    BEGIN
        MENUITEM "Montrer les espaces &vides\tCtrl+W",   CM_SHOWWHITESPACE
        MENUITEM "M&ontrer seulement les différences\tCtrl+D", CM_ONLYDIFFERENCES
        MENUITEM "&Différences détaillées\tF4",   CM_DETAILDIFF
        MENUITEM SEPARATOR
        MENUITEM "&Première différence\tAlt+Home", CM_FIRSTDIFF
        MENUITEM "Di&fférence précédente\tAlt+Flèche Haut", CM_PREVDIFF
        MENUITEM "Différence &suivante\tAlt+Flèche Bas", CM_NEXTDIFF
        MENUITEM "D&ernière différence\tAlt+Fin",   CM_LASTDIFF
        MENUITEM SEPARATOR
        MENUITEM "&Montrer le caret\tF2",             CM_SHOWCARET
        MENUITEM SEPARATOR
        MENUITEM "Maximiser la vue du fichier de &gauche\tCtrl+,", CM_MAXLEFTVIEW
        MENUITEM "M&aximiser la vue du fichier droit\tCtrl+.", CM_MAXRIGHTVIEW
        MENUITEM "Volets de v&ue de fichiers égaux\tCtrl+E", CM_SAMESIZEVIEW
        MENUITEM "&Basculer en plein écran\tF11",    CM_MAXIMIZE
        MENUITEM "Vue &horizontale\tCtrl+H",    CM_VIEW_HORIZONTAL
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "C&opie auto de la sélection dans le presse-papiers", CM_AUTOCOPY
        MENUITEM SEPARATOR
        MENUITEM "&Configuration...",           CM_OPTIONS
    END
    POPUP "&Aide"
    BEGIN
        MENUITEM "&Table des matières\tF1",               CM_HELP
        MENUITEM "&Raccourcis clavier",         CM_HELPKEYBOARD
        MENUITEM SEPARATOR
        MENUITEM "&A propos",                      CM_ABOUT
    END
END

IDM_CTX_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Tout sélectionner",                 CM_SELECTALL
        MENUITEM "&Copier",                       CM_COPY
    END
END

IDM_CTX_1COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Couleur personnalisée...",             CM_CUSTOMBACKGROUND
        MENUITEM "Couleur automatique",             CM_AUTOBACKGROUND
    END
END

IDM_CTX_2COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Couleur personnalisée du texte...",     CM_CUSTOMTEXT
        MENUITEM "Couleur automatique du texte",     CM_AUTOTEXT
        MENUITEM SEPARATOR
        MENUITEM "Couleur personnalisée du fond...", CM_CUSTOMBACKGROUND
        MENUITEM "Couleur automatique du fond", CM_AUTOBACKGROUND
    END
END

IDM_CTX_FONT_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Police personnalisée...",              CM_CUSTOMFONT
        MENUITEM "Police automatique",              CM_AUTOFONT
    END
END

