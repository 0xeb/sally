/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_MENU MENU 
BEGIN
    POPUP "&Fichero"
    BEGIN
        MENUITEM "Comparar...\tCtrl+O",          CM_COMPARE
        MENUITEM "Recomparar\tCtrl+R",           CM_RECOMPARE
        MENUITEM SEPARATOR
        MENUITEM "&Salir\tAlt+F4",               CM_EXIT
    END
    POPUP "&Editar"
    BEGIN
        MENUITEM "Copiar\tCtrl+C",                CM_COPY
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "Ver &espacio en blanco\tCtrl+W",   CM_SHOWWHITESPACE
        MENUITEM "Sólo ver &diferencias\tCtrl+D", CM_ONLYDIFFERENCES
        MENUITEM "D&iferencias detalladas\tF4",   CM_DETAILDIFF
        MENUITEM SEPARATOR
        MENUITEM "&Primera diferencia\tAlt+Inicio", CM_FIRSTDIFF
        MENUITEM "Diferencia &anterior\tAlt+Flecha arriba", CM_PREVDIFF
        MENUITEM "Diferencia &siguiente\tAlt+Flecha abajo", CM_NEXTDIFF
        MENUITEM "&Ultima diferencia\tAlt+Fin",   CM_LASTDIFF
        MENUITEM SEPARATOR
        MENUITEM "&Ver circunflejo\tF2",             CM_SHOWCARET
        MENUITEM SEPARATOR
        MENUITEM "Maximizar vista &fichero izquierdo\tCtrl+,", CM_MAXLEFTVIEW
        MENUITEM "Maximizar vista fichero de&recho\tCtrl+.", CM_MAXRIGHTVIEW
        MENUITEM "&Tamaños iguales de vistas de fichero\tCtrl+E", CM_SAMESIZEVIEW
        MENUITEM "&Conmutar pantalla completa\tF11",    CM_MAXIMIZE
        MENUITEM "Vista &horizontal\tCtrl+H",    CM_VIEW_HORIZONTAL
    END
    POPUP "&Opciones"
    BEGIN
        MENUITEM "&Autocopiado de selección al portapapeles", CM_AUTOCOPY
        MENUITEM SEPARATOR
        MENUITEM "&Configuración...",           CM_OPTIONS
    END
    POPUP "&Ayuda"
    BEGIN
        MENUITEM "&Contenidots\tF1",               CM_HELP
        MENUITEM "Atajos de &teclado",         CM_HELPKEYBOARD
        MENUITEM SEPARATOR
        MENUITEM "&Acerca de",                      CM_ABOUT
    END
END

IDM_CTX_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Seleccionat &todos",                 CM_SELECTALL
        MENUITEM "&Copiar",                       CM_COPY
    END
END

IDM_CTX_1COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Color personalizado...",             CM_CUSTOMBACKGROUND
        MENUITEM "Color automático",             CM_AUTOBACKGROUND
    END
END

IDM_CTX_2COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Color de texto personalizado...",     CM_CUSTOMTEXT
        MENUITEM "Color de texto automático",     CM_AUTOTEXT
        MENUITEM SEPARATOR
        MENUITEM "Color de fondo personalizado...", CM_CUSTOMBACKGROUND
        MENUITEM "Color de fondo automático", CM_AUTOBACKGROUND
    END
END

IDM_CTX_FONT_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Fuente personalizada...",              CM_CUSTOMFONT
        MENUITEM "Fuente automática",              CM_AUTOFONT
    END
END

