/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_MENU MENU 
BEGIN
    POPUP "&Datei"
    BEGIN
        MENUITEM "Vergleichen...\tStrg+O",          CM_COMPARE
        MENUITEM "Erneut vergleichen\tStrg+R",           CM_RECOMPARE
        MENUITEM SEPARATOR
        MENUITEM "&Beenden\tAlt+F4",               CM_EXIT
    END
    POPUP "B&earbeiten"
    BEGIN
        MENUITEM "Kopieren\tStrg+C",                CM_COPY
    END
    POPUP "An&sicht"
    BEGIN
        MENUITEM "&Leerraumzeichen anzeigen\tStrg+W",   CM_SHOWWHITESPACE
        MENUITEM "Nur Unterschie&de anzeigen\tStrg+D", CM_ONLYDIFFERENCES
        MENUITEM "D&etaillierte Unterschiede\tF4",   CM_DETAILDIFF
        MENUITEM SEPARATOR
        MENUITEM "E&rster Unterschied\tAlt+Home", CM_FIRSTDIFF
        MENUITEM "Vor&heriger Unterschied\tAlt+Pfeil hoch", CM_PREVDIFF
        MENUITEM "&Nächster Unterschied\tAlt+Pfeil runter", CM_NEXTDIFF
        MENUITEM "Le&tzter  Unterschied\tAlt+Ende",   CM_LASTDIFF
        MENUITEM SEPARATOR
        MENUITEM "&Zeige Textcursor\tF2",             CM_SHOWCARET
        MENUITEM SEPARATOR
        MENUITEM "Linkes Fenster &maximieren\tStrg+,", CM_MAXLEFTVIEW
        MENUITEM "Re&chtes Fenster maximieren\tStrg+.", CM_MAXRIGHTVIEW
        MENUITEM "Gleiche &Fenstergröße\tStrg+E", CM_SAMESIZEVIEW
        MENUITEM "&Vollbild umschalten\tF11",    CM_MAXIMIZE
        MENUITEM "Horizontale &Anordnung\tStrg+H",    CM_VIEW_HORIZONTAL
    END
    POPUP "&Optionen"
    BEGIN
        MENUITEM "&Auswahl in Zwischenablage kopieren", CM_AUTOCOPY
        MENUITEM SEPARATOR
        MENUITEM "&Konfiguration...",           CM_OPTIONS
    END
    POPUP "&Hilfe"
    BEGIN
        MENUITEM "&Inhalt\tF1",               CM_HELP
        MENUITEM "&Tastaturbelegung",         CM_HELPKEYBOARD
        MENUITEM SEPARATOR
        MENUITEM "Ü&ber",                      CM_ABOUT
    END
END

IDM_CTX_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Alles auswählen",                 CM_SELECTALL
        MENUITEM "&Kopieren",                       CM_COPY
    END
END

IDM_CTX_1COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Benutzerdefinierte Farbe...",             CM_CUSTOMBACKGROUND
        MENUITEM "Automatische Farbe",             CM_AUTOBACKGROUND
    END
END

IDM_CTX_2COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Benutzerdefinierte Farbe des Textes...",     CM_CUSTOMTEXT
        MENUITEM "Automatische Farbe des Textes",     CM_AUTOTEXT
        MENUITEM SEPARATOR
        MENUITEM "Benutzerdefinierte Farbe des Hintergrundes...", CM_CUSTOMBACKGROUND
        MENUITEM "Automatische Farbe des Hintergrundes", CM_AUTOBACKGROUND
    END
END

IDM_CTX_FONT_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Benutzerdefinierte Schrift...",              CM_CUSTOMFONT
        MENUITEM "Automatische Schrift",              CM_AUTOFONT
    END
END

