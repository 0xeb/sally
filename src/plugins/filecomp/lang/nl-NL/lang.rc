/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_MENU MENU 
BEGIN
    POPUP "&Bestand"
    BEGIN
        MENUITEM "Vergelijk...\tCtrl+O",          CM_COMPARE
        MENUITEM "Opnieuw vergelijken\tCtrl+R",           CM_RECOMPARE
        MENUITEM SEPARATOR
        MENUITEM "&Afsluiten\tAlt+F4",               CM_EXIT
    END
    POPUP "Be&werken"
    BEGIN
        MENUITEM "Kopiëren\tCtrl+C",                CM_COPY
    END
    POPUP "B&eeld"
    BEGIN
        MENUITEM "&Witruimte weergeven\tCtrl+W",   CM_SHOWWHITESPACE
        MENUITEM "Alleen ve&rschillen weergeven\tCtrl+D", CM_ONLYDIFFERENCES
        MENUITEM "Gede&taileerde verschillen\tF4",   CM_DETAILDIFF
        MENUITEM SEPARATOR
        MENUITEM "&Eerste verschil\tAlt+Home", CM_FIRSTDIFF
        MENUITEM "Vorige vers&chil\tAlt+Up Arrow", CM_PREVDIFF
        MENUITEM "V&olgende verschil\tAlt+Down Arrow", CM_NEXTDIFF
        MENUITEM "&Laatste verschil\tAlt+End",   CM_LASTDIFF
        MENUITEM SEPARATOR
        MENUITEM "Invoegte&ken weergeven\tF2",             CM_SHOWCARET
        MENUITEM SEPARATOR
        MENUITEM "Maximaliseer linker bestand&sweergave\tCtrl+,", CM_MAXLEFTVIEW
        MENUITEM "Maximaliseer rechter bestandsweer&gave\tCtrl+.", CM_MAXRIGHTVIEW
        MENUITEM "Maak bestandweerga&ve gelijk\tCtrl+E", CM_SAMESIZEVIEW
        MENUITEM "Volledig scherm w&isselen\tF11",    CM_MAXIMIZE
        MENUITEM "&Horizontale weergave\tCtrl+H",    CM_VIEW_HORIZONTAL
    END
    POPUP "&Opties"
    BEGIN
        MENUITEM "Selectie &automatisch naar klembord kopiëren", CM_AUTOCOPY
        MENUITEM SEPARATOR
        MENUITEM "&Configuratie...",           CM_OPTIONS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Inhoud\tF1",               CM_HELP
        MENUITEM "&Toetsenbord sneltoetsen",         CM_HELPKEYBOARD
        MENUITEM SEPARATOR
        MENUITEM "&Over",                      CM_ABOUT
    END
END

IDM_CTX_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Alles selecteren",                 CM_SELECTALL
        MENUITEM "&Kopiëren",                       CM_COPY
    END
END

IDM_CTX_1COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Kleur wijzigen...",             CM_CUSTOMBACKGROUND
        MENUITEM "Automatische kleur",             CM_AUTOBACKGROUND
    END
END

IDM_CTX_2COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Tekstkleur wijzigen...",     CM_CUSTOMTEXT
        MENUITEM "Automatische tekstkleur",     CM_AUTOTEXT
        MENUITEM SEPARATOR
        MENUITEM "Achtergrondkleur wijzigen...", CM_CUSTOMBACKGROUND
        MENUITEM "Automatische achtergrondkleur", CM_AUTOBACKGROUND
    END
END

IDM_CTX_FONT_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Lettertype wijzigen...",              CM_CUSTOMFONT
        MENUITEM "Automatisch lettertype",              CM_AUTOFONT
    END
END

