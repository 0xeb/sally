/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_MENU MENU 
BEGIN
    POPUP "&Файл"
    BEGIN
        MENUITEM "Сравнить...\tCtrl+O",          CM_COMPARE
        MENUITEM "Сравнить заново\tCtrl+R",           CM_RECOMPARE
        MENUITEM SEPARATOR
        MENUITEM "Вы&ход\tAlt+F4",               CM_EXIT
    END
    POPUP "&Правка"
    BEGIN
        MENUITEM "Копировать\tCtrl+C",                CM_COPY
    END
    POPUP "&Вид"
    BEGIN
        MENUITEM "Пок&азывать пробелы\tCtrl+W",   CM_SHOWWHITESPACE
        MENUITEM "Показывать только &различия\tCtrl+D", CM_ONLYDIFFERENCES
        MENUITEM "Показывать различия подро&бно\tF4",   CM_DETAILDIFF
        MENUITEM SEPARATOR
        MENUITEM "Первое ра&зличие\tAlt+Home", CM_FIRSTDIFF
        MENUITEM "Пред&ыдущее различие\tAlt+Стрелка вверх", CM_PREVDIFF
        MENUITEM "&Следующее различие\tAlt+Стрелка вниз", CM_NEXTDIFF
        MENUITEM "Последне&е различие\tAlt+End",   CM_LASTDIFF
        MENUITEM SEPARATOR
        MENUITEM "Показывать &курсор\tF2",             CM_SHOWCARET
        MENUITEM SEPARATOR
        MENUITEM "Максимизировать &левое окно просмотра файла\tCtrl+,", CM_MAXLEFTVIEW
        MENUITEM "Максимизировать &правое окно просмотра файла\tCtrl+.", CM_MAXRIGHTVIEW
        MENUITEM "Срав&нять размеры окон просмотра файлов\tCtrl+E", CM_SAMESIZEVIEW
        MENUITEM "&Во весь экран\tF11",    CM_MAXIMIZE
        MENUITEM "&Горизонтально\tCtrl+H",    CM_VIEW_HORIZONTAL
    END
    POPUP "П&араметры"
    BEGIN
        MENUITEM "&Aвтоматически копировать выделение в буфер", CM_AUTOCOPY
        MENUITEM SEPARATOR
        MENUITEM "&Настройка...",           CM_OPTIONS
    END
    POPUP "&Справка"
    BEGIN
        MENUITEM "&Содержание\tF1",               CM_HELP
        MENUITEM "&Клавиатурные сочетания",         CM_HELPKEYBOARD
        MENUITEM SEPARATOR
        MENUITEM "&О модуле",                      CM_ABOUT
    END
END

IDM_CTX_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Выделить &все",                 CM_SELECTALL
        MENUITEM "&Копировать",                       CM_COPY
    END
END

IDM_CTX_1COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Выбрать цвет...",             CM_CUSTOMBACKGROUND
        MENUITEM "Цвет по умолчанию",             CM_AUTOBACKGROUND
    END
END

IDM_CTX_2COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Выбрать цвет текста...",     CM_CUSTOMTEXT
        MENUITEM "Цвет текста по умолчанию",     CM_AUTOTEXT
        MENUITEM SEPARATOR
        MENUITEM "Выбрать цвет фона...", CM_CUSTOMBACKGROUND
        MENUITEM "Цвет фона  по умолчанию", CM_AUTOBACKGROUND
    END
END

IDM_CTX_FONT_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Выбрать шрифт...",              CM_CUSTOMFONT
        MENUITEM "Шрифт  по умолчанию",              CM_AUTOFONT
    END
END

