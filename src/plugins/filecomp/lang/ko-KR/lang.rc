/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_MENU MENU 
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "비교...\tCtrl+O",          CM_COMPARE
        MENUITEM "다시 비교\tCtrl+R",           CM_RECOMPARE
        MENUITEM SEPARATOR
        MENUITEM "끝내기(&X)\tAlt+F4",               CM_EXIT
    END
    POPUP "편집(&E)"
    BEGIN
        MENUITEM "복사\tCtrl+C",                CM_COPY
    END
    POPUP "보기(&V)"
    BEGIN
        MENUITEM "공백 표시(&W)\tCtrl+W",   CM_SHOWWHITESPACE
          MENUITEM "자동 줄 바꿈(&R)", CM_WORDWRAP
        MENUITEM "차이점만 표시(&D)\tCtrl+D", CM_ONLYDIFFERENCES
        MENUITEM "자세한 차이점(&E)\tF4",   CM_DETAILDIFF
        MENUITEM SEPARATOR
        MENUITEM "첫 번째 차이점(&F)\tAlt+Home", CM_FIRSTDIFF
        MENUITEM "이전 차이점(&P)\tAlt+위쪽 화살표", CM_PREVDIFF
        MENUITEM "다음 차이점(&N)\tAlt+아래쪽 화살표", CM_NEXTDIFF
        MENUITEM "마지막 차이점(&L)\tAlt+End",   CM_LASTDIFF
        MENUITEM SEPARATOR
        MENUITEM "캐럿 표시(&S)\tF2",             CM_SHOWCARET
        MENUITEM SEPARATOR
        MENUITEM "왼쪽 파일 보기 최대화(&V)\tCtrl+,", CM_MAXLEFTVIEW
        MENUITEM "오른쪽 파일 보기 최대화(&G)\tCtrl+.", CM_MAXRIGHTVIEW
        MENUITEM "파일 보기 크기 균등하게(&Z)\tCtrl+E", CM_SAMESIZEVIEW
        MENUITEM "전체 화면 전환(&T)\tF11",    CM_MAXIMIZE
        MENUITEM "가로 보기(&H)\tCtrl+H",    CM_VIEW_HORIZONTAL
    END
    POPUP "옵션(&O)"
    BEGIN
        MENUITEM "선택 영역을 클립보드에 자동 복사(&A)", CM_AUTOCOPY
        MENUITEM SEPARATOR
        MENUITEM "설정(&C)...",           CM_OPTIONS
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "목차(&C)\tF1",               CM_HELP
        MENUITEM "단축키(&K)",         CM_HELPKEYBOARD
        MENUITEM SEPARATOR
        MENUITEM "정보(&A)",                      CM_ABOUT
    END
END

IDM_CTX_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "모두 선택(&A)",                 CM_SELECTALL
        MENUITEM "복사(&C)",                       CM_COPY
    END
END

IDM_CTX_1COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "사용자 지정 색...",             CM_CUSTOMBACKGROUND
        MENUITEM "자동 색",             CM_AUTOBACKGROUND
    END
END

IDM_CTX_2COLOR_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "사용자 지정 텍스트 색...",     CM_CUSTOMTEXT
        MENUITEM "자동 텍스트 색",     CM_AUTOTEXT
        MENUITEM SEPARATOR
        MENUITEM "사용자 지정 배경색...", CM_CUSTOMBACKGROUND
        MENUITEM "자동 배경색", CM_AUTOBACKGROUND
    END
END

IDM_CTX_FONT_MENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "사용자 지정 글꼴...",              CM_CUSTOMFONT
        MENUITEM "자동 글꼴",              CM_AUTOFONT
    END
END

