// French (fr-FR) resources for mmviewer. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/mmviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\mmviewer.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_ABOUT DIALOGEX 87, 50, 387, 132
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "A propos du module"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Fermer",IDCANCEL,329,113,50,14
    ICON            "",IDC_MAIN_ICON,11,9,20,20
    LTEXT           "MMViewer %s - Visualiseur Multimédia pour Sally",IDC_ABOUT_TITLE,46,9,336,8
    LTEXT           "dummy",IDC_ABOUT_COPYRIGHT,46,19,256,8,SS_NOPREFIX
    ICON            "",IDC_DISKEXPLORER_ICON,11,42,20,20
    LTEXT           "MPEG, ID3 Tag version 1 et 2, OGG, WMA, VQF et analyseurs de Tracker",IDC_STATIC_1,46,41,247,8
    LTEXT           "sont sous licence de",IDC_STATIC_2,46,51,70,8
    LTEXT           "Disk Explorer Professional",IDC_ABOUT_DEPRO,116,51,237,8
    LTEXT           "Copyright 2003-2016 par",IDC_STATIC_3,46,67,85,8
    LTEXT           "Tomas Jelinek",IDC_STATIC_4,131,67,79,8
    LTEXT           "Email:",IDC_STATIC_5,46,78,30,8
    LTEXT           "tomas@tjelinek.com",IDC_ABOUT_EMAIL,131,78,141,8,WS_TABSTOP
    LTEXT           "Site web:",IDC_STATIC_6,46,89,49,8
    LTEXT           "www.tjelinek.com",IDC_ABOUT_WWW,131,89,140,8,WS_TABSTOP
    LTEXT           "",IDC_STATIC_7,2,107,378,1,SS_ETCHEDHORZ | WS_GROUP
END

