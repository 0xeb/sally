// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/mmviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\mmviewer.rh2"

LANGUAGE LANG_ROMANIAN, SUBLANG_ROMANIAN_ROMANIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_ABOUT DIALOGEX 87, 50, 395, 132
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Despre Plugin"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Inchide",IDCANCEL,337,113,50,14
    ICON            "",IDC_MAIN_ICON,11,9,20,20
    LTEXT           "MMViewer %s - Vizualizator Multimedia pentru Sally",IDC_ABOUT_TITLE,46,9,344,8
    LTEXT           "dummy",IDC_ABOUT_COPYRIGHT,46,19,177,8,SS_NOPREFIX
    ICON            "",IDC_DISKEXPLORER_ICON,11,42,20,20
    LTEXT           "MPEG, ID3 Tag version 1 and 2, OGG, WMA, VQF and Tracker parsers",IDC_STATIC_1,46,41,238,8
    LTEXT           "cu licenta de la",IDC_STATIC_2,46,51,52,8
    LTEXT           "Disk Explorer Professional",IDC_ABOUT_DEPRO,99,51,200,8
    LTEXT           "Copyright 2003-2016 by",IDC_STATIC_3,46,67,81,8
    LTEXT           "Tomas Jelinek",IDC_STATIC_4,128,67,60,8
    LTEXT           "Email:",IDC_STATIC_5,46,78,30,8
    LTEXT           "tomas@tjelinek.com",IDC_ABOUT_EMAIL,128,78,119,8,WS_TABSTOP
    LTEXT           "Pagina web:",IDC_STATIC_6,46,89,49,8
    LTEXT           "www.tjelinek.com",IDC_ABOUT_WWW,128,89,118,8,WS_TABSTOP
    LTEXT           "",IDC_STATIC_7,2,107,386,1,SS_ETCHEDHORZ | WS_GROUP
END

