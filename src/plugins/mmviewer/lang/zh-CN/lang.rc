// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/mmviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\mmviewer.rh2"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_ABOUT DIALOGEX 87, 50, 334, 132
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于插件"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "关闭",IDCANCEL,276,113,50,14
    ICON            "",IDC_MAIN_ICON,11,9,20,20
    LTEXT           "MMViewer %s - Sally 的多媒体查看器",IDC_ABOUT_TITLE,46,9,283,8
    LTEXT           "dummy",IDC_ABOUT_COPYRIGHT,46,19,177,8,SS_NOPREFIX
    ICON            "",IDC_DISKEXPLORER_ICON,11,42,20,20
    LTEXT           "MPEG, ID3 Tag 版本 1 和 2, OGG, WMA, VQF 和音轨解析器",IDC_STATIC_1,46,41,238,8
    LTEXT           "许可来自",IDC_STATIC_2,46,51,37,8
    LTEXT           "Disk Explorer 专业版",IDC_ABOUT_DEPRO,84,51,200,8
    LTEXT           "版权所有 2003-2016",IDC_STATIC_3,46,67,74,8
    LTEXT           "Tomas Jelinek",IDC_STATIC_4,120,67,60,8
    LTEXT           "Email:",IDC_STATIC_5,46,78,30,8
    LTEXT           "tomas@tjelinek.com",IDC_ABOUT_EMAIL,120,78,119,8,WS_TABSTOP
    LTEXT           "主页:",IDC_STATIC_6,46,89,49,8
    LTEXT           "www.tjelinek.com",IDC_ABOUT_WWW,120,89,118,8,WS_TABSTOP
    LTEXT           "",IDC_STATIC_7,2,107,326,1,SS_ETCHEDHORZ | WS_GROUP
END

