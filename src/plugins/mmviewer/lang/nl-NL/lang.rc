// Dutch (nl-NL) resources for mmviewer. Translation: Cor van der Smissen, Marco Fung, Patrick Vijgeboom, S.V. (Stephan) Rietveld.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/mmviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\mmviewer.rh2"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_ABOUT DIALOGEX 87, 50, 369, 132
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Over plugin"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Sluiten",IDCANCEL,311,113,50,14
    ICON            "",IDC_MAIN_ICON,11,9,20,20
    LTEXT           "MMViewer %s - Multimedia Viewer voor Sally",IDC_ABOUT_TITLE,46,9,318,8
    LTEXT           "dummy",IDC_ABOUT_COPYRIGHT,46,19,177,8,SS_NOPREFIX
    ICON            "",IDC_DISKEXPLORER_ICON,11,42,20,20
    LTEXT           "MPEG, ID3 Tag versie 1 en 2, OGG, WMA, VQF en Tracker parsers",IDC_STATIC_1,46,41,238,8
    LTEXT           "zijn gelicenseerd onder",IDC_STATIC_2,46,51,80,8
    LTEXT           "Disk Explorer Professional",IDC_ABOUT_DEPRO,127,51,200,8
    LTEXT           "Copyright 2003-2016 door",IDC_STATIC_3,46,67,89,8
    LTEXT           "Tomas Jelinek",IDC_STATIC_4,135,67,60,8
    LTEXT           "E-mail:",IDC_STATIC_5,46,78,30,8
    LTEXT           "tomas@tjelinek.com",IDC_ABOUT_EMAIL,135,78,119,8,WS_TABSTOP
    LTEXT           "Webpagina:",IDC_STATIC_6,46,89,49,8
    LTEXT           "www.tjelinek.com",IDC_ABOUT_WWW,135,89,118,8,WS_TABSTOP
    LTEXT           "",IDC_STATIC_7,2,107,360,1,SS_ETCHEDHORZ | WS_GROUP
END

