#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\mmviewer.rh2"

LANGUAGE LANG_HUNGARIAN, SUBLANG_HUNGARIAN_HUNGARY

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_ABOUT DIALOGEX 87, 50, 357, 132
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Plugin névjegy"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Bezárás",IDCANCEL,299,113,50,14
    ICON            "",IDC_MAIN_ICON,11,9,20,20
    LTEXT           "MMViewer %s - Multimédia Néző Sally-hez",IDC_ABOUT_TITLE,46,9,306,8
    LTEXT           "dummy",IDC_ABOUT_COPYRIGHT,46,19,177,8,SS_NOPREFIX
    ICON            "",IDC_DISKEXPLORER_ICON,11,42,20,20
    LTEXT           "MPEG, ID3 Tag verzió 1 és 2, OGG, WMA, VQF és Tracker parsers",IDC_STATIC_1,46,41,233,8
    LTEXT           "are licensed from",IDC_STATIC_2,46,51,60,8
    LTEXT           "Disk Explorer Professional",IDC_ABOUT_DEPRO,107,51,200,8
    LTEXT           "Copyright 2003-2016 by",IDC_STATIC_3,46,67,82,8
    LTEXT           "Tomas Jelinek",IDC_STATIC_4,129,67,60,8
    LTEXT           "Email:",IDC_STATIC_5,46,78,30,8
    LTEXT           "tomas@tjelinek.com",IDC_ABOUT_EMAIL,129,78,119,8,WS_TABSTOP
    LTEXT           "Honlap:",IDC_STATIC_6,46,89,49,8
    LTEXT           "www.tjelinek.com",IDC_ABOUT_WWW,129,89,118,8,WS_TABSTOP
    LTEXT           "",IDC_STATIC_7,2,107,348,1,SS_ETCHEDHORZ | WS_GROUP
END

