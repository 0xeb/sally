// German (de-DE) resources for mmviewer. Translation: Dirk Bornhütter, Thomas Kelso, Thomas Pagels, Thomas Wölk, Marko Meister und Mick Weiss.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/mmviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\mmviewer.rh2"

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_ABOUT DIALOGEX 87, 50, 375, 132
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Über Plugin"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Schließen",IDCANCEL,317,113,50,14
    ICON            "",IDC_MAIN_ICON,11,9,20,20
    LTEXT           "MMViewer %s - Multimedia Betrachter für Sally",IDC_ABOUT_TITLE,46,9,324,8
    LTEXT           "dummy",IDC_ABOUT_COPYRIGHT,46,19,192,8,SS_NOPREFIX
    ICON            "",IDC_DISKEXPLORER_ICON,11,42,20,20
    LTEXT           "MPEG, ID3 Tag Version 1 und 2, OGG, WMA, VQF und Tracker-Parser",IDC_STATIC_1,46,41,248,8
    LTEXT           "sind lizensiert von",IDC_STATIC_2,46,51,62,8
    LTEXT           "Disk Explorer Professional",IDC_ABOUT_DEPRO,109,51,212,8
    LTEXT           "Copyright 2003-2016 von",IDC_STATIC_3,46,67,86,8
    LTEXT           "Tomas Jelinek",IDC_STATIC_4,133,67,60,8
    LTEXT           "E-Mail:",IDC_STATIC_5,46,78,30,8
    LTEXT           "tomas@tjelinek.com",IDC_ABOUT_EMAIL,133,78,119,8,WS_TABSTOP
    LTEXT           "Webseite:",IDC_STATIC_6,46,89,49,8
    LTEXT           "www.tjelinek.com",IDC_ABOUT_WWW,133,89,118,8,WS_TABSTOP
    LTEXT           "",IDC_STATIC_7,2,107,366,1,SS_ETCHEDHORZ | WS_GROUP
END

