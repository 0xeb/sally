// German (de-DE) resources for checkver. Translation: Dirk Bornhütter, Thomas Kelso, Thomas Pagels, Thomas Wölk, Marko Meister und Mick Weiss.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/checkver/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\checkver.rh2"

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_MAIN DIALOGEX 30, 30, 338, 238
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION "Auf neue Versionen prüfen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "&Jetzt prüfen",IDC_MAIN_CHECK,161,220,50,14
    PUSHBUTTON      "&Schließen",IDCANCEL,220,220,50,14
    PUSHBUTTON      "Hilfe",IDHELP,279,220,50,14
    CONTROL         "",IDC_MAIN_LOG,"CheckVerLogWindow",WS_VSCROLL | WS_GROUP,5,5,328,209
    PUSHBUTTON      "&Konfigurieren...",IDC_MAIN_CFG,6,220,60,14,WS_GROUP
    PUSHBUTTON      "&Installieren",IDC_MAIN_INSTALL,70,220,86,14
END

IDD_CONFIGURATION DIALOGEX 15, 39, 357, 144
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Versionsprüfung - Konfiguration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Interneteinstellungen:",IDC_STATIC_1,11,8,330,8
    GROUPBOX        "&Beim Start von Sally die Versionsprüfung aufrufen",IDC_STATIC_2,5,21,347,74,WS_GROUP
    CONTROL         "Niemals",IDC_CFG_NEVER,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,13,32,60,12
    CONTROL         "Jeden Tag",IDC_CFG_DAY,"Button",BS_AUTORADIOBUTTON,107,32,60,12
    CONTROL         "Jede Woche",IDC_CFG_WEEK,"Button",BS_AUTORADIOBUTTON,232,32,60,12
    CONTROL         "Jeden Monat",IDC_CFG_MONTH,"Button",BS_AUTORADIOBUTTON,13,44,60,12
    CONTROL         "Alle drei Monate",IDC_CFG_3MONTHS,"Button",BS_AUTORADIOBUTTON,107,44,104,12
    CONTROL         "Alle sechs Monate",IDC_CFG_6MONTHS,"Button",BS_AUTORADIOBUTTON,232,44,75,12
    CONTROL         "Fenster beim &Öffnen der Versionsprüfung minimieren und automatisch verbinden",IDC_CFG_AUTOCONNECT,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,13,62,325,12
    CONTROL         "Fenster &nach Versionsprüfung schließen, falls keine neue Version gefunden wurde",IDC_CFG_AUTOCLOSE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,74,270,12
    LTEXT           "Hinweis: Dieses Fenster kann vom Sally Menü 'Plugins/Versionsprüfung' aufgerufen werden.",IDC_STATIC_3,13,92,330,8
    LTEXT           "&Filter",IDC_STATIC_4,13,104,330,8
    PUSHBUTTON      "&Standard",IDC_CFG_DEFAULTS,6,123,60,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,183,123,50,14,WS_GROUP
    PUSHBUTTON      "Abbrechen",IDCANCEL,242,123,50,14
    PUSHBUTTON      "Hilfe",IDHELP,301,123,50,14
END

IDD_INTERNET DIALOGEX 50, 20, 258, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Versionsprüfung - Interneteinstellungen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_INTERNET_ICON,8,8,20,20,WS_GROUP
    LTEXT           "Das Versionsprüfungs-Plugin informiert Sie über die neuesten Versionen von Sally und seinen Plugins. Um diese Informationen zu ermitteln ist eine Internetverbindung notwendig.",IDC_STATIC_1,39,7,202,24
    GROUPBOX        "Internetverbindung",IDC_STATIC_2,40,38,211,67,WS_GROUP
    CONTROL         "Verbindung über eine &Telefonleitung und ein Modem",IDC_INET_PHONE,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,51,166,12
    CONTROL         "Verbindung über ein lokales &Netzwerk (LAN)",IDC_INET_LAN,
                    "Button",BS_AUTORADIOBUTTON,47,63,164,12
    CONTROL         "Keine Verbindung zum &Internet",IDC_INET_NONE,"Button",BS_AUTORADIOBUTTON,47,75,183,12
    LTEXT           "(Automatischer Start der Versionsprüfung ausgeschaltet)",IDC_STATIC_3,59,87,188,8
    GROUPBOX        "Internetprotokoll",IDC_STATIC_4,40,109,211,55,WS_GROUP
    CONTROL         "&HTTP (empfohlen)",IDC_INET_HTTP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,121,158,12
    CONTROL         "&FTP",IDC_INET_FTP,"Button",BS_AUTORADIOBUTTON,47,133,158,12
    CONTROL         "FT&P im passiven Transfermodus (hilfreich hinter Firewall)",IDC_INET_FTP_PASSIVE,
                    "Button",BS_AUTORADIOBUTTON,47,145,188,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,3,174,250,1
    DEFPUSHBUTTON   "OK",IDOK,85,181,50,14,WS_GROUP
    PUSHBUTTON      "Abbrechen",IDCANCEL,142,181,50,14
    PUSHBUTTON      "Hilfe",IDHELP,199,181,50,14
END

