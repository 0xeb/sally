// French (fr-FR) resources for checkver. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/checkver/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\checkver.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_MAIN DIALOGEX 30, 30, 338, 238
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION "Vérification de nouvelles versions"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "&Vérifier maintenant",IDC_MAIN_CHECK,161,220,50,14
    PUSHBUTTON      "&Fermer",IDCANCEL,220,220,50,14
    PUSHBUTTON      "Aide",IDHELP,279,220,50,14
    CONTROL         "",IDC_MAIN_LOG,"CheckVerLogWindow",WS_VSCROLL | WS_GROUP,5,5,328,209
    PUSHBUTTON      "&Configurer...",IDC_MAIN_CFG,6,220,60,14,WS_GROUP
END

IDD_CONFIGURATION DIALOGEX 15, 39, 357, 144
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration de la vérification de version"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Réglages de connexion Internet:",IDC_STATIC_1,11,8,330,8
    GROUPBOX        "&Ouvrir la fenêtre de Vérification de nouvelles versions au démarrage de Sally",IDC_STATIC_2,5,21,347,74,WS_GROUP
    CONTROL         "Jamais",IDC_CFG_NEVER,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,13,32,60,12
    CONTROL         "Chaque jour",IDC_CFG_DAY,"Button",BS_AUTORADIOBUTTON,107,32,60,12
    CONTROL         "Chaque semaine",IDC_CFG_WEEK,"Button",BS_AUTORADIOBUTTON,232,32,60,12
    CONTROL         "Chaque mois",IDC_CFG_MONTH,"Button",BS_AUTORADIOBUTTON,13,44,60,12
    CONTROL         "Tous les 3 mois",IDC_CFG_3MONTHS,"Button",BS_AUTORADIOBUTTON,107,44,104,12
    CONTROL         "Tous les 6 mois",IDC_CFG_6MONTHS,"Button",BS_AUTORADIOBUTTON,232,44,75,12
    CONTROL         "&Lorsque la fenêtre de Vérification de versions est ouverte, la cacher et se connecter automatiquement",IDC_CFG_AUTOCONNECT,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,13,62,325,12
    CONTROL         "&Fermer la fenêtre si aucune nouvelle version n'est trouvée, sinon afficher la fenêtre",IDC_CFG_AUTOCLOSE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,74,270,12
    LTEXT           "Note: cette fenêtre peut être appelée depuis le menu Modules / Vérification de version de Sally.",IDC_STATIC_3,13,92,330,8
    LTEXT           "F&iltres",IDC_STATIC_4,13,104,330,8
    PUSHBUTTON      "&Valeurs par défaut",IDC_CFG_DEFAULTS,6,123,60,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,183,123,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,242,123,50,14
    PUSHBUTTON      "Aide",IDHELP,301,123,50,14
END

IDD_INTERNET DIALOGEX 50, 20, 258, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Réglages de connexion Internet de VérifVer"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_INTERNET_ICON,8,8,20,20,WS_GROUP
    LTEXT           "Le module VérifVer vérifie la disponibilité des dernières versions d'Sally et de ses modules. Pour cela, une connexion Internet est nécessaire.",IDC_STATIC_1,39,7,202,24
    GROUPBOX        "Comment vous connectez-vous à Internet",IDC_STATIC_2,40,38,211,67,WS_GROUP
    CONTROL         "Connexion par &ligne téléphonique et modem",IDC_INET_PHONE,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,51,166,12
    CONTROL         "Connexion par &réseau local (LAN)",IDC_INET_LAN,
                    "Button",BS_AUTORADIOBUTTON,47,63,164,12
    CONTROL         "&Pas de connexion Internet",IDC_INET_NONE,"Button",BS_AUTORADIOBUTTON,47,75,183,12
    LTEXT           "(le lancement automatique du module VérifVer sera désactivé)",IDC_STATIC_3,59,87,188,8
    GROUPBOX        "Protocole Internet",IDC_STATIC_4,40,109,211,55,WS_GROUP
    CONTROL         "&HTTP (recommandé)",IDC_INET_HTTP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,121,158,12
    CONTROL         "&FTP",IDC_INET_FTP,"Button",BS_AUTORADIOBUTTON,47,133,158,12
    CONTROL         "F&TP en mode transfert passif (utile derrière un pare-feu)",IDC_INET_FTP_PASSIVE,
                    "Button",BS_AUTORADIOBUTTON,47,145,188,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,3,174,250,1
    DEFPUSHBUTTON   "OK",IDOK,85,181,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,142,181,50,14
    PUSHBUTTON      "Aide",IDHELP,199,181,50,14
END

