// Spanish (es-ES) resources for checkver. Translation: Juan Pablo Barrio Lera.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/checkver/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\checkver.rh2"

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_MAIN DIALOGEX 30, 30, 338, 238
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION "Comprobar existencia de nuevas versiones"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Comprobar &ahora",IDC_MAIN_CHECK,161,220,50,14
    PUSHBUTTON      "&Cerrar",IDCANCEL,220,220,50,14
    PUSHBUTTON      "Ayuda",IDHELP,279,220,50,14
    CONTROL         "",IDC_MAIN_LOG,"CheckVerLogWindow",WS_VSCROLL | WS_GROUP,5,5,328,209
    PUSHBUTTON      "C&onfigurar...",IDC_MAIN_CFG,6,220,60,14,WS_GROUP
END

IDD_CONFIGURATION DIALOGEX 15, 39, 357, 144
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuración de comprobación de versiones"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Ajustes de conexión a Internet:",IDC_STATIC_1,11,8,330,8
    GROUPBOX        "Abrir &comprobación de nuevas versiones al iniciar Sally",IDC_STATIC_2,5,21,347,74,WS_GROUP
    CONTROL         "Nunca",IDC_CFG_NEVER,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,13,32,60,12
    CONTROL         "Cada día",IDC_CFG_DAY,"Button",BS_AUTORADIOBUTTON,107,32,60,12
    CONTROL         "Cada semana",IDC_CFG_WEEK,"Button",BS_AUTORADIOBUTTON,232,32,60,12
    CONTROL         "Cada mes",IDC_CFG_MONTH,"Button",BS_AUTORADIOBUTTON,13,44,60,12
    CONTROL         "Cada tres meses",IDC_CFG_3MONTHS,"Button",BS_AUTORADIOBUTTON,107,44,104,12
    CONTROL         "Casa seis meses",IDC_CFG_6MONTHS,"Button",BS_AUTORADIOBUTTON,232,44,75,12
    CONTROL         "&Al abrir la ventana Comprobar nuevas versiones, ocultarla y efectuar autoconexión",IDC_CFG_AUTOCONNECT,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,13,62,325,12
    CONTROL         "C&errar ventana si no se encuentra nueva versión, y mostrarla en caso contrario",IDC_CFG_AUTOCLOSE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,74,270,12
    LTEXT           "Nota: esta ventana puede invocarse desde el menú Plugins / Comprobar versión de Sally.",IDC_STATIC_3,13,92,330,8
    LTEXT           "&Filtros",IDC_STATIC_4,13,104,330,8
    PUSHBUTTON      "&Disponer por omisión",IDC_CFG_DEFAULTS,6,123,60,14,WS_GROUP
    DEFPUSHBUTTON   "Aceptar",IDOK,183,123,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",IDCANCEL,242,123,50,14
    PUSHBUTTON      "Ayuda",IDHELP,301,123,50,14
END

IDD_INTERNET DIALOGEX 50, 20, 258, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ajustes de conexión a Internet"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_INTERNET_ICON,8,8,20,20,WS_GROUP
    LTEXT           "El plugin CheckVer le permite conocer las últimas versiones de Sally y plugins. Se necesita una conexión a Internet para leer la información de nuevas versiones.",IDC_STATIC_1,39,7,202,24
    GROUPBOX        "Cómo se conecta este ordenador a Internet",IDC_STATIC_2,40,38,211,67,WS_GROUP
    CONTROL         "a través de una línea &telefónica y un módem",IDC_INET_PHONE,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,51,166,12
    CONTROL         "a través de una &red local (LAN)",IDC_INET_LAN,
                    "Button",BS_AUTORADIOBUTTON,47,63,164,12
    CONTROL         "&no está´conectado a Internet",IDC_INET_NONE,"Button",BS_AUTORADIOBUTTON,47,75,183,12
    LTEXT           "(el inicio automático del plugin CheckVer se deshabilitará)",IDC_STATIC_3,59,87,188,8
    GROUPBOX        "Protocolo de Internet",IDC_STATIC_4,40,109,211,55,WS_GROUP
    CONTROL         "&HTTP (recomendado)",IDC_INET_HTTP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,121,158,12
    CONTROL         "&FTP",IDC_INET_FTP,"Button",BS_AUTORADIOBUTTON,47,133,158,12
    CONTROL         "FT&P con transferencias pasivas (útil tras un cortafuegos)",IDC_INET_FTP_PASSIVE,
                    "Button",BS_AUTORADIOBUTTON,47,145,188,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,3,174,250,1
    DEFPUSHBUTTON   "Aceptar",IDOK,85,181,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",IDCANCEL,142,181,50,14
    PUSHBUTTON      "Ayuda",IDHELP,199,181,50,14
END

