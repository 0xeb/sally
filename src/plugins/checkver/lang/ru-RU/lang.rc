// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/checkver/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\checkver.rh2"

LANGUAGE LANG_RUSSIAN, SUBLANG_RUSSIAN_RUSSIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_MAIN DIALOGEX 30, 30, 338, 238
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION "Проверка обновлений"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "&Проверить",IDC_MAIN_CHECK,161,220,50,14
    PUSHBUTTON      "&Закрыть",IDCANCEL,220,220,50,14
    PUSHBUTTON      "Справка",IDHELP,279,220,50,14
    CONTROL         "",IDC_MAIN_LOG,"CheckVerLogWindow",WS_VSCROLL | WS_GROUP,5,5,328,209
    PUSHBUTTON      "&Настройка...",IDC_MAIN_CFG,6,220,60,14,WS_GROUP
END

IDD_CONFIGURATION DIALOGEX 15, 39, 357, 144
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Настройка модуля проверки обновлений"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Подключение к Интернету:",IDC_STATIC_1,11,8,330,8
    GROUPBOX        "&Выполнять проверку обновлений при запуске Sally",IDC_STATIC_2,5,21,347,74,WS_GROUP
    CONTROL         "Никогда",IDC_CFG_NEVER,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,13,32,60,12
    CONTROL         "Каждый день",IDC_CFG_DAY,"Button",BS_AUTORADIOBUTTON,107,32,60,12
    CONTROL         "Каждую неделю",IDC_CFG_WEEK,"Button",BS_AUTORADIOBUTTON,232,32,60,12
    CONTROL         "Каждый месяц",IDC_CFG_MONTH,"Button",BS_AUTORADIOBUTTON,13,44,60,12
    CONTROL         "Каждые три месяца",IDC_CFG_3MONTHS,"Button",BS_AUTORADIOBUTTON,107,44,104,12
    CONTROL         "Каждые полгода",IDC_CFG_6MONTHS,"Button",BS_AUTORADIOBUTTON,232,44,75,12
    CONTROL         "&Не отображать окно проверки обновлений и соединиться автоматически",IDC_CFG_AUTOCONNECT,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,13,62,325,12
    CONTROL         "З&акрыть окно, если новых версий не обнаружено",IDC_CFG_AUTOCLOSE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,74,270,12
    LTEXT           "Совет: это окно можно открыть из меню Sally ""Модули - Проверка обновлений"".",IDC_STATIC_3,13,92,330,8
    LTEXT           "И&сключения",IDC_STATIC_4,13,104,330,8
    PUSHBUTTON      "По умол&чанию",IDC_CFG_DEFAULTS,6,123,60,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,183,123,50,14,WS_GROUP
    PUSHBUTTON      "Отмена",IDCANCEL,242,123,50,14
    PUSHBUTTON      "Справка",IDHELP,301,123,50,14
END

IDD_INTERNET DIALOGEX 50, 20, 258, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Проверка обновлений: Подключение к Интернету"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_INTERNET_ICON,8,8,20,20,WS_GROUP
    LTEXT           "Данный модуль проверяет обновления Sally и его модулей. Для получения обновлений требуется подключение к Интернету.",IDC_STATIC_1,39,7,202,24
    GROUPBOX        "Ваше подключение к Интернету",IDC_STATIC_2,40,38,211,67,WS_GROUP
    CONTROL         "&Я подключен с помощью модема (dial-up)",IDC_INET_PHONE,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,51,166,12
    CONTROL         "Я подключен по &локальной сети (LAN)",IDC_INET_LAN,
                    "Button",BS_AUTORADIOBUTTON,47,63,164,12
    CONTROL         "Я не п&одключен к Интернету",IDC_INET_NONE,"Button",BS_AUTORADIOBUTTON,47,75,183,12
    LTEXT           "(автопроверка обновлений будет отключена)",IDC_STATIC_3,59,87,188,8
    GROUPBOX        "Протокол Интернета",IDC_STATIC_4,40,109,211,55,WS_GROUP
    CONTROL         "&HTTP (рекомендуется)",IDC_INET_HTTP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,121,158,12
    CONTROL         "&FTP",IDC_INET_FTP,"Button",BS_AUTORADIOBUTTON,47,133,158,12
    CONTROL         "F&TP в пассивном режиме (при исп. сетевых экранов)",IDC_INET_FTP_PASSIVE,
                    "Button",BS_AUTORADIOBUTTON,47,145,188,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,3,174,250,1
    DEFPUSHBUTTON   "OK",IDOK,85,181,50,14,WS_GROUP
    PUSHBUTTON      "Отмена",IDCANCEL,142,181,50,14
    PUSHBUTTON      "Справка",IDHELP,199,181,50,14
END

