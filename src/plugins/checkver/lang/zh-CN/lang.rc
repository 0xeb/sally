// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/checkver/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\checkver.rh2"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_MAIN DIALOGEX 30, 30, 338, 238
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION "检查新版本"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "立即检查(&N)",IDC_MAIN_CHECK,161,220,50,14
    PUSHBUTTON      "关闭(&L)",IDCANCEL,220,220,50,14
    PUSHBUTTON      "帮助",IDHELP,279,220,50,14
    CONTROL         "",IDC_MAIN_LOG,"CheckVerLogWindow",WS_VSCROLL | WS_GROUP,5,5,328,209
    PUSHBUTTON      "配置(&C)...",IDC_MAIN_CFG,6,220,60,14,WS_GROUP
END

IDD_CONFIGURATION DIALOGEX 15, 39, 357, 144
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "检查版本的配置"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "因特网连接设置:",IDC_STATIC_1,11,8,330,8
    GROUPBOX        "在 Sally 启动时打开""检查新版本""窗口(&O)",IDC_STATIC_2,5,21,347,74,WS_GROUP
    CONTROL         "从不",IDC_CFG_NEVER,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,13,32,60,12
    CONTROL         "每天",IDC_CFG_DAY,"Button",BS_AUTORADIOBUTTON,107,32,60,12
    CONTROL         "每周",IDC_CFG_WEEK,"Button",BS_AUTORADIOBUTTON,232,32,60,12
    CONTROL         "每月",IDC_CFG_MONTH,"Button",BS_AUTORADIOBUTTON,13,44,60,12
    CONTROL         "每三个月",IDC_CFG_3MONTHS,"Button",BS_AUTORADIOBUTTON,107,44,104,12
    CONTROL         "每六个月",IDC_CFG_6MONTHS,"Button",BS_AUTORADIOBUTTON,232,44,75,12
    CONTROL         "当""检查新版本""窗口打开时，将它隐藏并执行自动连接(&W)",IDC_CFG_AUTOCONNECT,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,13,62,325,12
    CONTROL         "如果未发现新版本就关闭窗口，否则显示窗口(&L)",IDC_CFG_AUTOCLOSE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,74,270,12
    LTEXT           "注: 此窗口可以从 Sally 菜单""插件 / 检查版本""调出。",IDC_STATIC_3,13,92,330,8
    LTEXT           "过滤器(&F)",IDC_STATIC_4,13,104,330,8
    PUSHBUTTON      "设为默认(&D)",IDC_CFG_DEFAULTS,6,123,60,14,WS_GROUP
    DEFPUSHBUTTON   "确定",IDOK,183,123,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,242,123,50,14
    PUSHBUTTON      "帮助",IDHELP,301,123,50,14
END

IDD_INTERNET DIALOGEX 50, 20, 258, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION """检查版本""因特网连接设置"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_INTERNET_ICON,8,8,20,20,WS_GROUP
    LTEXT           """检查版本""插件让你了解 Sally 及插件的最新版本。需要因特网连接来读取新版本信息。",IDC_STATIC_1,39,7,202,24
    GROUPBOX        "你如何连接到因特网",IDC_STATIC_2,40,38,211,67,WS_GROUP
    CONTROL         "我通过电话线和调制解调器连接(&P)",IDC_INET_PHONE,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,51,166,12
    CONTROL         "我通过局域网(LAN)连接(&L)",IDC_INET_LAN,
                    "Button",BS_AUTORADIOBUTTON,47,63,164,12
    CONTROL         "我没连接到因特网(&N)",IDC_INET_NONE,"Button",BS_AUTORADIOBUTTON,47,75,183,12
    LTEXT           "(将禁止""检查版本""插件自动启动)",IDC_STATIC_3,59,87,188,8
    GROUPBOX        "因特网协议",IDC_STATIC_4,40,109,211,55,WS_GROUP
    CONTROL         "&HTTP (推荐)",IDC_INET_HTTP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,121,158,12
    CONTROL         "&FTP",IDC_INET_FTP,"Button",BS_AUTORADIOBUTTON,47,133,158,12
    CONTROL         "F&TP 被动传输模式(在防火墙后面有用)",IDC_INET_FTP_PASSIVE,
                    "Button",BS_AUTORADIOBUTTON,47,145,188,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,3,174,250,1
    DEFPUSHBUTTON   "确定",IDOK,85,181,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,142,181,50,14
    PUSHBUTTON      "帮助",IDHELP,199,181,50,14
END

