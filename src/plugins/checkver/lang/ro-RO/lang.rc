// Romanian (ro-RO) resources for checkver. Translation: Ioan Stefancu, Donca Radu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/checkver/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\checkver.rh2"

LANGUAGE LANG_ROMANIAN, SUBLANG_ROMANIAN_ROMANIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_MAIN DIALOGEX 30, 30, 338, 238
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION "Verific de Noi Versiuni"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Verifica &Acum",IDC_MAIN_CHECK,161,220,50,14
    PUSHBUTTON      "I&nchid",IDCANCEL,220,220,50,14
    PUSHBUTTON      "Help",IDHELP,279,220,50,14
    CONTROL         "",IDC_MAIN_LOG,"CheckVerLogWindow",WS_VSCROLL | WS_GROUP,5,5,328,209
    PUSHBUTTON      "&Configurez...",IDC_MAIN_CFG,6,220,60,14,WS_GROUP
END

IDD_CONFIGURATION DIALOGEX 15, 39, 357, 144
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configurarea Verificarii Versiunii"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Setari de conexiune la internet:",IDC_STATIC_1,11,8,330,8
    GROUPBOX        "Desc&hid fereastra pentru verificarea de noi versiuni de Servant Sally la startul programului",IDC_STATIC_2,5,21,347,74,WS_GROUP
    CONTROL         "Niciodata",IDC_CFG_NEVER,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,13,32,60,12
    CONTROL         "In fiecare zi",IDC_CFG_DAY,"Button",BS_AUTORADIOBUTTON,107,32,60,12
    CONTROL         "In fiecare saptamana",IDC_CFG_WEEK,"Button",BS_AUTORADIOBUTTON,232,32,60,12
    CONTROL         "In fiecare luna",IDC_CFG_MONTH,"Button",BS_AUTORADIOBUTTON,13,44,60,12
    CONTROL         "La fiecare trei luni",IDC_CFG_3MONTHS,"Button",BS_AUTORADIOBUTTON,107,44,104,12
    CONTROL         "La fiecare sase luni",IDC_CFG_6MONTHS,"Button",BS_AUTORADIOBUTTON,232,44,75,12
    CONTROL         "&Cand fereastra de verificare a noii versiuni e deschisa, ascunde-o si activeaza auto-conectarea",IDC_CFG_AUTOCONNECT,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,13,62,325,12
    CONTROL         "I&nchide fereastra daca nici o versiune noua nu e gasita, altfel arata fereastra",IDC_CFG_AUTOCLOSE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,74,270,12
    LTEXT           "Nota: aceasta fereastra poate fi invocata din meniul Plugins al Sally / Verifica Versiune.",IDC_STATIC_3,13,92,330,8
    LTEXT           "&Filtre",IDC_STATIC_4,13,104,330,8
    PUSHBUTTON      "Se&teaza Defaults",IDC_CFG_DEFAULTS,6,123,60,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,183,123,50,14,WS_GROUP
    PUSHBUTTON      "Anuleaza",IDCANCEL,242,123,50,14
    PUSHBUTTON      "Help",IDHELP,301,123,50,14
END

IDD_INTERNET DIALOGEX 50, 20, 258, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "CheckVer Setari de Conexiune Internet"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_INTERNET_ICON,8,8,20,20,WS_GROUP
    LTEXT           "CheckVer plugin te instiinteaza de ultimele versiuni de Sally si plugin-uri. Conexiunea la internet e necesara pentru citirea de informatii noi ale versiunilor aparute.",IDC_STATIC_1,39,7,202,24
    GROUPBOX        "Cum te conectezi la Internet",IDC_STATIC_2,40,38,211,67,WS_GROUP
    CONTROL         "Ma conectez printr-o linie &telefonica si un modem",IDC_INET_PHONE,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,51,166,12
    CONTROL         "Ma conectez prin &LAN (cable modem, retea de cartier)",IDC_INET_LAN,
                    "Button",BS_AUTORADIOBUTTON,47,63,164,12
    CONTROL         "&Nu ma conectez la Internet",IDC_INET_NONE,"Button",BS_AUTORADIOBUTTON,47,75,183,12
    LTEXT           "(pornirea automata a CheckVer plugin va fi dezactivata)",IDC_STATIC_3,59,87,188,8
    GROUPBOX        "Internet protocol",IDC_STATIC_4,40,109,211,55,WS_GROUP
    CONTROL         "&HTTP (recomandat)",IDC_INET_HTTP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,121,158,12
    CONTROL         "&FTP",IDC_INET_FTP,"Button",BS_AUTORADIOBUTTON,47,133,158,12
    CONTROL         "FT&P in mod de transfer pasiv (folositor in spatele firewall)",IDC_INET_FTP_PASSIVE,
                    "Button",BS_AUTORADIOBUTTON,47,145,188,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,3,174,250,1
    DEFPUSHBUTTON   "OK",IDOK,85,181,50,14,WS_GROUP
    PUSHBUTTON      "Anuleaza",IDCANCEL,142,181,50,14
    PUSHBUTTON      "Help",IDHELP,199,181,50,14
END

