// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/checkver/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\checkver.rh2"

LANGUAGE LANG_HUNGARIAN, SUBLANG_HUNGARIAN_HUNGARY

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_MAIN DIALOGEX 30, 30, 338, 238
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION "Új verziók keresése"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Elle&nőrzés",IDC_MAIN_CHECK,161,220,50,14
    PUSHBUTTON      "&Bezárás",IDCANCEL,220,220,50,14
    PUSHBUTTON      "Súgó",IDHELP,279,220,50,14
    CONTROL         "",IDC_MAIN_LOG,"CheckVerLogWindow",WS_VSCROLL | WS_GROUP,5,5,328,209
    PUSHBUTTON      "Beá&llítás...",IDC_MAIN_CFG,6,220,60,14,WS_GROUP
END

IDD_CONFIGURATION DIALOGEX 15, 39, 357, 144
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Verzió ellenőrzés beállítása"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Internet kapcsolat beállítása:",IDC_STATIC_1,11,8,330,8
    GROUPBOX        "Új verzió ellenőrzése ablak nyitása az Sally indulásak&or",IDC_STATIC_2,5,21,347,74,WS_GROUP
    CONTROL         "Soha",IDC_CFG_NEVER,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,13,32,60,12
    CONTROL         "Minden nap",IDC_CFG_DAY,"Button",BS_AUTORADIOBUTTON,107,32,60,12
    CONTROL         "Minden hét",IDC_CFG_WEEK,"Button",BS_AUTORADIOBUTTON,232,32,60,12
    CONTROL         "Minden hónap",IDC_CFG_MONTH,"Button",BS_AUTORADIOBUTTON,13,44,60,12
    CONTROL         "Minden három hónap",IDC_CFG_3MONTHS,"Button",BS_AUTORADIOBUTTON,107,44,104,12
    CONTROL         "Minden hat hónap",IDC_CFG_6MONTHS,"Button",BS_AUTORADIOBUTTON,232,44,75,12
    CONTROL         "Az Új verzió ellenőrzése ablak megjelenésekor annak rejtése és &automatikus csatlakozás",IDC_CFG_AUTOCONNECT,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,13,62,325,12
    CONTROL         "Me&gnyitott ablak bezárása, ha nincs új verzió, egyébként az ablak mutatása",IDC_CFG_AUTOCLOSE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,74,270,12
    LTEXT           "Megjegyzés: ez az ablak elérhető az Sally Plugin / Verzió ellenőrzése menüpont alól is.",IDC_STATIC_3,13,92,330,8
    LTEXT           "Szűrő&k",IDC_STATIC_4,13,104,330,8
    PUSHBUTTON      "A&lap",IDC_CFG_DEFAULTS,6,123,60,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,183,123,50,14,WS_GROUP
    PUSHBUTTON      "Mégse",IDCANCEL,242,123,50,14
    PUSHBUTTON      "Súgó",IDHELP,301,123,50,14
END

IDD_INTERNET DIALOGEX 50, 20, 258, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ellenőrzés internet kapcsolatának beállításai"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_INTERNET_ICON,8,8,20,20,WS_GROUP
    LTEXT           "Az ellenőrző plugin tudatja, ha van új Sally vagy plugin verzió. Az internet kapcsolat szükséges az új verziók információinak beolvasásához.",IDC_STATIC_1,39,7,202,24
    GROUPBOX        "Hogy kapcsolódik az internetre",IDC_STATIC_2,40,38,211,67,WS_GROUP
    CONTROL         "Telefonvonalon és &modemen keresztül csatlakozom",IDC_INET_PHONE,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,51,166,12
    CONTROL         "He&lyi hálózaton keresztül csatlakozom (LAN)",IDC_INET_LAN,
                    "Button",BS_AUTORADIOBUTTON,47,63,164,12
    CONTROL         "&Nincs internet kapcsolatom",IDC_INET_NONE,"Button",BS_AUTORADIOBUTTON,47,75,183,12
    LTEXT           "(az ellenőrzés plugin automatikus indulása kikapcsolva)",IDC_STATIC_3,59,87,188,8
    GROUPBOX        "Internet protokoll",IDC_STATIC_4,40,109,211,55,WS_GROUP
    CONTROL         "&HTTP (ajánlott)",IDC_INET_HTTP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,47,121,158,12
    CONTROL         "&FTP",IDC_INET_FTP,"Button",BS_AUTORADIOBUTTON,47,133,158,12
    CONTROL         "F&TP passzív átviteli módban (tűzfal mögött hasznos)",IDC_INET_FTP_PASSIVE,
                    "Button",BS_AUTORADIOBUTTON,47,145,188,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,3,174,250,1
    DEFPUSHBUTTON   "OK",IDOK,85,181,50,14,WS_GROUP
    PUSHBUTTON      "Mégse",IDCANCEL,142,181,50,14
    PUSHBUTTON      "Súgó",IDHELP,199,181,50,14
END

