// Korean (ko-KR) resources for uncab. Translation: Sally contributors (AI-assisted).
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/uncab/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\uncab.rh2"

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 11, 21, 221, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "다음 CAB 볼륨"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_TEXT,12,9,198,32
    LTEXT           "디스크 이름:",IDC_STATIC_1,12,48,39,8
    LTEXT           "",IDC_DISKNAME,53,48,157,8
    LTEXT           "CAB 이름:",IDC_STATIC_2,12,59,39,8
    LTEXT           "",IDC_CABNAME,53,59,157,8
    LTEXT           "경로(&P):",IDC_STATIC_3,12,70,32,8
    EDITTEXT        IDC_FILENAME,12,80,182,12
    PUSHBUTTON      "...",IDC_BROWSE,197,80,13,12
    DEFPUSHBUTTON   "확인",IDOK,106,103,50,14
    PUSHBUTTON      "취소",IDCANCEL,160,103,50,14
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,97,209,1
END

IDD_ERROR DIALOGEX 15, 34, 352, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "오류"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "이름:",IDC_STATIC_1,6,10,26,8
    LTEXT           "",IDS_FILENAME,36,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "오류:",IDC_STATIC_2,6,23,26,8,NOT WS_GROUP
    LTEXT           "이전 볼륨에서 이어지는 파일이므로 추출할 수 없습니다. 이 파일을 추출하려면 파일이 시작되는 볼륨부터 시작해야 합니다.",IDC_STATIC_3,36,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "앞으로 이 메시지를 표시하지 않음(&D)",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,44,183,12
    DEFPUSHBUTTON   "건너뛰기(&S)",IDSKIP,89,63,54,14,WS_GROUP
    PUSHBUTTON      "모두 건너뛰기(&A)",IDALL,149,63,54,14
    PUSHBUTTON      "취소",IDCANCEL,209,63,54,14
END

IDD_CONFIG DIALOGEX 22, 38, 167, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnCAB 설정"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "자동으로 건너뛰기",IDC_STATIC_1,23,22,61,8
    CONTROL         "압축을 풀 때 이전 볼륨에서 이어지는 파일을(&A)",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,10,144,12
    LTEXT           "주의 메시지를 표시하지 않음",IDC_STATIC_2,23,44,61,8
    CONTROL         "압축 파일 전체 내용을 나열할 수 없을 때(&D)",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,136,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,155,1
    DEFPUSHBUTTON   "확인",IDOK,31,66,50,14
    PUSHBUTTON      "취소",IDCANCEL,86,66,50,14
END

IDD_WARNING DIALOGEX 6, 15, 213, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnCAB - 주의"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "일부 압축 파일 볼륨을 찾을 수 없어 다중 볼륨 압축 파일의 모든 파일을 나열(및 패널에 표시)할 수 없습니다.",IDC_STATIC_1,11,9,193,16
    LTEXT           "압축 파일 전체 내용을 나열하려면 모든 압축 파일 볼륨을 같은 디렉터리에 복사하고 첫 번째 압축 파일 볼륨을 여십시오.",IDC_STATIC_2,11,32,193,16
    CONTROL         "앞으로 이 메시지를 표시하지 않음(&D)",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,57,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,75,202,1
    DEFPUSHBUTTON   "확인",IDOK,154,82,50,14
END

