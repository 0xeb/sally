// Russian (ru-RU) resources for uncab. Translation: Ален Хайруллин, Vasiliy, Игорь Полякофф, Neutron16.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/uncab/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\uncab.rh2"

LANGUAGE LANG_RUSSIAN, SUBLANG_RUSSIAN_RUSSIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 11, 21, 241, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Следующий том архива САВ"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_TEXT,12,9,218,32
    LTEXT           "Имя диска:",IDC_STATIC_1,12,48,56,8
    LTEXT           "",IDC_DISKNAME,75,48,155,8
    LTEXT           "Имя архива CAB:",IDC_STATIC_2,12,59,62,8
    LTEXT           "",IDC_CABNAME,75,59,155,8
    LTEXT           "&Путь:",IDC_STATIC_3,12,70,39,8
    EDITTEXT        IDC_FILENAME,12,80,202,12
    PUSHBUTTON      "...",IDC_BROWSE,217,80,13,12
    DEFPUSHBUTTON   "ОК",IDOK,126,103,50,14
    PUSHBUTTON      "Отмена",IDCANCEL,180,103,50,14
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,97,229,1
END

IDD_ERROR DIALOGEX 15, 34, 363, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ошибка"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Имя:",IDC_STATIC_1,8,10,32,8
    LTEXT           "",IDS_FILENAME,44,10,312,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Ошибка:",IDC_STATIC_2,8,23,32,8,NOT WS_GROUP
    LTEXT           "Файл не может быть извлечен, так как его начальная часть содержится в предыдущем томе. Для извлечения файла следует начать его извлечение из предыдущего тома.",IDC_STATIC_3,44,23,312,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&Больше не показывать это сообщение.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,44,44,183,12
    DEFPUSHBUTTON   "&Пропустить",IDSKIP,85,63,57,14,WS_GROUP
    PUSHBUTTON      "Пропустить &все",IDALL,152,63,65,14
    PUSHBUTTON      "Отмена",IDCANCEL,227,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 220, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Настройка UnCAB"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "содержится в предыдущем томе.",IDC_STATIC_1,23,22,154,8
    CONTROL         "&При распаковке пропускать файлы, начало которых",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,10,197,12
    LTEXT           "отобразить содержимое архива полностью.",IDC_STATIC_2,23,44,157,8
    CONTROL         "&Не показывать предупреждение о невозможности",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,189,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,208,1
    DEFPUSHBUTTON   "ОК",IDOK,57,66,50,14
    PUSHBUTTON      "Отмена",IDCANCEL,112,66,50,14
END

IDD_WARNING DIALOGEX 6, 15, 213, 108
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnCAB - Предупреждение"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Невозможно отобразить полный перечень файлов многотомного архива, так как некоторые тома не были найдены.",IDC_STATIC_1,11,9,193,24
    LTEXT           "Для просмотра полного перечня файлов необходимо поместить все тома в одну папку и открыть 1-ый том.",IDC_STATIC_2,11,40,193,16
    CONTROL         "&Больше не показывать это сообщение",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,65,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,83,202,1
    DEFPUSHBUTTON   "ОК",IDOK,154,90,50,14
END

