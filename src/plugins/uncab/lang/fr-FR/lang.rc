// French (fr-FR) resources for uncab. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/uncab/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\uncab.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 11, 21, 243, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Volume suivant de l'archive Cabinet"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_TEXT,12,9,220,32
    LTEXT           "Libellé du disque:",IDC_STATIC_1,12,48,62,8
    LTEXT           "",IDC_DISKNAME,76,48,156,8
    LTEXT           "Nom du CAB:",IDC_STATIC_2,12,59,62,8
    LTEXT           "",IDC_CABNAME,76,59,156,8
    LTEXT           "&Chemin:",IDC_STATIC_3,12,70,30,8
    EDITTEXT        IDC_FILENAME,12,80,204,12
    PUSHBUTTON      "...",IDC_BROWSE,219,80,13,12
    DEFPUSHBUTTON   "OK",IDOK,128,103,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,182,103,50,14
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,97,231,1
END

IDD_ERROR DIALOGEX 15, 34, 352, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Erreur"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Nom:",IDC_STATIC_1,6,10,26,8
    LTEXT           "",IDS_FILENAME,36,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Erreur:",IDC_STATIC_2,6,23,26,8,NOT WS_GROUP
    LTEXT           "Ce fichier ne peut pas être extrait, car il est partiellement contenu au sein d'un volume précédent. Pour extraire ce fichier, commencez par le volume contenant sa première partie.",IDC_STATIC_3,36,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&Ne plus afficher ce message à l'avenir.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,44,183,12
    DEFPUSHBUTTON   "&Ignorer",IDSKIP,83,63,55,14,WS_GROUP
    PUSHBUTTON      "&Tout Ignorer",IDALL,148,63,55,14
    PUSHBUTTON      "Annuler",IDCANCEL,213,63,55,14
END

IDD_CONFIG DIALOGEX 22, 38, 286, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration de UnCAB"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "la décompression.",IDC_STATIC_1,23,22,154,8
    CONTROL         "&Ignorer automatiquement les fichiers issus d'un volume précédent lors de",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,10,263,12
    LTEXT           "ne peut être listé.",IDC_STATIC_2,23,44,111,8
    CONTROL         "&Ne pas afficher d'avertissement lorsque l'ensemble du contenu de l'archive",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,263,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,274,1
    DEFPUSHBUTTON   "OK",IDOK,90,66,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,145,66,50,14
END

IDD_WARNING DIALOGEX 6, 15, 213, 116
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnCAB - Avertissement"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Impossible de lister (et afficher) l'ensemble des fichiers contenus dans cette archive multi-volumes, car certains volumes n'ont pas été trouvés.",IDC_STATIC_1,11,9,193,24
    LTEXT           "Pour lister l'intégralité des fichiers contenus dans l'archive, copiez l'ensemble de ses volumes dans le même dossier, et ouvrez le PREMIER volume de l'archive.",IDC_STATIC_2,11,40,193,24
    CONTROL         "&Ne plus afficher ce message à l'avenir",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,73,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,91,202,1
    DEFPUSHBUTTON   "OK",IDOK,154,98,50,14
END

