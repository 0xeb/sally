  IDS_EXTRPROGTITLE, "Décompression de l'archive CAB - %s"
  IDS_PREPAREDATA, "préparation des données et création des dossiers..."
  IDS_EXTRACTFILES, "décompression..."
  IDS_EXTRACTING, "décompression de: "
  IDS_UNABLEGETFIELPOS, "Impossible d'obtenir un pointeur sur le fichier: "
  IDS_UNABLEWRITE, "Impossible d'écrire dans le fichier:"
  IDS_UNABLESEEK, "Impossible de positionner un pointeur sur le fichier: "
  IDS_TOOLONGNAME, "L'opération ne peut pas être achevée en raison d'un nom de chemin trop long."
  IDS_TOOLONGMASK, "L'opération ne peut pas être achevée en raison d'un masque trop long."
  IDS_EXPIRE, "Nous sommes désolés, votre version du module a expiré. Veuillez consulter notre site Web pour obtenir une mise à jour."
  IDS_UNABLECREATE, "Impossible de créer ou d'ouvrir le fichier."
  IDS_UNABLEREAD, "Impossible de lire le fichier."
  IDS_BROWSEFOLDERTEXT, "Sélectionnez un dossier contenant '%s'."
  IDS_NOTFOUND, "Fichier non trouvé."
  IDS_SKIPPING, "saut du fichier"
  IDS_NEXTVOLTEXT, "Veuillez insérer un disque contenant le volume n°%d du fichier Cabinet, ou indiquez le chemin du fichier Cabinet approprié sur le disque.\n\nAppuyez sur OK lorsque vous êtes prêt(e)."

  // FDIERROR - Error codes returned in erf.erfOper field
  IDS_CABINET_NOT_FOUND, "Fichier Cabinet non trouvé."
  IDS_NOT_A_CABINET, "Le format du fichier Cabinet est incorrect."
  IDS_UNKNOWN_CABINET_VERSION, "La version du fichier Cabinet n'est pas prise en charge."
  IDS_CORRUPT_CABINET, "Le fichier Cabinet est corrompu."
  IDS_BAD_COMPR_TYPE, "Un type de compression non pris en charge a été détecté dans un dossier Cabinet."
  IDS_MDI_FAIL, "Une erreur est survenue lors de la décompression de données issues d'un fichier Cabinet."
  IDS_RESERVE_MISMATCH, "Les composants Cabinet de l'un des ensembles ne présentent pas la même taille de RESERVE."
  IDS_WRONG_CABINET, "Fichier Cabinet incorrect."
  IDS_USER_ABORT, "Interruption de l'utilisateur."
  IDS_ERROR, "Erreur"
}
