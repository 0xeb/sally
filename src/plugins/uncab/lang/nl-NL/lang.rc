// Dutch (nl-NL) resources for uncab. Translation: Cor van der Smissen, Marco Fung, Patrick Vijgeboom, S.V. (Stephan) Rietveld.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/uncab/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\uncab.rh2"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 11, 21, 221, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Volgende cabinet volume"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_TEXT,12,9,198,32
    LTEXT           "Disk naam:",IDC_STATIC_1,12,48,40,8
    LTEXT           "",IDC_DISKNAME,54,48,156,8
    LTEXT           "CAB Naam:",IDC_STATIC_2,12,59,40,8
    LTEXT           "",IDC_CABNAME,54,59,156,8
    LTEXT           "&Pad:",IDC_STATIC_3,12,70,19,8
    EDITTEXT        IDC_FILENAME,12,80,182,12
    PUSHBUTTON      "...",IDC_BROWSE,197,80,13,12
    DEFPUSHBUTTON   "OK",IDOK,106,103,50,14
    PUSHBUTTON      "Annuleren",IDCANCEL,160,103,50,14
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,97,209,1
END

IDD_ERROR DIALOGEX 15, 34, 356, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Fout"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Naam:",IDC_STATIC_1,6,10,26,8
    LTEXT           "",IDS_FILENAME,36,10,313,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Fout:",IDC_STATIC_2,6,23,26,8,NOT WS_GROUP
    LTEXT           "Bestand kan niet uitgepakt worden omdat het gecontinueerd wordt vanaf het vorige volume. Om het bestand uit te pakken moet je beginnen met het volume waar het bestand begint.",IDC_STATIC_3,36,23,313,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&Toon dit bericht niet in het vervolg.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,44,183,12
    DEFPUSHBUTTON   "&Overslaan",IDSKIP,86,63,50,14,WS_GROUP
    PUSHBUTTON      "&Alles oveslaan",IDALL,145,63,65,14
    PUSHBUTTON      "Annuleren",IDCANCEL,219,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 247, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnCAB Configuratie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "uitpakken.",IDC_STATIC_1,23,22,154,8
    CONTROL         "&Automatisch bestanden uit vorige volumes overslaan tijdens",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,10,212,12
    LTEXT           "niet opgesomd kan worden.",IDC_STATIC_2,23,44,111,8
    CONTROL         "A&ttentie niet weergeven wanneer de hele inhoud van het archief",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,229,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,235,1
    DEFPUSHBUTTON   "OK",IDOK,69,66,50,14
    PUSHBUTTON      "Annuleren",IDCANCEL,128,66,50,14
END

IDD_WARNING DIALOGEX 6, 15, 232, 108
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnCAB - Attentie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Niet alle bestanden in het multi-volume archief kunnen opgesomd worden (en weergegeven worden in het paneel), omdat sommige archief volumes niet zijn gevonden.",IDC_STATIC_1,11,9,215,24
    LTEXT           "Om de hele inhoud van het archief op te sommen, kopieer alle volumes naar dezelfde map en open het eerste archief volume.",IDC_STATIC_2,11,40,215,16
    CONTROL         "&Toon dit bericht niet in het vervolg",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,65,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,83,221,1
    DEFPUSHBUTTON   "OK",IDOK,173,90,50,14
END

