// Hungarian (hu-HU) resources for uncab. Translation: Török József.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/uncab/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\uncab.rh2"

LANGUAGE LANG_HUNGARIAN, SUBLANG_HUNGARIAN_HUNGARY

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 11, 21, 221, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Következő kötet"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_TEXT,12,9,198,32
    LTEXT           "Lemeznév:",IDC_STATIC_1,12,48,38,8
    LTEXT           "",IDC_DISKNAME,54,48,156,8
    LTEXT           "CAB név:",IDC_STATIC_2,12,59,39,8
    LTEXT           "",IDC_CABNAME,54,59,156,8
    LTEXT           "&Elérési út:",IDC_STATIC_3,12,70,36,8
    EDITTEXT        IDC_FILENAME,12,80,182,12
    PUSHBUTTON      "...",IDC_BROWSE,197,80,13,12
    DEFPUSHBUTTON   "OK",IDOK,106,103,50,14
    PUSHBUTTON      "Mégse",IDCANCEL,160,103,50,14
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,97,209,1
END

IDD_ERROR DIALOGEX 15, 34, 350, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Hiba"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Név:",IDC_STATIC_1,8,10,22,8
    LTEXT           "",IDS_FILENAME,34,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Hiba:",IDC_STATIC_2,8,23,22,8,NOT WS_GROUP
    LTEXT           "A fájl nem tömöríthető ki, mert egy előző kötet folytatása. A fájl kibontásához, azzal a kötettel kell indítania, ahol a fájl kezdődik.",IDC_STATIC_3,34,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&Ne mutassa ezt az üzenetet.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,34,44,183,12
    DEFPUSHBUTTON   "&Kihagy",IDSKIP,90,63,50,14,WS_GROUP
    PUSHBUTTON      "Mind kih&agy",IDALL,150,63,50,14
    PUSHBUTTON      "Mégse",IDCANCEL,210,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 220, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnCAB beállítás"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "folytatandó fájlokat.",IDC_STATIC_1,23,22,154,8
    CONTROL         "Kibontáskor &automatikusan hagyja ki az előző kötetből",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,10,195,12
    LTEXT           "listázható ki.",IDC_STATIC_2,23,44,111,8
    CONTROL         "&Ne figyelmeztessen, ha az archívum teljes tartalma nem",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,199,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,208,1
    DEFPUSHBUTTON   "OK",IDOK,57,66,50,14
    PUSHBUTTON      "Mégse",IDCANCEL,112,66,50,14
END

IDD_WARNING DIALOGEX 6, 15, 218, 108
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnCAB - Figyelmeztetés"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "A több-kötetes archívum nem minden fájlja listázható (és látható a panelben), mert néhány archívum kötet nem található.",IDC_STATIC_1,11,9,198,24
    LTEXT           "A archívum teljes tartalmához, az archívum minden kötetét másoljon egy mappába és nyissa meg az ELSŐ kötetet.",IDC_STATIC_2,11,40,198,16
    CONTROL         "&Ne mutassa ezt az üzenetet",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,65,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,83,207,1
    DEFPUSHBUTTON   "OK",IDOK,159,90,50,14
END

