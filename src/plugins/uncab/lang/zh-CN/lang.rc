// Chinese (Simplified) (zh-CN) resources for uncab. Translation: Michael Lu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/uncab/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\uncab.rh2"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 11, 21, 221, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "下一个 cabinet 卷"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_TEXT,12,9,198,32
    LTEXT           "磁盘名称:",IDC_STATIC_1,12,48,39,8
    LTEXT           "",IDC_DISKNAME,53,48,157,8
    LTEXT           "CAB 名称:",IDC_STATIC_2,12,59,39,8
    LTEXT           "",IDC_CABNAME,53,59,157,8
    LTEXT           "路径(&P):",IDC_STATIC_3,12,70,32,8
    EDITTEXT        IDC_FILENAME,12,80,182,12
    PUSHBUTTON      "...",IDC_BROWSE,197,80,13,12
    DEFPUSHBUTTON   "确定",IDOK,106,103,50,14
    PUSHBUTTON      "取消",IDCANCEL,160,103,50,14
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,97,209,1
END

IDD_ERROR DIALOGEX 15, 34, 352, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "错误"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "名称:",IDC_STATIC_1,6,10,26,8
    LTEXT           "",IDS_FILENAME,36,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "错误:",IDC_STATIC_2,6,23,26,8,NOT WS_GROUP
    LTEXT           "无法解压文件，因为它是从上一个卷继续的。要提取这个文件，你必须从文件开头的卷开始解压。",IDC_STATIC_3,36,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "将来不再显示此消息(&D)。",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,44,183,12
    DEFPUSHBUTTON   "跳过(&S)",IDSKIP,89,63,54,14,WS_GROUP
    PUSHBUTTON      "跳过所有(&A)",IDALL,149,63,54,14
    PUSHBUTTON      "取消",IDCANCEL,209,63,54,14
END

IDD_CONFIG DIALOGEX 22, 38, 167, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnCAB 配置"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "继续的文件。",IDC_STATIC_1,23,22,61,8
    CONTROL         "当解压缩时自动跳过从上一个卷(&A)",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,10,144,12
    LTEXT           "不显示注意。",IDC_STATIC_2,23,44,61,8
    CONTROL         "当无法列出整个压缩包内容时(&D)",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,136,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,155,1
    DEFPUSHBUTTON   "确定",IDOK,31,66,50,14
    PUSHBUTTON      "取消",IDCANCEL,86,66,50,14
END

IDD_WARNING DIALOGEX 6, 15, 213, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnCAB - 注意"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "不是所有多卷压缩包中的文件都能被列出(并显示在面板中)，因为一些压缩包卷无法找到。",IDC_STATIC_1,11,9,193,16
    LTEXT           "要列出整个压缩包内容，复制所有压缩卷到相同的目录并打开第一个压缩卷。",IDC_STATIC_2,11,32,193,16
    CONTROL         "将来不再显示此消息(&D)",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,57,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,75,202,1
    DEFPUSHBUTTON   "确定",IDOK,154,82,50,14
END

