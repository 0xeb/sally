// Spanish (es-ES) resources for uncab. Translation: Juan Pablo Barrio Lera.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/uncab/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\uncab.rh2"

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 11, 21, 246, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Siguiente volumen cabinet"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_TEXT,12,9,223,32
    LTEXT           "Nombre del disco:",IDC_STATIC_1,12,48,64,8
    LTEXT           "",IDC_DISKNAME,78,48,157,8
    LTEXT           "Nombre del CAB:",IDC_STATIC_2,12,59,60,8
    LTEXT           "",IDC_CABNAME,78,59,157,8
    LTEXT           "&Ruta:",IDC_STATIC_3,12,70,21,8
    EDITTEXT        IDC_FILENAME,12,80,207,12
    PUSHBUTTON      "...",IDC_BROWSE,222,80,13,12
    DEFPUSHBUTTON   "Aceptar",IDOK,131,103,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,185,103,50,14
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,97,234,1
END

IDD_ERROR DIALOGEX 15, 34, 352, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Error"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Nombre:",IDC_STATIC_1,6,10,32,8
    LTEXT           "",IDS_FILENAME,42,10,303,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Error:",IDC_STATIC_2,6,23,32,8,NOT WS_GROUP
    LTEXT           "El fichero no puede ser extraído porque continúa a partir de un voiumen previo. Para extraer este fichero debe empezar con un volumen donde empiece el fichero.",IDC_STATIC_3,42,23,303,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&No presentar este mensaje en lo sucesivo.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,42,44,177,12
    DEFPUSHBUTTON   "&Saltar",IDSKIP,91,63,50,14,WS_GROUP
    PUSHBUTTON      "Saltar &todos",IDALL,151,63,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,211,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 260, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuración desCAB"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "cuando se desempaquete.",IDC_STATIC_1,23,22,154,8
    CONTROL         "&Automáticamente saltar ficheros continuados desde volumen previo",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,10,238,12
    LTEXT           "no pueda ser listado.",IDC_STATIC_2,23,44,111,8
    CONTROL         "&No mostrar atención cuando todo el contenido del archivo",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,207,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,248,1
    DEFPUSHBUTTON   "Aceptar",IDOK,77,66,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,132,66,50,14
END

IDD_WARNING DIALOGEX 6, 15, 258, 108
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "DesCAB - Atención"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "No todos los ficheros del archivo multivolumen pueden ser listados (y verse en el panel) porque algunos volúmenes del archivo no se encuentran.",IDC_STATIC_1,11,9,216,24
    LTEXT           "Para listar todo el contenido del archivo copie todos los volúmenes del archivo al mismo directorio y abra el PRIMER volumen del archivo.",IDC_STATIC_2,11,40,235,16
    CONTROL         "&No mostrar este mensaje en lo sucesivo",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,65,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,83,247,1
    DEFPUSHBUTTON   "Aceptar",IDOK,199,90,50,14
END

