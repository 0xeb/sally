// Romanian (ro-RO) resources for uncab. Translation: Ioan Stefancu, Donca Radu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/uncab/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\uncab.rh2"

LANGUAGE LANG_ROMANIAN, SUBLANG_ROMANIAN_ROMANIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 11, 21, 221, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Urmatorul volum cabinet"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_TEXT,12,9,198,32
    LTEXT           "Nume disc:",IDC_STATIC_1,12,48,40,8
    LTEXT           "",IDC_DISKNAME,54,48,156,8
    LTEXT           "Nume CAB:",IDC_STATIC_2,12,59,41,8
    LTEXT           "",IDC_CABNAME,54,59,156,8
    LTEXT           "&Cale:",IDC_STATIC_3,12,70,19,8
    EDITTEXT        IDC_FILENAME,12,80,182,12
    PUSHBUTTON      "...",IDC_BROWSE,197,80,13,12
    DEFPUSHBUTTON   "OK",IDOK,106,103,50,14
    PUSHBUTTON      "Anuleaza",IDCANCEL,160,103,50,14
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,97,209,1
END

IDD_ERROR DIALOGEX 15, 34, 352, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Eroare"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Nume:",IDC_STATIC_1,6,10,26,8
    LTEXT           "",IDS_FILENAME,36,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Eroare:",IDC_STATIC_2,6,23,26,8,NOT WS_GROUP
    LTEXT           "Fisierul nu poate fi extras deoarece continua din volumul precedent. Ca sa extragi acest fisier, trebuie sa pornesti cu volumul de unde incepe fisierul.",IDC_STATIC_3,36,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "Nu mai afisa acest mesaj alta &data.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,44,183,12
    DEFPUSHBUTTON   "S&ari Peste",IDSKIP,78,63,60,14,WS_GROUP
    PUSHBUTTON      "Sari Peste &Tot",IDALL,146,63,60,14
    PUSHBUTTON      "Anuleaza",IDCANCEL,214,63,60,14
END

IDD_CONFIG DIALOGEX 22, 38, 210, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configurare UnCAB"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "precedent cand dezarhivezi.",IDC_STATIC_1,23,22,154,8
    CONTROL         "&Automat sari peste fisierele continuate din volumul",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,10,181,12
    LTEXT           "nu poate fi listat.",IDC_STATIC_2,23,44,111,8
    CONTROL         "Nu afisa atentionare can&d tot continutul arhivei",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,170,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,198,1
    DEFPUSHBUTTON   "OK",IDOK,52,66,50,14
    PUSHBUTTON      "Anuleaza",IDCANCEL,107,66,50,14
END

IDD_WARNING DIALOGEX 6, 15, 213, 108
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnCAB - Atentie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Nu toate fisierele din arhiva multi-volum pot fi listate (si vazute in panou), deoarece unele volume ale arhivei nu pot fi gasite.",IDC_STATIC_1,11,9,193,24
    LTEXT           "Ca sa listezi tot continutul arhivei, copie toate volumele in acelasi director si deschide PRIMUL volum al archivei.",IDC_STATIC_2,11,40,193,16
    CONTROL         "Nu mai afisa acest mesaj alta &data",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,65,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,83,202,1
    DEFPUSHBUTTON   "OK",IDOK,154,90,50,14
END

