// Slovak (sk-SK) resources for uncab. Translation: Roman Paholík.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/uncab/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\uncab.rh2"

LANGUAGE LANG_SLOVAK, SUBLANG_SLOVAK_SLOVAKIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 11, 21, 228, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ďalší zväzok kabinetu"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_TEXT,12,9,205,32
    LTEXT           "Názov disku:",IDC_STATIC_1,12,48,45,8
    LTEXT           "",IDC_DISKNAME,59,48,158,8
    LTEXT           "Názov CABu:",IDC_STATIC_2,12,59,46,8
    LTEXT           "",IDC_CABNAME,59,59,158,8
    LTEXT           "&Cesta:",IDC_STATIC_3,12,70,24,8
    EDITTEXT        IDC_FILENAME,12,80,189,12
    PUSHBUTTON      "...",IDC_BROWSE,204,80,13,12
    DEFPUSHBUTTON   "OK",IDOK,113,103,50,14
    PUSHBUTTON      "Zrušiť",IDCANCEL,167,103,50,14
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,6,97,216,1
END

IDD_ERROR DIALOGEX 15, 34, 350, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Chyba"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Názov:",IDC_STATIC_1,4,10,26,8
    LTEXT           "",IDS_FILENAME,34,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Chyba:",IDC_STATIC_2,4,23,26,8,NOT WS_GROUP
    LTEXT           "Súbor nemôže byť extrahovaný, pretože je pokračujúci z predchádzajúceho zväzku. Na extrahovanie tohto súboru musíte začať zväzkom, v ktorom súbor začína.",IDC_STATIC_3,34,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&Nabudúce nezobrazovať.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,34,44,183,12
    DEFPUSHBUTTON   "Pres&kočiť",IDSKIP,81,63,55,14,WS_GROUP
    PUSHBUTTON      "Preskočiť &všetko",IDALL,142,63,65,14
    PUSHBUTTON      "Zrušiť",IDCANCEL,213,63,55,14
END

IDD_CONFIG DIALOGEX 22, 38, 225, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnCAB - Konfigurácia"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "z predchádzajúceho zväzku.",IDC_STATIC_1,23,22,154,8
    CONTROL         "&Pri extrahovaní automaticky preskočiť súbory pokračujúce",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,10,206,12
    LTEXT           "obsah archívu.",IDC_STATIC_2,23,44,111,8
    CONTROL         "&Nezobrazovať upozornenie, ak nemôže byť vypísaný celý",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,203,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,213,1
    DEFPUSHBUTTON   "OK",IDOK,60,66,50,14
    PUSHBUTTON      "Zrušiť",IDCANCEL,115,66,50,14
END

IDD_WARNING DIALOGEX 6, 15, 213, 108
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnCAB - Upozornenie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Nie všetky súbory vo viaczväzkovom archívu je možné vypísať (a zobraziť v paneli), pretože nie je možné nájsť niektorý zväzok archívu.",IDC_STATIC_1,11,9,193,24
    LTEXT           "Na výpis celého obsahu archívu skopírujte všetky zväzky archívu do jedného adresára a otvorte prvý zväzok.",IDC_STATIC_2,11,40,193,16
    CONTROL         "&Nabudúce nezobrazovať",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,65,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,83,202,1
    DEFPUSHBUTTON   "OK",IDOK,154,90,50,14
END

