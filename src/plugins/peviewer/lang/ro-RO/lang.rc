// Romanian (ro-RO) resources for peviewer. Translation: Ioan Stefancu, Donca Radu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/peviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\peviewer.rh2"

LANGUAGE LANG_ROMANIAN, SUBLANG_ROMANIAN_ROMANIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 346, 154
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configurare Vizualizator Executabil Portabil"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Sectiuni dispon&ibile:",IDC_STATIC_1,7,7,69,8
    LISTBOX         IDC_AVAILABLELB,7,17,105,130,LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Adauga ->",IDC_ADD,119,17,50,14,WS_GROUP
    PUSHBUTTON      "<- &Elimina",IDC_REMOVE,119,35,50,14
    LTEXT           "Sectiuni &Vizibile:",IDC_STATIC_2,176,7,58,8
    LISTBOX         IDC_SELECTEDLB,176,17,105,130,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Muta &Sus",IDC_UP,289,17,50,14,WS_GROUP
    PUSHBUTTON      "Muta &Jos",IDC_DOWN,289,35,50,14
    DEFPUSHBUTTON   "OK",IDOK,289,97,50,14,WS_GROUP
    PUSHBUTTON      "Anuleaza",IDCANCEL,289,115,50,14
    PUSHBUTTON      "Rese&t",IDC_RESET,289,133,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGIN_NAME, "Vizualizator Executabil Portabil"
 IDS_PLUGIN_DESCRIPTION, "Afiseaza informatii despre fisiere Executabile Portabile cum ar fi EXE, DLL, etc."
 IDS_ABOUT, "Despre Plugin"
 IDS_ERR_OPEN_FILE, "Nu pot deschide fisierul %s."
 IDS_ERR_TMP, "Crearea fisierului temporar a esuat."
 IDS_EXCEPTION, "A aparut o exceptie.\n\nFisierul vizualizat: %s\n\nDaca tu consideri ca fisierul vizualizat nu este corupt, te rog deschide un issue la https://github.com/0xeb/sally/issues si ataseaza acest fisier.\nVom reface si fixa defectul vizualizatorului. Multumiri pentru cooperare!"
 IDS_HIDDEN_SECTIONS, "Nici o sectiune Portabila Executabila selectata in configuratia plugin-ului nu a fost gasita.\nFoloseste meniul Optiuni > Configurare Plugin >Vizualizator Portabil Executabil\nin Sally fereastra principala pentru a seta sectiunile vizibile."
}
