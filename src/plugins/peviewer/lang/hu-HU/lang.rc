// Hungarian (hu-HU) resources for peviewer. Translation: Török József.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/peviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\peviewer.rh2"

LANGUAGE LANG_HUNGARIAN, SUBLANG_HUNGARIAN_HUNGARY

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 346, 154
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Hordozható végrehajtható fájl-néző beállítás"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Elérhető szekciók:",IDC_STATIC_1,7,7,64,8
    LISTBOX         IDC_AVAILABLELB,7,17,105,130,LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Hozzá&ad ->",IDC_ADD,119,17,50,14,WS_GROUP
    PUSHBUTTON      "<- Tö&röl",IDC_REMOVE,119,35,50,14
    LTEXT           "Lát&ható szekciók:",IDC_STATIC_2,176,7,60,8
    LISTBOX         IDC_SELECTEDLB,176,17,105,130,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Fel",IDC_UP,289,17,50,14,WS_GROUP
    PUSHBUTTON      "&Le",IDC_DOWN,289,35,50,14
    DEFPUSHBUTTON   "OK",IDOK,289,97,50,14,WS_GROUP
    PUSHBUTTON      "Mégse",IDCANCEL,289,115,50,14
    PUSHBUTTON      "Ala&p",IDC_RESET,289,133,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGIN_NAME, "Hordozható futtatható néző"
 IDS_PLUGIN_DESCRIPTION, "Olyan futtatható fájlok információinak megjelenítése, mint EXE, DLL, stb."
 IDS_ABOUT, "Plugin névjegy"
 IDS_ERR_OPEN_FILE, "A(z) %s nem nyitható meg."
 IDS_ERR_TMP, "Ideiglenes fájl létrehozása sikertelen."
 IDS_EXCEPTION, "Kivétel lépett fel.\n\nNézett fájl: %s\n\nHa biztos, hogy a megnézett fájl nem sérült, nyisson egy hibajegyet itt: https://github.com/0xeb/sally/issues és csatolja a fájlt.\nÚjra előidézzük és kijavítjuk a hibát. Köszönjük az együttműködését!"
 IDS_HIDDEN_SECTIONS, "Nincs Hordozható végrehajtható fájl szekció kijelölve a plugin beállításokban.\nBeállítások > Plugin beállítás > Hordozható végrehajtható fájl néző\naz Sally főablakának menüjében, a látható szekciók megadásához."
}
