// Korean (ko-KR) resources for peviewer. Translation: Sally contributors (AI-assisted).
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/peviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\peviewer.rh2"

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 346, 154
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Portable Executable 뷰어 설정"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "사용 가능한 섹션(&B):",IDC_STATIC_1,7,7,64,8
    LISTBOX         IDC_AVAILABLELB,7,17,105,130,LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "추가(&A) ->",IDC_ADD,119,17,50,14,WS_GROUP
    PUSHBUTTON      "<- 제거(&R)",IDC_REMOVE,119,35,50,14
    LTEXT           "표시할 섹션(&V):",IDC_STATIC_2,176,7,58,8
    LISTBOX         IDC_SELECTEDLB,176,17,105,130,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "위로 이동(&U)",IDC_UP,289,17,50,14,WS_GROUP
    PUSHBUTTON      "아래로 이동(&D)",IDC_DOWN,289,35,50,14
    DEFPUSHBUTTON   "확인",IDOK,289,97,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,289,115,50,14
    PUSHBUTTON      "초기화(&S)",IDC_RESET,289,133,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGIN_NAME, "Portable Executable 뷰어"
 IDS_PLUGIN_DESCRIPTION, "EXE, DLL 등 Portable Executable 파일의 정보를 표시합니다."
 IDS_ABOUT, "플러그인 정보"
 IDS_ERR_OPEN_FILE, "파일 %s을(를) 열 수 없습니다."
 IDS_ERR_TMP, "임시 파일을 만들지 못했습니다."
 IDS_EXCEPTION, "예외가 발생했습니다.\n\n보고 있던 파일: %s\n\n보고 있던 파일이 손상되지 않았다고 생각되면 https://github.com/0xeb/sally/issues 에 이슈를 등록하고 이 파일을 첨부해 주십시오.\n뷰어 버그를 재현하여 수정하겠습니다. 협조해 주셔서 감사합니다!"
 IDS_HIDDEN_SECTIONS, "플러그인 설정에서 선택한 Portable Executable 섹션을 찾을 수 없습니다.\nSally 주 창에서 옵션 > 플러그인 설정 > Portable Executable 뷰어\n메뉴를 사용하여 표시할 섹션을 설정하십시오."
}
