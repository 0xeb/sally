// Czech (cs-CZ) resources for peviewer. Translation: Hynek Mikulič.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/peviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\peviewer.rh2"

LANGUAGE LANG_CZECH, SUBLANG_CZECH_CZECH_REPUBLIC

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 346, 154
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Prohlížeč spustitelných souborů - Konfigurace"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Do&stupné sekce:",IDC_STATIC_1,7,7,64,8
    LISTBOX         IDC_AVAILABLELB,7,17,105,130,LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Přidat ->",IDC_ADD,119,17,50,14,WS_GROUP
    PUSHBUTTON      "<- &Odebrat",IDC_REMOVE,119,35,50,14
    LTEXT           "&Viditelné sekce:",IDC_STATIC_2,176,7,58,8
    LISTBOX         IDC_SELECTEDLB,176,17,105,130,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Na&horu",IDC_UP,289,17,50,14,WS_GROUP
    PUSHBUTTON      "&Dolů",IDC_DOWN,289,35,50,14
    DEFPUSHBUTTON   "OK",IDOK,289,97,50,14,WS_GROUP
    PUSHBUTTON      "Storno",IDCANCEL,289,115,50,14
    PUSHBUTTON      "Původ&ní",IDC_RESET,289,133,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGIN_NAME, "Prohlížeč spustitelných souborů"
 IDS_PLUGIN_DESCRIPTION, "Zobrazí informace o spustitelných souborech - EXE, DLL, atd."
 IDS_ABOUT, "O pluginu"
 IDS_ERR_OPEN_FILE, "Nelze otevřít soubor %s."
 IDS_ERR_TMP, "Vytvoření dočasného souboru selhalo."
 IDS_EXCEPTION, "Došlo k výjimce.\n\nProhlížený soubor: %s\n\nPokud si myslíte, že prohlížený soubor není poškozený, založte prosím issue na https://github.com/0xeb/sally/issues a přiložte tento soubor.\nChybu prohlížeče zopakujeme a opravíme. Děkujeme za spolupráci!"
 IDS_HIDDEN_SECTIONS, "V konfiguraci pluginu nebyly nalezeny žádné viditelné sekce. K výběru\nviditelných sekcí použijte v hlavním okně Sally nabídku\nMožnosti > Konfigurace pluginů > Prohlížeč spustitelných souborů."
}
