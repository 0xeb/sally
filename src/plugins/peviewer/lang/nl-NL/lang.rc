// Dutch (nl-NL) resources for peviewer. Translation: Cor van der Smissen, Marco Fung, Patrick Vijgeboom, S.V. (Stephan) Rietveld.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/peviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\peviewer.rh2"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 360, 154
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Portable Executable Viewer Configuratie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Beschikbare secties:",IDC_STATIC_1,7,7,70,8
    LISTBOX         IDC_AVAILABLELB,7,17,105,130,LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Toevoegen ->",IDC_ADD,119,17,64,14,WS_GROUP
    PUSHBUTTON      "<- &Verwijderen",IDC_REMOVE,119,35,64,14
    LTEXT           "&Zichtbare secties:",IDC_STATIC_2,190,7,62,8
    LISTBOX         IDC_SELECTEDLB,190,17,105,130,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Om&hoog",IDC_UP,303,17,50,14,WS_GROUP
    PUSHBUTTON      "Om&laag",IDC_DOWN,303,35,50,14
    DEFPUSHBUTTON   "OK",IDOK,303,97,50,14,WS_GROUP
    PUSHBUTTON      "Annuleren",IDCANCEL,303,115,50,14
    PUSHBUTTON      "Re&set",IDC_RESET,303,133,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGIN_NAME, "Portable Executable Viewer"
 IDS_PLUGIN_DESCRIPTION, "Informatie weergeven over de Portable Executable bestanden zoals EXE, DLL, etc."
 IDS_ABOUT, "Over plugin"
 IDS_ERR_OPEN_FILE, "Kan bestand %s niet openen."
 IDS_ERR_TMP, "Maken van tijdelijk bestand is mislukt."
 IDS_EXCEPTION, "Uitzondering opgetreden.\n\nGeopend bestand: %s\n\nAls u er zeker van bent dat dit bestand niet is beschadigd, maak dan a.u.b. een issue aan op https://github.com/0xeb/sally/issues en voeg dit bestand toe.\nWij zullen uw probleem reproduceren en het voor u oplossen. Alvast bedankt voor uw medewerking!"
 IDS_HIDDEN_SECTIONS, "Geen geselecteerde Portable Executable sectie werd in plugin configuratie gevonden.\nGebruik menu Opties > Plugin Configuratie > Portable Executable Viewer\nin Sally hoofdvenster om zichtbare secties te installeren."
}
