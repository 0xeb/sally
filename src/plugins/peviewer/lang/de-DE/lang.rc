// German (de-DE) resources for peviewer. Translation: Dirk Bornhütter, Thomas Kelso, Thomas Pagels, Thomas Wölk, Marko Meister und Mick Weiss.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/peviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\peviewer.rh2"

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 0, 0, 355, 154
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PE Dateibetrachter - Konfiguration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Verfügbare Bereiche:",IDC_STATIC_1,7,7,75,8
    LISTBOX         IDC_AVAILABLELB,7,17,105,130,LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Hin&zufügen ->",IDC_ADD,119,17,59,14,WS_GROUP
    PUSHBUTTON      "<- Entfe&rnen",IDC_REMOVE,119,35,59,14
    LTEXT           "&Sichtbare Bereiche:",IDC_STATIC_2,185,7,75,8
    LISTBOX         IDC_SELECTEDLB,185,17,105,130,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Nach &oben",IDC_UP,298,17,50,14,WS_GROUP
    PUSHBUTTON      "Nach &unten",IDC_DOWN,298,35,50,14
    DEFPUSHBUTTON   "OK",IDOK,298,97,50,14,WS_GROUP
    PUSHBUTTON      "Abbrechen",IDCANCEL,298,115,50,14
    PUSHBUTTON      "Stan&dard",IDC_RESET,298,133,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE
{
 IDS_PLUGIN_NAME, "PE Dateibetrachter"
 IDS_PLUGIN_DESCRIPTION, "Zeigt Informationen über ausführbare Dateien an (EXE, DLL, usw.)."
 IDS_ABOUT, "Über Plugin"
 IDS_ERR_OPEN_FILE, "Fehler beim Öffnen der Datei %s."
 IDS_ERR_TMP, "Fehler beim Erzeugen der temporären Datei."
 IDS_EXCEPTION, "Ausnahmefehler aufgetreten.\n\nAngesehene Datei: %s\n\nWenn die angezeigte Datei nach Ihrer Meinung nicht defekt ist, erstellen Sie bitte ein Issue auf https://github.com/0xeb/sally/issues und hängen Sie die Datei an.\nWir werden den Fehler im Betrachter beseitigen. Vielen Dank für die Kooperation!"
 IDS_HIDDEN_SECTIONS, "Es wurde kein ausgewählter PE Bereich in der Pluginkonfiguration gefunden.\nGehe zu Optionen > Pluginkonfiguration > PE Dateibetrachter\nim Sally Hauptfenster, um sichtbare Bereiche einzurichten."
}
