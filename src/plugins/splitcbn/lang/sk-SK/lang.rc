// Slovak (sk-SK) resources for splitcbn. Translation: Roman Paholík.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/splitcbn/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\splitcbn.rh2"

LANGUAGE LANG_SLOVAK, SUBLANG_SLOVAK_SLOVAKIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 53, 55, 220, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Rozdelenie a spojenie súborov - Konfigurácia"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "&Zahrnúť pôvodnú príponu do výstupného názvu súboru",IDC_CHECK_INCLUDE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,10,6,200,10
    CONTROL         "Vytvoriť &dávkový súbor na spojenie",IDC_CHECK_CREATE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,19,130,10
    CONTROL         "Rozdeliť do druhéh&o panelu",IDC_CHECK_SPLITOTHER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,32,106,10
    CONTROL         "&Rozdeliť do podadresára s názvom zdrojového súboru",IDC_CHECK_SPLITSUB,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,45,193,10
    CONTROL         "&Spojiť do druhého panelu",IDC_CHECK_COMBINEOTHER,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,58,99,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,76,212,1
    DEFPUSHBUTTON   "OK",IDOK,48,83,50,14,WS_GROUP
    PUSHBUTTON      "Zrušiť",IDCANCEL,105,83,50,14
    PUSHBUTTON      "Nápoveda",IDHELP,162,83,50,14
END

IDD_SPLIT DIALOGEX 32, 33, 258, 125
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Rozdeliť"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_SPLIT_ICON,6,7,20,20,WS_GROUP
    CONTROL         "",IDC_STATIC_TITLE,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,35,9,211,8
    EDITTEXT        IDC_EDIT_DIR,35,19,198,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,237,19,14,14,WS_GROUP
    CONTROL         "&Veľkosť častí:",IDC_RADIO_SIZE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,35,43,71,10
    CONTROL         "&Počet častí:",IDC_RADIO_NUMBER,"Button",BS_AUTORADIOBUTTON,35,60,68,10
    COMBOBOX        IDC_COMBO_SIZE,110,42,142,83,CBS_DROPDOWN | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    EDITTEXT        IDC_EDIT_NUMBER,110,59,65,14,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "Posledná časť:",IDC_STATIC_1,47,79,56,8
    EDITTEXT        IDC_EDIT_LASTPART,108,79,143,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,7,97,245,1
    PUSHBUTTON      "&Konfigurácia...",IDC_BUTTON_CONFIG,7,105,65,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,87,105,50,14
    PUSHBUTTON      "Zrušiť",IDCANCEL,144,105,50,14
    PUSHBUTTON      "Nápoveda",IDHELP,201,105,50,14
END

IDD_COMBINE DIALOGEX 30, 28, 270, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Spojenie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Die&lčie súbory:",IDC_STATIC_1,7,9,52,8
    LISTBOX         IDC_LIST_FILES,7,19,200,108,LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | LBS_WANTKEYBOARDINPUT | WS_VSCROLL | WS_HSCROLL | WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "&Hore",IDC_BUTTON_UP,214,20,50,14,WS_GROUP
    PUSHBUTTON      "&Dolu",IDC_BUTTON_DOWN,214,43,50,14
    PUSHBUTTON      "&Pridať...",IDC_BUTTON_ADD,214,66,50,14
    PUSHBUTTON      "&Odstrániť",IDC_BUTTON_REMOVE,214,89,50,14
    PUSHBUTTON      "&CRC...",IDC_BUTTON_CRC,214,112,50,14
    LTEXT           "&Spojiť do:",IDC_STATIC_2,7,136,51,8
    EDITTEXT        IDC_EDIT_TARGET,7,146,237,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE2,250,146,14,14,WS_GROUP
    LTEXT           "",IDC_STATIC_3,7,166,258,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,100,176,50,14,WS_GROUP
    PUSHBUTTON      "Zrušiť",IDCANCEL,157,176,50,14
    PUSHBUTTON      "Nápoveda",IDHELP,214,176,50,14
END

IDD_CRC DIALOGEX 39, 34, 162, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "CRC Test"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Zatvoriť",IDCANCEL,105,85,50,14
    LTEXT           "Vypočítané CRC:",IDC_STATIC_1,7,7,58,8
    EDITTEXT        IDC_EDIT_CRC1,21,23,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC2,86,23,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT           "Pôvodné CRC:",IDC_STATIC_2,7,44,50,8
    EDITTEXT        IDC_EDIT_CRC3,21,61,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC4,86,61,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,67,10,89,1
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,59,48,97,1
    ICON            "",IDC_ICON_WARN,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
    ICON            "",IDC_ICON_OK,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
END

