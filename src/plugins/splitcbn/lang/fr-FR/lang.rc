// French (fr-FR) resources for splitcbn. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/splitcbn/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\splitcbn.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 53, 55, 230, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration de Scinder & Combiner"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "&Inclure l'extension originale aux noms de fichiers résultants",IDC_CHECK_INCLUDE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,10,6,210,10
    CONTROL         "Créer un fichier &batch pour la combinaison",IDC_CHECK_CREATE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,19,156,10
    CONTROL         "Scinder vers l'&autre panneau",IDC_CHECK_SPLITOTHER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,32,109,10
    CONTROL         "Scinder vers le &sous-répertoire nommé par le fichier source",IDC_CHECK_SPLITSUB,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,45,211,10
    CONTROL         "&Combiner vers l'autre panneau",IDC_CHECK_COMBINEOTHER,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,58,116,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,76,222,1
    DEFPUSHBUTTON   "OK",IDOK,58,83,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,115,83,50,14
    PUSHBUTTON      "Aide",IDHELP,172,83,50,14
END

IDD_SPLIT DIALOGEX 32, 33, 269, 125
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Scinder"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_SPLIT_ICON,6,7,20,20,WS_GROUP
    CONTROL         "",IDC_STATIC_TITLE,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,35,9,222,8
    EDITTEXT        IDC_EDIT_DIR,35,19,209,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,248,19,14,14,WS_GROUP
    CONTROL         "&Taille de chaque partie:",IDC_RADIO_SIZE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,35,43,92,10
    CONTROL         "&Nombre de parties:",IDC_RADIO_NUMBER,"Button",BS_AUTORADIOBUTTON,35,60,78,10
    COMBOBOX        IDC_COMBO_SIZE,131,42,132,83,CBS_DROPDOWN | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    EDITTEXT        IDC_EDIT_NUMBER,131,59,60,14,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "Taille de la dernière partie:",IDC_STATIC_1,35,79,93,8
    EDITTEXT        IDC_EDIT_LASTPART,129,79,133,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,7,97,256,1
    PUSHBUTTON      "&Configurer...",IDC_BUTTON_CONFIG,7,105,60,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,98,105,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,155,105,50,14
    PUSHBUTTON      "Aide",IDHELP,212,105,50,14
END

IDD_COMBINE DIALOGEX 30, 28, 277, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Combiner"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Fichiers &partiels:",IDC_STATIC_1,7,9,57,8
    LISTBOX         IDC_LIST_FILES,7,19,207,108,LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | LBS_WANTKEYBOARDINPUT | WS_VSCROLL | WS_HSCROLL | WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "&Monter",IDC_BUTTON_UP,221,20,50,14,WS_GROUP
    PUSHBUTTON      "&Descendre",IDC_BUTTON_DOWN,221,43,50,14
    PUSHBUTTON      "&Ajouter...",IDC_BUTTON_ADD,221,66,50,14
    PUSHBUTTON      "&Supprimer",IDC_BUTTON_REMOVE,221,89,50,14
    PUSHBUTTON      "&CRC...",IDC_BUTTON_CRC,221,112,50,14
    LTEXT           "Combiner &vers:",IDC_STATIC_2,7,136,53,8
    EDITTEXT        IDC_EDIT_TARGET,7,146,244,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE2,257,146,14,14,WS_GROUP
    LTEXT           "",IDC_STATIC_3,7,166,265,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,107,176,50,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,164,176,50,14
    PUSHBUTTON      "Help",IDHELP,221,176,50,14
END

IDD_CRC DIALOGEX 39, 34, 162, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Test de CRC"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Fermer",IDCANCEL,105,85,50,14
    LTEXT           "CRC calculé:",IDC_STATIC_1,7,7,44,8
    EDITTEXT        IDC_EDIT_CRC1,21,23,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC2,86,23,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT           "CRC originel:",IDC_STATIC_2,7,44,46,8
    EDITTEXT        IDC_EDIT_CRC3,21,61,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC4,86,61,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,53,10,103,1
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,55,48,101,1
    ICON            "",IDC_ICON_WARN,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
    ICON            "",IDC_ICON_OK,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
END

