// Romanian (ro-RO) resources for splitcbn. Translation: Ioan Stefancu, Donca Radu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/splitcbn/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\splitcbn.rh2"

LANGUAGE LANG_ROMANIAN, SUBLANG_ROMANIAN_ROMANIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 53, 55, 210, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configurare Imparte & Combina"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "&Include extensia originala in nume fisiere iesire",IDC_CHECK_INCLUDE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,10,6,170,10
    CONTROL         "Creaza grup fisiere pentru com&binare",IDC_CHECK_CREATE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,19,138,10
    CONTROL         "Imparte in alt pan&ou",IDC_CHECK_SPLITOTHER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,32,82,10
    CONTROL         "Imparte in &subdirector denumit de fisierul sursa",IDC_CHECK_SPLITSUB,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,45,172,10
    CONTROL         "&Combina in alt panou",IDC_CHECK_COMBINEOTHER,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,58,84,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,76,202,1
    DEFPUSHBUTTON   "OK",IDOK,38,83,50,14,WS_GROUP
    PUSHBUTTON      "Anuleaza",IDCANCEL,95,83,50,14
    PUSHBUTTON      "Help",IDHELP,152,83,50,14
END

IDD_SPLIT DIALOGEX 32, 33, 264, 125
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Imparte"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_SPLIT_ICON,6,7,20,20,WS_GROUP
    CONTROL         "",IDC_STATIC_TITLE,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,35,9,217,8
    EDITTEXT        IDC_EDIT_DIR,35,19,204,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,243,19,14,14,WS_GROUP
    CONTROL         "&Marimea fiecarei parti:",IDC_RADIO_SIZE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,35,43,89,10
    CONTROL         "&Numar de parti:",IDC_RADIO_NUMBER,"Button",BS_AUTORADIOBUTTON,35,60,68,10
    COMBOBOX        IDC_COMBO_SIZE,126,42,132,83,CBS_DROPDOWN | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    EDITTEXT        IDC_EDIT_NUMBER,126,59,60,14,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "Marimea ultimei parti:",IDC_STATIC_1,47,79,76,8
    EDITTEXT        IDC_EDIT_LASTPART,124,79,133,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,7,97,251,1
    PUSHBUTTON      "&Configurare...",IDC_BUTTON_CONFIG,7,105,59,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,93,105,50,14
    PUSHBUTTON      "Anuleaza",IDCANCEL,150,105,50,14
    PUSHBUTTON      "Help",IDHELP,207,105,50,14
END

IDD_COMBINE DIALOGEX 30, 28, 270, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Combina"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Fisiere &partiale:",IDC_STATIC_1,7,9,54,8
    LISTBOX         IDC_LIST_FILES,7,19,200,108,LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | LBS_WANTKEYBOARDINPUT | WS_VSCROLL | WS_HSCROLL | WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "S&us",IDC_BUTTON_UP,214,20,50,14,WS_GROUP
    PUSHBUTTON      "&Jos",IDC_BUTTON_DOWN,214,43,50,14
    PUSHBUTTON      "&Adauga...",IDC_BUTTON_ADD,214,66,50,14
    PUSHBUTTON      "&Elimina",IDC_BUTTON_REMOVE,214,89,50,14
    PUSHBUTTON      "&CRC...",IDC_BUTTON_CRC,214,112,50,14
    LTEXT           "Com&bina in:",IDC_STATIC_2,7,136,51,8
    EDITTEXT        IDC_EDIT_TARGET,7,146,237,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE2,250,146,14,14,WS_GROUP
    LTEXT           "",IDC_STATIC_3,7,166,258,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,100,176,50,14,WS_GROUP
    PUSHBUTTON      "Anuleaza",IDCANCEL,157,176,50,14
    PUSHBUTTON      "Help",IDHELP,214,176,50,14
END

IDD_CRC DIALOGEX 39, 34, 162, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "CRC Test"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Inchide",IDCANCEL,105,85,50,14
    LTEXT           "CRC calculat:",IDC_STATIC_1,7,7,46,8
    EDITTEXT        IDC_EDIT_CRC1,21,23,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC2,86,23,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT           "CRC original:",IDC_STATIC_2,7,44,46,8
    EDITTEXT        IDC_EDIT_CRC3,21,61,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC4,86,61,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,55,10,101,1
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,55,48,101,1
    ICON            "",IDC_ICON_WARN,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
    ICON            "",IDC_ICON_OK,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
END

