// Korean (ko-KR) resources for splitcbn. Translation: Sally contributors (AI-assisted).
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/splitcbn/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\splitcbn.rh2"

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 53, 55, 210, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "분할 및 결합 설정"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "출력 파일 이름에 원래 확장명 포함(&I)",IDC_CHECK_INCLUDE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,10,6,166,10
    CONTROL         "결합용 배치 파일 만들기(&B)",IDC_CHECK_CREATE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,19,116,10
    CONTROL         "다른 패널로 분할(&O)",IDC_CHECK_SPLITOTHER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,32,90,10
    CONTROL         "원본 파일 이름의 하위 디렉터리로 분할(&S)",IDC_CHECK_SPLITSUB,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,45,152,10
    CONTROL         "다른 패널로 결합(&C)",IDC_CHECK_COMBINEOTHER,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,58,104,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,76,202,1
    DEFPUSHBUTTON   "확인",IDOK,38,83,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,95,83,50,14
    PUSHBUTTON      "도움말",IDHELP,152,83,50,14
END

IDD_SPLIT DIALOGEX 32, 33, 248, 125
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "분할"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_SPLIT_ICON,6,7,20,20,WS_GROUP
    CONTROL         "",IDC_STATIC_TITLE,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,35,9,201,8
    EDITTEXT        IDC_EDIT_DIR,35,19,188,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,227,19,14,14,WS_GROUP
    CONTROL         "각 부분의 크기(&S):",IDC_RADIO_SIZE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,35,43,78,10
    CONTROL         "부분 수(&N):",IDC_RADIO_NUMBER,"Button",BS_AUTORADIOBUTTON,35,60,70,10
    COMBOBOX        IDC_COMBO_SIZE,115,42,127,83,CBS_DROPDOWN | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    EDITTEXT        IDC_EDIT_NUMBER,115,59,55,14,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "마지막 부분의 크기:",IDC_STATIC_1,47,79,65,8
    EDITTEXT        IDC_EDIT_LASTPART,115,79,126,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,7,97,235,1
    PUSHBUTTON      "설정(&C)...",IDC_BUTTON_CONFIG,7,105,50,14,WS_GROUP
    DEFPUSHBUTTON   "확인",IDOK,77,105,50,14
    PUSHBUTTON      "취소",IDCANCEL,134,105,50,14
    PUSHBUTTON      "도움말",IDHELP,191,105,50,14
END

IDD_COMBINE DIALOGEX 30, 28, 270, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "결합"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "부분 파일(&P):",IDC_STATIC_1,7,9,49,8
    LISTBOX         IDC_LIST_FILES,7,19,200,108,LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | LBS_WANTKEYBOARDINPUT | WS_VSCROLL | WS_HSCROLL | WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "위로(&U)",IDC_BUTTON_UP,214,20,50,14,WS_GROUP
    PUSHBUTTON      "아래로(&D)",IDC_BUTTON_DOWN,214,43,50,14
    PUSHBUTTON      "추가(&A)...",IDC_BUTTON_ADD,214,66,50,14
    PUSHBUTTON      "제거(&R)",IDC_BUTTON_REMOVE,214,89,50,14
    PUSHBUTTON      "CRC(&C)...",IDC_BUTTON_CRC,214,112,50,14
    LTEXT           "결합 대상(&T):",IDC_STATIC_2,7,136,41,8
    EDITTEXT        IDC_EDIT_TARGET,7,146,237,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE2,250,146,14,14,WS_GROUP
    LTEXT           "",IDC_STATIC_3,7,166,259,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "확인",IDOK,100,176,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,157,176,50,14
    PUSHBUTTON      "도움말",IDHELP,214,176,50,14
END

IDD_CRC DIALOGEX 39, 34, 162, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "CRC 테스트"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "닫기",IDCANCEL,105,85,50,14
    LTEXT           "계산된 CRC:",IDC_STATIC_1,7,7,47,8
    EDITTEXT        IDC_EDIT_CRC1,21,23,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC2,86,23,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT           "원래 CRC:",IDC_STATIC_2,7,44,38,8
    EDITTEXT        IDC_EDIT_CRC3,21,61,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC4,86,61,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,56,10,100,1
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,47,48,109,1
    ICON            "",IDC_ICON_WARN,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
    ICON            "",IDC_ICON_OK,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
END

