// German (de-DE) resources for splitcbn. Translation: Dirk Bornhütter, Thomas Kelso, Thomas Pagels, Thomas Wölk, Marko Meister und Mick Weiss.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/splitcbn/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\splitcbn.rh2"

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 53, 55, 225, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Teilen & Zusammenfügen - Konfiguration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Ursprüngliche &Erweiterung in neuen Dateinamen erhalten",IDC_CHECK_INCLUDE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,10,6,207,10
    CONTROL         "&Batchdatei für das Zusammenfügen anlegen",IDC_CHECK_CREATE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,19,162,10
    CONTROL         "In das &andere Dateifenster teilen",IDC_CHECK_SPLITOTHER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,32,123,10
    CONTROL         "In nach &Quelldatei benanntem Unterverzeichnis teilen",IDC_CHECK_SPLITSUB,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,45,192,10
    CONTROL         "In das andere &Dateifenster zusammenfügen",IDC_CHECK_COMBINEOTHER,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,58,160,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,76,217,1
    DEFPUSHBUTTON   "OK",IDOK,53,83,50,14,WS_GROUP
    PUSHBUTTON      "Abbrechen",IDCANCEL,110,83,50,14
    PUSHBUTTON      "Hilfe",IDHELP,167,83,50,14
END

IDD_SPLIT DIALOGEX 32, 33, 275, 125
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Teilen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_SPLIT_ICON,6,7,20,20,WS_GROUP
    CONTROL         "",IDC_STATIC_TITLE,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,35,9,228,8
    EDITTEXT        IDC_EDIT_DIR,35,19,215,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,254,19,14,14,WS_GROUP
    CONTROL         "&Größe der einzelnen Teile:",IDC_RADIO_SIZE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,35,43,101,10
    CONTROL         "&Anzahl der Teile:",IDC_RADIO_NUMBER,"Button",BS_AUTORADIOBUTTON,35,60,70,10
    COMBOBOX        IDC_COMBO_SIZE,137,42,132,83,CBS_DROPDOWN | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    EDITTEXT        IDC_EDIT_NUMBER,137,59,60,14,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "Größe des letzten Teils:",IDC_STATIC_1,47,79,81,8
    EDITTEXT        IDC_EDIT_LASTPART,135,79,133,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,7,97,262,1
    PUSHBUTTON      "&Konfigurieren...",IDC_BUTTON_CONFIG,7,105,65,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,104,105,50,14
    PUSHBUTTON      "Abbrechen",IDCANCEL,161,105,50,14
    PUSHBUTTON      "Hilfe",IDHELP,218,105,50,14
END

IDD_COMBINE DIALOGEX 30, 28, 285, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Zusammenfügen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Teildateien:",IDC_STATIC_1,7,9,47,8
    LISTBOX         IDC_LIST_FILES,7,19,207,108,LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | LBS_WANTKEYBOARDINPUT | WS_VSCROLL | WS_HSCROLL | WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Nach &oben",IDC_BUTTON_UP,221,20,58,14,WS_GROUP
    PUSHBUTTON      "Nach &unten",IDC_BUTTON_DOWN,221,43,58,14
    PUSHBUTTON      "&Hinzufügen...",IDC_BUTTON_ADD,221,66,58,14
    PUSHBUTTON      "&Entfernen",IDC_BUTTON_REMOVE,221,89,58,14
    PUSHBUTTON      "&CRC...",IDC_BUTTON_CRC,221,112,58,14
    LTEXT           "&Zusammenfügen zu:",IDC_STATIC_2,7,136,72,8
    EDITTEXT        IDC_EDIT_TARGET,7,146,252,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE2,265,146,14,14,WS_GROUP
    LTEXT           "",IDC_STATIC_3,7,166,273,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,115,176,50,14,WS_GROUP
    PUSHBUTTON      "Abbrechen",IDCANCEL,172,176,50,14
    PUSHBUTTON      "Hilfe",IDHELP,229,176,50,14
END

IDD_CRC DIALOGEX 39, 34, 162, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "CRC Test"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Beenden",IDCANCEL,105,85,50,14
    LTEXT           "Berechnete CRC:",IDC_STATIC_1,7,7,59,8
    EDITTEXT        IDC_EDIT_CRC1,21,23,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC2,86,23,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT           "Original CRC:",IDC_STATIC_2,7,44,47,8
    EDITTEXT        IDC_EDIT_CRC3,21,61,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC4,86,61,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,68,10,88,1
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,56,48,100,1
    ICON            "",IDC_ICON_WARN,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
    ICON            "",IDC_ICON_OK,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
END

