// Hungarian (hu-HU) resources for splitcbn. Translation: Török József.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/splitcbn/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\splitcbn.rh2"

LANGUAGE LANG_HUNGARIAN, SUBLANG_HUNGARIAN_HUNGARY

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 53, 55, 210, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Darabolás és Összeillesztés beállítás"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Eredet&i kiterjesztés a kimeneti fájlnevekben",IDC_CHECK_INCLUDE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,10,6,158,10
    CONTROL         "&Parancsfájl létrehozása összeillesztéshez",IDC_CHECK_CREATE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,19,149,10
    CONTROL         "Darab&olás a másik panelra",IDC_CHECK_SPLITOTHER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,32,101,10
    CONTROL         "Darabolá&s a forrásfájl nevű almappába",IDC_CHECK_SPLITSUB,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,45,142,10
    CONTROL         "Öss&zeillesztés a másik panelra",IDC_CHECK_COMBINEOTHER,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,58,114,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,76,202,1
    DEFPUSHBUTTON   "OK",IDOK,38,83,50,14,WS_GROUP
    PUSHBUTTON      "Mégse",IDCANCEL,95,83,50,14
    PUSHBUTTON      "Súgó",IDHELP,152,83,50,14
END

IDD_SPLIT DIALOGEX 32, 33, 248, 125
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Darabolás"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_SPLIT_ICON,6,7,20,20,WS_GROUP
    CONTROL         "",IDC_STATIC_TITLE,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,35,9,201,8
    EDITTEXT        IDC_EDIT_DIR,35,19,188,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,227,19,14,14,WS_GROUP
    CONTROL         "&Darabok mérete:",IDC_RADIO_SIZE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,35,43,71,10
    CONTROL         "Darabok &száma:",IDC_RADIO_NUMBER,"Button",BS_AUTORADIOBUTTON,35,60,68,10
    COMBOBOX        IDC_COMBO_SIZE,110,42,132,83,CBS_DROPDOWN | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    EDITTEXT        IDC_EDIT_NUMBER,110,59,60,14,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "Utolsó mérete:",IDC_STATIC_1,47,79,56,8
    EDITTEXT        IDC_EDIT_LASTPART,108,79,133,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,7,97,235,1
    PUSHBUTTON      "&Beállítás...",IDC_BUTTON_CONFIG,7,105,50,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,77,105,50,14
    PUSHBUTTON      "Mégse",IDCANCEL,134,105,50,14
    PUSHBUTTON      "Súgó",IDHELP,191,105,50,14
END

IDD_COMBINE DIALOGEX 30, 28, 277, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Összeillesztés"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Ré&szleges fájlok:",IDC_STATIC_1,7,9,58,8
    LISTBOX         IDC_LIST_FILES,7,19,207,108,LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | LBS_WANTKEYBOARDINPUT | WS_VSCROLL | WS_HSCROLL | WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "&Fel",IDC_BUTTON_UP,221,20,50,14,WS_GROUP
    PUSHBUTTON      "&Le",IDC_BUTTON_DOWN,221,43,50,14
    PUSHBUTTON      "Hozzá&ad...",IDC_BUTTON_ADD,221,66,50,14
    PUSHBUTTON      "Tö&röl",IDC_BUTTON_REMOVE,221,89,50,14
    PUSHBUTTON      "&CRC...",IDC_BUTTON_CRC,221,112,50,14
    LTEXT           "Összeállí&tás ezzé:",IDC_STATIC_2,7,136,62,8
    EDITTEXT        IDC_EDIT_TARGET,7,146,244,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE2,257,146,14,14,WS_GROUP
    LTEXT           "",IDC_STATIC_3,7,166,265,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,107,176,50,14,WS_GROUP
    PUSHBUTTON      "Mégse",IDCANCEL,164,176,50,14
    PUSHBUTTON      "Súgó",IDHELP,221,176,50,14
END

IDD_CRC DIALOGEX 39, 34, 162, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "CRC teszt"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Bezárás",IDCANCEL,105,85,50,14
    LTEXT           "Számolt CRC:",IDC_STATIC_1,7,7,46,8
    EDITTEXT        IDC_EDIT_CRC1,21,23,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC2,86,23,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT           "Eredeti CRC:",IDC_STATIC_2,7,44,44,8
    EDITTEXT        IDC_EDIT_CRC3,21,61,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC4,86,61,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,54,10,102,1
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,52,48,104,1
    ICON            "",IDC_ICON_WARN,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
    ICON            "",IDC_ICON_OK,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
END

