// Spanish (es-ES) resources for splitcbn. Translation: Juan Pablo Barrio Lera.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/splitcbn/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\splitcbn.rh2"

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 53, 55, 230, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuración de Dividir &y combinar"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "&Incluir extensión original a los nombres de fichero de salida",IDC_CHECK_INCLUDE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,10,6,212,10
    CONTROL         "Crear fichero por &lotes para combinar",IDC_CHECK_CREATE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,19,138,10
    CONTROL         "Dividir al &otro panel",IDC_CHECK_SPLITOTHER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,32,78,10
    CONTROL         "Dividir al &subdirectorio nombrado por fichero origen",IDC_CHECK_SPLITSUB,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,45,186,10
    CONTROL         "&Combinar al otro panel",IDC_CHECK_COMBINEOTHER,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,58,89,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,76,222,1
    DEFPUSHBUTTON   "Aceptar",IDOK,58,83,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",IDCANCEL,115,83,50,14
    PUSHBUTTON      "Ayuda",IDHELP,172,83,50,14
END

IDD_SPLIT DIALOGEX 32, 33, 278, 125
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Dividir"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "",IDC_SPLIT_ICON,6,7,20,20,WS_GROUP
    CONTROL         "",IDC_STATIC_TITLE,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,35,9,231,8
    EDITTEXT        IDC_EDIT_DIR,35,19,218,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,257,19,14,14,WS_GROUP
    CONTROL         "&Tamaño de parte:",IDC_RADIO_SIZE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,35,43,73,10
    CONTROL         "&Número de partes:",IDC_RADIO_NUMBER,"Button",BS_AUTORADIOBUTTON,35,60,76,10
    COMBOBOX        IDC_COMBO_SIZE,130,42,140,83,CBS_DROPDOWN | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    EDITTEXT        IDC_EDIT_NUMBER,130,59,60,14,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "Tamaño de última parte:",IDC_STATIC_1,45,79,86,8
    EDITTEXT        IDC_EDIT_LASTPART,132,79,137,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_2,"Static",SS_ETCHEDHORZ | WS_GROUP,7,97,267,1
    PUSHBUTTON      "&Configurar...",IDC_BUTTON_CONFIG,7,105,60,14,WS_GROUP
    DEFPUSHBUTTON   "Aceptar",IDOK,107,105,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,164,105,50,14
    PUSHBUTTON      "Ayuda",IDHELP,221,105,50,14
END

IDD_COMBINE DIALOGEX 30, 28, 270, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Combinar"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Ficheros parciales:",IDC_STATIC_1,7,9,64,8
    LISTBOX         IDC_LIST_FILES,7,19,200,108,LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | LBS_WANTKEYBOARDINPUT | WS_VSCROLL | WS_HSCROLL | WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "A&rriba",IDC_BUTTON_UP,214,20,50,14,WS_GROUP
    PUSHBUTTON      "A&bajo",IDC_BUTTON_DOWN,214,43,50,14
    PUSHBUTTON      "&Añadir...",IDC_BUTTON_ADD,214,66,50,14
    PUSHBUTTON      "&Quitar",IDC_BUTTON_REMOVE,214,89,50,14
    PUSHBUTTON      "&CRC...",IDC_BUTTON_CRC,214,112,50,14
    LTEXT           "Combinar &en:",IDC_STATIC_2,7,136,51,8
    EDITTEXT        IDC_EDIT_TARGET,7,146,237,14,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE2,250,146,14,14,WS_GROUP
    LTEXT           "",IDC_STATIC_3,7,166,258,1,SS_ETCHEDHORZ | WS_GROUP
    DEFPUSHBUTTON   "Aceptar",IDOK,100,176,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",IDCANCEL,157,176,50,14
    PUSHBUTTON      "Ayuda",IDHELP,214,176,50,14
END

IDD_CRC DIALOGEX 39, 34, 162, 106
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Prueba CRC"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Cerrar",IDCANCEL,105,85,50,14
    LTEXT           "CRC calculado:",IDC_STATIC_1,7,7,52,8
    EDITTEXT        IDC_EDIT_CRC1,21,23,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC2,86,23,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT           "CRC original:",IDC_STATIC_2,7,44,46,8
    EDITTEXT        IDC_EDIT_CRC3,21,61,62,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_EDIT_CRC4,86,61,69,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,61,10,95,1
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,55,48,101,1
    ICON            "",IDC_ICON_WARN,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
    ICON            "",IDC_ICON_OK,7,22,20,20,SS_REALSIZEIMAGE | NOT WS_VISIBLE
END

