// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/dbviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\dbviewer.rh2"

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_PROPERTIES DIALOGEX 28, 35, 235, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Propiedades"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Aceptar",IDOK,179,162,50,14,WS_GROUP
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,155,227,1
    EDITTEXT        IDC_PROP_INFO,5,5,224,143,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

IDD_CONFIGURATION DIALOGEX 26, 35, 282, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuración del visor de bases de datos"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Fuente",IDC_STATIC_1,6,10,270,35,WS_GROUP
    PUSHBUTTON      "&Fuente",IDB_CFG_FONT,13,23,50,14,WS_GROUP
    EDITTEXT        IDE_CFG_FONT,69,23,200,14,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    GROUPBOX        "Posición de ventana",IDC_STATIC_2,6,48,270,27,WS_GROUP
    CONTROL         "&Guardar al cerrar",IDC_CFG_SAVEPOSONCLOSE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,58,70,12
    CONTROL         "&Como la ventana principal de Sally",IDC_CFG_SETBYMAINWINDOW,
                    "Button",BS_AUTORADIOBUTTON,118,58,152,12
    PUSHBUTTON      "Opciones CSV...",IDB_CFG_CSVOPTIONS,13,85,70,14,WS_GROUP
    DEFPUSHBUTTON   "Aceptar",IDOK,113,85,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,168,85,50,14
    PUSHBUTTON      "Ayuda",IDHELP,223,85,50,14
END

IDD_COLUMNS DIALOGEX 26, 35, 282, 178
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Campos"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_COL_LV,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,6,6,270,142
    LTEXT           "",IDC_STATIC_1,4,153,273,1,SS_ETCHEDHORZ | WS_GROUP
    PUSHBUTTON      "&Valores por omisión",IDC_COL_RESTORE,6,159,80,14,WS_GROUP
    DEFPUSHBUTTON   "Aceptar",IDOK,115,159,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",IDCANCEL,170,159,50,14
    PUSHBUTTON      "Ayuda",IDHELP,225,159,50,14
END

IDD_CSV_CONFIG DIALOGEX 35, 35, 327, 137
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Opciones CSV"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "&Separador",IDC_STATIC_1,6,6,98,101,WS_GROUP
    CONTROL         "Autoselección",IDC_CSV_AS_SEP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,15,18,70,12
    CONTROL         "Tabulador",IDC_CSV_TABULATOR,"Button",BS_AUTORADIOBUTTON,15,32,70,12
    CONTROL         "Punto y coma (;)",IDC_CSV_SEMICOLON,"Button",BS_AUTORADIOBUTTON,15,46,70,12
    CONTROL         "Coma (,)",IDC_CSV_COMMA,"Button",BS_AUTORADIOBUTTON,15,60,70,12
    CONTROL         "Espacio ( )",IDC_CSV_SPACE,"Button",BS_AUTORADIOBUTTON,15,74,70,12
    CONTROL         "Otro",IDC_CSV_OTHER,"Button",BS_AUTORADIOBUTTON,15,88,28,12
    EDITTEXT        IDE_CSV_OTHER,44,88,16,12,WS_GROUP
    GROUPBOX        "&Calificador de texto",IDC_STATIC_2,114,6,98,101,WS_GROUP
    CONTROL         "Autoselección",IDC_CSV_AS_TQ,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,123,18,70,12
    CONTROL         "Comillas dobles ("")",IDC_CSV_DOUBLE,"Button",BS_AUTORADIOBUTTON,123,32,79,12
    CONTROL         "Comillas (')",IDC_CSV_QUOTES,"Button",BS_AUTORADIOBUTTON,123,46,70,12
    CONTROL         "Ninguno",IDC_CSV_NONE,"Button",BS_AUTORADIOBUTTON,123,60,70,12
    GROUPBOX        "&Primera fila",IDC_STATIC_3,222,6,98,101,WS_GROUP
    CONTROL         "Autoselección",IDC_CSV_AS_FR,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,231,18,70,12
    CONTROL         "Nombres de columna",IDC_CSV_ASHEADER,"Button",BS_AUTORADIOBUTTON,231,32,84,12
    CONTROL         "Como datos",IDC_CSV_ASDATA,"Button",BS_AUTORADIOBUTTON,231,46,70,12
    DEFPUSHBUTTON   "Aceptar",IDOK,160,118,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",IDCANCEL,215,118,50,14
    PUSHBUTTON      "Ayuda",IDHELP,270,118,50,14
    PUSHBUTTON      "&Valores por omisión",IDC_CSV_SETDEF,6,118,80,14,WS_GROUP
END

IDD_FIND DIALOGEX 81, 47, 217, 131
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Buscar"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,36,11,173,1
    LTEXT           "&Buscar",IDC_STATIC_2,9,7,25,8
    COMBOBOX        IDC_FIND_TEXT,16,17,189,64,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,44,47,165,1
    LTEXT           "Opciones",IDC_STATIC_4,9,43,33,8
    CONTROL         "Buscar hacia &adelante",IDC_FIND_SFORWARD,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,16,53,86,12
    CONTROL         "Buscar hacia a&trás",IDC_FIND_SBACKWARD,"Button",BS_AUTORADIOBUTTON,16,65,74,12
    CONTROL         "&Palabras completas",IDC_FIND_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,113,53,78,12
    CONTROL         "&Distinguir M/minúsculas",IDC_FIND_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,65,93,12
    CONTROL         "&Expresión regular",IDC_FIND_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,77,71,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,8,102,201,1
    DEFPUSHBUTTON   "Aceptar",IDOK,23,110,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",IDCANCEL,83,110,50,14
    PUSHBUTTON      "Ayuda",IDHELP,143,110,50,14
END

IDD_GOTO DIALOGEX 85, 100, 125, 54
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ir a registro"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Registro:",IDC_STATIC_1,8,9,32,8,NOT WS_GROUP
    EDITTEXT        IDC_GOTO_RECORD,41,7,74,12,ES_NUMBER
    DEFPUSHBUTTON   "Aceptar",IDOK,9,32,50,14,BS_CENTER
    PUSHBUTTON      "Cancelar",IDCANCEL,66,32,50,14,BS_CENTER
END

