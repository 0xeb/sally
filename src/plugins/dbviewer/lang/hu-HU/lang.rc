    CONTROL         "Nincs",IDC_CSV_NONE,"Button",BS_AUTORADIOBUTTON,110,60,60,12
    GROUPBOX        "&Első sor",IDC_STATIC_3,196,6,85,101,WS_GROUP
    CONTROL         "Auto-kijelölés",IDC_CSV_AS_FR,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,205,18,60,12
    CONTROL         "Oszlop nevekként",IDC_CSV_ASHEADER,"Button",BS_AUTORADIOBUTTON,205,32,70,12
    CONTROL         "Adatként",IDC_CSV_ASDATA,"Button",BS_AUTORADIOBUTTON,205,46,60,12
    DEFPUSHBUTTON   "OK",IDOK,121,118,50,14,WS_GROUP
    PUSHBUTTON      "Mégse",IDCANCEL,176,118,50,14
    PUSHBUTTON      "Súgó",IDHELP,231,118,50,14
    PUSHBUTTON      "Ez &legyen az alap",IDC_CSV_SETDEF,6,118,70,14,WS_GROUP
END

IDD_FIND DIALOGEX 81, 47, 210, 131
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Keresés"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,30,11,172,1
    LTEXT           "Ke&res",IDC_STATIC_2,9,7,20,8
    COMBOBOX        IDC_FIND_TEXT,16,17,182,64,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,49,47,153,1
    LTEXT           "Beállítások",IDC_STATIC_4,9,43,38,8
    CONTROL         "Keresés &előre",IDC_FIND_SFORWARD,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,16,53,66,12
    CONTROL         "Keresés &vissza",IDC_FIND_SBACKWARD,"Button",BS_AUTORADIOBUTTON,16,65,72,12
    CONTROL         "&Teljes szavak",IDC_FIND_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,113,53,57,12
    CONTROL         "&Nagybetű érzékeny",IDC_FIND_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,65,76,12
    CONTROL         "&Szabályos kifejezés",IDC_FIND_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,77,77,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,8,102,194,1
    DEFPUSHBUTTON   "OK",IDOK,20,110,50,14,WS_GROUP
    PUSHBUTTON      "Mégse",IDCANCEL,80,110,50,14
    PUSHBUTTON      "Súgó",IDHELP,140,110,50,14
END

IDD_GOTO DIALOGEX 85, 100, 123, 54
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Rekordra ugrás"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
