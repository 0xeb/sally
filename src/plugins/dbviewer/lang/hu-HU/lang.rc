// Dialogs

IDD_PROPERTIES DIALOGEX 28, 35, 235, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Tulajdonságok"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,179,162,50,14,WS_GROUP
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,155,227,1
    EDITTEXT        IDC_PROP_INFO,5,5,224,143,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

IDD_CONFIGURATION DIALOGEX 26, 35, 282, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Adatbázis Néző beállítások"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Betűtípus",IDC_STATIC_1,6,10,270,35,WS_GROUP
    PUSHBUTTON      "&Betűtípus",IDB_CFG_FONT,13,23,50,14,WS_GROUP
    EDITTEXT        IDE_CFG_FONT,69,23,200,14,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    GROUPBOX        "Ablak pozíció",IDC_STATIC_2,6,48,270,27,WS_GROUP
    CONTROL         "Menté&s bezáráskor",IDC_CFG_SAVEPOSONCLOSE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,58,76,12
    CONTROL         "A Salamand&er fő ablakához igazítás",IDC_CFG_SETBYMAINWINDOW,
                    "Button",BS_AUTORADIOBUTTON,114,58,156,12
    PUSHBUTTON      "CSV beállítások...",IDB_CFG_CSVOPTIONS,13,85,70,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,113,85,50,14
    PUSHBUTTON      "Mégse",IDCANCEL,168,85,50,14
    PUSHBUTTON      "Súgó",IDHELP,223,85,50,14
END

IDD_COLUMNS DIALOGEX 26, 35, 282, 178
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Mezők"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
