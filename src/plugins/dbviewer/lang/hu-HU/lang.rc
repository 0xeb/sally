    LTEXT           "",IDC_STATIC_1,4,153,273,1,SS_ETCHEDHORZ | WS_GROUP
    PUSHBUTTON      "Visszaállítá&s",IDC_COL_RESTORE,6,159,69,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,115,159,50,14,WS_GROUP
    PUSHBUTTON      "Mégse",IDCANCEL,170,159,50,14
    PUSHBUTTON      "Súgó",IDHELP,225,159,50,14
END

IDD_CSV_CONFIG DIALOGEX 35, 35, 288, 137
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "CSV beállítások"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
