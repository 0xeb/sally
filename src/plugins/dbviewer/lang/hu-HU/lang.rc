    EDITTEXT        IDE_CSV_OTHER,49,88,16,12,WS_GROUP
    GROUPBOX        "S&zöveg határoló",IDC_STATIC_2,101,6,85,101,WS_GROUP
    CONTROL         "Auto-kijelölés",IDC_CSV_AS_TQ,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,110,18,60,12
