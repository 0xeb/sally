// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/dbviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\dbviewer.rh2"

LANGUAGE LANG_CZECH, SUBLANG_CZECH_CZECH_REPUBLIC

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_PROPERTIES DIALOGEX 28, 35, 235, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Vlastnosti"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,179,162,50,14,WS_GROUP
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,155,227,1
    EDITTEXT        IDC_PROP_INFO,5,5,224,143,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

IDD_CONFIGURATION DIALOGEX 26, 35, 282, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Prohlížeč databází - Konfigurace"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Písmo",IDC_STATIC_1,6,10,270,35,WS_GROUP
    PUSHBUTTON      "&Písmo",IDB_CFG_FONT,13,23,50,14,WS_GROUP
    EDITTEXT        IDE_CFG_FONT,69,23,200,14,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    GROUPBOX        "Pozice okna",IDC_STATIC_2,6,48,270,27,WS_GROUP
    CONTROL         "&Uložit a zavřít",IDC_CFG_SAVEPOSONCLOSE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,58,63,12
    CONTROL         "&Nastavit pozici na hlavní okno Sally",IDC_CFG_SETBYMAINWINDOW,
                    "Button",BS_AUTORADIOBUTTON,112,58,158,12
    PUSHBUTTON      "Možnosti CSV...",IDB_CFG_CSVOPTIONS,13,85,62,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,113,85,50,14
    PUSHBUTTON      "Storno",IDCANCEL,168,85,50,14
    PUSHBUTTON      "Nápověda",IDHELP,223,85,50,14
END

IDD_COLUMNS DIALOGEX 26, 35, 282, 178
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Pole"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_COL_LV,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,6,6,270,142
    LTEXT           "",IDC_STATIC_1,4,153,273,1,SS_ETCHEDHORZ | WS_GROUP
    PUSHBUTTON      "&Obnovit výchozí",IDC_COL_RESTORE,6,159,69,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,115,159,50,14,WS_GROUP
    PUSHBUTTON      "Storno",IDCANCEL,170,159,50,14
    PUSHBUTTON      "Nápověda",IDHELP,225,159,50,14
END

IDD_CSV_CONFIG DIALOGEX 35, 35, 318, 137
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Možnosti CSV"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "&Oddělovač",IDC_STATIC_1,6,6,95,101,WS_GROUP
    CONTROL         "Auto-Výběr",IDC_CSV_AS_SEP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,15,18,60,12
    CONTROL         "Tabulátor",IDC_CSV_TABULATOR,"Button",BS_AUTORADIOBUTTON,15,32,60,12
    CONTROL         "Středník (;)",IDC_CSV_SEMICOLON,"Button",BS_AUTORADIOBUTTON,15,46,60,12
    CONTROL         "Čárka (,)",IDC_CSV_COMMA,"Button",BS_AUTORADIOBUTTON,15,60,60,12
    CONTROL         "Mezera ( )",IDC_CSV_SPACE,"Button",BS_AUTORADIOBUTTON,15,74,60,12
    CONTROL         "Jiný",IDC_CSV_OTHER,"Button",BS_AUTORADIOBUTTON,15,88,31,12
    EDITTEXT        IDE_CSV_OTHER,48,88,16,12,WS_GROUP
    GROUPBOX        "Označení &textu",IDC_STATIC_2,111,6,95,101,WS_GROUP
    CONTROL         "Auto-Výběr",IDC_CSV_AS_TQ,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,120,18,60,12
    CONTROL         "Dvojité uvozovky ("")",IDC_CSV_DOUBLE,"Button",BS_AUTORADIOBUTTON,120,32,81,12
    CONTROL         "Uvozovky (')",IDC_CSV_QUOTES,"Button",BS_AUTORADIOBUTTON,120,46,60,12
    CONTROL         "Není",IDC_CSV_NONE,"Button",BS_AUTORADIOBUTTON,120,60,60,12
    GROUPBOX        "&První řada",IDC_STATIC_3,216,6,95,101,WS_GROUP
    CONTROL         "Auto-Výběr",IDC_CSV_AS_FR,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,225,18,60,12
    CONTROL         "Jako název sloupce",IDC_CSV_ASHEADER,"Button",BS_AUTORADIOBUTTON,225,32,77,12
    CONTROL         "Jako data",IDC_CSV_ASDATA,"Button",BS_AUTORADIOBUTTON,225,46,60,12
    DEFPUSHBUTTON   "OK",IDOK,146,118,50,14,WS_GROUP
    PUSHBUTTON      "Storno",IDCANCEL,201,118,50,14
    PUSHBUTTON      "Nápověda",IDHELP,256,118,50,14
    PUSHBUTTON      "&Uložit jako Výchozí",IDC_CSV_SETDEF,6,118,75,14,WS_GROUP
END

IDD_FIND DIALOGEX 81, 47, 229, 131
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Hledání"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,28,11,193,1
    LTEXT           "&Najít",IDC_STATIC_2,9,7,17,8
    COMBOBOX        IDC_FIND_TEXT,16,17,201,64,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,44,47,177,1
    LTEXT           "Nastavení",IDC_STATIC_4,9,43,34,8
    CONTROL         "Hledat &dopředu",IDC_FIND_SFORWARD,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,16,53,66,12
    CONTROL         "Hledat do&zadu",IDC_FIND_SBACKWARD,"Button",BS_AUTORADIOBUTTON,16,65,72,12
    CONTROL         "&Celá slova",IDC_FIND_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,113,53,57,12
    CONTROL         "Rozlišovat &velikost písmen",IDC_FIND_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,65,100,12
    CONTROL         "&Regulární výraz",IDC_FIND_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,77,75,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,8,102,213,1
    DEFPUSHBUTTON   "OK",IDOK,29,110,50,14,WS_GROUP
    PUSHBUTTON      "Storno",IDCANCEL,89,110,50,14
    PUSHBUTTON      "Nápověda",IDHELP,149,110,50,14
END

IDD_GOTO DIALOGEX 85, 100, 125, 54
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Přejít na záznam"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Záznam:",IDC_STATIC_1,8,9,32,8,NOT WS_GROUP
    EDITTEXT        IDC_GOTO_RECORD,42,7,74,12,ES_NUMBER
    DEFPUSHBUTTON   "OK",IDOK,9,32,50,14,BS_CENTER
    PUSHBUTTON      "Storno",IDCANCEL,66,32,50,14,BS_CENTER
END

