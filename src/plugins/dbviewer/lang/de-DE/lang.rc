// German (de-DE) resources for dbviewer. Translation: Dirk Bornhütter, Thomas Kelso, Thomas Pagels, Thomas Wölk, Marko Meister und Mick Weiss.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/dbviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\dbviewer.rh2"

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_PROPERTIES DIALOGEX 28, 35, 235, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Eigenschaften"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,179,162,50,14,WS_GROUP
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,155,227,1
    EDITTEXT        IDC_PROP_INFO,5,5,224,143,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

IDD_CONFIGURATION DIALOGEX 26, 35, 292, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Datenbankbetrachter - Konfiguration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Schrift",IDC_STATIC_1,6,10,280,35,WS_GROUP
    PUSHBUTTON      "&Schrift",IDB_CFG_FONT,13,23,50,14,WS_GROUP
    EDITTEXT        IDE_CFG_FONT,69,23,210,14,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    GROUPBOX        "Fensterposition",IDC_STATIC_2,6,48,280,27,WS_GROUP
    CONTROL         "Beim &Beenden speichern",IDC_CFG_SAVEPOSONCLOSE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,58,96,12
    CONTROL         "Wie &Position des Sally Hauptfensters",IDC_CFG_SETBYMAINWINDOW,
                    "Button",BS_AUTORADIOBUTTON,122,58,158,12
    PUSHBUTTON      "CSV Optionen...",IDB_CFG_CSVOPTIONS,13,85,70,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,123,85,50,14
    PUSHBUTTON      "Abbrechen",IDCANCEL,178,85,50,14
    PUSHBUTTON      "Hilfe",IDHELP,233,85,50,14
END

IDD_COLUMNS DIALOGEX 26, 35, 292, 178
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Felder"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_COL_LV,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,6,6,280,142
    LTEXT           "",IDC_STATIC_1,4,153,283,1,SS_ETCHEDHORZ | WS_GROUP
    PUSHBUTTON      "&Standard wiederherstellen",IDC_COL_RESTORE,6,159,100,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,125,159,50,14,WS_GROUP
    PUSHBUTTON      "Abbrechen",IDCANCEL,180,159,50,14
    PUSHBUTTON      "Hilfe",IDHELP,235,159,50,14
END

IDD_CSV_CONFIG DIALOGEX 35, 35, 333, 137
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "CSV Optionen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Trenn&zeichen",IDC_STATIC_1,6,6,100,101,WS_GROUP
    CONTROL         "Automatisch",IDC_CSV_AS_SEP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,15,18,60,12
    CONTROL         "Tabulator",IDC_CSV_TABULATOR,"Button",BS_AUTORADIOBUTTON,15,32,60,12
    CONTROL         "Semikolon (;)",IDC_CSV_SEMICOLON,"Button",BS_AUTORADIOBUTTON,15,46,60,12
    CONTROL         "Komma (,)",IDC_CSV_COMMA,"Button",BS_AUTORADIOBUTTON,15,60,60,12
    CONTROL         "Leerzeichen ( )",IDC_CSV_SPACE,"Button",BS_AUTORADIOBUTTON,15,74,63,12
    CONTROL         "Andere",IDC_CSV_OTHER,"Button",BS_AUTORADIOBUTTON,15,88,37,12
    EDITTEXT        IDE_CSV_OTHER,53,88,16,12,WS_GROUP
    GROUPBOX        "Text&begrenzer",IDC_STATIC_2,116,6,100,101,WS_GROUP
    CONTROL         "Automatisch",IDC_CSV_AS_TQ,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,125,18,60,12
    CONTROL         "Anführungszeichen ("")",IDC_CSV_DOUBLE,"Button",BS_AUTORADIOBUTTON,125,32,88,12
    CONTROL         "Apostroph (')",IDC_CSV_QUOTES,"Button",BS_AUTORADIOBUTTON,125,46,60,12
    CONTROL         "Keine",IDC_CSV_NONE,"Button",BS_AUTORADIOBUTTON,125,60,60,12
    GROUPBOX        "&Erste Zeile",IDC_STATIC_3,226,6,100,101,WS_GROUP
    CONTROL         "Automatisch",IDC_CSV_AS_FR,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,235,18,60,12
    CONTROL         "Spaltennamen",IDC_CSV_ASHEADER,"Button",BS_AUTORADIOBUTTON,235,32,70,12
    CONTROL         "Daten",IDC_CSV_ASDATA,"Button",BS_AUTORADIOBUTTON,235,46,60,12
    DEFPUSHBUTTON   "OK",IDOK,166,118,50,14,WS_GROUP
    PUSHBUTTON      "Abbrechen",IDCANCEL,221,118,50,14
    PUSHBUTTON      "Hilfe",IDHELP,276,118,50,14
    PUSHBUTTON      "Als &Standard",IDC_CSV_SETDEF,6,118,63,14,WS_GROUP
END

IDD_FIND DIALOGEX 81, 47, 210, 131
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Suchen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,39,11,163,1
    LTEXT           "&Suchen",IDC_STATIC_2,9,7,28,8
    COMBOBOX        IDC_FIND_TEXT,16,17,182,64,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,44,47,158,1
    LTEXT           "Optionen",IDC_STATIC_4,9,43,33,8
    CONTROL         "Vorwär&ts suchen",IDC_FIND_SFORWARD,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,16,53,69,12
    CONTROL         "Rüc&kwärts suchen",IDC_FIND_SBACKWARD,"Button",BS_AUTORADIOBUTTON,16,65,74,12
    CONTROL         "Ganze &Wörter",IDC_FIND_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,108,53,59,12
    CONTROL         "&Groß-/Kleinschreibung",IDC_FIND_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,108,65,87,12
    CONTROL         "&Regulärer Ausdruck",IDC_FIND_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,108,77,78,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,8,102,194,1
    DEFPUSHBUTTON   "OK",IDOK,20,110,50,14,WS_GROUP
    PUSHBUTTON      "Abbrechen",IDCANCEL,80,110,50,14
    PUSHBUTTON      "Hilfe",IDHELP,140,110,50,14
END

IDD_GOTO DIALOGEX 85, 100, 121, 54
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Gehe zu Satz"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Satz:",IDC_STATIC_1,8,9,27,8,NOT WS_GROUP
    EDITTEXT        IDC_GOTO_RECORD,38,7,74,12,ES_NUMBER
    DEFPUSHBUTTON   "OK",IDOK,7,32,50,14,BS_CENTER
    PUSHBUTTON      "Beenden",IDCANCEL,64,32,50,14,BS_CENTER
END

