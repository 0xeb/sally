// French (fr-FR) resources for dbviewer. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/dbviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\dbviewer.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_PROPERTIES DIALOGEX 28, 35, 235, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Propriétés"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,179,162,50,14,WS_GROUP
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,155,227,1
    EDITTEXT        IDC_PROP_INFO,5,5,224,143,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

IDD_CONFIGURATION DIALOGEX 26, 35, 349, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration du visualiseur de base de données"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Police",IDC_STATIC_1,6,10,337,35,WS_GROUP
    PUSHBUTTON      "&Police",IDB_CFG_FONT,13,23,50,14,WS_GROUP
    EDITTEXT        IDE_CFG_FONT,69,23,267,14,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    GROUPBOX        "Position de la fenêtre",IDC_STATIC_2,6,48,337,27,WS_GROUP
    CONTROL         "&Sauvegarder à la fermeture",IDC_CFG_SAVEPOSONCLOSE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,58,105,12
    CONTROL         "&Définir à la position de la fenêtre principale de Sally",IDC_CFG_SETBYMAINWINDOW,
                    "Button",BS_AUTORADIOBUTTON,127,58,210,12
    PUSHBUTTON      "Options CSV...",IDB_CFG_CSVOPTIONS,13,85,60,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,180,85,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,235,85,50,14
    PUSHBUTTON      "Aide",IDHELP,290,85,50,14
END

IDD_COLUMNS DIALOGEX 26, 35, 282, 178
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Champs"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_COL_LV,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,6,6,270,142
    LTEXT           "",IDC_STATIC_1,4,153,274,1,SS_ETCHEDHORZ | WS_GROUP
    PUSHBUTTON      "&Valeurs par défaut",IDC_COL_RESTORE,6,159,76,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,115,159,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,170,159,50,14
    PUSHBUTTON      "Aide",IDHELP,225,159,50,14
END

IDD_CSV_CONFIG DIALOGEX 35, 35, 335, 137
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Options CSV"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "&Séparateur",IDC_STATIC_1,6,6,84,101,WS_GROUP
    CONTROL         "Sélection auto",IDC_CSV_AS_SEP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,15,18,60,12
    CONTROL         "Tabulation",IDC_CSV_TABULATOR,"Button",BS_AUTORADIOBUTTON,15,32,48,12
    CONTROL         "Point-virgule (;)",IDC_CSV_SEMICOLON,"Button",BS_AUTORADIOBUTTON,15,46,66,12
    CONTROL         "Virgule (,)",IDC_CSV_COMMA,"Button",BS_AUTORADIOBUTTON,15,60,47,12
    CONTROL         "Espace ( )",IDC_CSV_SPACE,"Button",BS_AUTORADIOBUTTON,15,74,48,12
    CONTROL         "Autre",IDC_CSV_OTHER,"Button",BS_AUTORADIOBUTTON,15,88,32,12
    EDITTEXT        IDE_CSV_OTHER,49,88,16,12,WS_GROUP
    GROUPBOX        "Délimiteur de &Texte",IDC_STATIC_2,100,6,94,101,WS_GROUP
    CONTROL         "Sélection auto",IDC_CSV_AS_TQ,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,109,18,60,12
    CONTROL         "Guillemet double ("")",IDC_CSV_DOUBLE,"Button",BS_AUTORADIOBUTTON,109,32,80,12
    CONTROL         "Guillemet simple (')",IDC_CSV_QUOTES,"Button",BS_AUTORADIOBUTTON,109,46,78,12
    CONTROL         "Aucun",IDC_CSV_NONE,"Button",BS_AUTORADIOBUTTON,109,60,34,12
    GROUPBOX        "&Première ligne",IDC_STATIC_3,204,6,124,101,WS_GROUP
    CONTROL         "Sélection auto",IDC_CSV_AS_FR,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,213,18,60,12
    CONTROL         "Comme les noms de colonne",IDC_CSV_ASHEADER,"Button",BS_AUTORADIOBUTTON,213,32,108,12
    CONTROL         "Comme les données",IDC_CSV_ASDATA,"Button",BS_AUTORADIOBUTTON,213,46,80,12
    DEFPUSHBUTTON   "OK",IDOK,168,118,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,223,118,50,14
    PUSHBUTTON      "Aide",IDHELP,278,118,50,14
    PUSHBUTTON      "&Définir par défaut",IDC_CSV_SETDEF,6,118,70,14,WS_GROUP
END

IDD_FIND DIALOGEX 81, 47, 210, 131
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Rechercher"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,52,11,150,1
    LTEXT           "&Rechercher",IDC_STATIC_2,9,7,41,8
    COMBOBOX        IDC_FIND_TEXT,16,17,182,64,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,39,47,163,1
    LTEXT           "Options",IDC_STATIC_4,9,43,28,8
    CONTROL         "Recherche en avan&t",IDC_FIND_SFORWARD,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,16,53,80,12
    CONTROL         "Recherche en &arrière",IDC_FIND_SBACKWARD,"Button",BS_AUTORADIOBUTTON,16,65,83,12
    CONTROL         "&Mots entiers",IDC_FIND_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,113,53,54,12
    CONTROL         "&Sensible à la casse",IDC_FIND_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,65,76,12
    CONTROL         "&Expression régulière",IDC_FIND_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,77,80,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,8,102,194,1
    DEFPUSHBUTTON   "OK",IDOK,20,110,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,80,110,50,14
    PUSHBUTTON      "Aide",IDHELP,140,110,50,14
END

IDD_GOTO DIALOGEX 85, 100, 150, 54
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Aller à l'enregistrement"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Enregistrement:",IDC_STATIC_1,8,9,56,8,NOT WS_GROUP
    EDITTEXT        IDC_GOTO_RECORD,67,7,74,12,ES_NUMBER
    DEFPUSHBUTTON   "OK",IDOK,21,32,50,14,BS_CENTER
    PUSHBUTTON      "Annuler",IDCANCEL,78,32,50,14,BS_CENTER
END

