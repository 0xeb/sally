// Romanian (ro-RO) resources for dbviewer. Translation: Ioan Stefancu, Donca Radu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/dbviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\dbviewer.rh2"

LANGUAGE LANG_ROMANIAN, SUBLANG_ROMANIAN_ROMANIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_PROPERTIES DIALOGEX 28, 35, 235, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Proprietati"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,179,162,50,14,WS_GROUP
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,155,227,1
    EDITTEXT        IDC_PROP_INFO,5,5,224,143,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

IDD_CONFIGURATION DIALOGEX 26, 35, 307, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configurare Vizualizator Baze de Date"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Font",IDC_STATIC_1,6,10,295,35,WS_GROUP
    PUSHBUTTON      "&Font",IDB_CFG_FONT,13,23,50,14,WS_GROUP
    EDITTEXT        IDE_CFG_FONT,69,23,225,14,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    GROUPBOX        "Pozitia ferestrei",IDC_STATIC_2,6,48,295,27,WS_GROUP
    CONTROL         "&Salveaza la inchidere",IDC_CFG_SAVEPOSONCLOSE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,58,83,12
    CONTROL         "S&eteaza la pozitia ferestrei principale a Sally",IDC_CFG_SETBYMAINWINDOW,
                    "Button",BS_AUTORADIOBUTTON,114,58,182,12
    PUSHBUTTON      "Optiuni CSV...",IDB_CFG_CSVOPTIONS,13,85,60,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,138,85,50,14
    PUSHBUTTON      "Anuleaza",IDCANCEL,193,85,50,14
    PUSHBUTTON      "Help",IDHELP,248,85,50,14
END

IDD_COLUMNS DIALOGEX 26, 35, 282, 178
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Campuri"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_COL_LV,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,6,6,270,142
    LTEXT           "",IDC_STATIC_1,4,153,273,1,SS_ETCHEDHORZ | WS_GROUP
    PUSHBUTTON      "&Revenire la Defaults",IDC_COL_RESTORE,6,159,79,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,115,159,50,14,WS_GROUP
    PUSHBUTTON      "Anuleaza",IDCANCEL,170,159,50,14
    PUSHBUTTON      "Help",IDHELP,225,159,50,14
END

IDD_CSV_CONFIG DIALOGEX 35, 35, 324, 137
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Optiuni CSV"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "&Separator",IDC_STATIC_1,6,6,97,101,WS_GROUP
    CONTROL         "Auto-Select",IDC_CSV_AS_SEP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,15,18,60,12
    CONTROL         "Tabulator",IDC_CSV_TABULATOR,"Button",BS_AUTORADIOBUTTON,15,32,60,12
    CONTROL         "Punct si Virgula (;)",IDC_CSV_SEMICOLON,"Button",BS_AUTORADIOBUTTON,15,46,75,12
    CONTROL         "Virgula (,)",IDC_CSV_COMMA,"Button",BS_AUTORADIOBUTTON,15,60,60,12
    CONTROL         "Spatiu ( )",IDC_CSV_SPACE,"Button",BS_AUTORADIOBUTTON,15,74,60,12
    CONTROL         "Altul",IDC_CSV_OTHER,"Button",BS_AUTORADIOBUTTON,15,88,29,12
    EDITTEXT        IDE_CSV_OTHER,45,88,16,12,WS_GROUP
    GROUPBOX        "Text &Qualifier",IDC_STATIC_2,113,6,97,101,WS_GROUP
    CONTROL         "Auto-Select",IDC_CSV_AS_TQ,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,122,18,60,12
    CONTROL         "Ghilimele Duble ("")",IDC_CSV_DOUBLE,"Button",BS_AUTORADIOBUTTON,122,32,77,12
    CONTROL         "Ghilimele Simple (')",IDC_CSV_QUOTES,"Button",BS_AUTORADIOBUTTON,122,46,78,12
    CONTROL         "Nimic",IDC_CSV_NONE,"Button",BS_AUTORADIOBUTTON,122,60,60,12
    GROUPBOX        "&Primul rand",IDC_STATIC_3,220,6,97,101,WS_GROUP
    CONTROL         "Auto-Select",IDC_CSV_AS_FR,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,229,18,60,12
    CONTROL         "Ca Nume de Coloana",IDC_CSV_ASHEADER,"Button",BS_AUTORADIOBUTTON,229,32,83,12
    CONTROL         "Ca Data",IDC_CSV_ASDATA,"Button",BS_AUTORADIOBUTTON,229,46,60,12
    DEFPUSHBUTTON   "OK",IDOK,157,118,50,14,WS_GROUP
    PUSHBUTTON      "Anuleaza",IDCANCEL,212,118,50,14
    PUSHBUTTON      "Help",IDHELP,267,118,50,14
    PUSHBUTTON      "Seteaza ca &Default",IDC_CSV_SETDEF,6,118,73,14,WS_GROUP
END

IDD_FIND DIALOGEX 81, 47, 235, 131
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Gaseste"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,40,11,187,1
    LTEXT           "&Gaseste",IDC_STATIC_2,9,7,29,8
    COMBOBOX        IDC_FIND_TEXT,16,17,207,64,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,37,47,190,1
    LTEXT           "Optiuni",IDC_STATIC_4,9,43,26,8
    CONTROL         "Cauta in fat&a",IDC_FIND_SFORWARD,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,16,53,66,12
    CONTROL         "Cauta &in spate",IDC_FIND_SBACKWARD,"Button",BS_AUTORADIOBUTTON,16,65,72,12
    CONTROL         "C&uvinte intregi",IDC_FIND_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,102,53,60,12
    CONTROL         "Cau&ta exact (litere mari sau mici)",IDC_FIND_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,102,65,124,12
    CONTROL         "&Expresie obisnuita",IDC_FIND_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,102,77,75,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,8,102,219,1
    DEFPUSHBUTTON   "OK",IDOK,32,110,50,14,WS_GROUP
    PUSHBUTTON      "Anuleaza",IDCANCEL,92,110,50,14
    PUSHBUTTON      "Help",IDHELP,152,110,50,14
END

IDD_GOTO DIALOGEX 85, 100, 135, 54
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Mergi la Inregistrare"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Inregistrare:",IDC_STATIC_1,8,9,43,8,NOT WS_GROUP
    EDITTEXT        IDC_GOTO_RECORD,52,7,74,12,ES_NUMBER
    DEFPUSHBUTTON   "OK",IDOK,14,32,50,14,BS_CENTER
    PUSHBUTTON      "Anuleaza",IDCANCEL,71,32,50,14,BS_CENTER
END

