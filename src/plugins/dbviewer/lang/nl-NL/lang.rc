// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/dbviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\dbviewer.rh2"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_PROPERTIES DIALOGEX 28, 35, 235, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Eigenschappen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,179,162,50,14,WS_GROUP
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,155,227,1
    EDITTEXT        IDC_PROP_INFO,5,5,224,143,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

IDD_CONFIGURATION DIALOGEX 26, 35, 302, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Database Viewer Configuratie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Lettertype",IDC_STATIC_1,6,10,290,35,WS_GROUP
    PUSHBUTTON      "&Lettertype",IDB_CFG_FONT,13,23,57,14,WS_GROUP
    EDITTEXT        IDE_CFG_FONT,76,23,213,14,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    GROUPBOX        "Venster positie",IDC_STATIC_2,6,48,290,27,WS_GROUP
    CONTROL         "&Opslaan bij afsluiten",IDC_CFG_SAVEPOSONCLOSE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,58,95,12
    CONTROL         "Zelfde positi&e als Sally's hoofdvenster",IDC_CFG_SETBYMAINWINDOW,
                    "Button",BS_AUTORADIOBUTTON,127,58,161,12
    PUSHBUTTON      "CSV Opties...",IDB_CFG_CSVOPTIONS,13,85,57,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,133,85,50,14
    PUSHBUTTON      "Annuleren",IDCANCEL,188,85,50,14
    PUSHBUTTON      "Help",IDHELP,243,85,50,14
END

IDD_COLUMNS DIALOGEX 26, 35, 282, 178
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Velden"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_COL_LV,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,6,6,270,142
    LTEXT           "",IDC_STATIC_1,4,153,273,1,SS_ETCHEDHORZ | WS_GROUP
    PUSHBUTTON      "&Standaardwaarden herstellen",IDC_COL_RESTORE,6,159,107,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,115,159,50,14,WS_GROUP
    PUSHBUTTON      "Annuleren",IDCANCEL,170,159,50,14
    PUSHBUTTON      "Help",IDHELP,225,159,50,14
END

IDD_CSV_CONFIG DIALOGEX 35, 35, 318, 137
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "CSV Opties"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "&Scheidingsteken",IDC_STATIC_1,6,6,95,101,WS_GROUP
    CONTROL         "Auto-Select",IDC_CSV_AS_SEP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,15,18,60,12
    CONTROL         "Tab",IDC_CSV_TABULATOR,"Button",BS_AUTORADIOBUTTON,15,32,60,12
    CONTROL         "Puntkomma (;)",IDC_CSV_SEMICOLON,"Button",BS_AUTORADIOBUTTON,15,46,63,12
    CONTROL         "Komma (,)",IDC_CSV_COMMA,"Button",BS_AUTORADIOBUTTON,15,60,60,12
    CONTROL         "Spatie ( )",IDC_CSV_SPACE,"Button",BS_AUTORADIOBUTTON,15,74,60,12
    CONTROL         "Andere",IDC_CSV_OTHER,"Button",BS_AUTORADIOBUTTON,15,88,37,12
    EDITTEXT        IDE_CSV_OTHER,53,88,16,12,WS_GROUP
    GROUPBOX        "Tekst &kwalificatietype",IDC_STATIC_2,111,6,95,101,WS_GROUP
    CONTROL         "Auto-Selectie",IDC_CSV_AS_TQ,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,120,18,60,12
    CONTROL         "Dubbele Quotes ("")",IDC_CSV_DOUBLE,"Button",BS_AUTORADIOBUTTON,120,32,78,12
    CONTROL         "Quote (')",IDC_CSV_QUOTES,"Button",BS_AUTORADIOBUTTON,120,46,60,12
    CONTROL         "Geen",IDC_CSV_NONE,"Button",BS_AUTORADIOBUTTON,120,60,60,12
    GROUPBOX        "&Eerste regel",IDC_STATIC_3,216,6,95,101,WS_GROUP
    CONTROL         "Auto-Select",IDC_CSV_AS_FR,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,225,18,60,12
    CONTROL         "Kolomnamen",IDC_CSV_ASHEADER,"Button",BS_AUTORADIOBUTTON,225,32,74,12
    CONTROL         "Data",IDC_CSV_ASDATA,"Button",BS_AUTORADIOBUTTON,225,46,60,12
    DEFPUSHBUTTON   "OK",IDOK,151,118,50,14,WS_GROUP
    PUSHBUTTON      "Annuleren",IDCANCEL,206,118,50,14
    PUSHBUTTON      "Help",IDHELP,261,118,50,14
    PUSHBUTTON      "Instellen als stan&daard",IDC_CSV_SETDEF,6,118,90,14,WS_GROUP
END

IDD_FIND DIALOGEX 81, 47, 220, 131
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Zoeken"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,29,11,183,1
    LTEXT           "&Zoek",IDC_STATIC_2,9,7,18,8
    COMBOBOX        IDC_FIND_TEXT,16,17,192,64,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,38,47,174,1
    LTEXT           "Opties",IDC_STATIC_4,9,43,28,8
    CONTROL         "&Vooruit zoeken",IDC_FIND_SFORWARD,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,16,53,66,12
    CONTROL         "&Achteruit zoeken",IDC_FIND_SBACKWARD,"Button",BS_AUTORADIOBUTTON,16,65,72,12
    CONTROL         "Alle &woorden",IDC_FIND_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,103,53,57,12
    CONTROL         "&Hoofd-/klein letter gevoelig",IDC_FIND_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,103,65,103,12
    CONTROL         "&Reguliere expressie",IDC_FIND_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,103,77,78,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,8,102,204,1
    DEFPUSHBUTTON   "OK",IDOK,25,110,50,14,WS_GROUP
    PUSHBUTTON      "Annuleren",IDCANCEL,85,110,50,14
    PUSHBUTTON      "Help",IDHELP,145,110,50,14
END

IDD_GOTO DIALOGEX 85, 100, 123, 54
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ga naar regel"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Regel:",IDC_STATIC_1,8,9,29,8,NOT WS_GROUP
    EDITTEXT        IDC_GOTO_RECORD,40,7,74,12,ES_NUMBER
    DEFPUSHBUTTON   "OK",IDOK,8,32,50,14,BS_CENTER
    PUSHBUTTON      "Annuleren",IDCANCEL,65,32,50,14,BS_CENTER
END

