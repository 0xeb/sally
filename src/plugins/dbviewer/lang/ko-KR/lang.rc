    LTEXT           "",IDC_STATIC_1,4,153,274,1,SS_ETCHEDHORZ | WS_GROUP
    PUSHBUTTON      "기본값 복원(&R)",IDC_COL_RESTORE,6,159,69,14,WS_GROUP
