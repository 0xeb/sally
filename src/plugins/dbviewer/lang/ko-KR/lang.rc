    CONTROL         "기타",IDC_CSV_OTHER,"Button",BS_AUTORADIOBUTTON,15,88,32,12
    EDITTEXT        IDE_CSV_OTHER,49,88,16,12,WS_GROUP
    GROUPBOX        "텍스트 한정자(&Q)",IDC_STATIC_2,106,6,90,101,WS_GROUP
    CONTROL         "자동 선택",IDC_CSV_AS_TQ,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,115,18,60,12
    CONTROL         "큰따옴표("")",IDC_CSV_DOUBLE,"Button",BS_AUTORADIOBUTTON,115,32,74,12
    CONTROL         "작은따옴표(')",IDC_CSV_QUOTES,"Button",BS_AUTORADIOBUTTON,115,46,60,12
    CONTROL         "없음",IDC_CSV_NONE,"Button",BS_AUTORADIOBUTTON,115,60,60,12
    GROUPBOX        "첫 행(&F)",IDC_STATIC_3,206,6,90,101,WS_GROUP
    CONTROL         "자동 선택",IDC_CSV_AS_FR,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,215,18,60,12
    CONTROL         "열 이름으로 사용",IDC_CSV_ASHEADER,"Button",BS_AUTORADIOBUTTON,215,32,74,12
    CONTROL         "데이터로 사용",IDC_CSV_ASDATA,"Button",BS_AUTORADIOBUTTON,215,46,60,12
    DEFPUSHBUTTON   "확인",IDOK,136,118,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,191,118,50,14
    PUSHBUTTON      "도움말",IDHELP,246,118,50,14
    PUSHBUTTON      "기본값으로 설정(&D)",IDC_CSV_SETDEF,6,118,63,14,WS_GROUP
END

