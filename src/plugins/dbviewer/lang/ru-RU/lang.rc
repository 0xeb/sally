// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/dbviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\dbviewer.rh2"

LANGUAGE LANG_RUSSIAN, SUBLANG_RUSSIAN_RUSSIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_PROPERTIES DIALOGEX 28, 35, 235, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Свойства"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,179,162,50,14,WS_GROUP
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,155,227,1
    EDITTEXT        IDC_PROP_INFO,5,5,224,143,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

IDD_CONFIGURATION DIALOGEX 26, 35, 312, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Настройка модуля просмотра баз данных"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Шрифт",IDC_STATIC_1,6,10,300,35,WS_GROUP
    PUSHBUTTON      "&Шрифт",IDB_CFG_FONT,13,23,50,14,WS_GROUP
    EDITTEXT        IDE_CFG_FONT,69,23,230,14,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    GROUPBOX        "Расположение окна",IDC_STATIC_2,6,48,300,27,WS_GROUP
    CONTROL         "Со&хранять при закрытии",IDC_CFG_SAVEPOSONCLOSE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,58,99,12
    CONTROL         "&Совпадает с главным окном Sally",IDC_CFG_SETBYMAINWINDOW,
                    "Button",BS_AUTORADIOBUTTON,128,58,172,12
    PUSHBUTTON      "Параметры CSV...",IDB_CFG_CSVOPTIONS,8,85,75,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,143,85,50,14
    PUSHBUTTON      "Отмена",IDCANCEL,198,85,50,14
    PUSHBUTTON      "Справка",IDHELP,253,85,50,14
END

IDD_COLUMNS DIALOGEX 26, 35, 302, 178
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Поля"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_COL_LV,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,6,6,290,142
    LTEXT           "",IDC_STATIC_1,4,153,293,1,SS_ETCHEDHORZ | WS_GROUP
    PUSHBUTTON      "&По умолчанию",IDC_COL_RESTORE,6,159,67,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,135,159,50,14,WS_GROUP
    PUSHBUTTON      "Отмена",IDCANCEL,190,159,50,14
    PUSHBUTTON      "Справка",IDHELP,245,159,50,14
END

IDD_CSV_CONFIG DIALOGEX 35, 35, 318, 137
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Параметры CSV"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "&Разделитель",IDC_STATIC_1,6,6,95,101,WS_GROUP
    CONTROL         "Автовыбор",IDC_CSV_AS_SEP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,15,18,51,12
    CONTROL         "Табулятор",IDC_CSV_TABULATOR,"Button",BS_AUTORADIOBUTTON,15,32,49,12
    CONTROL         "Точка с запятой (;)",IDC_CSV_SEMICOLON,"Button",BS_AUTORADIOBUTTON,15,46,81,12
    CONTROL         "Запятая (,)",IDC_CSV_COMMA,"Button",BS_AUTORADIOBUTTON,15,60,51,12
    CONTROL         "Пробел ( )",IDC_CSV_SPACE,"Button",BS_AUTORADIOBUTTON,15,74,49,12
    CONTROL         "Другой",IDC_CSV_OTHER,"Button",BS_AUTORADIOBUTTON,15,88,40,12
    EDITTEXT        IDE_CSV_OTHER,58,88,16,12,WS_GROUP
    GROUPBOX        "&Ограничитель текста",IDC_STATIC_2,111,6,95,101,WS_GROUP
    CONTROL         "Автовыбор",IDC_CSV_AS_TQ,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,120,18,51,12
    CONTROL         "Кавычки ("")",IDC_CSV_DOUBLE,"Button",BS_AUTORADIOBUTTON,120,32,78,12
    CONTROL         "Апострофы (')",IDC_CSV_QUOTES,"Button",BS_AUTORADIOBUTTON,120,46,63,12
    CONTROL         "Отсутствует",IDC_CSV_NONE,"Button",BS_AUTORADIOBUTTON,120,60,57,12
    GROUPBOX        "&Первая строка",IDC_STATIC_3,216,6,95,101,WS_GROUP
    CONTROL         "Автовыбор",IDC_CSV_AS_FR,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,225,18,51,12
    CONTROL         "Имена столбцов",IDC_CSV_ASHEADER,"Button",BS_AUTORADIOBUTTON,225,32,70,12
    CONTROL         "Данные",IDC_CSV_ASDATA,"Button",BS_AUTORADIOBUTTON,225,46,41,12
    DEFPUSHBUTTON   "OK",IDOK,151,118,50,14,WS_GROUP
    PUSHBUTTON      "Отмена",IDCANCEL,206,118,50,14
    PUSHBUTTON      "Справка",IDHELP,261,118,50,14
    PUSHBUTTON      "&Установить как умолчание",IDC_CSV_SETDEF,6,118,108,14,WS_GROUP
END

IDD_FIND DIALOGEX 81, 47, 220, 131
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Поиск"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,34,11,178,1
    LTEXT           "&Поиск",IDC_STATIC_2,9,7,23,8
    COMBOBOX        IDC_FIND_TEXT,16,17,192,64,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,53,47,159,1
    LTEXT           "Параметры",IDC_STATIC_4,9,43,42,8
    CONTROL         "Поиск &вперед",IDC_FIND_SFORWARD,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,16,53,64,12
    CONTROL         "Поиск на&зад",IDC_FIND_SBACKWARD,"Button",BS_AUTORADIOBUTTON,16,65,59,12
    CONTROL         "&Слова целиком",IDC_FIND_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,110,53,66,12
    CONTROL         "С &учетом регистра",IDC_FIND_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,110,65,77,12
    CONTROL         "&Регулярное выражение",IDC_FIND_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,110,77,95,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,8,102,204,1
    DEFPUSHBUTTON   "OK",IDOK,25,110,50,14,WS_GROUP
    PUSHBUTTON      "Отмена",IDCANCEL,85,110,50,14
    PUSHBUTTON      "Справка",IDHELP,145,110,50,14
END

IDD_GOTO DIALOGEX 85, 100, 122, 54
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Перейти к записи"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Запись:",IDC_STATIC_1,8,9,30,8,NOT WS_GROUP
    EDITTEXT        IDC_GOTO_RECORD,39,7,74,12,ES_NUMBER
    DEFPUSHBUTTON   "OK",IDOK,7,32,50,14,BS_CENTER
    PUSHBUTTON      "Отмена",IDCANCEL,64,32,50,14,BS_CENTER
END

