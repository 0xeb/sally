// Slovak (sk-SK) resources for dbviewer. Translation: Roman Paholík.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/dbviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\dbviewer.rh2"

LANGUAGE LANG_SLOVAK, SUBLANG_SLOVAK_SLOVAKIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_PROPERTIES DIALOGEX 28, 35, 235, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Vlastnosti"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,179,162,50,14,WS_GROUP
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,155,227,1
    EDITTEXT        IDC_PROP_INFO,5,5,224,143,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

IDD_CONFIGURATION DIALOGEX 26, 35, 282, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Prehliadač databáz - Konfigurácia"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Písmo",IDC_STATIC_1,6,10,270,35,WS_GROUP
    PUSHBUTTON      "&Písmo",IDB_CFG_FONT,13,23,50,14,WS_GROUP
    EDITTEXT        IDE_CFG_FONT,69,23,200,14,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    GROUPBOX        "Pozícia okna",IDC_STATIC_2,6,48,270,27,WS_GROUP
    CONTROL         "&Uložiť a zatvoriť",IDC_CFG_SAVEPOSONCLOSE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,58,67,12
    CONTROL         "&Nastaviť pozíciu na hlavné okno Sally",IDC_CFG_SETBYMAINWINDOW,
                    "Button",BS_AUTORADIOBUTTON,105,58,165,12
    PUSHBUTTON      "Možnosti CSV...",IDB_CFG_CSVOPTIONS,13,85,65,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,113,85,50,14
    PUSHBUTTON      "Zrušiť",IDCANCEL,168,85,50,14
    PUSHBUTTON      "Nápoveda",IDHELP,223,85,50,14
END

IDD_COLUMNS DIALOGEX 26, 35, 282, 178
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Pole"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_COL_LV,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,6,6,270,142
    LTEXT           "",IDC_STATIC_1,4,153,273,1,SS_ETCHEDHORZ | WS_GROUP
    PUSHBUTTON      "&Obnoviť predvolené",IDC_COL_RESTORE,6,159,79,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,115,159,50,14,WS_GROUP
    PUSHBUTTON      "Zrušiť",IDCANCEL,170,159,50,14
    PUSHBUTTON      "Nápoveda",IDHELP,225,159,50,14
END

IDD_CSV_CONFIG DIALOGEX 35, 35, 333, 137
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Možnosti CSV"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "&Oddeľovač",IDC_STATIC_1,6,6,100,101,WS_GROUP
    CONTROL         "Auto-výber",IDC_CSV_AS_SEP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,15,18,60,12
    CONTROL         "Tabulátor",IDC_CSV_TABULATOR,"Button",BS_AUTORADIOBUTTON,15,32,60,12
    CONTROL         "Bodkočiarka (;)",IDC_CSV_SEMICOLON,"Button",BS_AUTORADIOBUTTON,15,46,64,12
    CONTROL         "Čiarka (,)",IDC_CSV_COMMA,"Button",BS_AUTORADIOBUTTON,15,60,60,12
    CONTROL         "Medzera ( )",IDC_CSV_SPACE,"Button",BS_AUTORADIOBUTTON,15,74,60,12
    CONTROL         "Iný",IDC_CSV_OTHER,"Button",BS_AUTORADIOBUTTON,15,88,24,12
    EDITTEXT        IDE_CSV_OTHER,41,88,16,12,WS_GROUP
    GROUPBOX        "Označenie &textu",IDC_STATIC_2,116,6,100,101,WS_GROUP
    CONTROL         "Auto-výber",IDC_CSV_AS_TQ,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,125,18,60,12
    CONTROL         "Dvojité úvodzovky ("")",IDC_CSV_DOUBLE,"Button",BS_AUTORADIOBUTTON,125,32,85,12
    CONTROL         "Úvodzovky (')",IDC_CSV_QUOTES,"Button",BS_AUTORADIOBUTTON,125,46,60,12
    CONTROL         "Nie je",IDC_CSV_NONE,"Button",BS_AUTORADIOBUTTON,125,60,60,12
    GROUPBOX        "&Prvý rad",IDC_STATIC_3,226,6,100,101,WS_GROUP
    CONTROL         "Auto-výber",IDC_CSV_AS_FR,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,235,18,60,12
    CONTROL         "Ako názov stĺpca",IDC_CSV_ASHEADER,"Button",BS_AUTORADIOBUTTON,235,32,75,12
    CONTROL         "Ako dáta",IDC_CSV_ASDATA,"Button",BS_AUTORADIOBUTTON,235,46,60,12
    DEFPUSHBUTTON   "OK",IDOK,166,118,50,14,WS_GROUP
    PUSHBUTTON      "Zrušiť",IDCANCEL,221,118,50,14
    PUSHBUTTON      "Nápoveda",IDHELP,276,118,50,14
    PUSHBUTTON      "&Uložiť ako predvolené",IDC_CSV_SETDEF,6,118,85,14,WS_GROUP
END

IDD_FIND DIALOGEX 81, 47, 226, 131
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Hľadanie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,31,11,187,1
    LTEXT           "&Nájsť",IDC_STATIC_2,9,7,20,8
    COMBOBOX        IDC_FIND_TEXT,16,17,198,64,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,48,47,170,1
    LTEXT           "Nastavenie",IDC_STATIC_4,9,43,38,8
    CONTROL         "Hľadať &dopredu",IDC_FIND_SFORWARD,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,16,53,66,12
    CONTROL         "Hľadať do&zadu",IDC_FIND_SBACKWARD,"Button",BS_AUTORADIOBUTTON,16,65,72,12
    CONTROL         "&Celé slová",IDC_FIND_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,113,53,57,12
    CONTROL         "Rozlišovať &veľkosť písmen",IDC_FIND_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,65,101,12
    CONTROL         "&Regulárny výraz",IDC_FIND_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,77,75,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,8,102,210,1
    DEFPUSHBUTTON   "OK",IDOK,28,110,50,14,WS_GROUP
    PUSHBUTTON      "Zrušiť",IDCANCEL,88,110,50,14
    PUSHBUTTON      "Nápoveda",IDHELP,148,110,50,14
END

IDD_GOTO DIALOGEX 85, 100, 124, 54
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Prejsť na záznam"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Záznam:",IDC_STATIC_1,8,9,32,8,NOT WS_GROUP
    EDITTEXT        IDC_GOTO_RECORD,41,7,74,12,ES_NUMBER
    DEFPUSHBUTTON   "OK",IDOK,8,32,50,14,BS_CENTER
    PUSHBUTTON      "Zrušiť",IDCANCEL,65,32,50,14,BS_CENTER
END

