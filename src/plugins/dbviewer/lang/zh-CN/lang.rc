// Chinese (Simplified) (zh-CN) resources for dbviewer. Translation: Michael Lu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/dbviewer/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\dbviewer.rh2"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_PROPERTIES DIALOGEX 28, 35, 235, 181
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "属性"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,179,162,50,14,WS_GROUP
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,4,155,227,1
    EDITTEXT        IDC_PROP_INFO,5,5,224,143,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END

IDD_CONFIGURATION DIALOGEX 26, 35, 282, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "数据库查看器配置"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "字体",IDC_STATIC_1,6,10,270,35,WS_GROUP
    PUSHBUTTON      "字体(&F)",IDB_CFG_FONT,13,23,50,14,WS_GROUP
    EDITTEXT        IDE_CFG_FONT,69,23,200,14,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    GROUPBOX        "窗口位置",IDC_STATIC_2,6,48,270,27,WS_GROUP
    CONTROL         "关闭时保存(&S)",IDC_CFG_SAVEPOSONCLOSE,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,14,58,67,12
    CONTROL         "设置为 Sally 主窗口的位置(&E)",IDC_CFG_SETBYMAINWINDOW,
                    "Button",BS_AUTORADIOBUTTON,107,58,163,12
    PUSHBUTTON      "CSV 选项...",IDB_CFG_CSVOPTIONS,13,85,60,14,WS_GROUP
    DEFPUSHBUTTON   "确定",IDOK,113,85,50,14
    PUSHBUTTON      "取消",IDCANCEL,168,85,50,14
    PUSHBUTTON      "帮助",IDHELP,223,85,50,14
END

IDD_COLUMNS DIALOGEX 26, 35, 282, 178
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "字段"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_COL_LV,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,6,6,270,142
    LTEXT           "",IDC_STATIC_1,4,153,274,1,SS_ETCHEDHORZ | WS_GROUP
    PUSHBUTTON      "恢复默认(&R)",IDC_COL_RESTORE,6,159,69,14,WS_GROUP
    DEFPUSHBUTTON   "确定",IDOK,115,159,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,170,159,50,14
    PUSHBUTTON      "帮助",IDHELP,225,159,50,14
END

IDD_CSV_CONFIG DIALOGEX 35, 35, 303, 137
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "CSV 选项"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "分隔符(&S)",IDC_STATIC_1,6,6,90,101,WS_GROUP
    CONTROL         "自动选择",IDC_CSV_AS_SEP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,15,18,60,12
    CONTROL         "制表符",IDC_CSV_TABULATOR,"Button",BS_AUTORADIOBUTTON,15,32,60,12
    CONTROL         "分号(;)",IDC_CSV_SEMICOLON,"Button",BS_AUTORADIOBUTTON,15,46,60,12
    CONTROL         "逗号(,)",IDC_CSV_COMMA,"Button",BS_AUTORADIOBUTTON,15,60,60,12
    CONTROL         "空格( )",IDC_CSV_SPACE,"Button",BS_AUTORADIOBUTTON,15,74,60,12
    CONTROL         "其它",IDC_CSV_OTHER,"Button",BS_AUTORADIOBUTTON,15,88,32,12
    EDITTEXT        IDE_CSV_OTHER,49,88,16,12,WS_GROUP
    GROUPBOX        "文本修饰(&Q)",IDC_STATIC_2,106,6,90,101,WS_GROUP
    CONTROL         "自动选择",IDC_CSV_AS_TQ,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,115,18,60,12
    CONTROL         "双引号("")",IDC_CSV_DOUBLE,"Button",BS_AUTORADIOBUTTON,115,32,74,12
    CONTROL         "单引号(')",IDC_CSV_QUOTES,"Button",BS_AUTORADIOBUTTON,115,46,60,12
    CONTROL         "无",IDC_CSV_NONE,"Button",BS_AUTORADIOBUTTON,115,60,60,12
    GROUPBOX        "第一行(&F)",IDC_STATIC_3,206,6,90,101,WS_GROUP
    CONTROL         "自动选择",IDC_CSV_AS_FR,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,215,18,60,12
    CONTROL         "作为列名称",IDC_CSV_ASHEADER,"Button",BS_AUTORADIOBUTTON,215,32,74,12
    CONTROL         "作为数据",IDC_CSV_ASDATA,"Button",BS_AUTORADIOBUTTON,215,46,60,12
    DEFPUSHBUTTON   "确定",IDOK,136,118,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,191,118,50,14
    PUSHBUTTON      "帮助",IDHELP,246,118,50,14
    PUSHBUTTON      "设为默认(&D)",IDC_CSV_SETDEF,6,118,63,14,WS_GROUP
END

IDD_FIND DIALOGEX 81, 47, 210, 131
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "查找"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,40,11,162,1
    LTEXT           "查找(&F)",IDC_STATIC_2,9,7,29,8
    COMBOBOX        IDC_FIND_TEXT,16,17,182,64,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,31,47,171,1
    LTEXT           "选项",IDC_STATIC_4,9,43,20,8
    CONTROL         "向前搜索(&D)",IDC_FIND_SFORWARD,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,16,53,66,12
    CONTROL         "向后搜索(&B)",IDC_FIND_SBACKWARD,"Button",BS_AUTORADIOBUTTON,16,65,72,12
    CONTROL         "整个单词(&W)",IDC_FIND_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,113,53,61,12
    CONTROL         "区分大小写(&C)",IDC_FIND_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,65,67,12
    CONTROL         "正则表达式(&R)",IDC_FIND_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,113,77,75,12
    CONTROL         "",IDC_STATIC_5,"Static",SS_ETCHEDHORZ | WS_GROUP,8,102,194,1
    DEFPUSHBUTTON   "确定",IDOK,20,110,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,80,110,50,14
    PUSHBUTTON      "帮助",IDHELP,140,110,50,14
END

IDD_GOTO DIALOGEX 85, 100, 123, 54
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "转到记录"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "记录(&R):",IDC_STATIC_1,8,9,33,8,NOT WS_GROUP
    EDITTEXT        IDC_GOTO_RECORD,43,7,71,12,ES_NUMBER
    DEFPUSHBUTTON   "确定",IDOK,8,32,50,14,BS_CENTER
    PUSHBUTTON      "取消",IDCANCEL,65,32,50,14,BS_CENTER
END

