// French (fr-FR) resources for undelete. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/undelete/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\undelete.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_SNAPSHOTPROGRESSDLG DIALOGEX 18, 80, 341, 77
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Récupération de fichier"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_LABEL_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,12,12,324,8
    LTEXT           "",IDC_PROGRESSBAR,35,32,292,12,NOT WS_GROUP
    DEFPUSHBUTTON   "Annuler",IDCANCEL,144,54,50,14
    LTEXT           "Total:",IDC_STATIC_1,12,33,22,8
END

IDD_CONNECT DIALOGEX 18, 80, 443, 285
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Récupération de fichier"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Sélectionnez le &disque à analyser",IDC_STATIC_1,6,7,430,193,WS_GROUP
    CONTROL         "",IDC_LIST_VOLUMES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SORTASCENDING | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,14,21,414,139
    CONTROL         "&Image disque",IDC_CHECK_IMAGE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,166,58,10
    EDITTEXT        IDC_EDIT_IMAGE,14,178,361,14,ES_AUTOHSCROLL
    PUSHBUTTON      "&Parcourir...",IDC_BUTTON_BROWSE,379,178,50,14,WS_GROUP
    CONTROL         "Examiner les clusters &libres dans les partitions de la FAT",IDC_CHECK_SCANVACANT,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,208,200,10
    CONTROL         "Voir les fichiers et répertoires &existants",IDC_CHECK_SHOWEXISTING,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,220,184,10
    CONTROL         "Montrer les fichiers de taille &zéro",IDC_CHECK_SHOWZEROFILES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,232,184,10
    CONTROL         "M&ontrer les répertoires vides",IDC_CHECK_SHOWEMPTYDIRS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,244,184,10
    CONTROL         "Montrer les &métafichiers",IDC_CHECK_SHOWMETAFILES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,256,184,10
    CONTROL         "Estimer les dommages aux &fichiers",IDC_CHECK_ESTIMATEDAMAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,268,184,10
    DEFPUSHBUTTON   "OK",IDOK,278,264,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,332,264,50,14
    PUSHBUTTON      "Aide",IDHELP,386,264,50,14
END

IDD_COPYPROGRESSDLG DIALOGEX 18, 80, 360, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Récupération"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Récupération",IDC_LABEL_UNDELETING,3,11,47,8
    CONTROL         "",IDC_LABEL_SOURCE,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,54,11,301,8
    RTEXT           "sur",IDC_STATIC_1,3,23,47,8
    CONTROL         "",IDC_LABEL_DEST,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,54,23,301,8
    RTEXT           "Fichier:",IDC_STATIC_2,3,41,47,8
    LTEXT           "",IDC_PROGRESS_FILE,54,40,293,12,NOT WS_GROUP
    RTEXT           "Total:",IDC_STATIC_3,3,56,47,8
    LTEXT           "",IDC_PROGRESS_TOTAL,54,55,293,12,NOT WS_GROUP
    DEFPUSHBUTTON   "Annuler",IDCANCEL,155,78,50,14
END

IDD_FILENAME DIALOGEX 0, 0, 228, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Nom de fichier endommagé"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "La première lettre du nom de fichier suivant n'est pas récupérable. Veuillez indiquer le bon caractère.",IDC_STATIC_1,7,7,214,16
    EDITTEXT        IDC_EDIT_FILENAME,7,27,214,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,59,53,50,14
    PUSHBUTTON      "&Tout",IDC_BUTTON_ALL,115,53,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,171,53,50,14
END

IDD_CONFIG DIALOGEX 0, 0, 297, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration de la récupération"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Répertoire &temporaire alternatif pour la visualisation des fichiers:",IDC_STATIC_1,7,7,219,8
    EDITTEXT        IDC_EDIT_TEMPPATH,7,17,262,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,275,17,16,14,WS_GROUP
    CONTROL         "Toujours &réutiliser les infos de cluster de FAT précédentes",IDC_CHECK_ALWAYSREUSE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,39,206,10
    CONTROL         "Ne pas avertir lors d'une récupération sur le &même disque logique",IDC_CHECK_SAMEPARTITION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,50,234,10
    CONTROL         "Ne pas avertir avant de récupérer des fichiers &cryptés vers la FAT ou exFAT",IDC_CHECK_EFS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,61,265,10
    DEFPUSHBUTTON   "OK",IDOK,131,80,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,186,80,50,14
    PUSHBUTTON      "Aide",IDHELP,241,80,50,14
END

IDD_RESTORE DIALOGEX 0, 0, 314, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Restauration de fichiers cryptés depuis une sauvegarde"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Cette fonction va restaurer des fichiers cryptés précédemment récupérés vers une partition sans support du Système d'encryption de fichier (EFS), tel que la FAT. Les fichiers ordinaires (autres que *.bak) seront copiés sans modifications.",IDC_STATIC_1,7,7,300,24
    LTEXT           "&Restaurer %s vers:",IDC_LABEL_SOURCE,7,41,300,8
    EDITTEXT        IDC_EDIT_TARGET,7,51,282,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,293,51,14,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,76,74,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,132,74,50,14
    PUSHBUTTON      "Aide",IDHELP,188,74,50,14
END

