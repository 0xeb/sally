// Dialogs

IDD_SNAPSHOTPROGRESSDLG DIALOGEX 18, 80, 341, 77
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "삭제 취소"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_LABEL_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,12,12,323,8
    LTEXT           "",IDC_PROGRESSBAR,35,32,292,12,NOT WS_GROUP
    DEFPUSHBUTTON   "취소",IDCANCEL,144,54,50,14
    LTEXT           "전체:",IDC_STATIC_1,12,33,22,8
END

IDD_CONNECT DIALOGEX 18, 80, 443, 285
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "삭제 취소"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "분석할 디스크 선택(&D)",IDC_STATIC_1,6,7,430,193,WS_GROUP
    CONTROL         "",IDC_LIST_VOLUMES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SORTASCENDING | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,14,21,414,139
    CONTROL         "디스크 이미지(&I)",IDC_CHECK_IMAGE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,166,56,10
    EDITTEXT        IDC_EDIT_IMAGE,14,178,361,14,ES_AUTOHSCROLL
    PUSHBUTTON      "찾아보기(&B)...",IDC_BUTTON_BROWSE,379,178,50,14,WS_GROUP
    CONTROL         "FAT 파티션의 빈 클러스터 검사(&V)",IDC_CHECK_SCANVACANT,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,208,184,10
    CONTROL         "기존 파일 및 디렉터리 표시(&X)",IDC_CHECK_SHOWEXISTING,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,220,184,10
    CONTROL         "크기가 0인 파일 표시(&Z)",IDC_CHECK_SHOWZEROFILES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,232,184,10
    CONTROL         "빈 디렉터리 표시(&E)",IDC_CHECK_SHOWEMPTYDIRS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,244,184,10
    CONTROL         "메타파일 표시(&M)",IDC_CHECK_SHOWMETAFILES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,256,184,10
    CONTROL         "파일 손상 정도 예측(&F)",IDC_CHECK_ESTIMATEDAMAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,268,184,10
    DEFPUSHBUTTON   "확인",IDOK,278,264,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,332,264,50,14
    PUSHBUTTON      "도움말",IDHELP,386,264,50,14
END

IDD_COPYPROGRESSDLG DIALOGEX 18, 80, 353, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "삭제 취소"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "복구 중",IDC_LABEL_UNDELETING,3,11,54,8
    CONTROL         "",IDC_LABEL_SOURCE,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,61,11,287,8
    RTEXT           "대상",IDC_STATIC_1,3,23,40,8
    CONTROL         "",IDC_LABEL_DEST,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,61,23,287,8
    RTEXT           "파일:",IDC_STATIC_2,3,41,40,8
    LTEXT           "",IDC_PROGRESS_FILE,47,40,293,12,NOT WS_GROUP
    RTEXT           "전체:",IDC_STATIC_3,3,56,40,8
    LTEXT           "",IDC_PROGRESS_TOTAL,47,55,293,12,NOT WS_GROUP
    DEFPUSHBUTTON   "취소",IDCANCEL,151,78,50,14
END

IDD_FILENAME DIALOGEX 0, 0, 235, 66
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "손상된 파일 이름"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "다음 파일 이름의 첫 글자를 복구할 수 없습니다. 원래 문자를 입력하십시오.",IDC_STATIC_1,7,9,221,8
    EDITTEXT        IDC_EDIT_FILENAME,7,19,221,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "확인",IDOK,66,45,50,14
    PUSHBUTTON      "모두(&A)",IDC_BUTTON_ALL,122,45,50,14
    PUSHBUTTON      "취소",IDCANCEL,178,45,50,14
END

IDD_CONFIG DIALOGEX 0, 0, 257, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "삭제 취소 설정"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "파일 보기에 사용할 대체 임시 디렉터리(&T):",IDC_STATIC_1,7,7,163,8
    EDITTEXT        IDC_EDIT_TEMPPATH,7,17,222,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,235,17,16,14,WS_GROUP
    CONTROL         "FAT에서 이전 클러스터 검사 정보를 항상 다시 사용(&R)",IDC_CHECK_ALWAYSREUSE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,39,194,10
    CONTROL         "같은 논리 디스크로 복구할 때 경고 안 함(&S)",IDC_CHECK_SAMEPARTITION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,50,193,10
    CONTROL         "암호화된 파일을 FAT 또는 exFAT로 복구하기 전에 경고 안 함(&E)",IDC_CHECK_EFS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,61,223,10
    DEFPUSHBUTTON   "확인",IDOK,91,80,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,146,80,50,14
    PUSHBUTTON      "도움말",IDHELP,201,80,50,14
END

IDD_RESTORE DIALOGEX 0, 0, 276, 87
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "백업에서 암호화된 파일 복원"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "이 기능은 FAT처럼 EFS(파일 시스템 암호화)를 지원하지 않는 파티션으로 이전에 복구한 암호화된 파일을 복원합니다. 일반 파일(*.bak 이외의 파일)은 수정 없이 복사됩니다.",IDC_STATIC_1,7,7,262,16
    LTEXT           "%s 복원 위치(&R):",IDC_LABEL_SOURCE,7,33,262,8
    EDITTEXT        IDC_EDIT_TARGET,7,43,244,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,255,43,14,14,WS_GROUP
    DEFPUSHBUTTON   "확인",IDOK,57,66,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,113,66,50,14
    PUSHBUTTON      "도움말",IDHELP,169,66,50,14
END

