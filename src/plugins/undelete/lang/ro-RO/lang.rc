// Romanian (ro-RO) resources for undelete. Translation: Ioan Stefancu, Donca Radu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/undelete/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\undelete.rh2"

LANGUAGE LANG_ROMANIAN, SUBLANG_ROMANIAN_ROMANIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_SNAPSHOTPROGRESSDLG DIALOGEX 18, 80, 341, 77
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Recupereaza ce ai sters"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_LABEL_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,13,12,323,8
    LTEXT           "",IDC_PROGRESSBAR,37,32,290,12,NOT WS_GROUP
    DEFPUSHBUTTON   "Anuleaza",IDCANCEL,144,54,50,14
    LTEXT           "Total:",IDC_STATIC_1,13,33,22,8
END

IDD_CONNECT DIALOGEX 18, 80, 443, 285
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Recupereaza ce ai sters"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Selecteaza &discul pt. analizat",IDC_STATIC_1,6,7,430,193,WS_GROUP
    CONTROL         "",IDC_LIST_VOLUMES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SORTASCENDING | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,14,21,414,139
    CONTROL         "&Imagine Disc",IDC_CHECK_IMAGE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,166,57,10
    EDITTEXT        IDC_EDIT_IMAGE,14,178,351,14,ES_AUTOHSCROLL
    PUSHBUTTON      "&Rasfoieste...",IDC_BUTTON_BROWSE,369,178,60,14,WS_GROUP
    CONTROL         "Scanare clustere &vacante pe partitii FAT",IDC_CHECK_SCANVACANT,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,208,184,10
    CONTROL         "Arata fisiere si directoare &existente",IDC_CHECK_SHOWEXISTING,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,220,184,10
    CONTROL         "Arata fisierle cu dimensiune &zero",IDC_CHECK_SHOWZEROFILES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,232,184,10
    CONTROL         "Ara&ta directoarele goale",IDC_CHECK_SHOWEMPTYDIRS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,244,184,10
    CONTROL         "Arata &metafișiere",IDC_CHECK_SHOWMETAFILES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,256,184,10
    CONTROL         "Estimeaza stricarea &fisierelor",IDC_CHECK_ESTIMATEDAMAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,268,184,10
    DEFPUSHBUTTON   "OK",IDOK,278,264,50,14,WS_GROUP
    PUSHBUTTON      "Anuleaza",IDCANCEL,332,264,50,14
    PUSHBUTTON      "Help",IDHELP,386,264,50,14
END

IDD_COPYPROGRESSDLG DIALOGEX 18, 80, 353, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Recupereaza ce ai sters"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Recuperare",IDC_LABEL_UNDELETING,3,11,40,8
    CONTROL         "",IDC_LABEL_SOURCE,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,47,11,301,8
    RTEXT           "pe",IDC_STATIC_1,3,23,40,8
    CONTROL         "",IDC_LABEL_DEST,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,47,23,301,8
    RTEXT           "Fisier:",IDC_STATIC_2,3,41,40,8
    LTEXT           "",IDC_PROGRESS_FILE,47,40,293,12,NOT WS_GROUP
    RTEXT           "Total:",IDC_STATIC_3,3,56,40,8
    LTEXT           "",IDC_PROGRESS_TOTAL,47,55,293,12,NOT WS_GROUP
    DEFPUSHBUTTON   "Anuleaza",IDCANCEL,151,78,50,14
END

IDD_FILENAME DIALOGEX 0, 0, 213, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Nume fisier compromis"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Prima litera din numele urmatorului fisier nu poate fi recuperata. Va rugam introduceti caracterul original.",IDC_STATIC_1,7,7,199,16
    EDITTEXT        IDC_EDIT_FILENAME,7,27,199,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,44,53,50,14
    PUSHBUTTON      "&Tot",IDC_BUTTON_ALL,100,53,50,14
    PUSHBUTTON      "Anuleaza",IDCANCEL,156,53,50,14
END

IDD_CONFIG DIALOGEX 0, 0, 287, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configurare Recuperare ce ai sters"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Director &temporar alternativ pentru vizualizare fisiere:",IDC_STATIC_1,7,7,181,8
    EDITTEXT        IDC_EDIT_TEMPPATH,7,17,252,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,265,17,16,14,WS_GROUP
    CONTROL         "Tot timpul &refoloseste informatii din scanari anterioare cluster pe FAT",IDC_CHECK_ALWAYSREUSE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,39,244,10
    CONTROL         "Nu atentiona cand recuperezi de pe acela&si disc logic",IDC_CHECK_SAMEPARTITION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,50,190,10
    CONTROL         "Nu atentiona inainte de recuperare fisiere criptat&e pe FAT sau exFAT",IDC_CHECK_EFS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,61,243,10
    DEFPUSHBUTTON   "OK",IDOK,121,80,50,14,WS_GROUP
    PUSHBUTTON      "Anuleaza",IDCANCEL,176,80,50,14
    PUSHBUTTON      "Help",IDHELP,231,80,50,14
END

IDD_RESTORE DIALOGEX 0, 0, 276, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Restaureaza Fisiere Criptate din Backup"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Aceasta functie va reface fisierele criptate, anterior recuperate pe o partitie care nu suporta Encrypting File System (EFS), cum ar fi FAT. Fisierele normale (altele decat *.bak) vor fi copiate nemodificat.",IDC_STATIC_1,7,7,262,24
    LTEXT           "&Restaureaza %s in:",IDC_LABEL_SOURCE,7,41,262,8
    EDITTEXT        IDC_EDIT_TARGET,7,51,244,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,255,51,14,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,57,74,50,14,WS_GROUP
    PUSHBUTTON      "Anuleaza",IDCANCEL,113,74,50,14
    PUSHBUTTON      "Help",IDHELP,169,74,50,14
END

