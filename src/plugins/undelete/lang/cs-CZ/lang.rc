// Czech (cs-CZ) resources for undelete. Translation: Hynek Mikulič.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/undelete/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\undelete.rh2"

LANGUAGE LANG_CZECH, SUBLANG_CZECH_CZECH_REPUBLIC

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_SNAPSHOTPROGRESSDLG DIALOGEX 18, 80, 341, 77
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Obnovení souborů a adresářů"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_LABEL_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,12,12,324,8
    LTEXT           "",IDC_PROGRESSBAR,42,32,285,12,NOT WS_GROUP
    DEFPUSHBUTTON   "Storno",IDCANCEL,144,54,50,14
    LTEXT           "Celkem:",IDC_STATIC_1,12,33,29,8
END

IDD_CONNECT DIALOGEX 18, 80, 443, 285
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Obnovení souborů a adresářů"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Výběr &disku k analýze",IDC_STATIC_1,6,7,430,193,WS_GROUP
    CONTROL         "",IDC_LIST_VOLUMES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SORTASCENDING | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,14,21,414,139
    CONTROL         "&Obraz disku",IDC_CHECK_IMAGE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,166,51,10
    EDITTEXT        IDC_EDIT_IMAGE,14,178,361,14,ES_AUTOHSCROLL
    PUSHBUTTON      "&Procházet...",IDC_BUTTON_BROWSE,379,178,50,14,WS_GROUP
    CONTROL         "&Skenovat prázdné clustery na FAT oddílech",IDC_CHECK_SCANVACANT,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,208,184,10
    CONTROL         "&Zobrazit existující soubory a adresáře",IDC_CHECK_SHOWEXISTING,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,220,184,10
    CONTROL         "Zo&brazit soubory s nulovou velikostí",IDC_CHECK_SHOWZEROFILES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,232,184,10
    CONTROL         "Zob&razit prázdné adresáře",IDC_CHECK_SHOWEMPTYDIRS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,244,184,10
    CONTROL         "Zobrazit &metasoubory",IDC_CHECK_SHOWMETAFILES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,256,184,10
    CONTROL         "Od&hadnout poškození souborů",IDC_CHECK_ESTIMATEDAMAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,268,184,10
    DEFPUSHBUTTON   "OK",IDOK,278,264,50,14,WS_GROUP
    PUSHBUTTON      "Storno",IDCANCEL,332,264,50,14
    PUSHBUTTON      "Nápověda",IDHELP,386,264,50,14
END

IDD_COPYPROGRESSDLG DIALOGEX 18, 80, 353, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Obnovení souborů a adresářů"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Obnovení",IDC_LABEL_UNDELETING,3,11,40,8
    CONTROL         "",IDC_LABEL_SOURCE,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,47,11,301,8
    RTEXT           "do",IDC_STATIC_1,3,23,40,8
    CONTROL         "",IDC_LABEL_DEST,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,47,23,301,8
    RTEXT           "Soubor:",IDC_STATIC_2,3,41,40,8
    LTEXT           "",IDC_PROGRESS_FILE,47,40,293,12,NOT WS_GROUP
    RTEXT           "Celkem:",IDC_STATIC_3,3,56,40,8
    LTEXT           "",IDC_PROGRESS_TOTAL,47,55,293,12,NOT WS_GROUP
    DEFPUSHBUTTON   "Storno",IDCANCEL,151,78,50,14
END

IDD_FILENAME DIALOGEX 0, 0, 213, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Poškozený název souboru"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "První znak následujícího názvu souboru nelze obnovit.   Prosím zadejte původní znak.",IDC_STATIC_1,7,7,199,16
    EDITTEXT        IDC_EDIT_FILENAME,7,27,199,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,44,53,50,14
    PUSHBUTTON      "&Vše",IDC_BUTTON_ALL,100,53,50,14
    PUSHBUTTON      "Storno",IDCANCEL,156,53,50,14
END

IDD_CONFIG DIALOGEX 0, 0, 297, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Obnovení souborů a adresářů - Konfigurace"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Alternativní &dočasný adresář pro zobrazované soubory:",IDC_STATIC_1,7,7,186,8
    EDITTEXT        IDC_EDIT_TEMPPATH,7,17,262,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,275,17,16,14,WS_GROUP
    CONTROL         "&Vždy použít předchozí cluster skenovaných informací na FAT",IDC_CHECK_ALWAYSREUSE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,39,214,10
    CONTROL         "Nezobrazit upozornění při obnovení do &stejného logického disku",IDC_CHECK_SAMEPARTITION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,50,226,10
    CONTROL         "Nezobrazit upozornění při obnovení š&ifrovaného souboru na FAT nebo exFAT",IDC_CHECK_EFS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,61,269,10
    DEFPUSHBUTTON   "OK",IDOK,131,80,50,14,WS_GROUP
    PUSHBUTTON      "Storno",IDCANCEL,186,80,50,14
    PUSHBUTTON      "Nápověda",IDHELP,241,80,50,14
END

IDD_RESTORE DIALOGEX 0, 0, 276, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Obnovení šifrovaného souboru ze zálohy"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Tato funkce obnoví šifrované soubory, před obnovou smazaných, do oddílu bez podpory Šifrovaného systému souborů (EFS), jako např.: FAT. Běžné soubory (jiné než *.bak) budou kopírovány bez změny.",IDC_STATIC_1,7,7,262,24
    LTEXT           "&Obnovit %s do:",IDC_LABEL_SOURCE,7,41,262,8
    EDITTEXT        IDC_EDIT_TARGET,7,51,244,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,255,51,14,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,57,74,50,14,WS_GROUP
    PUSHBUTTON      "Storno",IDCANCEL,113,74,50,14
    PUSHBUTTON      "Nápověda",IDHELP,169,74,50,14
END

