// Dutch (nl-NL) resources for undelete. Translation: Cor van der Smissen, Marco Fung, Patrick Vijgeboom, S.V. (Stephan) Rietveld.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/undelete/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\undelete.rh2"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_SNAPSHOTPROGRESSDLG DIALOGEX 18, 80, 341, 77
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Herstellen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_LABEL_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,12,12,323,8
    LTEXT           "",IDC_PROGRESSBAR,39,32,288,12,NOT WS_GROUP
    DEFPUSHBUTTON   "Annuleren",IDCANCEL,145,54,50,14
    LTEXT           "Totaal:",IDC_STATIC_1,12,33,26,8
END

IDD_CONNECT DIALOGEX 18, 80, 443, 285
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Herstellen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Selecteer de &schijf welke u wilt analyseren",IDC_STATIC_1,6,7,430,193,WS_GROUP
    CONTROL         "",IDC_LIST_VOLUMES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SORTASCENDING | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,14,21,414,139
    CONTROL         "Schijf &Image",IDC_CHECK_IMAGE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,166,55,10
    EDITTEXT        IDC_EDIT_IMAGE,14,178,361,14,ES_AUTOHSCROLL
    PUSHBUTTON      "&Bladeren...",IDC_BUTTON_BROWSE,379,178,50,14,WS_GROUP
    CONTROL         "Scannen van &vacante clusters op FAT partitie's",IDC_CHECK_SCANVACANT,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,208,184,10
    CONTROL         "Laat b&estaande bestanden en mappen zien",IDC_CHECK_SHOWEXISTING,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,220,184,10
    CONTROL         "Laat bestanden met grootte van n&ul zien",IDC_CHECK_SHOWZEROFILES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,232,184,10
    CONTROL         "&Laat lege mappen zien",IDC_CHECK_SHOWEMPTYDIRS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,244,184,10
    CONTROL         "Laat &metabestanden zien",IDC_CHECK_SHOWMETAFILES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,256,184,10
    CONTROL         "S&chat beschadigde bestanden",IDC_CHECK_ESTIMATEDAMAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,268,184,10
    DEFPUSHBUTTON   "OK",IDOK,278,264,50,14,WS_GROUP
    PUSHBUTTON      "Annuleren",IDCANCEL,332,264,50,14
    PUSHBUTTON      "Help",IDHELP,386,264,50,14
END

IDD_COPYPROGRESSDLG DIALOGEX 18, 80, 363, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Herstellen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Herstellen van",IDC_LABEL_UNDELETING,3,11,50,8
    CONTROL         "",IDC_LABEL_SOURCE,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,57,11,301,8
    RTEXT           "naar",IDC_STATIC_1,3,23,50,8
    CONTROL         "",IDC_LABEL_DEST,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,57,23,301,8
    RTEXT           "Bestand:",IDC_STATIC_2,3,41,50,8
    LTEXT           "",IDC_PROGRESS_FILE,57,40,293,12,NOT WS_GROUP
    RTEXT           "Totaal:",IDC_STATIC_3,3,56,50,8
    LTEXT           "",IDC_PROGRESS_TOTAL,57,55,293,12,NOT WS_GROUP
    DEFPUSHBUTTON   "Annuleren",IDCANCEL,156,78,50,14
END

IDD_FILENAME DIALOGEX 0, 0, 213, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Beschadigde bestanden"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "De eerste letter van het volgende bestandsnaam kon niet worden hersteld. Gelieve het originele karakter in te vullen.",IDC_STATIC_1,7,7,199,16
    EDITTEXT        IDC_EDIT_FILENAME,7,27,199,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,44,53,50,14
    PUSHBUTTON      "&Alles",IDC_BUTTON_ALL,100,53,50,14
    PUSHBUTTON      "Annuleren",IDCANCEL,156,53,50,14
END

IDD_CONFIG DIALOGEX 0, 0, 397, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Undelete configuratie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Alternatieve &tijdelijke map om bestanden te bekijken:",IDC_STATIC_1,7,7,180,8
    EDITTEXT        IDC_EDIT_TEMPPATH,7,17,362,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,375,17,16,14,WS_GROUP
    CONTROL         "He&rgebruik altijd de eerder gebruikte cluster scan infomatie op FAT",IDC_CHECK_ALWAYSREUSE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,39,238,10
    CONTROL         "Geef geen waarschuwing wanneer er wordt hersteld naar &dezelfde logische schijf",IDC_CHECK_SAMEPARTITION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,50,286,10
    CONTROL         "&Geef geen waarschuwing voordat het herstel plaatsvindt van de versleutelde bestanden op FAT of exFAT",IDC_CHECK_EFS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,61,364,10
    DEFPUSHBUTTON   "OK",IDOK,231,80,50,14,WS_GROUP
    PUSHBUTTON      "Annuleren",IDCANCEL,286,80,50,14
    PUSHBUTTON      "Help",IDHELP,341,80,50,14
END

IDD_RESTORE DIALOGEX 0, 0, 286, 95
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Herstel versleutelde bestande van een back-up"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Deze functie zal versleutelde bestanden herstellen, welke eerder zijn hersteld, naar een partitie zonder Encrypting File System (EFS) ondersteuning, zoals FAT. Gewone bestanden (anders dan *.bak) zullen ongewijzigd worden gekopieërd.",IDC_STATIC_1,7,7,272,24
    LTEXT           "&Herstellen %s naar:",IDC_LABEL_SOURCE,7,41,272,8
    EDITTEXT        IDC_EDIT_TARGET,7,51,254,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,265,51,14,14,WS_GROUP
    DEFPUSHBUTTON   "OK",IDOK,62,74,50,14,WS_GROUP
    PUSHBUTTON      "Annuleren",IDCANCEL,118,74,50,14
    PUSHBUTTON      "Help",IDHELP,174,74,50,14
END

