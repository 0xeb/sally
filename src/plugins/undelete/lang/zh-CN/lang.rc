// Chinese (Simplified) (zh-CN) resources for undelete. Translation: Michael Lu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/undelete/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\undelete.rh2"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_SNAPSHOTPROGRESSDLG DIALOGEX 18, 80, 341, 77
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "取消删除"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_LABEL_FILENAME,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,12,12,323,8
    LTEXT           "",IDC_PROGRESSBAR,35,32,292,12,NOT WS_GROUP
    DEFPUSHBUTTON   "取消",IDCANCEL,144,54,50,14
    LTEXT           "总数:",IDC_STATIC_1,12,33,22,8
END

IDD_CONNECT DIALOGEX 18, 80, 443, 285
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "取消删除"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "选择要分析的磁盘(&D)",IDC_STATIC_1,6,7,430,193,WS_GROUP
    CONTROL         "",IDC_LIST_VOLUMES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SORTASCENDING | LVS_NOSORTHEADER | WS_BORDER | WS_GROUP | WS_TABSTOP,14,21,414,139
    CONTROL         "磁盘镜像(&I)",IDC_CHECK_IMAGE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,166,56,10
    EDITTEXT        IDC_EDIT_IMAGE,14,178,361,14,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览(&B)...",IDC_BUTTON_BROWSE,379,178,50,14,WS_GROUP
    CONTROL         "显示 FAT 分区上的空白簇(&V)",IDC_CHECK_SCANVACANT,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,208,184,10
    CONTROL         "显示存在的文件和目录(&x)",IDC_CHECK_SHOWEXISTING,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,220,184,10
    CONTROL         "显示0字节文件(&z)",IDC_CHECK_SHOWZEROFILES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,232,184,10
    CONTROL         "显示空目录(&e)",IDC_CHECK_SHOWEMPTYDIRS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,244,184,10
    CONTROL         "显示图元文件(&w)",IDC_CHECK_SHOWMETAFILES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,256,184,10
    CONTROL         "估计文件损坏(&f)",IDC_CHECK_ESTIMATEDAMAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,268,184,10
    DEFPUSHBUTTON   "确定",IDOK,278,264,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,332,264,50,14
    PUSHBUTTON      "帮助",IDHELP,386,264,50,14
END

IDD_COPYPROGRESSDLG DIALOGEX 18, 80, 353, 102
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "取消删除"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "正在取消删除",IDC_LABEL_UNDELETING,3,11,54,8
    CONTROL         "",IDC_LABEL_SOURCE,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,61,11,287,8
    RTEXT           "到",IDC_STATIC_1,3,23,40,8
    CONTROL         "",IDC_LABEL_DEST,"Static",SS_LEFTNOWORDWRAP | SS_NOPREFIX | WS_GROUP,61,23,287,8
    RTEXT           "文件:",IDC_STATIC_2,3,41,40,8
    LTEXT           "",IDC_PROGRESS_FILE,47,40,293,12,NOT WS_GROUP
    RTEXT           "总数:",IDC_STATIC_3,3,56,40,8
    LTEXT           "",IDC_PROGRESS_TOTAL,47,55,293,12,NOT WS_GROUP
    DEFPUSHBUTTON   "取消",IDCANCEL,151,78,50,14
END

IDD_FILENAME DIALOGEX 0, 0, 235, 66
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "损坏的文件名"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "以下文件名的第一个字母无法被恢复。请输入原始字符。",IDC_STATIC_1,7,9,221,8
    EDITTEXT        IDC_EDIT_FILENAME,7,19,221,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "确定",IDOK,66,45,50,14
    PUSHBUTTON      "全部(&A)",IDC_BUTTON_ALL,122,45,50,14
    PUSHBUTTON      "取消",IDCANCEL,178,45,50,14
END

IDD_CONFIG DIALOGEX 0, 0, 257, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "取消删除配置"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "用于查看文件的备用临时目录(&T):",IDC_STATIC_1,7,7,163,8
    EDITTEXT        IDC_EDIT_TEMPPATH,7,17,222,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,235,17,16,14,WS_GROUP
    CONTROL         "始终重复使用 FAT 上以前的簇扫描信息(&R)",IDC_CHECK_ALWAYSREUSE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,39,194,10
    CONTROL         "当取消删除到相同的逻辑磁盘时不警告(&S)",IDC_CHECK_SAMEPARTITION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,50,193,10
    CONTROL         "反删除加密文件到 FAT 或 exFAT 之前不警告(&e)",IDC_CHECK_EFS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,61,223,10
    DEFPUSHBUTTON   "确定",IDOK,91,80,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,146,80,50,14
    PUSHBUTTON      "帮助",IDHELP,201,80,50,14
END

IDD_RESTORE DIALOGEX 0, 0, 276, 87
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "从备份中恢复加密文件"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "本功能将恢复之前取消删除的加密文件到不支持""加密文件系统(EFS)""的分区，例如 FAT。普通文件(除了 *.bak)将被复制且不改变。",IDC_STATIC_1,7,7,262,16
    LTEXT           "恢复 %s 到(&R):",IDC_LABEL_SOURCE,7,33,262,8
    EDITTEXT        IDC_EDIT_TARGET,7,43,244,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_BROWSE,255,43,14,14,WS_GROUP
    DEFPUSHBUTTON   "确定",IDOK,57,66,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,113,66,50,14
    PUSHBUTTON      "帮助",IDHELP,169,66,50,14
END

