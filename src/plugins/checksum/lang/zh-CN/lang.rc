// Chinese (Simplified) (zh-CN) resources for checksum. Translation: Michael Lu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/checksum/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\checksum.rh2"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CALCULATE DIALOGEX 0, 0, 344, 84
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_VISIBLE
CAPTION "计算校验和"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "List1",IDC_LIST_FILES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | LVS_OWNERDATA | WS_CLIPSIBLINGS | WS_BORDER | WS_TABSTOP,5,5,334,54
    LTEXT           "正在计算:",IDC_LABEL,5,68,40,8,WS_CLIPSIBLINGS
    CONTROL         "Progress1",IDC_PROGRESS,"msctls_progress32",PBS_SMOOTH | WS_CLIPSIBLINGS | WS_BORDER,48,68,107,8
    PUSHBUTTON      "配置(&F)...",IDC_BUTTON_CONFIGURE,162,65,55,14,WS_CLIPSIBLINGS
    PUSHBUTTON      "保存(&S)...",IDC_BUTTON_SAVE,223,65,55,14,WS_CLIPSIBLINGS
    DEFPUSHBUTTON   "停止(&S)",IDC_BUTTON_CLOSE,284,65,55,14,WS_CLIPSIBLINGS
    LTEXT           "剪贴板提示",IDC_LABEL_HINT,5,68,45,8,WS_CLIPSIBLINGS
END

IDD_VERIFY DIALOGEX 0, 0, 260, 84
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_VISIBLE
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "List1",IDC_LIST_FILES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | LVS_OWNERDATA | WS_CLIPSIBLINGS | WS_BORDER | WS_TABSTOP,5,5,250,54
    LTEXT           "正在验证:",IDC_LABEL,5,68,40,8,WS_CLIPSIBLINGS
    CONTROL         "Progress1",IDC_PROGRESS,"msctls_progress32",PBS_SMOOTH | WS_CLIPSIBLINGS | WS_BORDER,48,68,95,8
    LTEXT           "",IDC_LABEL_RESULT,5,68,140,8,WS_CLIPSIBLINGS
    PUSHBUTTON      "焦点(&F)",IDC_BUTTON_FOCUS,149,65,50,14,WS_CLIPSIBLINGS
    DEFPUSHBUTTON   "停止(&S)",IDC_BUTTON_CLOSE,205,65,50,14,WS_CLIPSIBLINGS
END

IDD_CONFIGURATION DIALOGEX 22, 38, 189, 109
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "校验和配置"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        " 计算校验和 ",IDC_STATIC_1,8,5,174,76,WS_GROUP
    CONTROL         "&CRC/SFV",IDC_CFG_CRC,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,15,16,105,10
    CONTROL         "&MD5",IDC_CFG_MD5,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,28,105,10
    CONTROL         "SHA-&1",IDC_CFG_SHA1,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,40,105,10
    CONTROL         "SHA-&256",IDC_CFG_SHA256,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,52,105,10
    CONTROL         "SHA-&512",IDC_CFG_SHA512,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,64,105,10
    DEFPUSHBUTTON   "确定",IDOK,14,88,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,69,88,50,14
    PUSHBUTTON      "帮助",IDHELP,124,88,50,14
END

