//
// French (fr-FR) resources for checksum. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/checksum/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\checksum.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CALCULATE DIALOGEX 0, 0, 374, 84
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_VISIBLE
CAPTION "Calcul des checksums"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Liste1",IDC_LIST_FILES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | LVS_OWNERDATA | WS_CLIPSIBLINGS | WS_BORDER | WS_TABSTOP,5,5,364,54
    LTEXT           "Calcul en cours:",IDC_LABEL,5,68,56,8,WS_CLIPSIBLINGS
    CONTROL         "Progress1",IDC_PROGRESS,"msctls_progress32",PBS_SMOOTH | WS_CLIPSIBLINGS | WS_BORDER,64,68,91,8
    PUSHBUTTON      "Con&figurer...",IDC_BUTTON_CONFIGURE,162,65,65,14,WS_CLIPSIBLINGS
    PUSHBUTTON      "&Sauvegarder...",IDC_BUTTON_SAVE,233,65,65,14,WS_CLIPSIBLINGS
    DEFPUSHBUTTON   "&Arrêter",IDC_BUTTON_CLOSE,304,65,65,14,WS_CLIPSIBLINGS
    LTEXT           "astuce presse-papier",IDC_LABEL_HINT,5,68,72,8,WS_CLIPSIBLINGS
END

IDD_VERIFY DIALOGEX 0, 0, 260, 84
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_VISIBLE
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "List1",IDC_LIST_FILES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | LVS_OWNERDATA | WS_CLIPSIBLINGS | WS_BORDER | WS_TABSTOP,5,5,250,54
    LTEXT           "Vérification:",IDC_LABEL,5,68,42,8,WS_CLIPSIBLINGS
    CONTROL         "Progress1",IDC_PROGRESS,"msctls_progress32",PBS_SMOOTH | WS_CLIPSIBLINGS | WS_BORDER,50,68,93,8
    LTEXT           "",IDC_LABEL_RESULT,5,68,140,8,WS_CLIPSIBLINGS
    PUSHBUTTON      "&Cibler",IDC_BUTTON_FOCUS,149,65,50,14,WS_CLIPSIBLINGS
    DEFPUSHBUTTON   "&Arrêt",IDC_BUTTON_CLOSE,205,65,50,14,WS_CLIPSIBLINGS
END

IDD_CONFIGURATION DIALOGEX 22, 38, 189, 109
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration du Checksum"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        " Calcul des checksums ",IDC_STATIC_1,8,5,174,76,WS_GROUP
    CONTROL         "&CRC/SFV",IDC_CFG_CRC,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,15,16,105,10
    CONTROL         "&MD5",IDC_CFG_MD5,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,28,105,10
    CONTROL         "SHA-&1",IDC_CFG_SHA1,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,40,105,10
    CONTROL         "SHA-&256",IDC_CFG_SHA256,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,52,105,10
    CONTROL         "SHA-&512",IDC_CFG_SHA512,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,64,105,10
    DEFPUSHBUTTON   "OK",IDOK,14,88,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,69,88,50,14
    PUSHBUTTON      "Aide",IDHELP,124,88,50,14
END

