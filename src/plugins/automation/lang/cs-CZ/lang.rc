// Czech (cs-CZ) resources for automation. Translation: Hynek Mikulič.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/automation/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"

LANGUAGE LANG_CZECH, SUBLANG_CZECH_CZECH_REPUBLIC

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_INPUTBOX DIALOGEX 75, 140, 205, 64
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Vstupní box"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Výzva:",IDC_PROMPT,8,8,189,8
    EDITTEXT        IDC_INPUTBOX,8,18,189,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",1,48,42,50,14,WS_GROUP
    PUSHBUTTON      "Storno",2,107,42,50,14
END

IDD_CONFIG DIALOGEX 75, 140, 332, 143
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Automatizace - Konfigurace"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Adresáře &skriptů:",IDC_DIRLISTHEADER,8,9,67,8
    CONTROL         "",IDC_DIRLIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | LVS_NOCOLUMNHEADER | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,8,19,316,73
    CONTROL         "Povolit &ladění skriptu",IDC_ENABLEDBG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,102,105,10
    DEFPUSHBUTTON   "OK",IDOK,75,121,50,14,WS_GROUP
    PUSHBUTTON      "Storno",IDCANCEL,141,121,50,14
    PUSHBUTTON      "&Nápověda",IDHELP,207,121,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_BROWSE MENU
BEGIN
    POPUP "[POPUP]"
    BEGIN
        MENUITEM "Procházet…",                     ID_BROWSE
        MENUITEM SEPARATOR
        MENUITEM "Adresář Sally",        ID_SALDIR
        MENUITEM "Proměnná prostředí",        ID_ENVVAR
    END
END

