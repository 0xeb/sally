//
// Spanish (es-ES) resources for automation. Translation: Juan Pablo Barrio Lera.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/automation/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_INPUTBOX DIALOGEX 75, 140, 205, 64
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Cuadro de entrada"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Línea de comando:",IDC_PROMPT,8,8,189,8
    EDITTEXT        IDC_INPUTBOX,8,18,189,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Aceptar",1,48,42,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",2,107,42,50,14
END

IDD_CONFIG DIALOGEX 75, 140, 332, 143
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuración de automatización"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Directorios del &script:",IDC_DIRLISTHEADER,8,9,74,8
    CONTROL         "",IDC_DIRLIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | LVS_NOCOLUMNHEADER | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,8,19,316,73
    CONTROL         "Habilitar &depuración de scripts",IDC_ENABLEDBG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,102,114,10
    DEFPUSHBUTTON   "Aceptar",IDOK,75,121,50,14,WS_GROUP
    PUSHBUTTON      "Cancelar",IDCANCEL,141,121,50,14
    PUSHBUTTON      "&Ayuda",IDHELP,207,121,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_BROWSE MENU
BEGIN
    POPUP "[POPUP]"
    BEGIN
        MENUITEM "Hojear…",                     ID_BROWSE
        MENUITEM SEPARATOR
        MENUITEM "Directorio de Sally",        ID_SALDIR
        MENUITEM "Variable de entorno",        ID_ENVVAR
    END
END

