// German (de-DE) resources for automation. Translation: Dirk Bornhütter, Thomas Kelso, Thomas Pagels, Thomas Wölk, Marko Meister und Mick Weiss.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/automation/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_INPUTBOX DIALOGEX 75, 140, 205, 64
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Eingabefeld"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Abfrage:",IDC_PROMPT,8,8,189,8
    EDITTEXT        IDC_INPUTBOX,8,18,189,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",1,48,42,50,14,WS_GROUP
    PUSHBUTTON      "Abbrechen",2,107,42,50,14
END

IDD_CONFIG DIALOGEX 75, 140, 332, 143
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Automation Konfiguration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Skriptverzeichnisse:",IDC_DIRLISTHEADER,8,9,67,8
    CONTROL         "",IDC_DIRLIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | LVS_NOCOLUMNHEADER | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,8,19,316,73
    CONTROL         "Skript&debuggen ermöglichen",IDC_ENABLEDBG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,102,110,10
    DEFPUSHBUTTON   "OK",IDOK,75,121,50,14,WS_GROUP
    PUSHBUTTON      "Abbrechen",IDCANCEL,141,121,50,14
    PUSHBUTTON      "&Hilfe",IDHELP,207,121,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_BROWSE MENU
BEGIN
    POPUP "[POPUP]"
    BEGIN
        MENUITEM "Durchsuchen…",                     ID_BROWSE
        MENUITEM SEPARATOR
        MENUITEM "Sally Verzeichnis",        ID_SALDIR
        MENUITEM "Umgebungsvariable",        ID_ENVVAR
    END
END

