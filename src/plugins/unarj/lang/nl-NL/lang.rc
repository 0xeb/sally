// Dutch (nl-NL) resources for unarj. Translation: Cor van der Smissen, Marco Fung, Patrick Vijgeboom, S.V. (Stephan) Rietveld.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unarj/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unarj.rh2"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 6, 15, 213, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Volgende archief volume"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Plaats diskette die het volgende archief volume bevat of zoek naar het desbetreffende bestand in de hardeschijf.\n\nDruk op OK indien gereed.",IDC_STATIC_1,12,9,195,32
    LTEXT           "Vorige volume:",IDC_STATIC_2,12,48,60,8
    EDITTEXT        IDC_PREVVOL,73,48,134,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT           "&Volgende volume:",IDC_STATIC_3,12,62,63,8
    EDITTEXT        IDC_FILENAME,12,72,174,12
    PUSHBUTTON      "...",IDC_BROWSE,189,72,13,12
    DEFPUSHBUTTON   "OK",IDOK,50,91,50,14
    PUSHBUTTON      "Annuleren",IDCANCEL,113,91,50,14
END

IDD_ERROR DIALOGEX 15, 34, 356, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Fout"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Naam:",IDC_STATIC_1,6,10,26,8
    LTEXT           "",IDS_FILENAME,36,10,313,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Fout:",IDC_STATIC_2,6,23,26,8,NOT WS_GROUP
    LTEXT           "Bestand kan niet uitgepakt worden omdat het gecontinueerd wordt vanaf het vorige volume. Om het bestand uit te pakken moet je beginnen met het volume waar het bestand begint.",IDC_STATIC_3,36,23,313,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "&Toon dit bericht niet in het vervolg.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,44,183,12
    DEFPUSHBUTTON   "OK",IDOK,123,63,50,14,WS_GROUP
    PUSHBUTTON      "Annuleren",IDCANCEL,183,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 247, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnARJ Configuratie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "uitpakken.",IDC_STATIC_1,23,22,154,8
    CONTROL         "&Automatisch bestanden uit vorige volumes overslaan tijdens",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,10,212,12
    LTEXT           "niet opgesomd kan worden.",IDC_STATIC_2,23,44,111,8
    CONTROL         "A&ttentie niet weergeven wanneer de hele inhoud van het archief",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,229,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,235,1
    DEFPUSHBUTTON   "OK",IDOK,69,66,50,14
    PUSHBUTTON      "Annuleren",IDCANCEL,128,66,50,14
END

IDD_WARNING DIALOGEX 6, 15, 222, 107
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnARJ - Attentie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Niet alle bestanden in het multi-volume archief kunnen opgesomd worden (en weergegeven worden in het paneel), omdat sommige archief volumes niet zijn gevonden.",IDC_STATIC_1,11,10,205,24
    LTEXT           "Om de hele inhoud van het archief op te sommen, kopieer alle volumes naar dezelfde map.",IDC_STATIC_2,11,41,205,16
    CONTROL         "&Toon dit bericht niet in het vervolg",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,66,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,83,212,1
    DEFPUSHBUTTON   "OK",IDOK,162,89,50,14
END

