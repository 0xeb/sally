//
// Romanian (ro-RO) resources for unarj. Translation: Ioan Stefancu, Donca Radu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unarj/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unarj.rh2"

LANGUAGE LANG_ROMANIAN, SUBLANG_ROMANIAN_ROMANIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 6, 15, 198, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Urmatorul volum arhiva"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Introdu discul cu urmatorul volum arhiva sau localizeaza fisierul potrivit pe disc.\n\nApasa OK cand sunteti gata.",IDC_STATIC_1,12,9,180,32
    LTEXT           "Volumul precedent:",IDC_STATIC_2,12,48,68,8
    EDITTEXT        IDC_PREVVOL,81,48,109,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT           "&Volumul urmator:",IDC_STATIC_3,12,62,61,8
    EDITTEXT        IDC_FILENAME,12,72,159,12
    PUSHBUTTON      "...",IDC_BROWSE,174,72,13,12
    DEFPUSHBUTTON   "OK",IDOK,42,91,50,14
    PUSHBUTTON      "Anuleaza",IDCANCEL,105,91,50,14
END

IDD_ERROR DIALOGEX 15, 34, 352, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Eroare"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "Nume:",IDC_STATIC_1,6,10,26,8
    LTEXT           "",IDS_FILENAME,36,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Eroare:",IDC_STATIC_2,6,23,26,8,NOT WS_GROUP
    LTEXT           "Fisierul nu poate fi extras deoarece se continua din volumul precedent. Ca sa extragi acest fisier, trebuie sa pornesti cu un volum unde fisierul incepe.",IDC_STATIC_3,36,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "Nu mai afisa acest mesaj alta &data.",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,44,183,12
    DEFPUSHBUTTON   "OK",IDOK,121,63,50,14,WS_GROUP
    PUSHBUTTON      "Anuleaza",IDCANCEL,181,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 200, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configurare UnARJ"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "precedent cand dezarhivezi.",IDC_STATIC_1,23,22,154,8
    CONTROL         "&Automat sari peste fisierele continuate din volumul",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,10,181,12
    LTEXT           "nu poate fi listat.",IDC_STATIC_2,23,44,111,8
    CONTROL         "Nu afisa atentionare can&d tot continutul arhivei",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,170,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,188,1
    DEFPUSHBUTTON   "OK",IDOK,47,66,50,14
    PUSHBUTTON      "Anuleaza",IDCANCEL,102,66,50,14
END

IDD_WARNING DIALOGEX 6, 15, 213, 107
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnARJ - Atentie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Nu toate fisierele din arhiva multi-volum pot fi listate (si vazute in panou), deoarece unele volume ale arhivei nu pot fi gasite.",IDC_STATIC_1,11,10,194,24
    LTEXT           "Ca sa listezi tot continutul arhivei, copie toate volumele in acelasi director.",IDC_STATIC_2,11,41,192,16
    CONTROL         "Nu mai afisa acest mesaj alta &data",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,66,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,83,203,1
    DEFPUSHBUTTON   "OK",IDOK,153,89,50,14
END

