// Korean (ko-KR) resources for unarj. Translation: Sally contributors (AI-assisted).
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/unarj/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\unarj.rh2"

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CHANGEDISK DIALOGEX 6, 15, 194, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "다음 압축 파일 볼륨"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "다음 압축 파일 볼륨이 들어 있는 디스크를 넣거나 디스크에서 해당 파일을 찾으십시오.\n\n준비되면 확인을 누르십시오.",IDC_STATIC_1,12,9,170,32
    LTEXT           "이전 볼륨:",IDC_STATIC_2,12,48,60,8
    EDITTEXT        IDC_PREVVOL,73,48,109,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT           "다음 볼륨(&N):",IDC_STATIC_3,12,62,49,8
    EDITTEXT        IDC_FILENAME,12,72,155,12
    PUSHBUTTON      "...",IDC_BROWSE,170,72,13,12
    DEFPUSHBUTTON   "확인",IDOK,39,91,50,14
    PUSHBUTTON      "취소",IDCANCEL,102,91,50,14
END

IDD_ERROR DIALOGEX 15, 34, 352, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "오류"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    RTEXT           "이름:",IDC_STATIC_1,6,10,26,8
    LTEXT           "",IDS_FILENAME,36,10,309,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "오류:",IDC_STATIC_2,6,23,26,8,NOT WS_GROUP
    LTEXT           "이전 볼륨에서 이어지는 파일이므로 추출할 수 없습니다. 이 파일을 추출하려면 파일이 시작되는 볼륨부터 시작해야 합니다.",IDC_STATIC_3,36,23,309,16,SS_NOPREFIX | NOT WS_GROUP
    CONTROL         "앞으로 이 메시지를 표시하지 않음(&D)",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,36,44,183,12
    DEFPUSHBUTTON   "확인",IDOK,121,63,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,181,63,50,14
END

IDD_CONFIG DIALOGEX 22, 38, 167, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnARJ 설정"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "자동으로 건너뛰기",IDC_STATIC_1,23,22,61,8
    CONTROL         "압축을 풀 때 이전 볼륨에서 이어지는 파일을(&A)",IDC_SKIPCONTINUED,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,10,144,12
    LTEXT           "주의 메시지를 표시하지 않음",IDC_STATIC_2,23,44,61,8
    CONTROL         "압축 파일 전체 내용을 나열할 수 없을 때(&D)",IDC_NOVOLATTENTION,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,32,136,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,6,60,155,1
    DEFPUSHBUTTON   "확인",IDOK,31,66,50,14
    PUSHBUTTON      "취소",IDCANCEL,86,66,50,14
END

IDD_WARNING DIALOGEX 6, 15, 213, 99
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "UnARJ - 주의"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "일부 압축 파일 볼륨을 찾을 수 없어 다중 볼륨 압축 파일의 모든 파일을 나열(및 패널에 표시)할 수 없습니다.",IDC_STATIC_1,11,10,194,16
    LTEXT           "압축 파일 전체 내용을 나열하려면 모든 압축 파일 볼륨을 같은 디렉터리에 복사하십시오.",IDC_STATIC_2,11,33,192,16
    CONTROL         "앞으로 이 메시지를 표시하지 않음(&D)",IDC_DONTSHOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,11,58,157,12
    CONTROL         "",IDC_STATIC_3,"Static",SS_ETCHEDHORZ | WS_GROUP,5,75,203,1
    DEFPUSHBUTTON   "확인",IDOK,153,81,50,14
END

