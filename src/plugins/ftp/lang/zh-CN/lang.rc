IDD_CFGCONFIRMATIONS DIALOGEX 37, 31, 339, 218
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "确认"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "显示消息 ""你正在离开服务器。你想断开连接还是保持连接？""(&S)",IDC_ALWAYSNOTCLOSE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,5,5,262,12
    CONTROL         "显示消息 ""你要断开吗？""(&h)",IDC_ALWAYSDISCONNECT,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,18,117,12
    CONTROL         "显示消息 ""连接已关闭。你要重新连接吗？""(&o)",IDC_ALWAYSRECONNECT,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,31,193,12
    CONTROL         "在快速重命名中显示消息 ""目标名称已经被使用。你要覆盖它吗？""(&w)",IDC_ALWAYSOVERWRITE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,44,280,12
    CONTROL         "显示消息 ""服务器连接丢失""(&m)",IDC_WARNWHENCONLOST,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,57,128,12
    CONTROL         "显示消息 ""你是否总是要列出这个 FTP 服务器上的隐藏文件和目录，...""(&e)",IDC_HINTLISTHIDDENFILES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,70,294,12
END

