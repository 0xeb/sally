IDD_CONNECT DIALOGEX 23, 72, 422, 164
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "连接到 FTP 服务器"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LISTBOX         IDL_BOOKMARKS,7,7,167,129,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    LTEXT           "地址(&A):",IDT_HOSTADDRESS,188,9,33,8
    COMBOBOX        IDE_HOSTADDRESS,238,7,177,130,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    LTEXT           "开始路径(&p):",IDT_INITIALPATH,188,23,49,8
    COMBOBOX        IDE_INITIALPATH,238,21,177,117,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,252,47,163,1
    CONTROL         " 匿名登录(&m)",IDC_ANONYMOUSLOGIN,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,188,42,62,12
    LTEXT           "用户名(&U):",IDT_USERNAME,198,58,41,8
    EDITTEXT        IDE_USERNAME,241,56,174,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "密码(&w):",IDT_PASSWORD,198,72,39,8
    EDITTEXT        IDE_PASSWORD,241,70,58,12,ES_PASSWORD | ES_AUTOHSCROLL | WS_GROUP
    EDITTEXT        IDE_PASSWORD_LOCKED,304,70,58,12,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "解锁(&o)...",IDB_PASSWORD_CHANGE,365,69,50,14
    CONTROL         "保存密码(&S)",IDC_SAVEPASSWORD,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,198,84,58,12
    LTEXT           "它不安全",IDC_SAVEPASSWORD_HINT,258,86,155,8,WS_TABSTOP
    PUSHBUTTON      "高级(&v)...",IDB_ADVACED,188,107,50,14,WS_GROUP
    EDITTEXT        IDE_ADVANCEDINFO,241,108,174,12,ES_AUTOHSCROLL | ES_READONLY | WS_GROUP
    PUSHBUTTON      "新建(&N)...",IDB_NEWBOOKMARK,6,142,50,14,WS_GROUP
    PUSHBUTTON      "重命名(&R)...",IDB_RENAMEBOOKMARK,61,142,57,14
    PUSHBUTTON      "移除(&e)...",IDB_REMOVEBOOKMARK,123,142,50,14
    DEFPUSHBUTTON   "连接",IDOK,200,142,50,14,WS_GROUP
    PUSHBUTTON      "关闭(&C)",IDB_CLOSE,255,142,50,14
    PUSHBUTTON      "取消",IDCANCEL,310,142,50,14
    PUSHBUTTON      "帮助",IDHELP,365,142,50,14
END

