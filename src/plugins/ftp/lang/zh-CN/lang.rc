        MENUITEM "下(&D)\tAlt+下箭头",       CM_MOVECOLUMNDOWN
    END
END

IDM_SRVTYPERULESMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        POPUP "插入(&I)"
        BEGIN
            MENUITEM "标尺的开头(&T)",              CM_STRM_RULESTART
            MENUITEM "标尺的结尾(&E)",                CM_STRM_RULEEND
            MENUITEM "行注释(&L)",               CM_STRM_COMMENT
            MENUITEM SEPARATOR
            POPUP "跳过(&S)"
            BEGIN
                MENUITEM "空格(如果有)",       CM_STRM_SKIPWSIFANY
                MENUITEM "空格(至少一个)", CM_STRM_SKIPWS
                MENUITEM "精确个数的空格", CM_STRM_SKIPNUMOFWS
                MENUITEM "空格和行结束符(至少一个)", CM_STRM_SKIPWSENDEOLS
                MENUITEM "行剩余部分(至少一个字符)", CM_STRM_SKIPRESTOFLINE
                MENUITEM "单词",                        CM_STRM_SKIPWORD
                MENUITEM "精确个数的字符",  CM_STRM_SKIPNUMOFLETTERS
                MENUITEM "向上到搜索字符串结尾的所有字符", CM_STRM_SKIPALLTO
                MENUITEM "向上到最近数字的所有字符", CM_STRM_SKIPALLTONUMBER
            END
            POPUP "分配到列(&A)"
            BEGIN
                MENUITEM "行剩余部分(至少一个字符)", CM_STRM_ASGNRESTOFLINE
                MENUITEM "单词",                        CM_STRM_ASGNWORD
                MENUITEM "数字",                      CM_STRM_ASGNNUM
                MENUITEM "正数",             CM_STRM_ASGNPOSNUM
                MENUITEM "有分隔号的数字",      CM_STRM_ASGNNUMWITHSEP
                MENUITEM "三字母月(英语, 德语)", CM_STRM_ASGN3LETTERMONTH
                MENUITEM "三字母月(用户定义)", CM_STRM_ASGN3LETMONTHGEN
                MENUITEM "下个月(德语)",         CM_STRM_ASGNTEXTMONTH
                MENUITEM "下个月(用户定义)",   CM_STRM_ASGNTEXTMONTHGEN
                MENUITEM "月数",                CM_STRM_ASGNMONTH
                MENUITEM "天数",                  CM_STRM_ASGNDAY
                MENUITEM "年数",                 CM_STRM_ASGNYEAR
                MENUITEM "时间",                        CM_STRM_ASGNTIME
                MENUITEM "年或时间",                CM_STRM_ASGNYEARORTIME
                MENUITEM "精确个数的字符",  CM_STRM_ASGNNUMOFLETTERS
                MENUITEM "向上到搜索字符串结尾的所有字符", CM_STRM_ASGNALLTO
                MENUITEM "向上到最近数字的所有字符", CM_STRM_ASGNALLUPTO
                MENUITEM "Unix 链接(分隔链接名和目标)", CM_STRM_ASGNUNIXLINK
                MENUITEM "Unix 设备",                 CM_STRM_ASGNUNIXDEV
                MENUITEM "表达式",                  CM_STRM_ASGNEXPR
            END
            POPUP "删除列中的空白(&C)"
            BEGIN
                MENUITEM "开头",                     CM_STRM_CUTWSINIT
                MENUITEM "结尾",                    CM_STRM_CUTWSTRAIL
                MENUITEM "开头和结尾",        CM_STRM_CUTWSBOTH
            END
            POPUP "状态变量和表达式运算符(&V)"
            BEGIN
                MENUITEM "是第一个非空行", CM_STRM_STVARISFIRSTNELINE
                MENUITEM "是最后一个非空行",  CM_STRM_STVARISLASTNELINE
                MENUITEM "下个字符",              CM_STRM_STVARNEXTCHAR
                MENUITEM "下个单词",                   CM_STRM_STVARNEXTWORD
                MENUITEM "行剩余部分",                CM_STRM_STVARRESTOFLINE
                MENUITEM SEPARATOR
                MENUITEM "等于",                       CM_STRM_OPEREQUAL
                MENUITEM "不等于",                   CM_STRM_OPERNOTEQUAL
                MENUITEM "字符串相等(不区分大小写)", CM_STRM_OPERSTREQUAL
                MENUITEM "字符串不相等(不区分大小写)", CM_STRM_OPERSTRNOTEQUAL
                MENUITEM "子字符串在字符串中",      CM_STRM_OPERISINSTR
                MENUITEM "子字符串不在字符串中",  CM_STRM_OPERISNOTINSTR
                MENUITEM "字符串以字符串结尾",     CM_STRM_OPERENDWITH
                MENUITEM "字符串不以字符串结尾", CM_STRM_OPERNOTENDWITH
            END
            POPUP "其它(&O)"
            BEGIN
                MENUITEM "继续仅当",            CM_STRM_IF
                MENUITEM "添加字符串到列",        CM_STRM_ADDSTRTOCOL
                MENUITEM "回退一个字符", CM_STRM_BACK
                MENUITEM "剪切列中字符串结尾", CM_STRM_CUTENDOFSTR
            END
        END
        MENUITEM SEPARATOR
        MENUITEM "撤销(&U)",                       CM_STRM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "剪切(&T)",                        CM_STRM_CUT
        MENUITEM "复制(&C)",                       CM_STRM_COPY
        MENUITEM "粘贴(&P)",                      CM_STRM_PASTE
        MENUITEM "删除(&D)",                     CM_STRM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "选择全部(&A)",                 CM_STRM_SELECTALL
    END
END

