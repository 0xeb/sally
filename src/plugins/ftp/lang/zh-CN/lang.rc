IDD_LOGINERRORDLG DIALOGEX 10, 24, 264, 165
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "连接到服务器错误"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "用户名(&U):",IDC_STATIC_1,7,55,40,8
    EDITTEXT        IDE_USERNAME,48,53,210,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "密码(&P):",IDC_STATIC_2,7,70,36,8
    EDITTEXT        IDE_PASSWORD,48,68,210,12,ES_PASSWORD | ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "帐户(&A):",IDC_STATIC_3,7,85,34,8
    EDITTEXT        IDE_ACCOUNT,48,83,210,12,ES_PASSWORD | ES_AUTOHSCROLL | WS_GROUP
