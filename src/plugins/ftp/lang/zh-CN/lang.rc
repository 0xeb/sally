/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SRVCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "连接(&C)\tEnter",             IDOK
        MENUITEM SEPARATOR
        MENUITEM "新建(&N)...\tInsert",             IDB_NEWBOOKMARK
        MENUITEM "复制到(&o)...",                 CM_COPYSRVTO
        MENUITEM "重命名(&R)...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "移除(&E)...\tDelete",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "上移(&U)\tAlt+Up Arrow",      CM_MOVEUPBOOKMARK
        MENUITEM "下移(&D)\tAlt+Down Arrow",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_SRVCONTEXTMENU2 MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "新建(&N)...\tInsert",             IDB_NEWBOOKMARK
        MENUITEM "复制到(&o)...",                 CM_COPYSRVTO
        MENUITEM "重命名(&R)...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "移除(&E)...\tDelete",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "上移(&U)\tAlt+Up Arrow",      CM_MOVEUPBOOKMARK
        MENUITEM "下移(&D)\tAlt+Down Arrow",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_ACTPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "断开(&D)...",              CM_DISCONNECTSRV
        MENUITEM "显示证书(&w)...",        CM_SHOWCERT
        POPUP "传输模式(&T)"
        BEGIN
            MENUITEM "自动(&A)",                  CM_TRMODEAUTO
            MENUITEM "A&SCII",                      CM_TRMODEASCII
            MENUITEM "二进制(&B)",                     CM_TRMODEBINARY
        END
        MENUITEM "刷新(&R)",                    CM_REFRESHPATH
        MENUITEM SEPARATOR
        MENUITEM "添加书签(&A)...",            CM_ADDBOOKMARK
        MENUITEM "显示日志(&L)...",                CM_SHOWLOG
        MENUITEM "发送 FTP 命令(&S)...",        CM_SENDFTPCOMMAND
        MENUITEM "显示原始列表(&H)...",        CM_SHOWRAWLISTING
        MENUITEM "列出隐藏文件和目录(&i)(Unix)", CM_LISTHIDDENFILES
    END
END

IDM_CHNGDRVCONTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "连接到 FTP 服务器(&C)...",   CM_CONNECTSRV
        MENUITEM "管理书签(&O)...",      CM_ORGBOOKMARKS
        MENUITEM "显示日志(&L)...",               CM_SHOWLOGS
    END
END

IDM_DETPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "在面板中显示(&S)",              CM_OPENDETACHED
        MENUITEM SEPARATOR
        MENUITEM "断开(&D)",                 CM_DISCONNECTSRV
        MENUITEM SEPARATOR
        MENUITEM "添加书签(&A)...",            CM_ADDBOOKMARK
        MENUITEM "显示日志(&L)...",                CM_SHOWLOG
    END
END

IDM_LOGSMENU MENU 
BEGIN
    POPUP "日志(&L)"
    BEGIN
        MENUITEM "复制(&O)",                       CM_COPYLOG
        MENUITEM "复制全部(&P)",                   CM_COPYALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "另存为(&S)...",                 CM_SAVELOG
        MENUITEM "全部另存为(&A)...",             CM_SAVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "清除(&E)...",                   CM_CLEARLOG
        MENUITEM "移除(&R)...",                  CM_REMOVELOG
        MENUITEM "移除全部(&M)...",              CM_REMOVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "关闭(&C)\tAlt+F4",              IDCANCEL
    END
    POPUP "选项(&O)"
    BEGIN
        MENUITEM "总是为活动面板显示日志(&A)", CM_SHOWLOGFORPANEL
    END
    POPUP "&帮助"
    BEGIN
        MENUITEM "FTP 日志(&F)\tF1",               CM_HELPFORLOGSWND
    END
END

