        MENUITEM "复制到(&C)...",                 CM_COPYSERVERTO
        MENUITEM "重命名(&R)...\tF2",              CM_RENAMESERVER
        MENUITEM "移除(&M)...\tDelete",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "上移(&U)\tAlt+上箭头",      IDB_MOVESERVERUP
        MENUITEM "下移(&D)\tAlt+下箭头",  IDB_MOVESERVERDOWN
        MENUITEM SEPARATOR
        MENUITEM "从文件导入(&I)...",        CM_IMPORTSERVER
        MENUITEM "导出到文件(&X)...",          CM_EXPORTSERVER
