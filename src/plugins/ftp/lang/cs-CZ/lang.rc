                MENUITEM "Roku nebo času",                CM_STRM_ASGNYEARORTIME
                MENUITEM "Přesnému počtu znaků",  CM_STRM_ASGNNUMOFLETTERS
                MENUITEM "Všem znakům až do konce z hledaného řetězce", CM_STRM_ASGNALLTO
                MENUITEM "Všem znakům až k hledanému řetězci", CM_STRM_ASGNALLUPTO
