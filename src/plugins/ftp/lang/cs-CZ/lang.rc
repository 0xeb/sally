                MENUITEM "Unix zařízení",                 CM_STRM_ASGNUNIXDEV
                MENUITEM "Výrazu",                  CM_STRM_ASGNEXPR
            END
            POPUP "Oříznout &mezery ve sloupci"
            BEGIN
                MENUITEM "Počáteční",                     CM_STRM_CUTWSINIT
                MENUITEM "Koncové",                    CM_STRM_CUTWSTRAIL
                MENUITEM "Počáteční a koncové",        CM_STRM_CUTWSBOTH
            END
            POPUP "S&tavové proměnné a operátory výrazů"
            BEGIN
                MENUITEM "Je první neprázdný řádek", CM_STRM_STVARISFIRSTNELINE
                MENUITEM "Je poslední neprázdný řádek",  CM_STRM_STVARISLASTNELINE
