/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SRVCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Připojit\tEnter",             IDOK
        MENUITEM SEPARATOR
        MENUITEM "&Nový...\tInsert",             IDB_NEWBOOKMARK
        MENUITEM "&Kopírovat do...",                 CM_COPYSRVTO
        MENUITEM "Přej&menovat...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "&Odstranit...\tDelete",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "N&ahoru\tAlt+Up Arrow",      CM_MOVEUPBOOKMARK
        MENUITEM "&Dolů\tAlt+Down Arrow",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_SRVCONTEXTMENU2 MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Nový...\tInsert",             IDB_NEWBOOKMARK
        MENUITEM "&Kopírovat do...",                 CM_COPYSRVTO
        MENUITEM "Přej&menovat...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "&Odstranit...\tDelete",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "N&ahoru\tAlt+Up Arrow",      CM_MOVEUPBOOKMARK
        MENUITEM "&Dolů\tAlt+Down Arrow",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_ACTPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Odpojit...",              CM_DISCONNECTSRV
        MENUITEM "Zobrazit &certifikát...",        CM_SHOWCERT
        POPUP "&Režim přenosu"
        BEGIN
            MENUITEM "&Automatický",                  CM_TRMODEAUTO
            MENUITEM "A&SCII",                      CM_TRMODEASCII
            MENUITEM "&Binární",                     CM_TRMODEBINARY
        END
        MENUITEM "Obno&vit",                    CM_REFRESHPATH
        MENUITEM SEPARATOR
        MENUITEM "&Přidat záložku...",            CM_ADDBOOKMARK
        MENUITEM "Zobrazit &log...",                CM_SHOWLOG
        MENUITEM "Poslat &FTP příkaz...",        CM_SENDFTPCOMMAND
        MENUITEM "&Zobrazit RAW výpis...",        CM_SHOWRAWLISTING
        MENUITEM "Procház&et skryté soubory a adresáře (Unix)", CM_LISTHIDDENFILES
    END
END

IDM_CHNGDRVCONTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Připojit na FTP server...",   CM_CONNECTSRV
        MENUITEM "&Upravit záložky...",      CM_ORGBOOKMARKS
        MENUITEM "Zobrazit &log...",               CM_SHOWLOGS
    END
END

IDM_DETPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Zobrazit v panelu",              CM_OPENDETACHED
        MENUITEM SEPARATOR
        MENUITEM "&Odpojit",                 CM_DISCONNECTSRV
        MENUITEM SEPARATOR
        MENUITEM "&Přidat záložku...",            CM_ADDBOOKMARK
        MENUITEM "Zobrazit &log...",                CM_SHOWLOG
    END
END

IDM_LOGSMENU MENU 
BEGIN
    POPUP "&Protokol"
    BEGIN
        MENUITEM "&Kopírovat",                       CM_COPYLOG
        MENUITEM "Kopírovat &vše",                   CM_COPYALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Uložit jako...",                 CM_SAVELOG
        MENUITEM "U&ložit vše jako...",             CM_SAVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "Vyč&istit...",                   CM_CLEARLOG
        MENUITEM "&Odstranit...",                  CM_REMOVELOG
        MENUITEM "O&dstranit vše...",              CM_REMOVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Zavřít\tAlt+F4",              IDCANCEL
    END
    POPUP "&Možnosti"
    BEGIN
        MENUITEM "&Vždy zobrazit log pro aktivní panel", CM_SHOWLOGFORPANEL
    END
    POPUP "&Nápověda"
    BEGIN
        MENUITEM "&FTP logy\tF1",               CM_HELPFORLOGSWND
    END
END

IDM_SERVERSOTHERACT MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Kopírovat do...",                 CM_COPYSERVERTO
        MENUITEM "Přej&menovat...\tF2",              CM_RENAMESERVER
        MENUITEM "&Odstranit...\tDelete",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "&Importovat ze souboru...",        CM_IMPORTSERVER
        MENUITEM "E&xportovat do souboru...",          CM_EXPORTSERVER
    END
END

IDM_SERVERSACTIONS MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Nový...\tInsert",             IDB_NEWSERVER
        MENUITEM "&Upravit...",                    IDB_EDITSERVER
        MENUITEM "&Kopírovat do...",                 CM_COPYSERVERTO
        MENUITEM "Přej&menovat...\tF2",              CM_RENAMESERVER
        MENUITEM "&Odstranit...\tDelete",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "N&ahoru\tAlt+Up Arrow",      IDB_MOVESERVERUP
        MENUITEM "&Dolů\tAlt+Down Arrow",  IDB_MOVESERVERDOWN
        MENUITEM SEPARATOR
        MENUITEM "&Importovat ze souboru...",        CM_IMPORTSERVER
        MENUITEM "E&xportovat do souboru...",          CM_EXPORTSERVER
    END
END

IDM_SRVTYPEMOVECOLUMN MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Nahoru\tAlt+Up Arrow",           CM_MOVECOLUMNUP
        MENUITEM "&Dolů\tAlt+Down Arrow",       CM_MOVECOLUMNDOWN
    END
END

IDM_SRVTYPERULESMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        POPUP "&Vložit"
        BEGIN
            MENUITEM "&Začátek pravidla",              CM_STRM_RULESTART
            MENUITEM "&Konec pravidla",                CM_STRM_RULEEND
            MENUITEM "Řá&dek komentáře",               CM_STRM_COMMENT
            MENUITEM SEPARATOR
            POPUP "&Přeskočit"
            BEGIN
                MENUITEM "Mezery (Pokud jsou)",       CM_STRM_SKIPWSIFANY
                MENUITEM "Mezery (Nejméně jednu)", CM_STRM_SKIPWS
                MENUITEM "Přesný počet mezer", CM_STRM_SKIPNUMOFWS
                MENUITEM "Mezery a konec řádku (Nejméně jednu)", CM_STRM_SKIPWSENDEOLS
