                MENUITEM "Další slovo",                   CM_STRM_STVARNEXTWORD
                MENUITEM "Zbytek řádku",                CM_STRM_STVARRESTOFLINE
                MENUITEM SEPARATOR
                MENUITEM "Stejný",                       CM_STRM_OPEREQUAL
                MENUITEM "Nestejný",                   CM_STRM_OPERNOTEQUAL
                MENUITEM "Stejný řetězec (Nevnímá velikost písmen)", CM_STRM_OPERSTREQUAL
                MENUITEM "Nestejný řetězec (Nevnímá velikost písmen)", CM_STRM_OPERSTRNOTEQUAL
                MENUITEM "V řetězci je podřetězec",      CM_STRM_OPERISINSTR
                MENUITEM "V řetězci není podřetězec",  CM_STRM_OPERISNOTINSTR
                MENUITEM "Řetězec končí řetězcem",     CM_STRM_OPERENDWITH
                MENUITEM "Řetězec nekončí řetězcem", CM_STRM_OPERNOTENDWITH
            END
            POPUP "&Ostatní"
            BEGIN
                MENUITEM "Pokračovat jen pokud",            CM_STRM_IF
                MENUITEM "Přidat řetězec do sloupce",        CM_STRM_ADDSTRTOCOL
                MENUITEM "Jít zpět o počet znaků", CM_STRM_BACK
                MENUITEM "Vyjmout konec řetězce ze sloupce", CM_STRM_CUTENDOFSTR
            END
        END
        MENUITEM SEPARATOR
        MENUITEM "&Zpět",                       CM_STRM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Vyj&mout",                        CM_STRM_CUT
        MENUITEM "&Kopírovat",                       CM_STRM_COPY
        MENUITEM "V&ložit",                      CM_STRM_PASTE
        MENUITEM "&Odstranit",                     CM_STRM_DELETE
        MENUITEM SEPARATOR
