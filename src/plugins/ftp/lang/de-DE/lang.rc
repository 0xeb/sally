    POPUP ""
    BEGIN
        MENUITEM "Nach &oben\tAlt+Pfeil hoch",           CM_MOVECOLUMNUP
        MENUITEM "Nach &unten\tAlt+Pfeil runter",       CM_MOVECOLUMNDOWN
    END
END

IDM_SRVTYPERULESMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        POPUP "&Einfügen"
        BEGIN
            MENUITEM "&Beginn der Regel",              CM_STRM_RULESTART
            MENUITEM "&Ende der Regel",                CM_STRM_RULEEND
            MENUITEM "Zei&lenkommentar",               CM_STRM_COMMENT
            MENUITEM SEPARATOR
            POPUP "&Überspringen"
            BEGIN
                MENUITEM "Whitespaces (falls vorhanden)",       CM_STRM_SKIPWSIFANY
                MENUITEM "Whitespaces (mindestens eins)", CM_STRM_SKIPWS
                MENUITEM "Genaue Anzahl von Whitespaces", CM_STRM_SKIPNUMOFWS
                MENUITEM "Whitespaces und Zeilenende (mindestens eins)", CM_STRM_SKIPWSENDEOLS
                MENUITEM "Rest der Zeile (mindestens ein Zeichen)", CM_STRM_SKIPRESTOFLINE
                MENUITEM "Wort",                        CM_STRM_SKIPWORD
                MENUITEM "Genaue Anzahl von Zeichen",  CM_STRM_SKIPNUMOFLETTERS
                MENUITEM "Alle Zeichen bis zum Ende des Suchstrings", CM_STRM_SKIPALLTO
                MENUITEM "Alle Zeichen bis zur nächsten Zahl", CM_STRM_SKIPALLTONUMBER
            END
            POPUP "&Spalte zuweisen"
            BEGIN
                MENUITEM "Rest der Zeile (mindestens ein Zeichen)", CM_STRM_ASGNRESTOFLINE
                MENUITEM "Wort",                        CM_STRM_ASGNWORD
                MENUITEM "Zahl",                      CM_STRM_ASGNNUM
                MENUITEM "Positive Zahl",             CM_STRM_ASGNPOSNUM
                MENUITEM "Zahl mit Trennern",      CM_STRM_ASGNNUMWITHSEP
                MENUITEM "Monat in drei Buchstaben (English, Deutsch)", CM_STRM_ASGN3LETTERMONTH
                MENUITEM "Monat in drei Buchstaben (Benutzerdefiniert)", CM_STRM_ASGN3LETMONTHGEN
                MENUITEM "Monatsbezeichnung (Deutsch)",         CM_STRM_ASGNTEXTMONTH
                MENUITEM "Monatsbezeichnung (Benutzerdefiniert)",   CM_STRM_ASGNTEXTMONTHGEN
                MENUITEM "Monat als Zahl",                CM_STRM_ASGNMONTH
                MENUITEM "Tag als Zahl",                  CM_STRM_ASGNDAY
                MENUITEM "Jahr als Zahl",                 CM_STRM_ASGNYEAR
                MENUITEM "Zeit",                        CM_STRM_ASGNTIME
                MENUITEM "Jahr oder Zeit",                CM_STRM_ASGNYEARORTIME
                MENUITEM "Genaue Anzahl von Zeichen",  CM_STRM_ASGNNUMOFLETTERS
                MENUITEM "Alle Zeichen bis zum Ende des Suchstrings", CM_STRM_ASGNALLTO
                MENUITEM "Alle Zeichen bis zum Suchstring", CM_STRM_ASGNALLUPTO
                MENUITEM "Unix Link (Linkname und Ziel aufteilen)", CM_STRM_ASGNUNIXLINK
                MENUITEM "Unix Gerät",                 CM_STRM_ASGNUNIXDEV
                MENUITEM "Ausdruck",                  CM_STRM_ASGNEXPR
            END
            POPUP "&Leerraum in Spalte entfernen"
            BEGIN
                MENUITEM "am Anfang",                     CM_STRM_CUTWSINIT
                MENUITEM "am Ende",                    CM_STRM_CUTWSTRAIL
                MENUITEM "am Anfang und am Ende",        CM_STRM_CUTWSBOTH
            END
            POPUP "Status&variablen und Operatoren für Ausdrücke"
            BEGIN
                MENUITEM "Ist die erste nicht leere Zeile", CM_STRM_STVARISFIRSTNELINE
                MENUITEM "Ist die letzte nicht leere Zeile",  CM_STRM_STVARISLASTNELINE
                MENUITEM "Nächstes Zeichen",              CM_STRM_STVARNEXTCHAR
                MENUITEM "Nächstes Wort",                   CM_STRM_STVARNEXTWORD
                MENUITEM "Rest der Zeile",                CM_STRM_STVARRESTOFLINE
                MENUITEM SEPARATOR
                MENUITEM "Gleich",                       CM_STRM_OPEREQUAL
                MENUITEM "Ungleich",                   CM_STRM_OPERNOTEQUAL
                MENUITEM "Zeichenkette gleich (Groß/Kleinschreibung ignorieren)", CM_STRM_OPERSTREQUAL
                MENUITEM "Zeichenkette ungleich (Groß/Kleinschreibung ignorieren)", CM_STRM_OPERSTRNOTEQUAL
                MENUITEM "Teilstring kommt in Zeichenkette vor",      CM_STRM_OPERISINSTR
                MENUITEM "Teilstring kommt nicht in Zeichenkette vor",  CM_STRM_OPERISNOTINSTR
                MENUITEM "Zeichenkette endet mit Zeichenkette",     CM_STRM_OPERENDWITH
                MENUITEM "Zeichenkette endet nicht mit Zeichenkette", CM_STRM_OPERNOTENDWITH
            END
            POPUP "S&onstige"
            BEGIN
                MENUITEM "Nur weitermachen wenn",            CM_STRM_IF
                MENUITEM "Zeichenkette zur Spalte hinzufügen",        CM_STRM_ADDSTRTOCOL
                MENUITEM "Gehe eine Anzahl von Zeichen zurück", CM_STRM_BACK
                MENUITEM "Ende der Zeichenkette in der Spalte ausschneiden", CM_STRM_CUTENDOFSTR
            END
        END
        MENUITEM SEPARATOR
        MENUITEM "Rück&gängig",                       CM_STRM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Ausschnei&den",                        CM_STRM_CUT
        MENUITEM "&Kopieren",                       CM_STRM_COPY
        MENUITEM "&Einfügen",                      CM_STRM_PASTE
        MENUITEM "&Löschen",                     CM_STRM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Alles auswählen",                 CM_STRM_SELECTALL
    END
END

