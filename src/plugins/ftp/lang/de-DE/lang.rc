                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,5,5,288,12
    CONTROL         "Verbindun&gen im Dateifenster haben Priorität (schnellere Anzeige)",IDC_PRIORITYTOPANELCON,
                    "Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,434,130,235,12
