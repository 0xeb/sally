/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SRVCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Verbinden\tEnter",             IDOK
        MENUITEM SEPARATOR
        MENUITEM "&Neu...\tEinfg",             IDB_NEWBOOKMARK
        MENUITEM "K&opieren nach...",                 CM_COPYSRVTO
        MENUITEM "Um&benennen...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "&Entfernen...\tEntf",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "Nac&h oben\tAlt+Pfeil hoch",      CM_MOVEUPBOOKMARK
        MENUITEM "Nach &unten\tAlt+Pfeil runter",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_SRVCONTEXTMENU2 MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Neu...\tEinfg",             IDB_NEWBOOKMARK
        MENUITEM "K&opieren nach...",                 CM_COPYSRVTO
        MENUITEM "Um&benennen...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "&Entfernen...\tEntf",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "Nac&h oben\tAlt+Pfeil hoch",      CM_MOVEUPBOOKMARK
        MENUITEM "Nach &unten\tAlt+Pfeil runter",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_ACTPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Trennen...",              CM_DISCONNECTSRV
        MENUITEM "Zertifi&kat zeigen...",        CM_SHOWCERT
        POPUP "&Übertragungsmodus"
        BEGIN
            MENUITEM "&Automatisch",                  CM_TRMODEAUTO
            MENUITEM "A&SCII",                      CM_TRMODEASCII
            MENUITEM "&Binär",                     CM_TRMODEBINARY
        END
        MENUITEM "Aktualisie&ren",                    CM_REFRESHPATH
        MENUITEM SEPARATOR
        MENUITEM "F&avoriten hinzufügen...",            CM_ADDBOOKMARK
        MENUITEM "&Logdateien zeigen...",                CM_SHOWLOG
        MENUITEM "FTP-Befehl &senden...",        CM_SENDFTPCOMMAND
        MENUITEM "Rohdatenliste &zeigen...",        CM_SHOWRAWLISTING
        MENUITEM "Versteckte Date&ien und Verzeichnisse zeigen (Unix)", CM_LISTHIDDENFILES
    END
END

IDM_CHNGDRVCONTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Mit FTP-Server &verbinden...",   CM_CONNECTSRV
        MENUITEM "&Favoriten verwalten...",      CM_ORGBOOKMARKS
        MENUITEM "&Logdateien zeigen...",               CM_SHOWLOGS
    END
END

IDM_DETPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Im Fen&ster zeigen",              CM_OPENDETACHED
        MENUITEM SEPARATOR
        MENUITEM "&Trennen",                 CM_DISCONNECTSRV
        MENUITEM SEPARATOR
        MENUITEM "F&avoriten hinzufügen...",            CM_ADDBOOKMARK
        MENUITEM "&Logdateien zeigen...",                CM_SHOWLOG
    END
END

IDM_LOGSMENU MENU 
BEGIN
    POPUP "&Protokoll"
    BEGIN
        MENUITEM "K&opieren",                       CM_COPYLOG
        MENUITEM "Alle ko&pieren",                   CM_COPYALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Speichern unter...",                 CM_SAVELOG
        MENUITEM "&Alle speichern unter...",             CM_SAVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "Lösch&en...",                   CM_CLEARLOG
        MENUITEM "Entfe&rnen...",                  CM_REMOVELOG
        MENUITEM "Alle ent&fernen...",              CM_REMOVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "S&chließen\tAlt+F4",              IDCANCEL
    END
    POPUP "&Optionen"
    BEGIN
        MENUITEM "Logdatei für &aktives Fenster immer anzeigen", CM_SHOWLOGFORPANEL
    END
    POPUP "&Hilfe"
    BEGIN
        MENUITEM "&FTP Logs\tF1",               CM_HELPFORLOGSWND
    END
END

IDM_SERVERSOTHERACT MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Kopieren nach...",                 CM_COPYSERVERTO
        MENUITEM "Um&benennen...\tF2",              CM_RENAMESERVER
        MENUITEM "Ent&fernen...\tEntf",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "Aus Datei &importieren...",        CM_IMPORTSERVER
        MENUITEM "In Datei e&xportieren...",          CM_EXPORTSERVER
    END
END

IDM_SERVERSACTIONS MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Neu...\tEinfg",             IDB_NEWSERVER
        MENUITEM "B&earbeiten...",                    IDB_EDITSERVER
        MENUITEM "&Kopieren nach...",                 CM_COPYSERVERTO
        MENUITEM "Um&benennen...\tF2",              CM_RENAMESERVER
        MENUITEM "Ent&fernen...\tEntf",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "Nach &oben\tAlt+Pfeil hoch",      IDB_MOVESERVERUP
        MENUITEM "Nach &unten\tAlt+Pfeil runter",  IDB_MOVESERVERDOWN
        MENUITEM SEPARATOR
        MENUITEM "Aus Datei &importieren...",        CM_IMPORTSERVER
        MENUITEM "In Datei e&xportieren...",          CM_EXPORTSERVER
    END
END

IDM_SRVTYPEMOVECOLUMN MENU 
