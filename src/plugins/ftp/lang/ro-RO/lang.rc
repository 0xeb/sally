/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SRVCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Conecteaza\tEnter",             IDOK
        MENUITEM SEPARATOR
        MENUITEM "&Nou...\tInsereaza",             IDB_NEWBOOKMARK
        MENUITEM "C&opie in...",                 CM_COPYSRVTO
        MENUITEM "&Redenumeste...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "E&limina...\tSterge",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "Muta &Sus\tAlt+Up Arrow",      CM_MOVEUPBOOKMARK
        MENUITEM "Muta &Jos\tAlt+Down Arrow",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_SRVCONTEXTMENU2 MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Nou...\tInsereaza",             IDB_NEWBOOKMARK
        MENUITEM "C&opie in...",                 CM_COPYSRVTO
        MENUITEM "&Redenumeste...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "E&limina...\tSterge",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "Muta &Sus\tAlt+Up Arrow",      CM_MOVEUPBOOKMARK
        MENUITEM "Muta &Jos\tAlt+Down Arrow",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_ACTPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Deconecteaza...",              CM_DISCONNECTSRV
        MENUITEM "Arata &Certificatul...",        CM_SHOWCERT
        POPUP "&Modul de Transfer"
        BEGIN
            MENUITEM "&Automat",                  CM_TRMODEAUTO
            MENUITEM "A&SCII",                      CM_TRMODEASCII
            MENUITEM "&Binar",                     CM_TRMODEBINARY
        END
        MENUITEM "&Reimprospatare",                    CM_REFRESHPATH
        MENUITEM SEPARATOR
        MENUITEM "Ada&uga Bookmark...",            CM_ADDBOOKMARK
        MENUITEM "Arata &Log-ul...",                CM_SHOWLOG
        MENUITEM "&Trimite Comanda FTP...",        CM_SENDFTPCOMMAND
        MENUITEM "Arata Li&stare Raw...",        CM_SHOWRAWLISTING
        MENUITEM "L&isteaza Fisierele si Directoarele Ascunse (Unix)", CM_LISTHIDDENFILES
    END
END

IDM_CHNGDRVCONTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Conectare la Server-ul FTP...",   CM_CONNECTSRV
        MENUITEM "&Organizeaza Bookmarks...",      CM_ORGBOOKMARKS
        MENUITEM "Arata &Log-urile...",               CM_SHOWLOGS
    END
END

IDM_DETPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "A&rata in Panou",              CM_OPENDETACHED
        MENUITEM SEPARATOR
        MENUITEM "&Deconecteaza",                 CM_DISCONNECTSRV
        MENUITEM SEPARATOR
        MENUITEM "Ada&uga Bookmark...",            CM_ADDBOOKMARK
        MENUITEM "Arata &Log-ul...",                CM_SHOWLOG
    END
END

IDM_LOGSMENU MENU 
BEGIN
    POPUP "&Jurnal"
    BEGIN
        MENUITEM "C&opie",                       CM_COPYLOG
        MENUITEM "Co&pie Tot",                   CM_COPYALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Salveaza Ca...",                 CM_SAVELOG
        MENUITEM "S&alveaza Tot Ca...",             CM_SAVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Reseteaza...",                   CM_CLEARLOG
        MENUITEM "E&limina...",                  CM_REMOVELOG
        MENUITEM "El&imina Tot...",              CM_REMOVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "I&nchide\tAlt+F4",              IDCANCEL
    END
    POPUP "&Optiuni"
    BEGIN
        MENUITEM "&Intotdeauna arata log-ul pentru panoul activ", CM_SHOWLOGFORPANEL
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Log-uri &FTP\tF1",               CM_HELPFORLOGSWND
    END
END

IDM_SERVERSOTHERACT MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Copie in...",                 CM_COPYSERVERTO
        MENUITEM "&Redenumeste...\tF2",              CM_RENAMESERVER
        MENUITEM "&Elimina...\tSterge",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "I&mporta din Fisierul...",        CM_IMPORTSERVER
        MENUITEM "E&xporta in Fisierul...",          CM_EXPORTSERVER
    END
END

IDM_SERVERSACTIONS MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Nou...\tInsereaza",             IDB_NEWSERVER
        MENUITEM "&Editeaza...",                    IDB_EDITSERVER
        MENUITEM "&Copie in...",                 CM_COPYSERVERTO
        MENUITEM "&Redenumeste...\tF2",              CM_RENAMESERVER
        MENUITEM "E&limina...\tSterge",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "Muta &Sus\tAlt+Up Arrow",      IDB_MOVESERVERUP
        MENUITEM "Muta &Jos\tAlt+Down Arrow",  IDB_MOVESERVERDOWN
        MENUITEM SEPARATOR
        MENUITEM "I&mporta din Fisierul...",        CM_IMPORTSERVER
        MENUITEM "E&xporta in Fisierul...",          CM_EXPORTSERVER
    END
END

IDM_SRVTYPEMOVECOLUMN MENU 
