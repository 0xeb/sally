    POPUP ""
    BEGIN
        MENUITEM "&Sus\tAlt+Up Arrow",           CM_MOVECOLUMNUP
        MENUITEM "&Jos\tAlt+Down Arrow",       CM_MOVECOLUMNDOWN
    END
END

IDM_SRVTYPERULESMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        POPUP "&Insereaza"
        BEGIN
            MENUITEM "I&nceperea Regulei",              CM_STRM_RULESTART
            MENUITEM "S&farsitul Regulei",                CM_STRM_RULEEND
            MENUITEM "Comentariu de &Linie",               CM_STRM_COMMENT
            MENUITEM SEPARATOR
            POPUP "&Sari peste"
            BEGIN
                MENUITEM "Spatii Libere (Daca sunt)",       CM_STRM_SKIPWSIFANY
                MENUITEM "Spatii Libere (Cel Putin Unul)", CM_STRM_SKIPWS
                MENUITEM "Numarul Exact de Spatii Libere", CM_STRM_SKIPNUMOFWS
                MENUITEM "Spatii Libere Si Linia se Termina (Cel Putin Unul)", CM_STRM_SKIPWSENDEOLS
                MENUITEM "Restul Liniei (Cel Putin Un Caracter)", CM_STRM_SKIPRESTOFLINE
                MENUITEM "Cuvant",                        CM_STRM_SKIPWORD
                MENUITEM "Numarul Exact de Caractere",  CM_STRM_SKIPNUMOFLETTERS
                MENUITEM "Toate Caracterele Pana la Sfarsitul Sirului Cautat", CM_STRM_SKIPALLTO
                MENUITEM "Toate Caracterele Pana la Cel Mai Apropiat Numar", CM_STRM_SKIPALLTONUMBER
            END
            POPUP "&Atribuie coloanei"
            BEGIN
                MENUITEM "Restul Randului (Cel Putin Un Caracter)", CM_STRM_ASGNRESTOFLINE
                MENUITEM "Cuvant",                        CM_STRM_ASGNWORD
                MENUITEM "Numar",                      CM_STRM_ASGNNUM
                MENUITEM "Numar Pozitiv",             CM_STRM_ASGNPOSNUM
                MENUITEM "Numar cu Separatori",      CM_STRM_ASGNNUMWITHSEP
                MENUITEM "Luna formata din Trei Litere (Engleza, Germana)", CM_STRM_ASGN3LETTERMONTH
                MENUITEM "Luna formata din Trei Litere (Definita de Utilizator)", CM_STRM_ASGN3LETMONTHGEN
                MENUITEM "Luna Text (Germana)",         CM_STRM_ASGNTEXTMONTH
                MENUITEM "Luna Text (Definita de Utilizator)",   CM_STRM_ASGNTEXTMONTHGEN
                MENUITEM "Numar Luna",                CM_STRM_ASGNMONTH
                MENUITEM "Numar Ziua",                  CM_STRM_ASGNDAY
                MENUITEM "Numar An",                 CM_STRM_ASGNYEAR
                MENUITEM "Ora",                        CM_STRM_ASGNTIME
                MENUITEM "An sau Ora",                CM_STRM_ASGNYEARORTIME
                MENUITEM "Numar Exact de Caractere",  CM_STRM_ASGNNUMOFLETTERS
                MENUITEM "Toate Caracterele Pana la Sfarsitul Sirului Cautat", CM_STRM_ASGNALLTO
                MENUITEM "Toate Caracterele Pana la Sirul Cautat", CM_STRM_ASGNALLUPTO
                MENUITEM "Legatura Unix (Imparte Legatura Nume si Tinta)", CM_STRM_ASGNUNIXLINK
                MENUITEM "Dispozitiv Unix",                 CM_STRM_ASGNUNIXDEV
                MENUITEM "Expresie",                  CM_STRM_ASGNEXPR
            END
            POPUP "&Elimina spatiile din coloana"
            BEGIN
                MENUITEM "Initial",                     CM_STRM_CUTWSINIT
                MENUITEM "Trailing",                    CM_STRM_CUTWSTRAIL
                MENUITEM "Initial si Trailing",        CM_STRM_CUTWSBOTH
            END
            POPUP "&Variabile de stare si operatori pentru expresii"
            BEGIN
                MENUITEM "Este Prima Linie Plina", CM_STRM_STVARISFIRSTNELINE
                MENUITEM "Este Ultima Linie Plina",  CM_STRM_STVARISLASTNELINE
                MENUITEM "Urmatorul Caracter",              CM_STRM_STVARNEXTCHAR
                MENUITEM "Urmatorul Cuvant",                   CM_STRM_STVARNEXTWORD
                MENUITEM "Restul Liniei",                CM_STRM_STVARRESTOFLINE
                MENUITEM SEPARATOR
                MENUITEM "Egal",                       CM_STRM_OPEREQUAL
                MENUITEM "Inegal",                   CM_STRM_OPERNOTEQUAL
                MENUITEM "Sir Egal (Caracter Insensibil - litera mica, mare = nu conteaza)", CM_STRM_OPERSTREQUAL
                MENUITEM "Sir Inegal (Caracter Insensibil - litera mica, mare = nu conteaza)", CM_STRM_OPERSTRNOTEQUAL
                MENUITEM "Subsirul e in Sir",      CM_STRM_OPERISINSTR
                MENUITEM "Subsirul Nu e in Sir",  CM_STRM_OPERISNOTINSTR
                MENUITEM "Sirul se Termina cu Sir",     CM_STRM_OPERENDWITH
                MENUITEM "Sirul nu se Termina cu Sir", CM_STRM_OPERNOTENDWITH
            END
            POPUP "Al&tele"
            BEGIN
                MENUITEM "Continua Doar Daca",            CM_STRM_IF
                MENUITEM "Adauga Sir La Coloana",        CM_STRM_ADDSTRTOCOL
                MENUITEM "Mergi Inapoi cu Un Numar de Caractere", CM_STRM_BACK
                MENUITEM "Taie Sfarsitul Sirului in Coloana", CM_STRM_CUTENDOFSTR
            END
        END
        MENUITEM SEPARATOR
        MENUITEM "&Undo",                       CM_STRM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cut &x",                        CM_STRM_CUT
        MENUITEM "&Copie",                       CM_STRM_COPY
        MENUITEM "&Paste",                      CM_STRM_PASTE
        MENUITEM "&Sterge",                     CM_STRM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "S&electeaza Tot",                 CM_STRM_SELECTALL
    END
END

