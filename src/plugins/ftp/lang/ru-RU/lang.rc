            END
            POPUP "&Другие"
            BEGIN
                MENUITEM "Продолжить только, если",            CM_STRM_IF
                MENUITEM "Добавить строку к столбцу",        CM_STRM_ADDSTRTOCOL
                MENUITEM "Вернуться назад на определенное количество символов", CM_STRM_BACK
                MENUITEM "Вырезать конец строки столбца", CM_STRM_CUTENDOFSTR
            END
        END
