/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SRVCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Соединиться\tEnter",             IDOK
        MENUITEM SEPARATOR
        MENUITEM "Созд&ать...\tInsert",             IDB_NEWBOOKMARK
        MENUITEM "К&опировать в...",                 CM_COPYSRVTO
        MENUITEM "Пе&реименовать...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "У&далить...\tDelete",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "&Переместить вверх\tAlt+Стрелка вверх",      CM_MOVEUPBOOKMARK
        MENUITEM "П&ереместить вниз\tAlt+Стрелка вниз",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_SRVCONTEXTMENU2 MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Создать...\tInsert",             IDB_NEWBOOKMARK
        MENUITEM "К&опировать в...",                 CM_COPYSRVTO
        MENUITEM "Пе&реименовать...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "У&далить...\tDelete",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "&Переместить вверх\tAlt+Стрелка вверх",      CM_MOVEUPBOOKMARK
        MENUITEM "П&ереместить вниз\tAlt+Стрелка вниз",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_ACTPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "От&соединиться...",              CM_DISCONNECTSRV
        MENUITEM "По&казать сертификат...",        CM_SHOWCERT
        POPUP "&Режим передачи данных"
        BEGIN
            MENUITEM "&Автоматический",                  CM_TRMODEAUTO
            MENUITEM "A&SCII",                      CM_TRMODEASCII
            MENUITEM "&Бинарный",                     CM_TRMODEBINARY
        END
        MENUITEM "Об&новить",                    CM_REFRESHPATH
        MENUITEM SEPARATOR
        MENUITEM "&Добавить закладку...",            CM_ADDBOOKMARK
        MENUITEM "Показать &журнал...",                CM_SHOWLOG
        MENUITEM "&Послать команду FTP...",        CM_SENDFTPCOMMAND
        MENUITEM "П&оказать raw-листинг...",        CM_SHOWRAWLISTING
        MENUITEM "В&ыводить скрытые файлы и папки (Unix)", CM_LISTHIDDENFILES
    END
END

IDM_CHNGDRVCONTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Соединиться с FTP-сервером...",   CM_CONNECTSRV
        MENUITEM "&Управление закладками...",      CM_ORGBOOKMARKS
        MENUITEM "Показать &журналы...",               CM_SHOWLOGS
    END
END

IDM_DETPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Показывать на панели",              CM_OPENDETACHED
        MENUITEM SEPARATOR
        MENUITEM "&Отсоединиться",                 CM_DISCONNECTSRV
        MENUITEM SEPARATOR
        MENUITEM "&Добавить закладку...",            CM_ADDBOOKMARK
        MENUITEM "Показать &журнал...",                CM_SHOWLOG
    END
END

IDM_LOGSMENU MENU 
BEGIN
    POPUP "&Журнал"
    BEGIN
        MENUITEM "К&опировать",                       CM_COPYLOG
        MENUITEM "Ко&пировать все",                   CM_COPYALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Сохранить все...",                 CM_SAVELOG
        MENUITEM "Сох&ранить все как...",             CM_SAVEALLLOGS
