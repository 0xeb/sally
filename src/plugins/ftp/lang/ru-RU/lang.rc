    EDITTEXT        IDE_KEEPALIVEEVERY,256,103,28,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "секунд",IDC_STATIC_9,288,105,26,8
    LTEXT           "Прекратить отправк&у спустя:",IDC_STATIC_10,14,120,106,8
    EDITTEXT        IDE_KEEPALIVESTOPAFTER,190,118,28,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "минут",IDC_STATIC_11,223,120,22,8
    CONTROL         "",IDC_STATIC_12,"Static",SS_ETCHEDHORZ | WS_GROUP,149,145,288,1
    LTEXT           "Режим передачи файлов по умолчанию",IDC_STATIC_13,5,141,142,8
    CONTROL         "&Бинарный режим (нет изменений при передачах)",IDC_BINARYMODE,
