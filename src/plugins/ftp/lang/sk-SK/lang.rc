/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SRVCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Pripojiť\tEnter",             IDOK
        MENUITEM SEPARATOR
        MENUITEM "&Nový...\tInsert",             IDB_NEWBOOKMARK
        MENUITEM "&Kopírovať do...",                 CM_COPYSRVTO
        MENUITEM "Pre&menovať...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "&Odstrániť...\tDelete",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "&Hore\tAlt+Up Arrow",      CM_MOVEUPBOOKMARK
        MENUITEM "&Dolu\tAlt+Down Arrow",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_SRVCONTEXTMENU2 MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Nový...\tInsert",             IDB_NEWBOOKMARK
        MENUITEM "&Kopírovať do...",                 CM_COPYSRVTO
        MENUITEM "Pre&menovať...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "&Odstrániť...\tDelete",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "&Hore\tAlt+Up Arrow",      CM_MOVEUPBOOKMARK
        MENUITEM "&Dolu\tAlt+Down Arrow",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_ACTPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Odpojiť...",              CM_DISCONNECTSRV
        MENUITEM "Zobraziť &certifikát...",        CM_SHOWCERT
        POPUP "&Režim prenosu"
        BEGIN
            MENUITEM "&Automatický",                  CM_TRMODEAUTO
            MENUITEM "A&SCII",                      CM_TRMODEASCII
            MENUITEM "&Binárny",                     CM_TRMODEBINARY
        END
        MENUITEM "Obno&viť",                    CM_REFRESHPATH
        MENUITEM SEPARATOR
        MENUITEM "&Pridať záložku...",            CM_ADDBOOKMARK
        MENUITEM "Zobraziť &log...",                CM_SHOWLOG
        MENUITEM "Poslať &FTP príkaz...",        CM_SENDFTPCOMMAND
        MENUITEM "&Zobraziť RAW výpis...",        CM_SHOWRAWLISTING
        MENUITEM "Prechádz&ať skryté súbory a adresáre (Unix)", CM_LISTHIDDENFILES
    END
END

IDM_CHNGDRVCONTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Pripojiť na FTP server...",   CM_CONNECTSRV
        MENUITEM "&Upraviť záložky...",      CM_ORGBOOKMARKS
        MENUITEM "Zobraziť &log...",               CM_SHOWLOGS
    END
END

IDM_DETPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Zobraziť v paneli",              CM_OPENDETACHED
        MENUITEM SEPARATOR
        MENUITEM "&Odpojiť",                 CM_DISCONNECTSRV
        MENUITEM SEPARATOR
        MENUITEM "&Pridať záložku...",            CM_ADDBOOKMARK
        MENUITEM "Zobraziť &log...",                CM_SHOWLOG
    END
END

IDM_LOGSMENU MENU 
BEGIN
    POPUP "&Protokol"
    BEGIN
        MENUITEM "&Kopírovať",                       CM_COPYLOG
        MENUITEM "Kopírovať &všetko",                   CM_COPYALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Uložiť ako...",                 CM_SAVELOG
        MENUITEM "U&ložiť všetko ako...",             CM_SAVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "Vyč&istiť...",                   CM_CLEARLOG
        MENUITEM "&Odstrániť...",                  CM_REMOVELOG
        MENUITEM "O&dstrániť všetko...",              CM_REMOVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Zatvoriť\tAlt+F4",              IDCANCEL
    END
    POPUP "&Možnosti"
    BEGIN
        MENUITEM "&Vždy zobraziť log pre aktívny panel", CM_SHOWLOGFORPANEL
    END
    POPUP "&Nápoveda"
    BEGIN
        MENUITEM "&FTP logy\tF1",               CM_HELPFORLOGSWND
    END
END

IDM_SERVERSOTHERACT MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Kopírovať do...",                 CM_COPYSERVERTO
        MENUITEM "Pre&menovať...\tF2",              CM_RENAMESERVER
        MENUITEM "&Odstrániť...\tDelete",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "&Importovať zo súboru...",        CM_IMPORTSERVER
        MENUITEM "E&xportovať do súboru...",          CM_EXPORTSERVER
    END
END

IDM_SERVERSACTIONS MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Nový...\tInsert",             IDB_NEWSERVER
        MENUITEM "&Upraviť...",                    IDB_EDITSERVER
        MENUITEM "&Kopírovať do...",                 CM_COPYSERVERTO
        MENUITEM "Pre&menovať...\tF2",              CM_RENAMESERVER
        MENUITEM "&Odstrániť...\tDelete",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "&Hore\tAlt+Up Arrow",      IDB_MOVESERVERUP
        MENUITEM "&Dolu\tAlt+Down Arrow",  IDB_MOVESERVERDOWN
        MENUITEM SEPARATOR
        MENUITEM "&Importovať zo súboru...",        CM_IMPORTSERVER
        MENUITEM "E&xportovať do súboru...",          CM_EXPORTSERVER
    END
END

IDM_SRVTYPEMOVECOLUMN MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Hore\tAlt+Up Arrow",           CM_MOVECOLUMNUP
        MENUITEM "&Dolu\tAlt+Down Arrow",       CM_MOVECOLUMNDOWN
    END
END

IDM_SRVTYPERULESMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        POPUP "&Vložiť"
        BEGIN
            MENUITEM "&Začiatok pravidla",              CM_STRM_RULESTART
            MENUITEM "&Koniec pravidla",                CM_STRM_RULEEND
            MENUITEM "Ria&dok komentára",               CM_STRM_COMMENT
            MENUITEM SEPARATOR
            POPUP "&Preskočiť"
            BEGIN
                MENUITEM "Medzery (ak sú)",       CM_STRM_SKIPWSIFANY
                MENUITEM "Medzery (najmenej jedna)", CM_STRM_SKIPWS
                MENUITEM "Presný počet medzier", CM_STRM_SKIPNUMOFWS
                MENUITEM "Medzery a koniec riadku (najmenej jedna)", CM_STRM_SKIPWSENDEOLS
                MENUITEM "Zvyšok riadku (najmenej jeden znak)", CM_STRM_SKIPRESTOFLINE
                MENUITEM "Slovo",                        CM_STRM_SKIPWORD
                MENUITEM "Presný počet znakov",  CM_STRM_SKIPNUMOFLETTERS
                MENUITEM "Všetky znaky až do konca z hľadaného reťazca", CM_STRM_SKIPALLTO
                MENUITEM "Všetky znaky až k najbližšiemu číslu", CM_STRM_SKIPALLTONUMBER
            END
            POPUP "Priradiť ku &stĺpcu"
            BEGIN
                MENUITEM "Zvyšku riadku (najmenej jeden znak)", CM_STRM_ASGNRESTOFLINE
                MENUITEM "Slovu",                        CM_STRM_ASGNWORD
                MENUITEM "Číslu",                      CM_STRM_ASGNNUM
                MENUITEM "Kladnému číslu",             CM_STRM_ASGNPOSNUM
                MENUITEM "Číslu s oddeľovačom",      CM_STRM_ASGNNUMWITHSEP
                MENUITEM "Trojpísmenovému mesiacu (anglicky, nemecky)", CM_STRM_ASGN3LETTERMONTH
                MENUITEM "Trojpísmenovému mesiacu (definovanému užívateľom)", CM_STRM_ASGN3LETMONTHGEN
                MENUITEM "Textovému mesiacu (nemecky)",         CM_STRM_ASGNTEXTMONTH
                MENUITEM "Textovému mesiacu (definovanému užívateľom)",   CM_STRM_ASGNTEXTMONTHGEN
                MENUITEM "Číslu mesiaca",                CM_STRM_ASGNMONTH
                MENUITEM "Číslu dňa",                  CM_STRM_ASGNDAY
                MENUITEM "Číslu roka",                 CM_STRM_ASGNYEAR
                MENUITEM "Času",                        CM_STRM_ASGNTIME
                MENUITEM "Roku alebo času",                CM_STRM_ASGNYEARORTIME
                MENUITEM "Presnému počtu znakov",  CM_STRM_ASGNNUMOFLETTERS
                MENUITEM "Všetkým znakom až do konca z hľadaného reťazca", CM_STRM_ASGNALLTO
                MENUITEM "Všetkým znakom až k hľadanému reťazcu", CM_STRM_ASGNALLUPTO
                MENUITEM "Unix spojeniu (rozdeliť spojenie na názov a cieľ)", CM_STRM_ASGNUNIXLINK
                MENUITEM "Unix zariadeniu",                 CM_STRM_ASGNUNIXDEV
                MENUITEM "Výrazu",                  CM_STRM_ASGNEXPR
            END
            POPUP "Orezať &medzery v stĺpci"
            BEGIN
                MENUITEM "Počiatočné",                     CM_STRM_CUTWSINIT
                MENUITEM "Koncové",                    CM_STRM_CUTWSTRAIL
                MENUITEM "Počiatočné a koncové",        CM_STRM_CUTWSBOTH
            END
            POPUP "S&tavové premenné a operátory výrazov"
            BEGIN
                MENUITEM "Je prvý neprázdny riadok", CM_STRM_STVARISFIRSTNELINE
                MENUITEM "Je posledný neprázdny riadok",  CM_STRM_STVARISLASTNELINE
                MENUITEM "Ďalší znak",              CM_STRM_STVARNEXTCHAR
                MENUITEM "Ďalšie slovo",                   CM_STRM_STVARNEXTWORD
                MENUITEM "Zvyšok riadku",                CM_STRM_STVARRESTOFLINE
                MENUITEM SEPARATOR
                MENUITEM "Rovný",                       CM_STRM_OPEREQUAL
                MENUITEM "Nerovný",                   CM_STRM_OPERNOTEQUAL
                MENUITEM "Rovnaký reťazec (nevníma veľkosť písmen)", CM_STRM_OPERSTREQUAL
                MENUITEM "Nerovnaký reťazec (nevníma veľkosť písmen)", CM_STRM_OPERSTRNOTEQUAL
                MENUITEM "V reťazci je podreťazec",      CM_STRM_OPERISINSTR
                MENUITEM "V reťazci nie je podreťazec",  CM_STRM_OPERISNOTINSTR
                MENUITEM "Reťazec končí reťazcom",     CM_STRM_OPERENDWITH
                MENUITEM "Reťazec nekončí reťazcom", CM_STRM_OPERNOTENDWITH
            END
            POPUP "&Ostatné"
            BEGIN
                MENUITEM "Pokračovať len ak",            CM_STRM_IF
                MENUITEM "Pridať reťazec do stĺpca",        CM_STRM_ADDSTRTOCOL
                MENUITEM "Ísť späť o počet znakov", CM_STRM_BACK
                MENUITEM "Vyňať koniec reťazca zo stĺpca", CM_STRM_CUTENDOFSTR
            END
        END
        MENUITEM SEPARATOR
        MENUITEM "&Späť",                       CM_STRM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Vy&ňať",                        CM_STRM_CUT
        MENUITEM "&Kopírovať",                       CM_STRM_COPY
        MENUITEM "V&ložiť",                      CM_STRM_PASTE
        MENUITEM "&Odstrániť",                     CM_STRM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Vybrať vš&etko",                 CM_STRM_SELECTALL
    END
END

