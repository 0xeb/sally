IDD_CFGGENERAL DIALOGEX 37, 31, 348, 218
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Hlavné"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Po pripojení k serveru zobraziť okno s &uvítacou správou",IDC_WELCOMEMESSAGE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,5,5,198,12
    CONTROL         "&Dať prednosť pripojeniu používanému v paneloch (rýchlejšie prehliadanie)",IDC_PRIORITYTOPANELCON,
                    "Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,380,130,262,12
    CONTROL         "&Celková povolená rýchlosť pre FTP klienta:",IDC_ENABLETOTSPEEDLIM,
