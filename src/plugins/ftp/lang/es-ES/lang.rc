IDM_SRVTYPERULESMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        POPUP "&Insertar"
        BEGIN
            MENUITEM "&Inicio de regla",              CM_STRM_RULESTART
            MENUITEM "&Fin de regla",                CM_STRM_RULEEND
            MENUITEM "Comentario de &línea",               CM_STRM_COMMENT
            MENUITEM SEPARATOR
            POPUP "&Saltar"
            BEGIN
                MENUITEM "Espacio en blanco (si hay)",       CM_STRM_SKIPWSIFANY
                MENUITEM "Espacio en blanco (al menos uno)", CM_STRM_SKIPWS
                MENUITEM "Número exacto de espacios en blanco", CM_STRM_SKIPNUMOFWS
                MENUITEM "Espacios y finales de línea (al menos uno)", CM_STRM_SKIPWSENDEOLS
                MENUITEM "Resto de línea (al menos un caracter)", CM_STRM_SKIPRESTOFLINE
                MENUITEM "Palabra",                        CM_STRM_SKIPWORD
                MENUITEM "Número exacto de caracteres",  CM_STRM_SKIPNUMOFLETTERS
                MENUITEM "Todos los caracteres hasta el fin de la cadena buscada", CM_STRM_SKIPALLTO
                MENUITEM "Todos los caracteres hasta el númeo más próximo", CM_STRM_SKIPALLTONUMBER
            END
            POPUP "&Asignar a columna"
            BEGIN
                MENUITEM "Resto de línea (al menos un caracter)", CM_STRM_ASGNRESTOFLINE
                MENUITEM "Palabra",                        CM_STRM_ASGNWORD
                MENUITEM "Número",                      CM_STRM_ASGNNUM
                MENUITEM "Número positivo",             CM_STRM_ASGNPOSNUM
                MENUITEM "Número con separadores",      CM_STRM_ASGNNUMWITHSEP
                MENUITEM "Mes de tres letras (inglés, alemán)", CM_STRM_ASGN3LETTERMONTH
                MENUITEM "Mes de tres letras (definido por el usuario)", CM_STRM_ASGN3LETMONTHGEN
                MENUITEM "Mes en texto (alemán)",         CM_STRM_ASGNTEXTMONTH
                MENUITEM "Mes en texto (definido por el usuario(",   CM_STRM_ASGNTEXTMONTHGEN
                MENUITEM "Número del mes",                CM_STRM_ASGNMONTH
                MENUITEM "Número del día",                  CM_STRM_ASGNDAY
                MENUITEM "Número del año",                 CM_STRM_ASGNYEAR
                MENUITEM "Hora",                        CM_STRM_ASGNTIME
                MENUITEM "Año u hora",                CM_STRM_ASGNYEARORTIME
                MENUITEM "Número exacto de caracteres",  CM_STRM_ASGNNUMOFLETTERS
                MENUITEM "Todos los caracteres hasta el final de la cadena buscada", CM_STRM_ASGNALLTO
                MENUITEM "Todos los caracteres hasta la cadena buscada", CM_STRM_ASGNALLUPTO
                MENUITEM "Enlace Unix (salta nombre de enlace y destino)", CM_STRM_ASGNUNIXLINK
                MENUITEM "Dispositivo Unix",                 CM_STRM_ASGNUNIXDEV
                MENUITEM "Expresión",                  CM_STRM_ASGNEXPR
            END
            POPUP "&Quitar espacios en blanco de la columna"
            BEGIN
                MENUITEM "Iniciales",                     CM_STRM_CUTWSINIT
                MENUITEM "Finales",                    CM_STRM_CUTWSTRAIL
                MENUITEM "Iniciales y finales",        CM_STRM_CUTWSBOTH
            END
            POPUP "&Variables de estado y operadores de expresiones"
            BEGIN
                MENUITEM "Es la primera línea no vacía", CM_STRM_STVARISFIRSTNELINE
                MENUITEM "Es la última línea no vacía",  CM_STRM_STVARISLASTNELINE
                MENUITEM "Siguiente caracter",              CM_STRM_STVARNEXTCHAR
                MENUITEM "Siguiente palabra",                   CM_STRM_STVARNEXTWORD
                MENUITEM "Resto de línea",                CM_STRM_STVARRESTOFLINE
                MENUITEM SEPARATOR
                MENUITEM "Igual",                       CM_STRM_OPEREQUAL
                MENUITEM "No igual",                   CM_STRM_OPERNOTEQUAL
                MENUITEM "Cadena igual (no distingue M/minúsculas)", CM_STRM_OPERSTREQUAL
                MENUITEM "Cadena no igual (no distingue M/minúsculas)", CM_STRM_OPERSTRNOTEQUAL
                MENUITEM "Subcadena dentro de cadena",      CM_STRM_OPERISINSTR
                MENUITEM "Subcadena no dentro de cadena",  CM_STRM_OPERISNOTINSTR
                MENUITEM "Cadena finaliza con cadena",     CM_STRM_OPERENDWITH
                MENUITEM "Cadena no finaliza con cadena", CM_STRM_OPERNOTENDWITH
            END
            POPUP "&Otros"
            BEGIN
                MENUITEM "Continuar sólo si",            CM_STRM_IF
                MENUITEM "Añadir cadena a columna",        CM_STRM_ADDSTRTOCOL
                MENUITEM "ir un número de caracteres atrás", CM_STRM_BACK
