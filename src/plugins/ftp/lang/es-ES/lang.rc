IDM_SRVCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Conectar\tIntro",             IDOK
        MENUITEM SEPARATOR
        MENUITEM "&Nuevo...\tInsertar",             IDB_NEWBOOKMARK
        MENUITEM "C&opiar a...",                 CM_COPYSRVTO
        MENUITEM "Ca&mbiar nombre...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "&Quitar...\tSupr",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "Pasar &arriba\tAlt+Flecha arriba",      CM_MOVEUPBOOKMARK
        MENUITEM "Pasar a&bajo\tAlt+Flecha abajo",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_SRVCONTEXTMENU2 MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Nuevo...\tInsert",             IDB_NEWBOOKMARK
        MENUITEM "C&opiar a...",                 CM_COPYSRVTO
        MENUITEM "Ca&mbiar nombre...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "&Quitar...\tSupr",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "Pasar &arriba\tAlt+Flecha arriba",      CM_MOVEUPBOOKMARK
        MENUITEM "Pasar a&bajo\tAlt+Flecha abajo",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_ACTPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Desconectar...",              CM_DISCONNECTSRV
        MENUITEM "&Ver certificado...",        CM_SHOWCERT
        POPUP "Modo de &transferencia"
        BEGIN
            MENUITEM "&Automático",                  CM_TRMODEAUTO
            MENUITEM "A&SCII",                      CM_TRMODEASCII
            MENUITEM "&Binario",                     CM_TRMODEBINARY
        END
        MENUITEM "&Refrescar",                    CM_REFRESHPATH
        MENUITEM SEPARATOR
        MENUITEM "&Añadir marcador...",            CM_ADDBOOKMARK
        MENUITEM "Ver re&gistro...",                CM_SHOWLOG
        MENUITEM "&Enviar comando FTP...",        CM_SENDFTPCOMMAND
        MENUITEM "Ver &listado bruto...",        CM_SHOWRAWLISTING
        MENUITEM "L&istar ficheros y directorios ocultos (Unix)", CM_LISTHIDDENFILES
    END
END

IDM_CHNGDRVCONTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Conectar con servidor FTP...",   CM_CONNECTSRV
