        MENUITEM "&Retirar...",                  CM_REMOVELOG
        MENUITEM "Re&tirar todos...",              CM_REMOVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Cerrar\tAlt+F4",              IDCANCEL
