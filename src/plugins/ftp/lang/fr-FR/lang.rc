/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SRVCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Connexion\tEntrée",             IDOK
        MENUITEM SEPARATOR
        MENUITEM "&Nouveau..\tInser",             IDB_NEWBOOKMARK
        MENUITEM "C&opier vers...",                 CM_COPYSRVTO
        MENUITEM "&Renommer...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "S&upprimer...\tSuppr",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "&Monter\tAlt+Flèche haut",      CM_MOVEUPBOOKMARK
        MENUITEM "&Descendre\tAlt+Flèche bas",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_SRVCONTEXTMENU2 MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Nouveau...\tInser",             IDB_NEWBOOKMARK
        MENUITEM "C&opier vers...",                 CM_COPYSRVTO
        MENUITEM "&Renommer...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "S&upprimer...\tSuppr",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "&Monter\tAlt+Flèche haut",      CM_MOVEUPBOOKMARK
        MENUITEM "&Descendre\tAlt+Flèche bas",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_ACTPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Déconnexion...",              CM_DISCONNECTSRV
        MENUITEM "&Voir le certificat...",        CM_SHOWCERT
        POPUP "Mode de &Transfert"
        BEGIN
            MENUITEM "&Automatique",                  CM_TRMODEAUTO
            MENUITEM "A&SCII",                      CM_TRMODEASCII
            MENUITEM "&Binaire",                     CM_TRMODEBINARY
        END
        MENUITEM "&Rafraîchir",                    CM_REFRESHPATH
        MENUITEM SEPARATOR
        MENUITEM "&Ajouter un signet...",            CM_ADDBOOKMARK
        MENUITEM "Voir le &Journal...",                CM_SHOWLOG
        MENUITEM "&Envoyer une commande FTP...",        CM_SENDFTPCOMMAND
        MENUITEM "Voir la liste &brute...",        CM_SHOWRAWLISTING
        MENUITEM "L&ister les fichiers et répertoires cachés (Unix)", CM_LISTHIDDENFILES
    END
END

IDM_CHNGDRVCONTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Connexion au serveur FTP...",   CM_CONNECTSRV
        MENUITEM "&Organiser les signets...",      CM_ORGBOOKMARKS
        MENUITEM "Voir les &Journaux...",               CM_SHOWLOGS
    END
END

IDM_DETPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Montrer dans le panneau",              CM_OPENDETACHED
        MENUITEM SEPARATOR
        MENUITEM "&Déconnexion",                 CM_DISCONNECTSRV
        MENUITEM SEPARATOR
        MENUITEM "&Ajouter un signet...",            CM_ADDBOOKMARK
        MENUITEM "Voir le &Journal...",                CM_SHOWLOG
    END
END

IDM_LOGSMENU MENU 
BEGIN
    POPUP "&Journal"
    BEGIN
        MENUITEM "C&opier",                       CM_COPYLOG
        MENUITEM "Tout co&pier",                   CM_COPYALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "Sa&uvegarder sous...",                 CM_SAVELOG
        MENUITEM "Tout s&auvegarder sous...",             CM_SAVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Effacer...",                   CM_CLEARLOG
        MENUITEM "&Supprimer...",                  CM_REMOVELOG
        MENUITEM "&Tout supprimer...",              CM_REMOVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Fermer\tAlt+F4",              IDCANCEL
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Toujours montrer le journal du panneau actif", CM_SHOWLOGFORPANEL
    END
    POPUP "&Aide"
    BEGIN
        MENUITEM "Journaux &FTP\tF1",               CM_HELPFORLOGSWND
    END
END

IDM_SERVERSOTHERACT MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Copier vers...",                 CM_COPYSERVERTO
        MENUITEM "&Renommer...\tF2",              CM_RENAMESERVER
        MENUITEM "Su&pprimer...\tSuppr",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "&Importer depuis le fichier...",        CM_IMPORTSERVER
        MENUITEM "E&xporter vers le fichier...",          CM_EXPORTSERVER
    END
END

IDM_SERVERSACTIONS MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Nouveau...\tInser",             IDB_NEWSERVER
        MENUITEM "&Editer...",                    IDB_EDITSERVER
        MENUITEM "&Copier vers...",                 CM_COPYSERVERTO
        MENUITEM "&Renommer...\tF2",              CM_RENAMESERVER
        MENUITEM "Su&pprimer...\tSuppr",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "&Monter\tAlt+Flèche haut",      IDB_MOVESERVERUP
        MENUITEM "&Descendre\tAlt+Flèche bas",  IDB_MOVESERVERDOWN
        MENUITEM SEPARATOR
        MENUITEM "&Importer depuis le fichier...",        CM_IMPORTSERVER
        MENUITEM "E&xporter vers le fichier...",          CM_EXPORTSERVER
    END
END

IDM_SRVTYPEMOVECOLUMN MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Haut\tAlt+Flèche haut",           CM_MOVECOLUMNUP
        MENUITEM "&Bas\tAlt+Flèche bas",       CM_MOVECOLUMNDOWN
    END
END

IDM_SRVTYPERULESMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        POPUP "&Insérer"
        BEGIN
            MENUITEM "&Début de règle",              CM_STRM_RULESTART
            MENUITEM "&Fin de règle",                CM_STRM_RULEEND
            MENUITEM "C&ommentaire en ligne",               CM_STRM_COMMENT
            MENUITEM SEPARATOR
            POPUP "&Passer"
            BEGIN
                MENUITEM "Espace (s'il y en a)",       CM_STRM_SKIPWSIFANY
                MENUITEM "Espace (au moins un)", CM_STRM_SKIPWS
                MENUITEM "Nombre exact d'espaces", CM_STRM_SKIPNUMOFWS
                MENUITEM "Espaces et fins de ligne (au moins un)", CM_STRM_SKIPWSENDEOLS
                MENUITEM "Reste de ligne (au moins un caractère)", CM_STRM_SKIPRESTOFLINE
                MENUITEM "Mot",                        CM_STRM_SKIPWORD
                MENUITEM "Nombre exact de caractères",  CM_STRM_SKIPNUMOFLETTERS
                MENUITEM "Tous les caractères jusqu'à la fin de la chaîne recherchée", CM_STRM_SKIPALLTO
                MENUITEM "Tous les caractères jusqu'au nombre le plus proche", CM_STRM_SKIPALLTONUMBER
            END
            POPUP "&Affecter à la colonne"
            BEGIN
                MENUITEM "Reste de ligne (au moins un caractère)", CM_STRM_ASGNRESTOFLINE
                MENUITEM "Mot",                        CM_STRM_ASGNWORD
                MENUITEM "Nombre",                      CM_STRM_ASGNNUM
                MENUITEM "Nombre positif",             CM_STRM_ASGNPOSNUM
                MENUITEM "Nombre avec séparateurs",      CM_STRM_ASGNNUMWITHSEP
                MENUITEM "Mois en trois lettres (anglais, allemand)", CM_STRM_ASGN3LETTERMONTH
                MENUITEM "Mois en trois lettres (défini par l'utilisateur)", CM_STRM_ASGN3LETMONTHGEN
                MENUITEM "Mois en texte (allemand)",         CM_STRM_ASGNTEXTMONTH
                MENUITEM "Mois en texte (défini par l'utilisateur)",   CM_STRM_ASGNTEXTMONTHGEN
                MENUITEM "Numéro du mois",                CM_STRM_ASGNMONTH
                MENUITEM "Numéro du jour",                  CM_STRM_ASGNDAY
                MENUITEM "Numéro de l'année",                 CM_STRM_ASGNYEAR
                MENUITEM "Heure",                        CM_STRM_ASGNTIME
                MENUITEM "Année ou heure",                CM_STRM_ASGNYEARORTIME
                MENUITEM "Nombre exact de caractères",  CM_STRM_ASGNNUMOFLETTERS
                MENUITEM "Tous les caractères jusqu'à la fin de la chaîne recherchée", CM_STRM_ASGNALLTO
                MENUITEM "Tous les caractères jusqu'à la chaîne recherchée", CM_STRM_ASGNALLUPTO
                MENUITEM "Lien Unix (lien nom et cible séparés)", CM_STRM_ASGNUNIXLINK
                MENUITEM "Unité Unix",                 CM_STRM_ASGNUNIXDEV
                MENUITEM "Expression",                  CM_STRM_ASGNEXPR
            END
            POPUP "&Supprimer les espaces de la colonne"
            BEGIN
                MENUITEM "Initial",                     CM_STRM_CUTWSINIT
                MENUITEM "Trailing",                    CM_STRM_CUTWSTRAIL
                MENUITEM "Initial et Trailing",        CM_STRM_CUTWSBOTH
            END
            POPUP "&Variables d'état et opérateurs d'expressions"
            BEGIN
                MENUITEM "Est la première ligne non vide", CM_STRM_STVARISFIRSTNELINE
                MENUITEM "Est la dernière ligne non vide",  CM_STRM_STVARISLASTNELINE
                MENUITEM "Caractère suivant",              CM_STRM_STVARNEXTCHAR
                MENUITEM "Mot suivant",                   CM_STRM_STVARNEXTWORD
                MENUITEM "Reste de la ligne",                CM_STRM_STVARRESTOFLINE
                MENUITEM SEPARATOR
                MENUITEM "Egal",                       CM_STRM_OPEREQUAL
                MENUITEM "Non Egal",                   CM_STRM_OPERNOTEQUAL
                MENUITEM "Egal à la chaîne (insensible à la casse)", CM_STRM_OPERSTREQUAL
                MENUITEM "Non égal à la chaîne (insensible à la casse)", CM_STRM_OPERSTRNOTEQUAL
                MENUITEM "la sous-chaîne est dans la chaîne",      CM_STRM_OPERISINSTR
                MENUITEM "La sous-chaîne n'est pas dans la chaîne",  CM_STRM_OPERISNOTINSTR
                MENUITEM "La chaîne se termine par la chaîne",     CM_STRM_OPERENDWITH
                MENUITEM "La chaîne ne se termine pas par la chaîne", CM_STRM_OPERNOTENDWITH
            END
            POPUP "A&utres"
            BEGIN
                MENUITEM "Continuer seulement si",            CM_STRM_IF
                MENUITEM "Ajouter la chaîne à la colonne",        CM_STRM_ADDSTRTOCOL
                MENUITEM "Revenir à un certain nombre de caractères", CM_STRM_BACK
                MENUITEM "Couper la fin de la chaîne dans la colonne", CM_STRM_CUTENDOFSTR
            END
        END
        MENUITEM SEPARATOR
        MENUITEM "&Défaire",                       CM_STRM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Co&uper",                        CM_STRM_CUT
        MENUITEM "&Copier",                       CM_STRM_COPY
        MENUITEM "C&oller",                      CM_STRM_PASTE
        MENUITEM "&Supprimer",                     CM_STRM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Tout sélectionner",                 CM_STRM_SELECTALL
    END
END

