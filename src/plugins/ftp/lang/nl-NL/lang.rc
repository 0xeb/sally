/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SRVCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Verbinden\tEnter",             IDOK
        MENUITEM SEPARATOR
        MENUITEM "&Nieuw...\tInvoegen",             IDB_NEWBOOKMARK
        MENUITEM "K&opïeren naar...",                 CM_COPYSRVTO
        MENUITEM "H&ernoemen...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "&Wissen...\tVerwijder",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "Om&hoog\tAlt+Pijl omhoog",      CM_MOVEUPBOOKMARK
        MENUITEM "Om&laag\tAlt+Pijl omlaag",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_SRVCONTEXTMENU2 MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Nieuw...\tInvoegen",             IDB_NEWBOOKMARK
        MENUITEM "K&opïeren naar...",                 CM_COPYSRVTO
        MENUITEM "H&ernoemen...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "&Wissen...\tVerwijder",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "Om&hoog\tAlt+Pijl omhoog",      CM_MOVEUPBOOKMARK
        MENUITEM "Om&laag\tAlt+Pijl omlaag",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_ACTPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Ve&rbreken...",              CM_DISCONNECTSRV
        MENUITEM "Certificaat &weergeven...",        CM_SHOWCERT
        POPUP "Ov&erdracht Modus"
        BEGIN
            MENUITEM "&Automatisch",                  CM_TRMODEAUTO
            MENUITEM "A&SCII",                      CM_TRMODEASCII
            MENUITEM "&Binair",                     CM_TRMODEBINARY
        END
        MENUITEM "&Verversen",                    CM_REFRESHPATH
        MENUITEM SEPARATOR
        MENUITEM "&Bladwijzer toevoegen...",            CM_ADDBOOKMARK
        MENUITEM "&Logboek weergeven...",                CM_SHOWLOG
        MENUITEM "&Zend FTP commando...",        CM_SENDFTPCOMMAND
        MENUITEM "O&ngeformateerde lijst weergeven...",        CM_SHOWRAWLISTING
        MENUITEM "Verb&orgen bestanden en mappen weergeven (Unix)", CM_LISTHIDDENFILES
    END
END

IDM_CHNGDRVCONTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Naar FTP Server verbinden...",   CM_CONNECTSRV
        MENUITEM "Bladwijzers &organizeren...",      CM_ORGBOOKMARKS
        MENUITEM "&Logboek weergeven...",               CM_SHOWLOGS
    END
END

IDM_DETPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Toon in deelvester",              CM_OPENDETACHED
        MENUITEM SEPARATOR
        MENUITEM "&Verbreken",                 CM_DISCONNECTSRV
        MENUITEM SEPARATOR
        MENUITEM "&Bladwijzer toevoegen...",            CM_ADDBOOKMARK
        MENUITEM "&Logboek weergeven...",                CM_SHOWLOG
    END
END

IDM_LOGSMENU MENU 
BEGIN
    POPUP "&Logboek"
    BEGIN
        MENUITEM "&Kopieer",                       CM_COPYLOG
        MENUITEM "Ko&pieer alles",                   CM_COPYALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Opslaan als...",                 CM_SAVELOG
        MENUITEM "&Alles opslaan als...",             CM_SAVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "Lee&gmaken...",                   CM_CLEARLOG
        MENUITEM "&Verwijderen...",                  CM_REMOVELOG
        MENUITEM "Ver&wijder alles...",              CM_REMOVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Sluiten\tAlt+F4",              IDCANCEL
    END
    POPUP "O&pties"
    BEGIN
        MENUITEM "&Laat het logboek voor het actieve venster", CM_SHOWLOGFORPANEL
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&FTP Logbestanden\tF1",               CM_HELPFORLOGSWND
    END
END

IDM_SERVERSOTHERACT MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "K&opïeren naar...",                 CM_COPYSERVERTO
        MENUITEM "&Hernoemen...\tF2",              CM_RENAMESERVER
        MENUITEM "&Wissen...\tVerwijder",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "&Importeer van bestand...",        CM_IMPORTSERVER
        MENUITEM "E&xporteer naar bestand...",          CM_EXPORTSERVER
    END
END

IDM_SERVERSACTIONS MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Nieuw...\tInvoegen",             IDB_NEWSERVER
        MENUITEM "&Bewerken...",                    IDB_EDITSERVER
        MENUITEM "K&opïeren naar...",                 CM_COPYSERVERTO
        MENUITEM "H&ernoemen...\tF2",              CM_RENAMESERVER
        MENUITEM "R&Wissen...\tVerwijder",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "Om&hoog\tAlt+Pijl omhoog",      IDB_MOVESERVERUP
        MENUITEM "Om&laag\tAlt+Pijl omlaag",  IDB_MOVESERVERDOWN
        MENUITEM SEPARATOR
        MENUITEM "&Importeer van bestand...",        CM_IMPORTSERVER
        MENUITEM "E&xporteer naar bestand...",          CM_EXPORTSERVER
    END
END

IDM_SRVTYPEMOVECOLUMN MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Om&hoog\tAlt+Pijl omhoog",           CM_MOVECOLUMNUP
        MENUITEM "Om&laag\tAlt+Pijl omlaag",       CM_MOVECOLUMNDOWN
    END
END

IDM_SRVTYPERULESMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        POPUP "&Invoegen"
        BEGIN
            MENUITEM "B&egin van regel",              CM_STRM_RULESTART
            MENUITEM "E&inde van regel",                CM_STRM_RULEEND
            MENUITEM "&Regel commentaar",               CM_STRM_COMMENT
            MENUITEM SEPARATOR
            POPUP "&Overslaan"
            BEGIN
                MENUITEM "Lege ruimten (indien van toepassing)",       CM_STRM_SKIPWSIFANY
                MENUITEM "Lege ruimten (tenminste één)", CM_STRM_SKIPWS
                MENUITEM "Exact aantal lege ruimten", CM_STRM_SKIPNUMOFWS
                MENUITEM "Lege ruimten en einde regels (tenminste één)", CM_STRM_SKIPWSENDEOLS
                MENUITEM "Rest van de regels (tenminste één karakter)", CM_STRM_SKIPRESTOFLINE
                MENUITEM "Woord",                        CM_STRM_SKIPWORD
                MENUITEM "Exact aantal karakters",  CM_STRM_SKIPNUMOFLETTERS
                MENUITEM "Alle tekens tot het einde van de gezochte tekstwaarde", CM_STRM_SKIPALLTO
                MENUITEM "Alle tekens tot dichtstbijzijnde aantal", CM_STRM_SKIPALLTONUMBER
            END
            POPUP "&Toewijzen aan kolom"
            BEGIN
                MENUITEM "Rest van de regels (tenminste één karakter)", CM_STRM_ASGNRESTOFLINE
                MENUITEM "Woord",                        CM_STRM_ASGNWORD
                MENUITEM "Aantal",                      CM_STRM_ASGNNUM
                MENUITEM "Positief aantal",             CM_STRM_ASGNPOSNUM
                MENUITEM "Het aantal met scheidingstekens",      CM_STRM_ASGNNUMWITHSEP
                MENUITEM "Drie-letterige maand aanduiding (Engels, Duits)", CM_STRM_ASGN3LETTERMONTH
                MENUITEM "Drie-letterige maand aanduiding (gedefineerd door gebruiker)", CM_STRM_ASGN3LETMONTHGEN
                MENUITEM "Maand uitgeschreven (Duits)",         CM_STRM_ASGNTEXTMONTH
                MENUITEM "Maand uitgeschreven (gedefineerd door gebruiker)",   CM_STRM_ASGNTEXTMONTHGEN
                MENUITEM "Maand aanduiding in getal",                CM_STRM_ASGNMONTH
                MENUITEM "Dag aanduiding in getal",                  CM_STRM_ASGNDAY
                MENUITEM "Jaar aanduiding in getal",                 CM_STRM_ASGNYEAR
                MENUITEM "Tijd",                        CM_STRM_ASGNTIME
                MENUITEM "Jaar of Tijd",                CM_STRM_ASGNYEARORTIME
                MENUITEM "Exact aantal karakters",  CM_STRM_ASGNNUMOFLETTERS
                MENUITEM "Alle tekens tot het einde van de gezochte tekstwaarde", CM_STRM_ASGNALLTO
                MENUITEM "Alle tekens tot de gezochte tekstwaarde", CM_STRM_ASGNALLUPTO
                MENUITEM "Unix link Splits de link naam en doel)", CM_STRM_ASGNUNIXLINK
                MENUITEM "Unix apparaat",                 CM_STRM_ASGNUNIXDEV
                MENUITEM "Expressie",                  CM_STRM_ASGNEXPR
            END
            POPUP "&Witruimte in kolom verwijderen"
            BEGIN
                MENUITEM "Initieel",                     CM_STRM_CUTWSINIT
                MENUITEM "Achterstand",                    CM_STRM_CUTWSTRAIL
                MENUITEM "Initieel en achterstand",        CM_STRM_CUTWSBOTH
            END
            POPUP "Status&variabelen en operatoren voor expressies"
            BEGIN
                MENUITEM "Is de eerste niet-lege regel", CM_STRM_STVARISFIRSTNELINE
                MENUITEM "Is de laatste niet-lege regel",  CM_STRM_STVARISLASTNELINE
                MENUITEM "Volgend karakter",              CM_STRM_STVARNEXTCHAR
                MENUITEM "Volgend woord",                   CM_STRM_STVARNEXTWORD
                MENUITEM "Rest van de regel",                CM_STRM_STVARRESTOFLINE
                MENUITEM SEPARATOR
                MENUITEM "Gelijk",                       CM_STRM_OPEREQUAL
                MENUITEM "Ongelijk",                   CM_STRM_OPERNOTEQUAL
                MENUITEM "Tekstwaarde gelijk (hoofdlettergevoelig)", CM_STRM_OPERSTREQUAL
                MENUITEM "Tekstwaarde ongelijk (hoofdlettergevoelig)", CM_STRM_OPERSTRNOTEQUAL
                MENUITEM "Subreeks is in de tekenreeks",      CM_STRM_OPERISINSTR
                MENUITEM "Subreeks is niet in de tekenreeks",  CM_STRM_OPERISNOTINSTR
                MENUITEM "Tekenreeks eindigt met tekstwaarde",     CM_STRM_OPERENDWITH
                MENUITEM "Tekenreeks eindigt niet met tekstwaarde", CM_STRM_OPERNOTENDWITH
            END
            POPUP "Overi&ge"
            BEGIN
                MENUITEM "Continueer alleen als",            CM_STRM_IF
                MENUITEM "Voeg tekstwaarde toe aan kolom",        CM_STRM_ADDSTRTOCOL
                MENUITEM "Ga een aantal karakters terug", CM_STRM_BACK
                MENUITEM "Knip het einde van de tekstwaarden in de kolom", CM_STRM_CUTENDOFSTR
            END
        END
        MENUITEM SEPARATOR
        MENUITEM "&Ongedaan maken",                       CM_STRM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Kni&p",                        CM_STRM_CUT
        MENUITEM "&Kopieer",                       CM_STRM_COPY
        MENUITEM "P&lakken",                      CM_STRM_PASTE
        MENUITEM "&Verwijder",                     CM_STRM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Selecteer &alles",                 CM_STRM_SELECTALL
    END
END

