IDM_SRVTYPERULESMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        POPUP "삽입(&I)"
        BEGIN
            MENUITEM "규칙 시작(&T)",              CM_STRM_RULESTART
            MENUITEM "규칙 끝(&E)",                CM_STRM_RULEEND
            MENUITEM "줄 주석(&L)",               CM_STRM_COMMENT
            MENUITEM SEPARATOR
            POPUP "건너뛰기(&S)"
            BEGIN
                MENUITEM "공백(있는 경우)",       CM_STRM_SKIPWSIFANY
                MENUITEM "공백(하나 이상)", CM_STRM_SKIPWS
                MENUITEM "정확한 개수의 공백", CM_STRM_SKIPNUMOFWS
                MENUITEM "공백 및 줄 끝(하나 이상)", CM_STRM_SKIPWSENDEOLS
                MENUITEM "줄의 나머지(한 문자 이상)", CM_STRM_SKIPRESTOFLINE
                MENUITEM "단어",                        CM_STRM_SKIPWORD
                MENUITEM "정확한 개수의 문자",  CM_STRM_SKIPNUMOFLETTERS
                MENUITEM "검색한 문자열의 끝까지 모든 문자", CM_STRM_SKIPALLTO
                MENUITEM "가장 가까운 숫자까지 모든 문자", CM_STRM_SKIPALLTONUMBER
            END
            POPUP "열에 할당(&A)"
            BEGIN
                MENUITEM "줄의 나머지(한 문자 이상)", CM_STRM_ASGNRESTOFLINE
                MENUITEM "단어",                        CM_STRM_ASGNWORD
                MENUITEM "숫자",                      CM_STRM_ASGNNUM
                MENUITEM "양수",             CM_STRM_ASGNPOSNUM
                MENUITEM "구분 기호가 있는 숫자",      CM_STRM_ASGNNUMWITHSEP
                MENUITEM "세 글자 월(영어, 독일어)", CM_STRM_ASGN3LETTERMONTH
                MENUITEM "세 글자 월(사용자 정의)", CM_STRM_ASGN3LETMONTHGEN
                MENUITEM "텍스트 월(독일어)",         CM_STRM_ASGNTEXTMONTH
                MENUITEM "텍스트 월(사용자 정의)",   CM_STRM_ASGNTEXTMONTHGEN
                MENUITEM "월 숫자",                CM_STRM_ASGNMONTH
                MENUITEM "일 숫자",                  CM_STRM_ASGNDAY
                MENUITEM "연도 숫자",                 CM_STRM_ASGNYEAR
                MENUITEM "시간",                        CM_STRM_ASGNTIME
                MENUITEM "연도 또는 시간",                CM_STRM_ASGNYEARORTIME
                MENUITEM "정확한 개수의 문자",  CM_STRM_ASGNNUMOFLETTERS
                MENUITEM "검색한 문자열의 끝까지 모든 문자", CM_STRM_ASGNALLTO
                MENUITEM "검색한 문자열 앞까지 모든 문자", CM_STRM_ASGNALLUPTO
                MENUITEM "Unix 링크(링크 이름과 대상 분리)", CM_STRM_ASGNUNIXLINK
                MENUITEM "Unix 장치",                 CM_STRM_ASGNUNIXDEV
                MENUITEM "식",                  CM_STRM_ASGNEXPR
            END
            POPUP "열의 공백 잘라내기(&C)"
            BEGIN
                MENUITEM "앞",                     CM_STRM_CUTWSINIT
                MENUITEM "뒤",                    CM_STRM_CUTWSTRAIL
                MENUITEM "앞과 뒤",        CM_STRM_CUTWSBOTH
            END
            POPUP "식의 상태 변수 및 연산자(&V)"
            BEGIN
                MENUITEM "비어 있지 않은 첫 줄임", CM_STRM_STVARISFIRSTNELINE
                MENUITEM "비어 있지 않은 마지막 줄임",  CM_STRM_STVARISLASTNELINE
                MENUITEM "다음 문자",              CM_STRM_STVARNEXTCHAR
                MENUITEM "다음 단어",                   CM_STRM_STVARNEXTWORD
                MENUITEM "줄의 나머지",                CM_STRM_STVARRESTOFLINE
                MENUITEM SEPARATOR
                MENUITEM "같음",                       CM_STRM_OPEREQUAL
                MENUITEM "같지 않음",                   CM_STRM_OPERNOTEQUAL
                MENUITEM "문자열 같음(대/소문자 구분 안 함)", CM_STRM_OPERSTREQUAL
                MENUITEM "문자열 같지 않음(대/소문자 구분 안 함)", CM_STRM_OPERSTRNOTEQUAL
                MENUITEM "부분 문자열이 문자열에 있음",      CM_STRM_OPERISINSTR
                MENUITEM "부분 문자열이 문자열에 없음",  CM_STRM_OPERISNOTINSTR
                MENUITEM "문자열이 문자열로 끝남",     CM_STRM_OPERENDWITH
                MENUITEM "문자열이 문자열로 끝나지 않음", CM_STRM_OPERNOTENDWITH
            END
            POPUP "기타(&O)"
            BEGIN
                MENUITEM "다음 경우에만 계속",            CM_STRM_IF
                MENUITEM "열에 문자열 추가",        CM_STRM_ADDSTRTOCOL
                MENUITEM "지정한 문자 수만큼 뒤로 이동", CM_STRM_BACK
                MENUITEM "열에서 문자열 끝 잘라내기", CM_STRM_CUTENDOFSTR
            END
        END
        MENUITEM SEPARATOR
        MENUITEM "실행 취소(&U)",                       CM_STRM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "잘라내기(&T)",                        CM_STRM_CUT
        MENUITEM "복사(&C)",                       CM_STRM_COPY
        MENUITEM "붙여넣기(&P)",                      CM_STRM_PASTE
        MENUITEM "삭제(&D)",                     CM_STRM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "모두 선택(&A)",                 CM_STRM_SELECTALL
    END
END

