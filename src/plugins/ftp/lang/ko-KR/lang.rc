IDM_SRVCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "연결(&C)\tEnter",             IDOK
        MENUITEM SEPARATOR
        MENUITEM "새로 만들기(&N)...\tInsert",             IDB_NEWBOOKMARK
        MENUITEM "다른 이름으로 복사(&O)...",                 CM_COPYSRVTO
        MENUITEM "이름 바꾸기(&R)...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "제거(&E)...\tDelete",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "위로 이동(&U)\tAlt+위쪽 화살표",      CM_MOVEUPBOOKMARK
        MENUITEM "아래로 이동(&D)\tAlt+아래쪽 화살표",  CM_MOVEDOWNBOOKMARK
    END
END

