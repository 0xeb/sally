FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "서버가 제공한 인증서에 다음 문제가 있습니다.",IDC_STATIC_1,
                    "Static",SS_LEFTNOWORDWRAP | WS_GROUP,7,9,258,8
    GROUPBOX        " 인증서 확인 요약 ",IDC_STATIC_2,9,21,252,54
    LTEXT           "",IDT_CERTIFICATE_ERROR,16,32,238,40
    LTEXT           "인증서를 수락하면 위험할 수 있으므로 권장하지 않습니다.",IDC_STATIC_3,7,80,258,8,NOT WS_GROUP
    LTEXT           "",IDC_STATIC_4,5,95,261,1,SS_ETCHEDHORZ | WS_GROUP
    PUSHBUTTON      "인증서 보기(&V)",IDB_CERTIFICATE_VIEW,10,100,80,14,WS_GROUP
    PUSHBUTTON      "인증서 수락(&A)",IDOK,95,100,80,14
    DEFPUSHBUTTON   "취소",IDCANCEL,180,100,80,14
END

