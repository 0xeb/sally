                MENUITEM "Hónap szöveg (egyéni)",   CM_STRM_ASGNTEXTMONTHGEN
                MENUITEM "Hónap száma",                CM_STRM_ASGNMONTH
                MENUITEM "Nap száma",                  CM_STRM_ASGNDAY
                MENUITEM "Évszám",                 CM_STRM_ASGNYEAR
                MENUITEM "Idő",                        CM_STRM_ASGNTIME
                MENUITEM "Év vagy idő",                CM_STRM_ASGNYEARORTIME
                MENUITEM "Adott számú karakter",  CM_STRM_ASGNNUMOFLETTERS
                MENUITEM "Minden karakter a keresett karakterlánc végéig", CM_STRM_ASGNALLTO
                MENUITEM "Minden karakter a keresett karakterláncig", CM_STRM_ASGNALLUPTO
                MENUITEM "Unix link (link felosztása névre és célra)", CM_STRM_ASGNUNIXLINK
                MENUITEM "Unix eszköz",                 CM_STRM_ASGNUNIXDEV
                MENUITEM "Kifejezés",                  CM_STRM_ASGNEXPR
            END
            POPUP "Szóközök &levágása az oszlopban"
            BEGIN
                MENUITEM "Kezdő",                     CM_STRM_CUTWSINIT
                MENUITEM "Záró",                    CM_STRM_CUTWSTRAIL
                MENUITEM "Kezdő és záró",        CM_STRM_CUTWSBOTH
            END
            POPUP "Állapot&változók és kifejezés-operátorok"
            BEGIN
                MENUITEM "Az első nem üres sor", CM_STRM_STVARISFIRSTNELINE
                MENUITEM "Az utolsó nem üres sor",  CM_STRM_STVARISLASTNELINE
                MENUITEM "Következő karakter",              CM_STRM_STVARNEXTCHAR
                MENUITEM "Következő szó",                   CM_STRM_STVARNEXTWORD
                MENUITEM "Többi sor",                CM_STRM_STVARRESTOFLINE
                MENUITEM SEPARATOR
                MENUITEM "Egyenlő",                       CM_STRM_OPEREQUAL
                MENUITEM "Nem egyenlő",                   CM_STRM_OPERNOTEQUAL
                MENUITEM "Karakterlánc egyenlő (nagybetű érzékeny)", CM_STRM_OPERSTREQUAL
                MENUITEM "Karakterlánc nem egyenlő (nagybetű érzékeny)", CM_STRM_OPERSTRNOTEQUAL
                MENUITEM "Karakterláncrész a karakterláncban",      CM_STRM_OPERISINSTR
                MENUITEM "Karakterláncrész nincs a karakterláncban",  CM_STRM_OPERISNOTINSTR
                MENUITEM "A karakterlánc a karakterlánccal ér véget",     CM_STRM_OPERENDWITH
                MENUITEM "A karakterlánc nem a karakterlánccal ér véget", CM_STRM_OPERNOTENDWITH
            END
            POPUP "E&gyebek"
            BEGIN
                MENUITEM "Csak akkor folytat ha",            CM_STRM_IF
                MENUITEM "Karakterlánc adása az oszlophoz",        CM_STRM_ADDSTRTOCOL
                MENUITEM "Karakterek végétől egy számra ugrás", CM_STRM_BACK
                MENUITEM "Karakterlánc végének levágása az oszlopban", CM_STRM_CUTENDOFSTR
            END
        END
        MENUITEM SEPARATOR
        MENUITEM "&Visszavonás",                       CM_STRM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "&Kivágás",                        CM_STRM_CUT
        MENUITEM "Má&solás",                       CM_STRM_COPY
        MENUITEM "B&eillesztés",                      CM_STRM_PASTE
        MENUITEM "&Törlés",                     CM_STRM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Mind kijelöl",                 CM_STRM_SELECTALL
    END
END

