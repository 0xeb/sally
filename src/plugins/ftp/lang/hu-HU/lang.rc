/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_SRVCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Csatlakozás\tEnter",             IDOK
        MENUITEM SEPARATOR
        MENUITEM "Ú&j...\tInsert",             IDB_NEWBOOKMARK
        MENUITEM "Más&olás ide...",                 CM_COPYSRVTO
        MENUITEM "Á&tnevezés...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "&Eltávolítás...\tDelete",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "&Fel\tAlt+Felfelé nyíl",      CM_MOVEUPBOOKMARK
        MENUITEM "&Le\tAlt+Lefelé nyíl",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_SRVCONTEXTMENU2 MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Ú&j...\tInsert",             IDB_NEWBOOKMARK
        MENUITEM "Más&olás ide...",                 CM_COPYSRVTO
        MENUITEM "Á&tnevezés...\tF2",              IDB_RENAMEBOOKMARK
        MENUITEM "&Eltávolítás...\tDelete",          IDB_REMOVEBOOKMARK
        MENUITEM SEPARATOR
        MENUITEM "&Fel\tAlt+Felfelé nyíl",      CM_MOVEUPBOOKMARK
        MENUITEM "&Le\tAlt+Lefelé nyíl",  CM_MOVEDOWNBOOKMARK
    END
END

IDM_ACTPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "L&eválasztás...",              CM_DISCONNECTSRV
        MENUITEM "Ta&núsítvány...",        CM_SHOWCERT
        POPUP "Á&tviteli mód"
        BEGIN
            MENUITEM "&Automatikus",                  CM_TRMODEAUTO
            MENUITEM "A&SCII",                      CM_TRMODEASCII
            MENUITEM "&Bináris",                     CM_TRMODEBINARY
        END
        MENUITEM "F&rissítés",                    CM_REFRESHPATH
        MENUITEM SEPARATOR
        MENUITEM "Könyvjelzőhöz &adás...",            CM_ADDBOOKMARK
        MENUITEM "Eseménynap&ló...",                CM_SHOWLOG
        MENUITEM "FTP paranc&s küldése...",        CM_SENDFTPCOMMAND
        MENUITEM "Ra&w listázás...",        CM_SHOWRAWLISTING
        MENUITEM "Rejtett fájlok és mappák l&istázása (Unix)", CM_LISTHIDDENFILES
    END
END

IDM_CHNGDRVCONTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "FTP szerverhez kap&csolódás...",   CM_CONNECTSRV
        MENUITEM "&Könyvjelzők rendezése...",      CM_ORGBOOKMARKS
        MENUITEM "Eseménynap&lók...",               CM_SHOWLOGS
    END
END

IDM_DETPATHCONTEXTMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Panelban mutatá&s",              CM_OPENDETACHED
        MENUITEM SEPARATOR
        MENUITEM "L&eválasztás",                 CM_DISCONNECTSRV
        MENUITEM SEPARATOR
        MENUITEM "Könyvjelzőhöz &adás...",            CM_ADDBOOKMARK
        MENUITEM "Eseménynap&ló...",                CM_SHOWLOG
    END
END

IDM_LOGSMENU MENU 
BEGIN
    POPUP "&Napló"
    BEGIN
        MENUITEM "Más&olás",                       CM_COPYLOG
        MENUITEM "&Mind másol",                   CM_COPYALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "Menté&s mint...",                 CM_SAVELOG
        MENUITEM "M&ind mentése mint...",             CM_SAVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Takarít...",                   CM_CLEARLOG
        MENUITEM "Tö&röl...",                  CM_REMOVELOG
        MENUITEM "Mi&nd töröl...",              CM_REMOVEALLLOGS
        MENUITEM SEPARATOR
        MENUITEM "&Bezárás\tAlt+F4",              IDCANCEL
    END
    POPUP "&Beállítások"
    BEGIN
        MENUITEM "Eseményn&apló mutatása aktív panelnál", CM_SHOWLOGFORPANEL
    END
    POPUP "&Súgó"
    BEGIN
        MENUITEM "&FTP naplók\tF1",               CM_HELPFORLOGSWND
    END
END

IDM_SERVERSOTHERACT MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Másolás ide...",                 CM_COPYSERVERTO
        MENUITEM "Át&nevezés...\tF2",              CM_RENAMESERVER
        MENUITEM "&Törlés...\tDelete",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "&Importálás fájlból...",        CM_IMPORTSERVER
        MENUITEM "E&xportálás fájlba...",          CM_EXPORTSERVER
    END
END

IDM_SERVERSACTIONS MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Ú&j...\tInsert",             IDB_NEWSERVER
        MENUITEM "Sz&erkesztés...",                    IDB_EDITSERVER
        MENUITEM "&Másolás ide...",                 CM_COPYSERVERTO
        MENUITEM "Á&tnevezés...\tF2",              CM_RENAMESERVER
        MENUITEM "Tö&rlés...\tDelete",          CM_REMOVESERVER
        MENUITEM SEPARATOR
        MENUITEM "&Fel\tAlt+Felfelé nyíl",      IDB_MOVESERVERUP
        MENUITEM "&Le\tAlt+Lefelé nyíl",  IDB_MOVESERVERDOWN
        MENUITEM SEPARATOR
        MENUITEM "&Importálás fájlból...",        CM_IMPORTSERVER
        MENUITEM "E&xportálás fájlba...",          CM_EXPORTSERVER
    END
END

IDM_SRVTYPEMOVECOLUMN MENU 
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Fel\tAlt+Felfelé nyíl",           CM_MOVECOLUMNUP
        MENUITEM "&Le\tAlt+Lefelé nyíl",       CM_MOVECOLUMNDOWN
    END
END

IDM_SRVTYPERULESMENU MENU 
BEGIN
    POPUP ""
    BEGIN
        POPUP "&Beszúrás"
        BEGIN
            MENUITEM "&Szabály elejére",              CM_STRM_RULESTART
            MENUITEM "Szabály végér&e",                CM_STRM_RULEEND
            MENUITEM "&Megjegyzés sor",               CM_STRM_COMMENT
            MENUITEM SEPARATOR
            POPUP "&Kihagyás"
            BEGIN
                MENUITEM "Térköz (ha van)",       CM_STRM_SKIPWSIFANY
                MENUITEM "Térköz (legalább egy)", CM_STRM_SKIPWS
                MENUITEM "Adott számú térköz", CM_STRM_SKIPNUMOFWS
                MENUITEM "Térköz és sorvégek (legalább egy)", CM_STRM_SKIPWSENDEOLS
                MENUITEM "Többi sor (legalább egy karakter)", CM_STRM_SKIPRESTOFLINE
                MENUITEM "Szó",                        CM_STRM_SKIPWORD
