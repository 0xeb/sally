// String tables

STRINGTABLE 
BEGIN
    IDS_COLUMN_COMMENTS     "Comentario"
    IDS_INFOLINE_SELECTION_PLURAL "{!}<%d> objeto{|1|s} seleccionado{1:0|1|s}"
    IDS_MENUITEM            "Red"
    IDS_REFRESHING          "Explorando la red…"
    IDS_NETWORK_UNAVAILABLE "La red no está disponible."
    IDS_ABOUT               "Acerca del Plugin"
    IDS_TSCLIENT            "%1 en %2"
    IDS_TSFOLDER            "Ordenador local"
    IDS_TSHOST              "Ordenador huésped"
    IDS_TSFOLDERCOMMENT     "Discos de %s"
END

STRINGTABLE 
BEGIN
    IDS_PLUGIN_NAME         "Red"
    IDS_DESCRIPTION         "Proporciona acceso a los ordenadores de la red."
