// Romanian (ro-RO) resources for nethood. Translation: Ioan Stefancu, Donca Radu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/nethood/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\nethood.rh2"

LANGUAGE LANG_ROMANIAN, SUBLANG_ROMANIAN_ROMANIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 22, 38, 220, 127
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configurare Retea"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Arata partajari &administrative",IDC_SYSSHARES,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,7,111,10
    CONTROL         "Arata partajari administrative ca obiecte asc&unse",IDC_HIDESYSSHARES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,22,176,10
    CONTROL         "Arata obiectele &My Network Places in directorul de sus",IDC_NETSHORTCUTS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,37,193,10
    CONTROL         "Arata retea &computere in directorul de sus",IDC_SHOWWORKGRP,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,52,154,10
    CONTROL         "Arata &disk-uri conectate prin Remote Desktop",IDC_SHOWTSC,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,67,165,10
    CONTROL         "&Scaneaza reteaua la pornirea Sally",IDC_PRELOAD,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,82,153,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,7,99,206,1
    DEFPUSHBUTTON   "OK",IDOK,30,106,50,14,WS_GROUP
    PUSHBUTTON      "Anuleaza",IDCANCEL,85,106,50,14
    PUSHBUTTON      "Help",IDHELP,140,106,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE 
BEGIN
    IDS_COLUMN_COMMENTS     "Comentariu"
    IDS_INFOLINE_SELECTION_PLURAL "{!}<%d> obiect selectat{|1|s}"
    IDS_MENUITEM            "Retea"
    IDS_REFRESHING          "Scaneaza reteaua…"
    IDS_NETWORK_UNAVAILABLE "Reteaua este indisponibila."
    IDS_ABOUT               "Despre Plugin"
    IDS_TSCLIENT            "%1 pe %2"
    IDS_TSFOLDER            "Computer Local"
    IDS_TSHOST              "Computer Gazda"
    IDS_TSFOLDERCOMMENT     "Disk-uri din %s"
END

STRINGTABLE 
BEGIN
    IDS_PLUGIN_NAME         "Retea"
    IDS_DESCRIPTION         "Da acces computerelor la retea."
END
