// Slovak (sk-SK) resources for nethood. Translation: Roman Paholík.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/nethood/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\nethood.rh2"

LANGUAGE LANG_SLOVAK, SUBLANG_SLOVAK_SLOVAKIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 22, 38, 232, 127
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Network - Konfigurácia"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Zobraziť &administračné zdieľania",IDC_SYSSHARES,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,7,122,10
    CONTROL         "Zobraziť administračné zdieľania ako s&kryté položky",IDC_HIDESYSSHARES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,22,185,10
    CONTROL         "Zobraziť položky z &Miesta v sieti na najvyššej úrovni adresára",IDC_NETSHORTCUTS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,37,216,10
    CONTROL         "Zobraziť sieťové počítače na &najvyššej úrovni adresára",IDC_SHOWWORKGRP,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,52,195,10
    CONTROL         "Zobraziť &disky pripojené cez Vzdialenú plochu",IDC_SHOWTSC,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,67,166,10
    CONTROL         "&Skenovať sieť pri spustení Sally",IDC_PRELOAD,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,82,166,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,7,99,218,1
    DEFPUSHBUTTON   "OK",IDOK,36,106,50,14,WS_GROUP
    PUSHBUTTON      "Zrušiť",IDCANCEL,91,106,50,14
    PUSHBUTTON      "Nápoveda",IDHELP,146,106,50,14
END

/////////////////////////////////////////////////////////////////////////////
// String tables

STRINGTABLE 
BEGIN
    IDS_COLUMN_COMMENTS     "Poznámka"
    IDS_INFOLINE_SELECTION_PLURAL "{!}<%d> vybran{ý objekt|1|é objekty|4|ých objektov}"
    IDS_MENUITEM            "Sieť"
    IDS_REFRESHING          "Skenujem sieť…"
    IDS_NETWORK_UNAVAILABLE "Sieť nie je dostupná."
    IDS_ABOUT               "O plugine"
    IDS_TSCLIENT            "%1 na %2"
    IDS_TSFOLDER            "Miestny počítač"
    IDS_TSHOST              "Vzdialený počítač"
    IDS_TSFOLDERCOMMENT     "Disky z %s"
END

STRINGTABLE 
BEGIN
    IDS_PLUGIN_NAME         "Sieť"
    IDS_DESCRIPTION         "Poskytuje prístup k počítačom na sieti."
END
