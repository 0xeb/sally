STRINGTABLE 
BEGIN
    IDS_COLUMN_COMMENTS     "Kommentar"
    IDS_INFOLINE_SELECTION_PLURAL "{!}<%d> ausgewählte{s|1|} Objekt{1:|1|e}"
    IDS_MENUITEM            "Netzwerk"
    IDS_REFRESHING          "Durchsuche Netzwerk…"
    IDS_NETWORK_UNAVAILABLE "Netzwerk ist nicht verfügbar."
    IDS_ABOUT               "Über Plugin"
    IDS_TSCLIENT            "%1 auf %2"
    IDS_TSFOLDER            "Lokaler Computer"
    IDS_TSHOST              "Host-Computer"
    IDS_TSFOLDERCOMMENT     "Laufwerke von %s"
END

STRINGTABLE 
BEGIN
