// German (de-DE) resources for nethood. Translation: Dirk Bornhütter, Thomas Kelso, Thomas Pagels, Thomas Wölk, Marko Meister und Mick Weiss.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/nethood/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\nethood.rh2"

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 22, 38, 245, 127
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Netzwerk - Konfiguration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "&Administrative Freigaben anzeigen",IDC_SYSSHARES,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,7,128,10
    CONTROL         "Administrative Freigaben als &versteckte Elemente anzeigen",IDC_HIDESYSSHARES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,22,209,10
    CONTROL         "Elemente der &Netzwerkumgebung im Stammverzeichnis anzeigen",IDC_NETSHORTCUTS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,37,232,10
    CONTROL         "Netzwerk&computer im Stammverzeichnis anzeigen",IDC_SHOWWORKGRP,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,52,180,10
    CONTROL         "&Laufwerke die über Remotedesktop verbunden sind anzeigen",IDC_SHOWTSC,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,67,218,10
    CONTROL         "Netzwerk beim &Start des Sally durchsuchen",IDC_PRELOAD,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,82,205,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,7,99,231,1
    DEFPUSHBUTTON   "OK",IDOK,42,106,50,14,WS_GROUP
    PUSHBUTTON      "Abbrechen",IDCANCEL,97,106,50,14
    PUSHBUTTON      "Hilfe",IDHELP,152,106,50,14
END

