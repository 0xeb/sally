STRINGTABLE 
BEGIN
    IDS_COLUMN_COMMENTS     "Commentaire"
    IDS_INFOLINE_SELECTION_PLURAL "{!}<%d> objet{|1|s} sélectionné(s)"
    IDS_MENUITEM            "Réseau"
    IDS_REFRESHING          "Analyse du réseau en cours…"
    IDS_NETWORK_UNAVAILABLE "Le réseau est indisponible."
    IDS_ABOUT               "A propos du module"
    IDS_TSCLIENT            "%1 sur %2"
    IDS_TSFOLDER            "Ordinateur local"
    IDS_TSHOST              "Ordinateur hôte"
    IDS_TSFOLDERCOMMENT     "Disques de %s"
END

STRINGTABLE 
BEGIN
    IDS_PLUGIN_NAME         "Réseau"
    IDS_DESCRIPTION         "Permet l'accès aux ordinateurs du réseau."
