// French (fr-FR) resources for nethood. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/nethood/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\nethood.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 22, 38, 240, 127
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration de réseau"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Montrer les &partages administratifs",IDC_SYSSHARES,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,7,129,10
    CONTROL         "Montrer les partages administratifs comme éléments &cachés",IDC_HIDESYSSHARES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,22,213,10
    CONTROL         "Montrer les éléments de Mes &Favoris Réseau de premier niveau",IDC_NETSHORTCUTS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,37,225,10
    CONTROL         "Montrer les &ordinateurs de premier niveau du réseau",IDC_SHOWWORKGRP,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,52,190,10
    CONTROL         "Montrer les &disques connectés via le Bureau distant",IDC_SHOWTSC,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,67,184,10
    CONTROL         "&Analyser le réseau au lancement de Sally",IDC_PRELOAD,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,82,174,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,7,99,226,1
    DEFPUSHBUTTON   "OK",IDOK,40,106,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,95,106,50,14
    PUSHBUTTON      "Aide",IDHELP,150,106,50,14
END

/////////////////////////////////////////////////////////////////////////////
