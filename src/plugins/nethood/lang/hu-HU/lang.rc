STRINGTABLE 
BEGIN
    IDS_COLUMN_COMMENTS     "Megjegyzés"
    IDS_INFOLINE_SELECTION_PLURAL "{!}<%d> kijelölt tárgy{|1|}"
    IDS_MENUITEM            "Hálózat"
    IDS_REFRESHING          "Hálózat vizsgálata…"
    IDS_NETWORK_UNAVAILABLE "A hálózat nem érhető el."
    IDS_ABOUT               "Plugin névjegy"
    IDS_TSCLIENT            "%1 / %2"
    IDS_TSFOLDER            "Helyi számítógép"
    IDS_TSHOST              "Gazda számítógép"
    IDS_TSFOLDERCOMMENT     "%s lemezei"
END

STRINGTABLE 
BEGIN
    IDS_PLUGIN_NAME         "Hálózat"
    IDS_DESCRIPTION         "Hozzáférést biztosít a hálózati számítógépekhez."
END
