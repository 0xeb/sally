// Korean (ko-KR) resources for nethood. Translation: Sally contributors (AI-assisted).
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/nethood/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\nethood.rh2"

LANGUAGE LANG_KOREAN, SUBLANG_KOREAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 22, 38, 220, 127
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "네트워크 설정"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "관리 공유 표시(&A)",IDC_SYSSHARES,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,7,106,10
    CONTROL         "관리 공유를 숨김 항목으로 표시(&H)",IDC_HIDESYSSHARES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,22,159,10
    CONTROL         "최상위 디렉터리에 내 네트워크 환경 항목 표시(&M)",IDC_NETSHORTCUTS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,37,204,10
    CONTROL         "최상위 디렉터리에 네트워크 컴퓨터 표시(&C)",IDC_SHOWWORKGRP,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,52,168,10
    CONTROL         "원격 데스크톱으로 연결된 디스크 표시(&D)",IDC_SHOWTSC,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,67,155,10
    CONTROL         "Sally 시작 시 네트워크 검색(&S)",IDC_PRELOAD,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,82,137,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,7,99,206,1
    DEFPUSHBUTTON   "확인",IDOK,30,106,50,14,WS_GROUP
    PUSHBUTTON      "취소",IDCANCEL,85,106,50,14
    PUSHBUTTON      "도움말",IDHELP,140,106,50,14
END

