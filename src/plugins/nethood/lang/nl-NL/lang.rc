// Dutch (nl-NL) resources for nethood. Translation: Cor van der Smissen, Marco Fung, Patrick Vijgeboom, S.V. (Stephan) Rietveld.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/nethood/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\nethood.rh2"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONFIG DIALOGEX 22, 38, 275, 127
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Network configuratie"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Toon &gedeelde netwerkmappen",IDC_SYSSHARES,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,7,7,153,10
    CONTROL         "Toon gedeelde netwerkmappen als &verborgen items",IDC_HIDESYSSHARES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,22,221,10
    CONTROL         "Toon items van &Mijn netwerklocaties op de hoofdmap",IDC_NETSHORTCUTS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,37,262,10
    CONTROL         "Toon &computers in het netwerk op de hoofdmap",IDC_SHOWWORKGRP,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,52,246,10
    CONTROL         "&Toon schijven aangesloten via extern bureaublad",IDC_SHOWTSC,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,67,177,10
    CONTROL         "&Scan het netwerk tijdens het opstarten van Sally",IDC_PRELOAD,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,82,200,10
    CONTROL         "",IDC_STATIC_1,"Static",SS_ETCHEDHORZ | WS_GROUP,7,99,261,1
    DEFPUSHBUTTON   "OK",IDOK,57,106,50,14,WS_GROUP
    PUSHBUTTON      "Annuleren",IDCANCEL,112,106,50,14
    PUSHBUTTON      "Help",IDHELP,167,106,50,14
END

