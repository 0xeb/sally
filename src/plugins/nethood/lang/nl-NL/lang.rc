    IDS_NETWORK_UNAVAILABLE "Netwerk is niet beschikbaar."
    IDS_ABOUT               "Over plugin"
    IDS_TSCLIENT            "%1 op %2"
    IDS_TSFOLDER            "Lokale computer"
    IDS_TSHOST              "Hostcomputer"
    IDS_TSFOLDERCOMMENT     "Schijven van %s"
