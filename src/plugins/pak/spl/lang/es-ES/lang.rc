// Spanish (es-ES) resources for pak. Translation: Juan Pablo Barrio Lera.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/pak/spl/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\pak.rh2"
#include "..\..\..\dll\texts.rh2"

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_OPTIMIZE DIALOGEX 15, 27, 219, 73
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Optimizar archivo PAK"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Tamaño datos válidos:",IDC_STATIC_1,8,9,78,8
    LTEXT           "",IDC_VALIDSIZE,87,9,120,8
    LTEXT           "Tamaño total ficheros:",IDC_STATIC_2,8,20,78,8
    LTEXT           "",IDC_TOTALSIZE,87,20,120,8
    LTEXT           "Espacio malgastado:",IDC_STATIC_3,8,31,71,8
    LTEXT           "",IDC_WASTEDSPACE,87,31,120,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,8,44,203,1
    DEFPUSHBUTTON   "Optimizar",IDOK,54,53,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,114,53,50,14
END

