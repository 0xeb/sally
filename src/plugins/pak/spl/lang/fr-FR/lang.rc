// French (fr-FR) resources for pak. Translation: Gérard Gréco, Arnaud Dupin de Beyssat, Jérémy Marc, Maxime Abbey.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/pak/spl/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\pak.rh2"
#include "..\..\..\dll\texts.rh2"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_OPTIMIZE DIALOGEX 15, 27, 234, 73
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Optimisation d'une archive PAK"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Taille des données valides:",IDC_STATIC_1,8,9,92,8
    LTEXT           "",IDC_VALIDSIZE,102,9,120,8
    LTEXT           "Taille totale du fichier:",IDC_STATIC_2,8,20,77,8
    LTEXT           "",IDC_TOTALSIZE,102,20,120,8
    LTEXT           "Espace perdu:",IDC_STATIC_3,8,31,51,8
    LTEXT           "",IDC_WASTEDSPACE,102,31,120,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,8,44,218,1
    DEFPUSHBUTTON   "Optimiser",IDOK,62,53,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,122,53,50,14
END

