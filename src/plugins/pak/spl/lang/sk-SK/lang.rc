// Slovak (sk-SK) resources for pak. Translation: Roman Paholík.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/pak/spl/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\pak.rh2"
#include "..\..\..\dll\texts.rh2"

LANGUAGE LANG_SLOVAK, SUBLANG_SLOVAK_SLOVAKIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_OPTIMIZE DIALOGEX 15, 27, 223, 73
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Optimalizácia PAK archívu"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Veľkosť platných dát:",IDC_STATIC_1,8,9,75,8
    LTEXT           "",IDC_VALIDSIZE,93,9,118,8
    LTEXT           "Celková veľkosť súboru:",IDC_STATIC_2,8,20,84,8
    LTEXT           "",IDC_TOTALSIZE,93,20,118,8
    LTEXT           "Prebytočné miesto:",IDC_STATIC_3,8,31,66,8
    LTEXT           "",IDC_WASTEDSPACE,93,31,118,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,8,44,207,1
    DEFPUSHBUTTON   "Optimalizovať",IDOK,48,53,60,14
    PUSHBUTTON      "Zrušiť",IDCANCEL,114,53,60,14
END

