// Romanian (ro-RO) resources for pak. Translation: Ioan Stefancu, Donca Radu.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/pak/spl/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\pak.rh2"
#include "..\..\..\dll\texts.rh2"

LANGUAGE LANG_ROMANIAN, SUBLANG_ROMANIAN_ROMANIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_OPTIMIZE DIALOGEX 15, 27, 212, 73
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Optimizeaza Arhiva PAK"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Marime valida data:",IDC_STATIC_1,8,9,69,8
    LTEXT           "",IDC_VALIDSIZE,82,9,118,8
    LTEXT           "Marimea totala fisier:",IDC_STATIC_2,8,20,73,8
    LTEXT           "",IDC_TOTALSIZE,82,20,118,8
    LTEXT           "Spatiu pierdut:",IDC_STATIC_3,8,31,53,8
    LTEXT           "",IDC_WASTEDSPACE,82,31,118,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,8,44,196,1
    DEFPUSHBUTTON   "Optimizeaza",IDOK,46,53,55,14
    PUSHBUTTON      "Anuleaza",IDCANCEL,111,53,55,14
END

