#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\pak.rh2"
#include "..\..\..\dll\texts.rh2"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_OPTIMIZE DIALOGEX 15, 27, 194, 73
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "优化 PAK 压缩包"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "有效数据大小:",IDC_STATIC_1,8,9,57,8
    LTEXT           "",IDC_VALIDSIZE,67,9,115,8
    LTEXT           "总文件大小:",IDC_STATIC_2,8,20,48,8
    LTEXT           "",IDC_TOTALSIZE,67,20,115,8
    LTEXT           "浪费空间:",IDC_STATIC_3,8,31,40,8
    LTEXT           "",IDC_WASTEDSPACE,67,31,115,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,8,44,178,1
    DEFPUSHBUTTON   "优化",IDOK,41,53,50,14
    PUSHBUTTON      "取消",IDCANCEL,101,53,50,14
END

