// German (de-DE) resources for pak. Translation: Dirk Bornhütter, Thomas Kelso, Thomas Pagels, Thomas Wölk, Marko Meister und Mick Weiss.
// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/pak/spl/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\pak.rh2"
#include "..\..\..\dll\texts.rh2"

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_OPTIMIZE DIALOGEX 15, 27, 216, 73
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "PAK Archiv optimieren"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Gültige Datengröße:",IDC_STATIC_1,8,9,77,8
    LTEXT           "",IDC_VALIDSIZE,86,9,118,8
    LTEXT           "Gesamte Dateigröße:",IDC_STATIC_2,8,20,77,8
    LTEXT           "",IDC_TOTALSIZE,86,20,118,8
    LTEXT           "Verschwendeter Platz:",IDC_STATIC_3,8,31,77,8
    LTEXT           "",IDC_WASTEDSPACE,86,31,118,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,8,44,200,1
    DEFPUSHBUTTON   "Optimieren",IDOK,53,53,50,14
    PUSHBUTTON      "Abbrechen",IDCANCEL,113,53,50,14
END

