// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/pak/spl/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\pak.rh2"
#include "..\..\..\dll\texts.rh2"

LANGUAGE LANG_HUNGARIAN, SUBLANG_HUNGARIAN_HUNGARY

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_OPTIMIZE DIALOGEX 15, 27, 211, 73
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "PAK archívum optimalizálása"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Érvényes adatméret:",IDC_STATIC_1,8,9,72,8
    LTEXT           "",IDC_VALIDSIZE,81,9,118,8
    LTEXT           "Teljes fájlméret:",IDC_STATIC_2,8,20,57,8
    LTEXT           "",IDC_TOTALSIZE,81,20,118,8
    LTEXT           "Pazarolt hely:",IDC_STATIC_3,8,31,50,8
    LTEXT           "",IDC_WASTEDSPACE,81,31,118,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,8,44,195,1
    DEFPUSHBUTTON   "Optimalizál",IDOK,50,53,50,14
    PUSHBUTTON      "Mégse",IDCANCEL,110,53,50,14
END

