LANGUAGE LANG_RUSSIAN, SUBLANG_RUSSIAN_RUSSIA

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_OPTIMIZE DIALOGEX 15, 27, 221, 73
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Оптимизация архива PAK"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Используемый объем:",IDC_STATIC_1,8,9,80,8
    LTEXT           "",IDC_VALIDSIZE,91,9,118,8
    LTEXT           "Общий размер файла:",IDC_STATIC_2,8,20,82,8
    LTEXT           "",IDC_TOTALSIZE,91,20,118,8
    LTEXT           "Избыточный объем:",IDC_STATIC_3,8,31,71,8
    LTEXT           "",IDC_WASTEDSPACE,91,31,118,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,8,44,205,1
    DEFPUSHBUTTON   "Оптимизировать",IDOK,45,53,70,14
    PUSHBUTTON      "Отмена",IDCANCEL,125,53,50,14
END

