// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/pak/spl/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\pak.rh2"
#include "..\..\..\dll\texts.rh2"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_OPTIMIZE DIALOGEX 15, 27, 222, 73
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Optimaliseren PAK archief"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Geldige gegevens grootte:",IDC_STATIC_1,8,9,91,8
    LTEXT           "",IDC_VALIDSIZE,101,9,109,8
    LTEXT           "Totale bestandsgrootte:",IDC_STATIC_2,8,20,82,8
    LTEXT           "",IDC_TOTALSIZE,101,20,109,8
    LTEXT           "Verspilde ruimte:",IDC_STATIC_3,8,31,70,8
    LTEXT           "",IDC_WASTEDSPACE,101,31,109,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,8,44,206,1
    DEFPUSHBUTTON   "Optimaliseren",IDOK,49,53,57,14
    PUSHBUTTON      "Annuleren",IDCANCEL,116,53,57,14
END

