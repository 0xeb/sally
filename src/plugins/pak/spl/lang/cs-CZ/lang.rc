// Translate by editing the text and, if needed, the size/position of controls; keep every ID,
// style and control in the same order as the English source (src/plugins/pak/spl/lang/lang.rc).

#pragma code_page(65001)

#include "..\lang.rh"
#include "winresrc.h"
#include "..\..\pak.rh2"
#include "..\..\..\dll\texts.rh2"

LANGUAGE LANG_CZECH, SUBLANG_CZECH_CZECH_REPUBLIC

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_OPTIMIZE DIALOGEX 15, 27, 225, 73
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Optimalizace PAK archivu"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Velikost platných dat:",IDC_STATIC_1,8,9,74,8
    LTEXT           "",IDC_VALIDSIZE,95,9,118,8
    LTEXT           "Celková velikost souboru:",IDC_STATIC_2,8,20,86,8
    LTEXT           "",IDC_TOTALSIZE,95,20,118,8
    LTEXT           "Nadbytečné místo:",IDC_STATIC_3,8,31,65,8
    LTEXT           "",IDC_WASTEDSPACE,95,31,118,8
    CONTROL         "",IDC_STATIC_4,"Static",SS_ETCHEDHORZ | WS_GROUP,8,44,209,1
    DEFPUSHBUTTON   "Optimalizovat",IDOK,52,53,55,14
    PUSHBUTTON      "Storno",IDCANCEL,117,53,55,14
END

