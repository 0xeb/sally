    LTEXT           "최소 너비(&W):",IDC_STATIC_4,7,57,52,8
    EDITTEXT        IDE_MINWIDTH,60,55,95,12,ES_AUTOHSCROLL
    LTEXT           "채울 문자(&F):",IDC_STATIC_5,7,73,52,8
    COMBOBOX        IDC_FILL,60,71,95,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "왼쪽 맞춤(&L)",IDC_LEFT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,90,49,12
    DEFPUSHBUTTON   "확인",IDOK,29,109,50,14
    PUSHBUTTON      "취소",IDCANCEL,83,109,50,14
END

IDD_DEFINESET DIALOGEX 9, 20, 269, 192
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "문자 집합 정의"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "집합에 포함할 문자(&S):",IDC_STATIC_1,7,7,67,8
    EDITTEXT        IDE_SET,7,17,255,12,ES_AUTOHSCROLL
    LTEXT           "힌트:\n\n문자 범위를 포함하려면 '-'를 사용합니다(예: A-Z).\n\n'-' 문자를 포함하려면 집합의 맨 앞이나 맨 뒤에 씁니다(예: -AZ).",IDC_STATIC_2,7,36,255,40
    LTEXT           "']' 문자를 포함하려면 집합의 맨 앞에 씁니다.\n\n긍정 문자 집합에 '^' 문자를 포함하려면 집합의 맨 앞이 아닌 곳에 씁니다.",IDC_STATIC_3,7,84,255,32
    LTEXT           "POSIX 문자 클래스를 포함하려면 [:class:]를 사용합니다. class는 alpha, alnum, ascii, blank, cntrl, digit, graph, lower, print, punct, space, upper, word, xdigit 중 하나입니다.\n\n백슬래시를 포함하려면 \\\\를 사용합니다.",IDC_STATIC_4,7,124,255,40
    DEFPUSHBUTTON   "확인",IDOK,82,171,50,14
    PUSHBUTTON      "취소",IDCANCEL,136,171,50,14
END

IDD_SUBEXPRESSION DIALOGEX 9, 20, 168, 78
