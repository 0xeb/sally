    DEFPUSHBUTTON   "확인",IDOK,53,67,50,14
    PUSHBUTTON      "취소",IDCANCEL,107,67,50,14
END

IDD_COUNTER DIALOGEX 9, 20, 162, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "카운터 추가"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "시작 값(&S):",IDC_STATIC_1,7,9,41,8
