    PUSHBUTTON      "Отмена",IDCANCEL,311,37,50,14
END

IDD_ERROR DIALOGEX 9, 20, 368, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ошибка командной строки"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Команда, возможно, выполнена с ошибкой.",IDC_STATIC_1,7,7,156,8
    LTEXT           "Командная строка:",IDC_STATIC_2,7,22,68,8
    EDITTEXT        IDE_COMMAND,75,22,286,8,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Код завершения:",IDC_STATIC_3,7,34,68,8
    LTEXT           "",IDS_EXITCODE,77,34,284,8
    LTEXT           "&Ошибка:",IDC_STATIC_4,7,46,33,8
    EDITTEXT        IDE_STDERR,7,56,354,176,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL
    DEFPUSHBUTTON   "Пропустить",IDOK,247,239,55,14
    PUSHBUTTON      "Отмена",IDCANCEL,306,239,55,14
END

IDD_CONFIG DIALOGEX 45, 31, 257, 160
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Дополнительные параметры переименования"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Настройка внешнего редактора для ручного режима:",IDC_STATIC_1,7,7,240,8
    LTEXT           "&Команда:",IDC_STATIC_2,14,21,52,8
