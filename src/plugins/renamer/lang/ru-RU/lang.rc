IDD_RENAME DIALOGEX 9, 20, 433, 260
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Групповое переименование"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDS_MENUSEP,"Static",SS_ETCHEDHORZ | WS_GROUP,0,0,433,1
    LTEXT           "&Маска:",IDC_STATIC_1,16,11,48,8
    COMBOBOX        IDC_MASK,66,9,160,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Вклю&чая вложенные папки",IDC_SUBDIRS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,239,10,107,12
    PUSHBUTTON      "Пе&реименовать",IDOK,351,9,75,14
    CONTROL         "Ручно&й режим",IDC_MANUAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,27,63,12
    CONTROL         "",IDS_MANSEP,"Static",SS_ETCHEDHORZ | WS_GROUP,71,32,356,1
    EDITTEXT        IDE_MANUAL,6,41,420,138,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "&Новое имя:",IDS_LABELNEWNAME,16,43,42,8
    COMBOBOX        IDC_NEWNAME,66,41,341,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_NEWNAME,414,41,12,12
    LTEXT           "Замена",IDS_LABELREPLACE,6,60,28,8
    CONTROL         "",IDS_REPLACESEP,"Static",SS_ETCHEDHORZ | WS_GROUP,36,64,391,1
    LTEXT           "И&скать:",IDS_LABELSEARCHFOR,16,77,29,8
    COMBOBOX        IDC_SEARCH,66,75,341,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_SEARCH,414,75,12,12
    LTEXT           "Замени&ть на:",IDS_LABELREPLACEWITH,16,94,49,8
    COMBOBOX        IDC_REPLACE,66,92,341,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_REPLACE,414,92,12,12
    CONTROL         "С &учетом регистра",IDC_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,66,109,76,12
    CONTROL         "Однокр&атно в каждом имени",IDC_GLOBAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,66,123,114,12
    CONTROL         "С&лова целиком",IDC_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,186,109,66,12
    CONTROL         "Регулярное выра&жение",IDC_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,186,123,95,12
    CONTROL         "Н&е обрабатывать расширение",IDC_EXCLUDEEXT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,289,109,119,12
    LTEXT           "Смена регистра",IDS_LABELCASE,6,139,58,8
    CONTROL         "",IDS_CHANGECASESEP,"Static",SS_ETCHEDHORZ | WS_GROUP,66,143,361,1
    LTEXT           "Им&я файла:",IDS_LABELNAME,16,155,44,8
    COMBOBOX        IDC_NAMECASE,66,153,100,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Рас&ширение:",IDS_LABELEXT,186,155,48,8
    COMBOBOX        IDC_EXTCASE,236,153,100,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Вкл&ючая путь",IDC_PATHPART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,66,170,62,12
    LTEXT           "Предпр&осмотр:",IDS_PREVIEW,6,182,56,8
    RTEXT           "",IDS_COUNT,100,182,326,8
    CONTROL         "",IDL_PREVIEW,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_OWNERDATA | WS_CLIPCHILDREN | WS_BORDER | WS_TABSTOP,0,192,433,68
END

IDD_CUT DIALOGEX 9, 20, 249, 88
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Добавить подстроку"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Подстрока от:",IDC_STATIC_1,7,9,55,8
    COMBOBOX        IDC_CUTFROM,85,7,90,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Начать с позиции",IDC_STATIC_2,7,28,65,8
    EDITTEXT        IDE_START,85,26,48,12,ES_AUTOHSCROLL
    LTEXT           "относительно",IDC_STATIC_3,141,28,50,8
    COMBOBOX        IDC_START,194,26,48,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Закончить в позиции",IDC_STATIC_4,7,47,77,8
    EDITTEXT        IDE_END,85,45,48,12,ES_AUTOHSCROLL
    LTEXT           "относительно",IDC_STATIC_5,141,47,50,8
    COMBOBOX        IDC_END,194,45,48,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "ОК",IDOK,72,67,50,14
    PUSHBUTTON      "Отмена",IDCANCEL,126,67,50,14
END

IDD_COUNTER DIALOGEX 9, 20, 167, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Добавить счетчик"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Начало:",IDC_STATIC_1,7,9,36,8
    EDITTEXT        IDE_START,70,7,90,12,ES_AUTOHSCROLL
    LTEXT           "Ш&аг:",IDC_STATIC_2,7,25,36,8
    EDITTEXT        IDE_STEP,70,23,90,12,ES_AUTOHSCROLL
    LTEXT           "&Основание:",IDC_STATIC_3,7,41,42,8
    COMBOBOX        IDC_BASE,70,39,90,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Миним. &ширина:",IDC_STATIC_4,7,57,62,8
    EDITTEXT        IDE_MINWIDTH,70,55,90,12,ES_AUTOHSCROLL
    LTEXT           "&Заполнить:",IDC_STATIC_5,7,73,61,8
    COMBOBOX        IDC_FILL,70,71,90,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "&Выравнивание по левому краю",IDC_LEFT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,90,122,12
    DEFPUSHBUTTON   "ОК",IDOK,31,109,50,14
    PUSHBUTTON      "Отмена",IDCANCEL,85,109,50,14
END

IDD_DEFINESET DIALOGEX 9, 20, 275, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Определение набора символов"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Набор символов:",IDC_STATIC_1,7,7,73,8
    EDITTEXT        IDE_SET,7,17,261,12,ES_AUTOHSCROLL
    LTEXT           "Советы:\n\nИспользуйте ""-"" (дефис) для указания набора символов (например A-Z).\n\nДля включения в набор символа ""-"", введите его в начале или конце (например -AZ).",IDC_STATIC_2,7,36,261,48
    LTEXT           "Для включения в набор символа ""]"", введите его в начале набора.\n\nДля включения в набор символов знака ""^"", введите его в любом месте, кроме начала набора.",IDC_STATIC_3,7,92,261,32
    LTEXT           "Для включения символьного класса POSIX используйте [:class:], где ""class"" один из: alpha, alnum, ascii, blank, cntrl, digit, graph, lower, print, punct, space, upper, word, xdigit.\n\nДля включения обратной косой черты, используйте \\\\.",IDC_STATIC_4,7,132,261,40
    DEFPUSHBUTTON   "ОК",IDOK,85,179,50,14
    PUSHBUTTON      "Отмена",IDCANCEL,139,179,50,14
END

IDD_SUBEXPRESSION DIALOGEX 9, 20, 249, 78
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Укажите подвыражение"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
