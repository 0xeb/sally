    COMBOBOX        IDC_NUMBER,91,7,151,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Совет: введите 0, чтобы задать все выражение целиком.",IDC_STATIC_2,7,23,205,8
    LTEXT           "&Регистр:",IDC_STATIC_3,7,37,32,8
    COMBOBOX        IDC_CASE,91,35,151,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "ОК",IDOK,72,57,50,14
    PUSHBUTTON      "Отмена",IDCANCEL,126,57,50,14
END

IDD_PROGRESS DIALOGEX 6, 15, 194, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Групповое переименование"
