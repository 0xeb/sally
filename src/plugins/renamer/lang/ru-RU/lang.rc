    PUSHBUTTON      "",IDB_BROWSE,237,19,13,12,WS_GROUP
    LTEXT           "&Параметры:",IDC_STATIC_3,14,37,52,8
    EDITTEXT        IDE_ARGUMENTS,70,35,164,12,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "",IDB_ARGHELP,237,35,13,12,WS_GROUP
    LTEXT           "Рабо&чая папка:",IDC_STATIC_4,14,53,55,8
    EDITTEXT        IDE_INITDIR,70,51,164,12,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "",IDB_INITDIRHELP,237,51,13,12,WS_GROUP
    LTEXT           "Шрифт в ручном режиме:",IDC_STATIC_5,7,74,94,8
    PUSHBUTTON      "&Изменить",IDB_FONT,14,84,50,14,WS_GROUP
    LTEXT           "Подтверждение:",IDC_STATIC_6,7,109,62,8
    CONTROL         "При &закрытии главного окна клавишей Esc.",IDC_CONFIRMESCCLOSE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,118,167,12
    CONTROL         "",IDC_STATIC_7,"Static",SS_ETCHEDHORZ | WS_GROUP,7,138,243,1
    DEFPUSHBUTTON   "ОК",IDOK,92,142,50,14,WS_GROUP
    PUSHBUTTON      "Отмена",IDCANCEL,146,142,50,14
    PUSHBUTTON      "Справка",IDHELP,200,142,50,14
END

