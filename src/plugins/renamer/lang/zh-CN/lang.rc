// Dialogs

IDD_RENAME DIALOGEX 9, 20, 368, 260
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "批量重命名"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDS_MENUSEP,"Static",SS_ETCHEDHORZ | WS_GROUP,0,0,368,1
    LTEXT           "掩码(&M):",IDC_STATIC_1,16,11,51,8
    COMBOBOX        IDC_MASK,70,9,95,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "包括子目录(&B)",IDC_SUBDIRS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,174,10,66,12
    PUSHBUTTON      "重命名(&R)",IDOK,301,9,60,14
    CONTROL         "手动模式(&L)",IDC_MANUAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,27,57,12
    CONTROL         "",IDS_MANSEP,"Static",SS_ETCHEDHORZ | WS_GROUP,65,32,297,1
    EDITTEXT        IDE_MANUAL,6,41,355,138,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "新名称(&N):",IDS_LABELNEWNAME,16,43,51,8
    COMBOBOX        IDC_NEWNAME,70,41,276,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_NEWNAME,349,41,12,12
    LTEXT           "替换",IDS_LABELREPLACE,6,60,20,8
    CONTROL         "",IDS_REPLACESEP,"Static",SS_ETCHEDHORZ | WS_GROUP,28,64,334,1
    LTEXT           "搜索(&S):",IDS_LABELSEARCHFOR,16,77,51,8
    COMBOBOX        IDC_SEARCH,70,75,276,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_SEARCH,349,75,12,12
    LTEXT           "替换为(&I):",IDS_LABELREPLACEWITH,16,94,51,8
    COMBOBOX        IDC_REPLACE,70,92,276,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_REPLACE,349,92,12,12
    CONTROL         "区分大小写(&T)",IDC_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,70,109,67,12
    CONTROL         "每个名称中仅一次(&Y)",IDC_GLOBAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,70,123,92,12
    CONTROL         "全词匹配(&W)",IDC_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,174,109,61,12
    CONTROL         "正则表达式(&G)",IDC_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,174,123,67,12
    CONTROL         "排除扩展名(&D)",IDC_EXCLUDEEXT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,274,109,67,12
    LTEXT           "更改大小写",IDS_LABELCASE,6,139,45,8
    CONTROL         "",IDS_CHANGECASESEP,"Static",SS_ETCHEDHORZ | WS_GROUP,53,143,309,1
    LTEXT           "文件名(&A):",IDS_LABELNAME,16,155,51,8
    COMBOBOX        IDC_NAMECASE,70,153,100,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "扩展名(&X):",IDS_LABELEXT,186,155,41,8
    COMBOBOX        IDC_EXTCASE,236,153,100,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "包括路径部分(&U)",IDC_PATHPART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,70,170,76,12
    LTEXT           "预览(&P):",IDS_PREVIEW,6,182,32,8
    RTEXT           "",IDS_COUNT,100,182,261,8
    CONTROL         "",IDL_PREVIEW,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_OWNERDATA | WS_CLIPCHILDREN | WS_BORDER | WS_TABSTOP,0,192,368,68
END

IDD_CUT DIALOGEX 9, 20, 210, 88
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "添加子字符串"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "子字符串(&S):",IDC_STATIC_1,7,9,50,8
    COMBOBOX        IDC_CUTFROM,64,7,90,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "开始位置(&A)",IDC_STATIC_2,7,28,50,8
    EDITTEXT        IDE_START,64,26,48,12,ES_AUTOHSCROLL
    LTEXT           "相对于",IDC_STATIC_3,121,28,28,8
    COMBOBOX        IDC_START,155,26,48,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "结束位置(&E)",IDC_STATIC_4,7,47,50,8
    EDITTEXT        IDE_END,64,45,48,12,ES_AUTOHSCROLL
    LTEXT           "相对于",IDC_STATIC_5,121,47,28,8
    COMBOBOX        IDC_END,155,45,48,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "确定",IDOK,53,67,50,14
    PUSHBUTTON      "取消",IDCANCEL,107,67,50,14
END

IDD_COUNTER DIALOGEX 9, 20, 162, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "添加计数器"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "开始于(&S):",IDC_STATIC_1,7,9,41,8
    EDITTEXT        IDE_START,60,7,95,12,ES_AUTOHSCROLL
    LTEXT           "步进(&E):",IDC_STATIC_2,7,25,32,8
    EDITTEXT        IDE_STEP,60,23,95,12,ES_AUTOHSCROLL
    LTEXT           "基数(&B):",IDC_STATIC_3,7,41,32,8
    COMBOBOX        IDC_BASE,60,39,95,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "最小宽度(&W):",IDC_STATIC_4,7,57,52,8
    EDITTEXT        IDE_MINWIDTH,60,55,95,12,ES_AUTOHSCROLL
    LTEXT           "填充用(&F):",IDC_STATIC_5,7,73,52,8
    COMBOBOX        IDC_FILL,60,71,95,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "左对齐(&L)",IDC_LEFT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,90,49,12
    DEFPUSHBUTTON   "确定",IDOK,29,109,50,14
    PUSHBUTTON      "取消",IDCANCEL,83,109,50,14
END

IDD_DEFINESET DIALOGEX 9, 20, 269, 192
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "定义字符集"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "集合中的字符(&S):",IDC_STATIC_1,7,7,67,8
    EDITTEXT        IDE_SET,7,17,255,12,ES_AUTOHSCROLL
    LTEXT           "提示:\n\n用 '-' 来包括一个字符范围(例如 A-Z)。\n\n要包括 '-' 字符，将它写在集合的开始或结尾(例如 -AZ)。",IDC_STATIC_2,7,36,255,40
    LTEXT           "要包括 ']' 字符，将它写在集合的开始或结尾。\n\n要在正字符集中包括 '^' 字符，将它写在除了集合开始或结尾以外的任意位置。",IDC_STATIC_3,7,84,255,32
    LTEXT           "要包括 POSIX 字符类，使用 [:class:]，类可以是 字母，字母数字，ascii，空白，cntrl，数字，图形，小写，打印，点状，空格，大写，单词，十六进制数字中的一个。\n\n要包括反斜杠，使用 \\\\.",IDC_STATIC_4,7,124,255,40
    DEFPUSHBUTTON   "确定",IDOK,82,171,50,14
    PUSHBUTTON      "取消",IDCANCEL,136,171,50,14
END

IDD_SUBEXPRESSION DIALOGEX 9, 20, 168, 78
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "指定子表达式"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "子表达式数(&S):",IDC_STATIC_1,7,9,58,8
    COMBOBOX        IDC_NUMBER,71,7,90,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "提示: 用 0 来指定整个匹配的表达式。",IDC_STATIC_2,7,23,154,8
    LTEXT           "大小写(&C):",IDC_STATIC_3,7,37,41,8
    COMBOBOX        IDC_CASE,71,35,90,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "确定",IDOK,32,57,50,14
    PUSHBUTTON      "取消",IDCANCEL,86,57,50,14
END

IDD_PROGRESS DIALOGEX 6, 15, 194, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "重命名器"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDS_MESSAGE,7,7,180,8
    LTEXT           "",IDS_PROGRESS,7,22,180,10,0,WS_EX_STATICEDGE
    DEFPUSHBUTTON   "取消",IDCANCEL,72,39,50,14
END

IDD_COMMAND DIALOGEX 9, 20, 368, 58
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "执行外壳命令"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "命令(&C):",IDC_STATIC_1,7,7,82,8
    COMBOBOX        IDC_COMMAND,7,17,354,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "确定",IDOK,257,37,50,14
    PUSHBUTTON      "取消",IDCANCEL,311,37,50,14
END

IDD_ERROR DIALOGEX 9, 20, 368, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "外壳命令错误"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "命令可能没有成功完成。",IDC_STATIC_1,7,7,218,8
    LTEXT           "命令行:",IDC_STATIC_2,7,22,40,8
    EDITTEXT        IDE_COMMAND,47,22,314,8,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "退出代码:",IDC_STATIC_3,7,34,40,8
    LTEXT           "",IDS_EXITCODE,49,34,312,8
    LTEXT           "标准错误(&S):",IDC_STATIC_4,7,46,82,8
    EDITTEXT        IDE_STDERR,7,56,354,176,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL
    DEFPUSHBUTTON   "忽略",IDOK,257,239,50,14
    PUSHBUTTON      "取消",IDCANCEL,311,239,50,14
END

IDD_CONFIG DIALOGEX 45, 31, 257, 160
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "重命名器高级选项"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "手动模式的外部编辑器设置:",IDC_STATIC_1,7,7,240,8
    LTEXT           "命令(&C):",IDC_STATIC_2,14,21,48,8
    EDITTEXT        IDE_COMMAND,63,19,171,12,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "",IDB_BROWSE,237,19,13,12,WS_GROUP
    LTEXT           "参数(&A):",IDC_STATIC_3,14,37,48,8
    EDITTEXT        IDE_ARGUMENTS,63,35,171,12,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "",IDB_ARGHELP,237,35,13,12,WS_GROUP
    LTEXT           "开始目录(&I):",IDC_STATIC_4,14,53,48,8
    EDITTEXT        IDE_INITDIR,63,51,171,12,ES_AUTOHSCROLL | WS_GROUP
    PUSHBUTTON      "",IDB_INITDIRHELP,237,51,13,12,WS_GROUP
    LTEXT           "手动模式字体:",IDC_STATIC_5,7,74,113,8
    PUSHBUTTON      "更改(&G)",IDB_FONT,14,84,50,14,WS_GROUP
    LTEXT           "确认:",IDC_STATIC_6,7,109,60,8
    CONTROL         "用 &ESC 键关闭主窗口。",IDC_CONFIRMESCCLOSE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,118,201,12
    CONTROL         "",IDC_STATIC_7,"Static",SS_ETCHEDHORZ | WS_GROUP,7,138,243,1
    DEFPUSHBUTTON   "确定",IDOK,92,142,50,14,WS_GROUP
    PUSHBUTTON      "取消",IDCANCEL,146,142,50,14
    PUSHBUTTON      "帮助",IDHELP,200,142,50,14
END

