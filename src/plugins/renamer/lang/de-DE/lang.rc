IDD_DEFINESET DIALOGEX 9, 20, 317, 192
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Zeichensatz definieren"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Im Satz enthaltene &Zeichen:",IDC_STATIC_1,7,7,98,8
    EDITTEXT        IDE_SET,7,17,303,12,ES_AUTOHSCROLL
    LTEXT           "Hinweise:\n\nUm einen Zeichenbereich einzufügen, benutzen Sie das '-' Zeichen (z.B. A-Z).\n\nUm das '-' Zeichen einzufügen, schreiben Sie es an den Anfang oder ans Ende (z.B. -AZ).",IDC_STATIC_2,7,36,303,40
    LTEXT           "Um das ']' Zeichen einzufügen, schreiben Sie es an den Anfang.\n\nUm das '^' Zeichen einzufügen, schreiben Sie es irgendwo in den Zeichensatz, aber nicht an den Anfang.",IDC_STATIC_3,7,84,303,32
    LTEXT           "Um eine POSIX Zeichenklasse einzufügen, benutzen Sie [:class:], wobei Class eine von Alpha, Alnum, Ascii, Blank, Cntrl, Ddigit, Graph, Lower, Print, Punct, Space, Upper, Word oder Xdigit ist.\n\nUm einen Backslash einzufügen, verwenden Sie \\\\.",IDC_STATIC_4,7,124,303,40
    DEFPUSHBUTTON   "OK",IDOK,106,171,50,14
    PUSHBUTTON      "Abbrechen",IDCANCEL,160,171,50,14
END

