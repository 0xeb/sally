    COMBOBOX        IDC_END,182,45,48,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,66,67,50,14
    PUSHBUTTON      "Abbrechen",IDCANCEL,120,67,50,14
END

