IDD_RENAME DIALOGEX 9, 20, 375, 260
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Stapel-Umbenennen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDS_MENUSEP,"Static",SS_ETCHEDHORZ | WS_GROUP,0,0,375,1
    LTEXT           "&Maske:",IDC_STATIC_1,16,11,51,8
    COMBOBOX        IDC_MASK,70,9,95,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Einschließlich &Unterverzeichnissen",IDC_SUBDIRS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,174,10,126,12
    PUSHBUTTON      "Um&benennen",IDOK,308,9,60,14
    CONTROL         "Manue&lle Methode",IDC_MANUAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,27,74,12
    CONTROL         "",IDS_MANSEP,"Static",SS_ETCHEDHORZ | WS_GROUP,82,32,287,1
    EDITTEXT        IDE_MANUAL,6,41,362,138,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "&Neuer Name:",IDS_LABELNEWNAME,16,43,51,8
    COMBOBOX        IDC_NEWNAME,70,41,283,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_NEWNAME,356,41,12,12
    LTEXT           "Ersetzen",IDS_LABELREPLACE,6,60,34,8
    CONTROL         "",IDS_REPLACESEP,"Static",SS_ETCHEDHORZ | WS_GROUP,37,64,332,1
    LTEXT           "&Suche nach:",IDS_LABELSEARCHFOR,16,77,51,8
    COMBOBOX        IDC_SEARCH,70,75,283,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_SEARCH,356,75,12,12
    LTEXT           "Erse&tzen mit:",IDS_LABELREPLACEWITH,16,94,51,8
    COMBOBOX        IDC_REPLACE,70,92,283,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_REPLACE,356,92,12,12
    CONTROL         "Groß-/&Kleinschreibung",IDC_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,70,109,87,12
    CONTROL         "Nur einmal in &jedem Namen",IDC_GLOBAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,70,123,107,12
    CONTROL         "Ganze &Worte",IDC_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,190,109,60,12
    CONTROL         "Re&gulärer Ausdruck",IDC_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,190,123,77,12
    CONTROL         "Ohne Erwe&iterung",IDC_EXCLUDEEXT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,283,109,74,12
    LTEXT           "Groß-/Kleinschreibung ändern",IDS_LABELCASE,6,139,104,8
    CONTROL         "",IDS_CHANGECASESEP,"Static",SS_ETCHEDHORZ | WS_GROUP,112,143,257,1
    LTEXT           "&Dateiname:",IDS_LABELNAME,16,155,51,8
    COMBOBOX        IDC_NAMECASE,70,153,100,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Erweiterung:",IDS_LABELEXT,190,155,46,8
    COMBOBOX        IDC_EXTCASE,243,153,100,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Einschließlich &Pfadnamen",IDC_PATHPART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,70,170,97,12
    LTEXT           "&Vorschau:",IDS_PREVIEW,6,182,51,8
    RTEXT           "",IDS_COUNT,100,182,268,8
    CONTROL         "",IDL_PREVIEW,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_OWNERDATA | WS_CLIPCHILDREN | WS_BORDER | WS_TABSTOP,0,192,375,68
END

IDD_CUT DIALOGEX 9, 20, 237, 88
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Teil einer Zeichenkette hinzufügen"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
