    DEFPUSHBUTTON   "OK",IDOK,30,109,50,14
    PUSHBUTTON      "Anuleaza",IDCANCEL,84,109,50,14
END

IDD_DEFINESET DIALOGEX 9, 20, 262, 192
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "DefinesteSetul de Caractere"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Caractere in &Set:",IDC_STATIC_1,7,7,65,8
    EDITTEXT        IDE_SET,7,17,248,12,ES_AUTOHSCROLL
    LTEXT           "Indicii:\n\nFoloseste '-' sa incluzi un interval de caractere (ex. A-Z).\n\nSa incluzi caracterul '-' scrie-l la inceputul sau la sfirsitul setului (ex. -AZ).",IDC_STATIC_2,7,36,248,40
    LTEXT           "Sa incluzi caracterul ']' scrie-l la inceputul setului.\n\nSa incluzi caracterul '^' in setul de caractere pozitive scrie-l oriunde dar nu la inceputul setului.",IDC_STATIC_3,7,84,248,32
    LTEXT           "Pentru a include un caracter din clasa POSIX foloseste [:class:], unde clasa e una din alpha, alnum, ascii, blank, cntrl, digit, graph, lower, print, punct, space, upper, word, xdigit.\n\nPentru a include backslash foloseste \\\\.",IDC_STATIC_4,7,124,248,40
    DEFPUSHBUTTON   "OK",IDOK,79,171,50,14
    PUSHBUTTON      "Anuleaza",IDCANCEL,133,171,50,14
END

IDD_SUBEXPRESSION DIALOGEX 9, 20, 207, 78
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
