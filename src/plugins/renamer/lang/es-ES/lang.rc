    LTEXT           "&Nuevo nombre:",IDS_LABELNEWNAME,16,43,55,8
    COMBOBOX        IDC_NEWNAME,72,41,274,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_NEWNAME,349,41,12,12
    LTEXT           "Sustituir",IDS_LABELREPLACE,6,60,30,8
    CONTROL         "",IDS_REPLACESEP,"Static",SS_ETCHEDHORZ | WS_GROUP,38,64,324,1
    LTEXT           "Bus&car:",IDS_LABELSEARCHFOR,16,77,51,8
    COMBOBOX        IDC_SEARCH,72,75,274,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_SEARCH,349,75,12,12
    LTEXT           "&Sustituir por:",IDS_LABELREPLACEWITH,16,94,51,8
    COMBOBOX        IDC_REPLACE,72,92,274,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_REPLACE,349,92,12,12
    CONTROL         "Distinguir &M/m",IDC_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,72,109,62,12
    CONTROL         "&Una vez en cada nombre",IDC_GLOBAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,72,123,96,12
    CONTROL         "&Palabras completas",IDC_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,176,109,78,12
    CONTROL         "Expresión re&gular",IDC_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,176,123,77,12
    CONTROL         "Exclu&ir extensión",IDC_EXCLUDEEXT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,276,109,71,12
    LTEXT           "Cambiar M/minúsculas",IDS_LABELCASE,6,139,78,8
    CONTROL         "",IDS_CHANGECASESEP,"Static",SS_ETCHEDHORZ | WS_GROUP,86,143,276,1
    LTEXT           "&Fichero:",IDS_LABELNAME,16,155,51,8
    COMBOBOX        IDC_NAMECASE,72,153,100,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "E&xtensión:",IDS_LABELEXT,186,155,38,8
    COMBOBOX        IDC_EXTCASE,236,153,100,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Incluir par&te de ruta",IDC_PATHPART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,72,170,92,12
    LTEXT           "Previsuali&zación:",IDS_PREVIEW,6,182,57,8
