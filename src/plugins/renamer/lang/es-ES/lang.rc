    LTEXT           "Pl&antilla:",IDC_STATIC_1,16,11,51,8
    COMBOBOX        IDC_MASK,72,9,95,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Inclui&r subdirectorios",IDC_SUBDIRS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,176,10,86,12
