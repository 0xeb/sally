IDD_DEFINESET DIALOGEX 9, 20, 262, 192
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Definir juego de caracteres"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Caracteres en el &juego:",IDC_STATIC_1,7,7,80,8
    EDITTEXT        IDE_SET,7,17,248,12,ES_AUTOHSCROLL
    LTEXT           "Ayuda:\n\nUse '-' para incluir un rango de caracteres (ej. A-Z).\n\nPara incluir el caracter '-' escríbalo al comienzo o final del juego (ej. -AZ).",IDC_STATIC_2,7,36,248,40
    LTEXT           "Para incluir el caracter ']' escríbalo al comienzo del juego.\n\nPara incluir el caracter '^' en el juego de caracteres positivo escríbalo en cualquier posición pero no al comienzo del juego.",IDC_STATIC_3,7,84,248,32
    LTEXT           "Para incluir una clase de caracteres POSIX use [:class:], donde class puede ser alpha, alnum, ascii, blank, cntrl, digit, graph, lower, print, punct, space, upper, word, xdigit.\n\nPara incluir la barra invertida use \\\\.",IDC_STATIC_4,7,124,248,40
    DEFPUSHBUTTON   "Aceptar",IDOK,79,171,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,133,171,50,14
END

IDD_SUBEXPRESSION DIALOGEX 9, 20, 209, 78
