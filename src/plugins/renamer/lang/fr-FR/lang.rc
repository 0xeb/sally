IDD_ERROR DIALOGEX 9, 20, 386, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Erreur lors de la commande Shell"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "La commande peut avoir échoué.",IDC_STATIC_1,7,7,218,8
    LTEXT           "Ligne de commande:",IDC_STATIC_2,7,22,74,8
    EDITTEXT        IDE_COMMAND,81,22,298,8,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Code de retour:",IDC_STATIC_3,7,34,74,8
    LTEXT           "",IDS_EXITCODE,83,34,296,8
    LTEXT           "&Sortie d'erreur:",IDC_STATIC_4,7,46,82,8
    EDITTEXT        IDE_STDERR,7,56,372,176,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL
    DEFPUSHBUTTON   "Ignorer",IDOK,275,239,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,329,239,50,14
END

IDD_CONFIG DIALOGEX 45, 31, 257, 160
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Options avancées du renommeur"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
