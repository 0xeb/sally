IDD_RENAME DIALOGEX 9, 20, 368, 260
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Renommer par lots"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDS_MENUSEP,"Static",SS_ETCHEDHORZ | WS_GROUP,0,0,368,1
    LTEXT           "Mas&que:",IDC_STATIC_1,16,11,51,8
    COMBOBOX        IDC_MASK,72,9,93,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Inclure les sous-&dossiers",IDC_SUBDIRS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,174,10,95,12
    PUSHBUTTON      "&Renommer",IDOK,301,9,60,14
    CONTROL         "Mode manue&l",IDC_MANUAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,27,58,12
    CONTROL         "",IDS_MANSEP,"Static",SS_ETCHEDHORZ | WS_GROUP,66,32,296,1
    EDITTEXT        IDE_MANUAL,6,41,355,138,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "Nou&veau nom:",IDS_LABELNEWNAME,16,43,51,8
    COMBOBOX        IDC_NEWNAME,72,41,274,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_NEWNAME,349,41,12,12
    LTEXT           "Remplacer",IDS_LABELREPLACE,6,60,38,8
    CONTROL         "",IDS_REPLACESEP,"Static",SS_ETCHEDHORZ | WS_GROUP,46,64,316,1
    LTEXT           "Rec&hercher:",IDS_LABELSEARCHFOR,16,77,51,8
    COMBOBOX        IDC_SEARCH,72,75,274,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_SEARCH,349,75,12,12
    LTEXT           "Re&mplacer par:",IDS_LABELREPLACEWITH,16,94,54,8
    COMBOBOX        IDC_REPLACE,72,92,274,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "",IDB_REPLACE,349,92,12,12
    CONTROL         "Sensi&ble à la casse",IDC_CASESENSITIVE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,72,109,76,12
    CONTROL         "Une se&ule fois par nom",IDC_GLOBAL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,72,123,92,12
    CONTROL         "Mot&s entiers",IDC_WHOLEWORDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,174,109,60,12
    CONTROL         "Expression ré&gulière",IDC_REGEXP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,174,123,80,12
    CONTROL         "&Inclure l'extension",IDC_EXCLUDEEXT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,274,109,73,12
    LTEXT           "Changer la casse",IDS_LABELCASE,6,139,59,8
    CONTROL         "",IDS_CHANGECASESEP,"Static",SS_ETCHEDHORZ | WS_GROUP,67,143,295,1
    LTEXT           "Nom du &fichier:",IDS_LABELNAME,16,155,55,8
    COMBOBOX        IDC_NAMECASE,72,153,100,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "E&xtension:",IDS_LABELEXT,186,155,38,8
    COMBOBOX        IDC_EXTCASE,236,153,100,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "I&nclure le chemin",IDC_PATHPART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,72,170,90,12
    LTEXT           "&Prévisualiser:",IDS_PREVIEW,6,182,51,8
    RTEXT           "",IDS_COUNT,100,182,261,8
    CONTROL         "",IDL_PREVIEW,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_OWNERDATA | WS_CLIPCHILDREN | WS_BORDER | WS_TABSTOP,0,192,368,68
END

IDD_CUT DIALOGEX 9, 20, 254, 88
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ajouter une sous-chaîne"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Sous-chaîne de:",IDC_STATIC_1,7,9,57,8
    COMBOBOX        IDC_CUTFROM,89,7,90,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Commencer en position",IDC_STATIC_2,7,28,81,8
    EDITTEXT        IDE_START,89,26,48,12,ES_AUTOHSCROLL
    LTEXT           "par rapport à",IDC_STATIC_3,146,28,47,8
    COMBOBOX        IDC_START,199,26,48,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Terminer en position",IDC_STATIC_4,7,47,72,8
    EDITTEXT        IDE_END,89,45,48,12,ES_AUTOHSCROLL
    LTEXT           "par rapport à",IDC_STATIC_5,146,47,47,8
    COMBOBOX        IDC_END,199,45,48,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,75,67,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,129,67,50,14
END

IDD_COUNTER DIALOGEX 9, 20, 174, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ajouter un compteur"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Commencer à:",IDC_STATIC_1,7,9,52,8
    EDITTEXT        IDE_START,72,7,95,12,ES_AUTOHSCROLL
    LTEXT           "&Pas:",IDC_STATIC_2,7,25,17,8
    EDITTEXT        IDE_STEP,72,23,95,12,ES_AUTOHSCROLL
    LTEXT           "&Base:",IDC_STATIC_3,7,41,21,8
    COMBOBOX        IDC_BASE,72,39,95,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Largeur &minimale:",IDC_STATIC_4,7,57,64,8
    EDITTEXT        IDE_MINWIDTH,72,55,95,12,ES_AUTOHSCROLL
    LTEXT           "Compléter a&vec:",IDC_STATIC_5,7,73,63,8
    COMBOBOX        IDC_FILL,72,71,95,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "&Aligner à gauche",IDC_LEFT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,90,76,12
    DEFPUSHBUTTON   "OK",IDOK,35,109,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,89,109,50,14
END

IDD_DEFINESET DIALOGEX 9, 20, 269, 192
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Définir un ensemble de caractères"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Saisissez les caractères de l'&ensemble:",IDC_STATIC_1,7,7,131,8
    EDITTEXT        IDE_SET,7,17,255,12,ES_AUTOHSCROLL
    LTEXT           "Astuce:\n\nUtilisez '-' afin de désigner une série de caractères (ex. A-Z).\n\nPour inclure le caractère '-' placez-le en premier (ex. -AZ).",IDC_STATIC_2,7,36,255,40
    LTEXT           "Pour inclure le caractère ']' placez-le en premier.\n\nPour inclure le caractère '^' dans l'ensemble, placez-le n'importe où sauf en première position.",IDC_STATIC_3,7,84,255,32
    LTEXT           "Pour inclure une classe de caractères POSIX utilisez [:classe:], en remplaçant ""classe"" par l'un des mots suivants: alpha, alnum, ascii, blank, cntrl, digit, graph, lower, print, punct, space, upper, word, xdigit.\n\nPour inclure des antislashs, utilisez \\\\.",IDC_STATIC_4,7,124,255,40
    DEFPUSHBUTTON   "OK",IDOK,82,171,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,136,171,50,14
END

IDD_SUBEXPRESSION DIALOGEX 9, 20, 203, 78
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Spécifier une sous-expression"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Numéro de sous-expression:",IDC_STATIC_1,7,9,98,8
    COMBOBOX        IDC_NUMBER,106,7,90,132,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Astuce: utilisez 0 pour spécifier une expression entière.",IDC_STATIC_2,7,23,187,8
    LTEXT           "&Casse:",IDC_STATIC_3,7,37,86,8
    COMBOBOX        IDC_CASE,106,35,90,132,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,49,57,50,14
    PUSHBUTTON      "Annuler",IDCANCEL,103,57,50,14
END

IDD_PROGRESS DIALOGEX 6, 15, 194, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Renommage"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
