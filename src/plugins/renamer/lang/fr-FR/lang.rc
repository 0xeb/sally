    PUSHBUTTON      "",IDB_INITDIRHELP,237,51,13,12,WS_GROUP
    LTEXT           "Police du mode manuel:",IDC_STATIC_5,7,74,113,8
    PUSHBUTTON      "Chan&ger",IDB_FONT,14,84,50,14,WS_GROUP
    LTEXT           "Confirmations:",IDC_STATIC_6,7,109,60,8
    CONTROL         "Fermeture de la fenêtre principale avec la touche &Echap.",IDC_CONFIRMESCCLOSE,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,14,118,204,12
    CONTROL         "",IDC_STATIC_7,"Static",SS_ETCHEDHORZ | WS_GROUP,7,138,243,1
    DEFPUSHBUTTON   "OK",IDOK,92,142,50,14,WS_GROUP
    PUSHBUTTON      "Annuler",IDCANCEL,146,142,50,14
    PUSHBUTTON      "Aide",IDHELP,200,142,50,14
END

