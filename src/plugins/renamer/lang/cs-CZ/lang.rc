IDD_DEFINESET DIALOGEX 9, 20, 257, 192
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Definování znakové sady"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Znaky v &sadě:",IDC_STATIC_1,7,7,65,8
    EDITTEXT        IDE_SET,7,17,243,12,ES_AUTOHSCROLL
    LTEXT           "Příklady:\n\nPoužijte '-' pro zahrnutí rozsahu znaků (např. A-Z).\n\nPro zahrnutí '-' napište znak na začátku nebo konci sady (např. -AZ).",IDC_STATIC_2,7,36,243,40
    LTEXT           "Pro zahrnutí ']' napište znak na začátku sady.\n\nPro zahrnutí '^' znaku v určité znakové sadě napište kdekoliv, ale ne na začátku sady.",IDC_STATIC_3,7,84,243,32
    LTEXT           "Pro zahrnutí POSIX znakové třídy použijte [:třída:], kde třída je jedním z alpha, alnum, ascii, blank, cntrl, digit, graph, lower, print, punct, space, upper, word, xdigit.\n\nPro zahrnutí opačného lomítka použijte \\\\.",IDC_STATIC_4,7,124,243,40
    DEFPUSHBUTTON   "OK",IDOK,76,171,50,14
    PUSHBUTTON      "Storno",IDCANCEL,130,171,50,14
END

