#ifdef APSTUDIO_INVOKED
#error this file is not editable by Microsoft Visual C++
#endif //APSTUDIO_INVOKED

#include "..\plugins\shared\spl_vers.h"
#include "salupdate.rh"
#include "winresrc.h"

// asInvoker matters: without it, Windows treats a 32-bit program named *update* as an
// installer and asks for administrator rights before it starts.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "manifest.xml"

1 VERSIONINFO
 FILEVERSION VERSINFO_SALAMANDER_MAJOR,VERSINFO_SALAMANDER_MINORA,VERSINFO_SALAMANDER_MINORB,VERSINFO_BUILDNUMBER
 PRODUCTVERSION VERSINFO_SALAMANDER_MAJOR,VERSINFO_SALAMANDER_MINORA,VERSINFO_SALAMANDER_MINORB,VERSINFO_BUILDNUMBER
 FILEFLAGSMASK 0x0L
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L  // VFT_APP=0x1
 FILESUBTYPE 0x0L
{
 BLOCK "StringFileInfo"
 {
  BLOCK "040904b0"
  {
   VALUE "CompanyName", "Sally\0"
   VALUE "FileDescription", "Sally Updater\0"
   VALUE "FileVersion", VERSINFO_SALAMANDER_VERSION "\0"
   VALUE "InternalName", "salupdate\0"
   VALUE "OriginalFilename", "salupdate.exe\0"
   VALUE "LegalCopyright", "Copyright \251 2026 Elias Bachaalany\0"
   VALUE "ProductVersion", VERSINFO_SALAMANDER_VERSION "\0"
   VALUE "ProductName", "Sally\0"
  }
 }
 BLOCK "VarFileInfo"
 {
  VALUE "Translation", 0x0409, 0x04b0
 }
}

// The messages, in every built-in language; after the version block, whose © must stay a
// single-byte escape.
#pragma code_page(65001)
#include "texts.rc2"
