//
// The updater's messages in Sally's built-in languages (UTF-8; included after
// #pragma code_page(65001)). Keep every language's ids identical to English.

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
{
 IDS_UPDATER_TITLE, "Sally Update"
 IDS_UPDATER_USAGE, "To update Sally from a downloaded release, open its .zip file with this program, or drop the .zip file onto it:\n\nsalupdate.exe Sally-v<version>-<processor>.zip [--yes]\n\n--yes answers every question with Yes and runs without messages, except errors. The release's SHA256SUMS file, when it lies next to the .zip file, is used to check it."
 IDS_UPDATER_NOT_IN_SALLY, "This updater is not in a Sally folder:\n%s\n\nRun the salupdate.exe in Sally's utils folder, or name the Sally folder with --install <folder>."
 IDS_UPDATER_BAD_PACKAGE, "%s cannot be installed:\n%s"
 IDS_UPDATER_CHECKSUM_MISMATCH, "%s does not match its SHA-256 checksum in %s.\n\nThe file is damaged or not the published one. It was not installed."
 IDS_UPDATER_UNVERIFIED, "No SHA-256 checksum for %s was found next to it (the release's Sally-v...-SHA256SUMS.txt), so it cannot be checked against the published release.\n\nInstall it anyway?"
 IDS_UPDATER_CONFIRM_NEWER, "Install Sally %s from %s?\n\nThe installed version is %s."
 IDS_UPDATER_CONFIRM_SAME, "Sally %s is already installed. Install it again from %s?"
 IDS_UPDATER_CONFIRM_OLDER, "%s holds Sally %s, which is older than the installed %s.\n\nInstall the older version?"
 IDS_UPDATER_WILL_CLOSE, "Sally is running (windows: %d). It will close, and start again after the update."
 IDS_UPDATER_OTHERS_RUNNING, "Close these programs started from the Sally folder, then try again:\n%s"
 IDS_UPDATER_DONE, "Sally was updated from %s to %s."
 IDS_UPDATER_FAILED, "The update to %s failed and nothing was changed:\n%s"
 IDS_UPDATER_INCOMPLETE, "The update to %s failed and some files could not be restored:\n%s\n\nPlease unpack the release into the Sally folder again."
 IDS_UPDATER_ABORTED, "The update to %s did not take place because Sally did not close."
 IDS_UPDATER_RECOVERED, "An update that was interrupted was found and undone; Sally is as it was before."
 IDS_UPDATER_RECOVER_FAILED, "An interrupted update could not be undone:\n%s\n\nPlease unpack the release into the Sally folder again."
 IDS_UPDATER_WRONG_PROCESSOR, "%s is a Sally for another processor than the installed one. It was not installed."
 IDS_UPDATER_CHECKING, "Checking GitHub for a newer Sally release..."
 IDS_UPDATER_NEWER, "A newer Sally release is available."
 IDS_UPDATER_LATEST, "You have the latest Sally release."
 IDS_UPDATER_INSTALLED_VERSION, "Installed version: %s"
 IDS_UPDATER_RELEASE_VERSION, "Latest release: %s"
 IDS_UPDATER_CHECK_FAILED, "Sally could not check for updates: %s"
 IDS_UPDATER_BAD_FEED, "GitHub did not answer with a Sally release (%s)."
 IDS_UPDATER_NOT_INSTALLABLE, "This release cannot be installed from here. Download it from its release page."
 IDS_UPDATER_DOWNLOADING, "Downloading %s..."
 IDS_UPDATER_VERIFYING, "Checking the download against the release's SHA-256 checksum..."
 IDS_UPDATER_PREPARING, "Unpacking Sally %s..."
 IDS_UPDATER_CONFIRM_INSTALL, "Sally will close, install version %s and start again.\n\nDo you want to continue?"
 IDS_UPDATER_CONFIRM_INSTALL_OTHERS, "Sally will close, install version %s and start again.\nOther Sally windows started from the same folder will close too: %d.\n\nDo you want to continue?"
 IDS_UPDATER_STOPPED, "The update stopped: %s"
 IDS_UPDATER_NO_CHECKSUM, "The release publishes no SHA-256 checksum for %s."
 IDS_UPDATER_DOWNLOAD_MISMATCH, "The download does not match the SHA-256 checksum published with the release."
 IDS_UPDATER_DOWNLOAD_INCOMPLETE, "The download is incomplete."
 IDS_UPDATER_INSTALL_BUTTON, "&Install and Restart"
 IDS_UPDATER_RELEASE_PAGE_BUTTON, "Open the &release page"
 IDS_UPDATER_CLOSE_BUTTON, "C&lose"
 IDS_UPDATER_NOTES_LABEL, "What's new:"
}

LANGUAGE LANG_CZECH, SUBLANG_DEFAULT
STRINGTABLE
{
 IDS_UPDATER_TITLE, "Aktualizace Sally"
 IDS_UPDATER_USAGE, "Chcete-li aktualizovat Sally ze staženého vydání, otevřete jeho soubor .zip tímto programem nebo jej na program přetáhněte:\n\nsalupdate.exe Sally-v<verze>-<procesor>.zip [--yes]\n\n--yes odpoví na všechny otázky Ano a kromě chyb nic nehlásí. Soubor SHA256SUMS vydání, pokud leží vedle souboru .zip, slouží k jeho kontrole."
 IDS_UPDATER_NOT_IN_SALLY, "Tento aktualizační program není ve složce Sally:\n%s\n\nSpusťte salupdate.exe ze složky utils programu Sally, nebo složku Sally zadejte pomocí --install <složka>."
 IDS_UPDATER_BAD_PACKAGE, "%s nelze nainstalovat:\n%s"
 IDS_UPDATER_CHECKSUM_MISMATCH, "%s neodpovídá svému kontrolnímu součtu SHA-256 v %s.\n\nSoubor je poškozený nebo to není zveřejněný soubor. Nebyl nainstalován."
 IDS_UPDATER_UNVERIFIED, "Vedle souboru %s nebyl nalezen jeho kontrolní součet SHA-256 (Sally-v...-SHA256SUMS.txt z vydání), takže jej nelze ověřit proti zveřejněnému vydání.\n\nPřesto nainstalovat?"
 IDS_UPDATER_CONFIRM_NEWER, "Nainstalovat Sally %s ze souboru %s?\n\nNainstalovaná verze je %s."
 IDS_UPDATER_CONFIRM_SAME, "Sally %s je již nainstalována. Nainstalovat ji znovu ze souboru %s?"
 IDS_UPDATER_CONFIRM_OLDER, "%s obsahuje Sally %s, která je starší než nainstalovaná %s.\n\nNainstalovat starší verzi?"
 IDS_UPDATER_WILL_CLOSE, "Sally běží (oken: %d). Zavře se a po aktualizaci se znovu spustí."
 IDS_UPDATER_OTHERS_RUNNING, "Zavřete tyto programy spuštěné ze složky Sally a zkuste to znovu:\n%s"
 IDS_UPDATER_DONE, "Sally byla aktualizována z verze %s na %s."
 IDS_UPDATER_FAILED, "Aktualizace na %s selhala a nic nebylo změněno:\n%s"
 IDS_UPDATER_INCOMPLETE, "Aktualizace na %s selhala a některé soubory se nepodařilo obnovit:\n%s\n\nRozbalte prosím vydání do složky Sally znovu."
 IDS_UPDATER_ABORTED, "Aktualizace na %s neproběhla, protože se Sally nezavřela."
 IDS_UPDATER_RECOVERED, "Byla nalezena přerušená aktualizace a vrácena zpět; Sally je jako dříve."
 IDS_UPDATER_RECOVER_FAILED, "Přerušenou aktualizaci se nepodařilo vrátit zpět:\n%s\n\nRozbalte prosím vydání do složky Sally znovu."
 IDS_UPDATER_WRONG_PROCESSOR, "%s je Sally pro jiný procesor než ta nainstalovaná. Nebyla nainstalována."
 IDS_UPDATER_CHECKING, "Hledá se novější vydání Sally na GitHubu..."
 IDS_UPDATER_NEWER, "Je k dispozici novější vydání Sally."
 IDS_UPDATER_LATEST, "Máte nejnovější vydání Sally."
 IDS_UPDATER_INSTALLED_VERSION, "Nainstalovaná verze: %s"
 IDS_UPDATER_RELEASE_VERSION, "Nejnovější vydání: %s"
 IDS_UPDATER_CHECK_FAILED, "Sally nemohla zjistit, zda jsou k dispozici aktualizace: %s"
 IDS_UPDATER_BAD_FEED, "GitHub neodpověděl vydáním Sally (%s)."
 IDS_UPDATER_NOT_INSTALLABLE, "Toto vydání nelze nainstalovat odsud. Stáhněte jej ze stránky vydání."
 IDS_UPDATER_DOWNLOADING, "Stahuje se %s..."
 IDS_UPDATER_VERIFYING, "Kontroluje se stažený soubor proti kontrolnímu součtu SHA-256 vydání..."
 IDS_UPDATER_PREPARING, "Rozbaluje se Sally %s..."
 IDS_UPDATER_CONFIRM_INSTALL, "Sally se zavře, nainstaluje verzi %s a znovu se spustí.\n\nChcete pokračovat?"
 IDS_UPDATER_CONFIRM_INSTALL_OTHERS, "Sally se zavře, nainstaluje verzi %s a znovu se spustí.\nZavřou se i další okna Sally spuštěná ze stejné složky: %d.\n\nChcete pokračovat?"
 IDS_UPDATER_STOPPED, "Aktualizace byla zastavena: %s"
 IDS_UPDATER_NO_CHECKSUM, "Vydání nezveřejňuje kontrolní součet SHA-256 pro %s."
 IDS_UPDATER_DOWNLOAD_MISMATCH, "Stažený soubor neodpovídá kontrolnímu součtu SHA-256 zveřejněnému s vydáním."
 IDS_UPDATER_DOWNLOAD_INCOMPLETE, "Stažený soubor je neúplný."
 IDS_UPDATER_INSTALL_BUTTON, "&Nainstalovat a restartovat"
 IDS_UPDATER_RELEASE_PAGE_BUTTON, "Otevřít &stránku vydání"
 IDS_UPDATER_CLOSE_BUTTON, "&Zavřít"
 IDS_UPDATER_NOTES_LABEL, "Novinky:"
}

LANGUAGE LANG_SLOVAK, SUBLANG_DEFAULT
STRINGTABLE
{
 IDS_UPDATER_TITLE, "Aktualizácia Sally"
 IDS_UPDATER_USAGE, "Ak chcete aktualizovať Sally zo stiahnutého vydania, otvorte jeho súbor .zip týmto programom alebo ho na program pretiahnite:\n\nsalupdate.exe Sally-v<verzia>-<procesor>.zip [--yes]\n\n--yes odpovie na všetky otázky Áno a okrem chýb nič nehlási. Súbor SHA256SUMS vydania, ak leží vedľa súboru .zip, slúži na jeho kontrolu."
 IDS_UPDATER_NOT_IN_SALLY, "Tento aktualizačný program nie je v priečinku Sally:\n%s\n\nSpustite salupdate.exe z priečinka utils programu Sally, alebo priečinok Sally zadajte pomocou --install <priečinok>."
 IDS_UPDATER_BAD_PACKAGE, "%s nemožno nainštalovať:\n%s"
 IDS_UPDATER_CHECKSUM_MISMATCH, "%s nezodpovedá svojmu kontrolnému súčtu SHA-256 v %s.\n\nSúbor je poškodený alebo to nie je zverejnený súbor. Nebol nainštalovaný."
 IDS_UPDATER_UNVERIFIED, "Vedľa súboru %s sa nenašiel jeho kontrolný súčet SHA-256 (Sally-v...-SHA256SUMS.txt z vydania), takže ho nemožno overiť voči zverejnenému vydaniu.\n\nNapriek tomu nainštalovať?"
 IDS_UPDATER_CONFIRM_NEWER, "Nainštalovať Sally %s zo súboru %s?\n\nNainštalovaná verzia je %s."
 IDS_UPDATER_CONFIRM_SAME, "Sally %s je už nainštalovaná. Nainštalovať ju znova zo súboru %s?"
 IDS_UPDATER_CONFIRM_OLDER, "%s obsahuje Sally %s, ktorá je staršia ako nainštalovaná %s.\n\nNainštalovať staršiu verziu?"
 IDS_UPDATER_WILL_CLOSE, "Sally beží (okien: %d). Zatvorí sa a po aktualizácii sa znova spustí."
 IDS_UPDATER_OTHERS_RUNNING, "Zatvorte tieto programy spustené z priečinka Sally a skúste to znova:\n%s"
 IDS_UPDATER_DONE, "Sally bola aktualizovaná z verzie %s na %s."
 IDS_UPDATER_FAILED, "Aktualizácia na %s zlyhala a nič sa nezmenilo:\n%s"
 IDS_UPDATER_INCOMPLETE, "Aktualizácia na %s zlyhala a niektoré súbory sa nepodarilo obnoviť:\n%s\n\nRozbaľte prosím vydanie do priečinka Sally znova."
 IDS_UPDATER_ABORTED, "Aktualizácia na %s neprebehla, pretože sa Sally nezatvorila."
 IDS_UPDATER_RECOVERED, "Našla sa prerušená aktualizácia a bola vrátená späť; Sally je ako predtým."
 IDS_UPDATER_RECOVER_FAILED, "Prerušenú aktualizáciu sa nepodarilo vrátiť späť:\n%s\n\nRozbaľte prosím vydanie do priečinka Sally znova."
 IDS_UPDATER_WRONG_PROCESSOR, "%s je Sally pre iný procesor ako tá nainštalovaná. Nebola nainštalovaná."
 IDS_UPDATER_CHECKING, "Hľadá sa novšie vydanie Sally na GitHube..."
 IDS_UPDATER_NEWER, "Je k dispozícii novšie vydanie Sally."
 IDS_UPDATER_LATEST, "Máte najnovšie vydanie Sally."
 IDS_UPDATER_INSTALLED_VERSION, "Nainštalovaná verzia: %s"
 IDS_UPDATER_RELEASE_VERSION, "Najnovšie vydanie: %s"
 IDS_UPDATER_CHECK_FAILED, "Sally nemohla zistiť, či sú k dispozícii aktualizácie: %s"
 IDS_UPDATER_BAD_FEED, "GitHub neodpovedal vydaním Sally (%s)."
 IDS_UPDATER_NOT_INSTALLABLE, "Toto vydanie nemožno nainštalovať odtiaľto. Stiahnite ho zo stránky vydania."
 IDS_UPDATER_DOWNLOADING, "Sťahuje sa %s..."
 IDS_UPDATER_VERIFYING, "Kontroluje sa stiahnutý súbor voči kontrolnému súčtu SHA-256 vydania..."
 IDS_UPDATER_PREPARING, "Rozbaľuje sa Sally %s..."
 IDS_UPDATER_CONFIRM_INSTALL, "Sally sa zatvorí, nainštaluje verziu %s a znova sa spustí.\n\nChcete pokračovať?"
 IDS_UPDATER_CONFIRM_INSTALL_OTHERS, "Sally sa zatvorí, nainštaluje verziu %s a znova sa spustí.\nZatvoria sa aj ďalšie okná Sally spustené z rovnakého priečinka: %d.\n\nChcete pokračovať?"
 IDS_UPDATER_STOPPED, "Aktualizácia bola zastavená: %s"
 IDS_UPDATER_NO_CHECKSUM, "Vydanie nezverejňuje kontrolný súčet SHA-256 pre %s."
 IDS_UPDATER_DOWNLOAD_MISMATCH, "Stiahnutý súbor nezodpovedá kontrolnému súčtu SHA-256 zverejnenému s vydaním."
 IDS_UPDATER_DOWNLOAD_INCOMPLETE, "Stiahnutý súbor je neúplný."
 IDS_UPDATER_INSTALL_BUTTON, "&Nainštalovať a reštartovať"
 IDS_UPDATER_RELEASE_PAGE_BUTTON, "Otvoriť &stránku vydania"
 IDS_UPDATER_CLOSE_BUTTON, "&Zatvoriť"
 IDS_UPDATER_NOTES_LABEL, "Novinky:"
}

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN
STRINGTABLE
{
 IDS_UPDATER_TITLE, "Sally-Aktualisierung"
 IDS_UPDATER_USAGE, "Um Sally aus einer heruntergeladenen Version zu aktualisieren, öffnen Sie deren .zip-Datei mit diesem Programm oder ziehen Sie sie darauf:\n\nsalupdate.exe Sally-v<Version>-<Prozessor>.zip [--yes]\n\n--yes beantwortet jede Frage mit Ja und meldet außer Fehlern nichts. Die SHA256SUMS-Datei der Version wird zur Prüfung verwendet, wenn sie neben der .zip-Datei liegt."
 IDS_UPDATER_NOT_IN_SALLY, "Dieses Aktualisierungsprogramm liegt nicht in einem Sally-Ordner:\n%s\n\nStarten Sie die salupdate.exe im utils-Ordner von Sally, oder geben Sie den Sally-Ordner mit --install <Ordner> an."
 IDS_UPDATER_BAD_PACKAGE, "%s kann nicht installiert werden:\n%s"
 IDS_UPDATER_CHECKSUM_MISMATCH, "%s stimmt nicht mit seiner SHA-256-Prüfsumme in %s überein.\n\nDie Datei ist beschädigt oder nicht die veröffentlichte. Sie wurde nicht installiert."
 IDS_UPDATER_UNVERIFIED, "Neben %s wurde keine SHA-256-Prüfsumme gefunden (die Sally-v...-SHA256SUMS.txt der Version), daher kann die Datei nicht mit der veröffentlichten Version verglichen werden.\n\nTrotzdem installieren?"
 IDS_UPDATER_CONFIRM_NEWER, "Sally %s aus %s installieren?\n\nDie installierte Version ist %s."
 IDS_UPDATER_CONFIRM_SAME, "Sally %s ist bereits installiert. Erneut aus %s installieren?"
 IDS_UPDATER_CONFIRM_OLDER, "%s enthält Sally %s, die älter ist als die installierte %s.\n\nDie ältere Version installieren?"
 IDS_UPDATER_WILL_CLOSE, "Sally läuft (Fenster: %d). Sally wird geschlossen und nach der Aktualisierung neu gestartet."
 IDS_UPDATER_OTHERS_RUNNING, "Schließen Sie diese Programme aus dem Sally-Ordner und versuchen Sie es erneut:\n%s"
 IDS_UPDATER_DONE, "Sally wurde von %s auf %s aktualisiert."
 IDS_UPDATER_FAILED, "Die Aktualisierung auf %s ist fehlgeschlagen; es wurde nichts geändert:\n%s"
 IDS_UPDATER_INCOMPLETE, "Die Aktualisierung auf %s ist fehlgeschlagen und einige Dateien konnten nicht wiederhergestellt werden:\n%s\n\nBitte entpacken Sie die Version erneut in den Sally-Ordner."
 IDS_UPDATER_ABORTED, "Die Aktualisierung auf %s fand nicht statt, weil Sally nicht geschlossen wurde."
 IDS_UPDATER_RECOVERED, "Eine unterbrochene Aktualisierung wurde gefunden und rückgängig gemacht; Sally ist wie zuvor."
 IDS_UPDATER_RECOVER_FAILED, "Eine unterbrochene Aktualisierung konnte nicht rückgängig gemacht werden:\n%s\n\nBitte entpacken Sie die Version erneut in den Sally-Ordner."
 IDS_UPDATER_WRONG_PROCESSOR, "%s ist eine Sally für einen anderen Prozessor als die installierte. Sie wurde nicht installiert."
 IDS_UPDATER_CHECKING, "Auf GitHub wird nach einer neueren Sally-Version gesucht..."
 IDS_UPDATER_NEWER, "Eine neuere Sally-Version ist verfügbar."
 IDS_UPDATER_LATEST, "Sie haben die neueste Sally-Version."
 IDS_UPDATER_INSTALLED_VERSION, "Installierte Version: %s"
 IDS_UPDATER_RELEASE_VERSION, "Neueste Version: %s"
 IDS_UPDATER_CHECK_FAILED, "Sally konnte nicht nach Updates suchen: %s"
 IDS_UPDATER_BAD_FEED, "GitHub hat nicht mit einer Sally-Version geantwortet (%s)."
 IDS_UPDATER_NOT_INSTALLABLE, "Diese Version kann nicht von hier installiert werden. Laden Sie sie von ihrer Release-Seite herunter."
 IDS_UPDATER_DOWNLOADING, "%s wird heruntergeladen..."
 IDS_UPDATER_VERIFYING, "Der Download wird mit der SHA-256-Prüfsumme der Version verglichen..."
 IDS_UPDATER_PREPARING, "Sally %s wird entpackt..."
 IDS_UPDATER_CONFIRM_INSTALL, "Sally wird geschlossen, installiert Version %s und startet neu.\n\nMöchten Sie fortfahren?"
 IDS_UPDATER_CONFIRM_INSTALL_OTHERS, "Sally wird geschlossen, installiert Version %s und startet neu.\nWeitere Sally-Fenster aus demselben Ordner werden ebenfalls geschlossen: %d.\n\nMöchten Sie fortfahren?"
 IDS_UPDATER_STOPPED, "Die Aktualisierung wurde abgebrochen: %s"
 IDS_UPDATER_NO_CHECKSUM, "Die Version veröffentlicht keine SHA-256-Prüfsumme für %s."
 IDS_UPDATER_DOWNLOAD_MISMATCH, "Der Download stimmt nicht mit der veröffentlichten SHA-256-Prüfsumme der Version überein."
 IDS_UPDATER_DOWNLOAD_INCOMPLETE, "Der Download ist unvollständig."
 IDS_UPDATER_INSTALL_BUTTON, "&Installieren und neu starten"
 IDS_UPDATER_RELEASE_PAGE_BUTTON, "&Release-Seite öffnen"
 IDS_UPDATER_CLOSE_BUTTON, "&Schließen"
 IDS_UPDATER_NOTES_LABEL, "Neuigkeiten:"
}

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH
STRINGTABLE
{
 IDS_UPDATER_TITLE, "Mise à jour de Sally"
 IDS_UPDATER_USAGE, "Pour mettre Sally à jour à partir d'une version téléchargée, ouvrez son fichier .zip avec ce programme ou déposez-le dessus :\n\nsalupdate.exe Sally-v<version>-<processeur>.zip [--yes]\n\n--yes répond Oui à toutes les questions et n'affiche que les erreurs. Le fichier SHA256SUMS de la version, s'il se trouve à côté du fichier .zip, sert à le vérifier."
 IDS_UPDATER_NOT_IN_SALLY, "Ce programme de mise à jour n'est pas dans un dossier Sally :\n%s\n\nLancez le salupdate.exe du dossier utils de Sally, ou indiquez le dossier de Sally avec --install <dossier>."
 IDS_UPDATER_BAD_PACKAGE, "%s ne peut pas être installé :\n%s"
 IDS_UPDATER_CHECKSUM_MISMATCH, "%s ne correspond pas à sa somme SHA-256 dans %s.\n\nLe fichier est endommagé ou n'est pas celui publié. Il n'a pas été installé."
 IDS_UPDATER_UNVERIFIED, "Aucune somme SHA-256 pour %s n'a été trouvée à côté de lui (le Sally-v...-SHA256SUMS.txt de la version) : il ne peut pas être comparé à la version publiée.\n\nL'installer quand même ?"
 IDS_UPDATER_CONFIRM_NEWER, "Installer Sally %s à partir de %s ?\n\nLa version installée est %s."
 IDS_UPDATER_CONFIRM_SAME, "Sally %s est déjà installé. Le réinstaller à partir de %s ?"
 IDS_UPDATER_CONFIRM_OLDER, "%s contient Sally %s, plus ancien que le %s installé.\n\nInstaller la version plus ancienne ?"
 IDS_UPDATER_WILL_CLOSE, "Sally est en cours d'exécution (fenêtres : %d). Il va se fermer, puis redémarrer après la mise à jour."
 IDS_UPDATER_OTHERS_RUNNING, "Fermez ces programmes lancés depuis le dossier de Sally, puis réessayez :\n%s"
 IDS_UPDATER_DONE, "Sally a été mis à jour de %s vers %s."
 IDS_UPDATER_FAILED, "La mise à jour vers %s a échoué et rien n'a été modifié :\n%s"
 IDS_UPDATER_INCOMPLETE, "La mise à jour vers %s a échoué et certains fichiers n'ont pas pu être restaurés :\n%s\n\nDécompressez à nouveau la version dans le dossier de Sally."
 IDS_UPDATER_ABORTED, "La mise à jour vers %s n'a pas eu lieu car Sally ne s'est pas fermé."
 IDS_UPDATER_RECOVERED, "Une mise à jour interrompue a été trouvée et annulée ; Sally est comme avant."
 IDS_UPDATER_RECOVER_FAILED, "Une mise à jour interrompue n'a pas pu être annulée :\n%s\n\nDécompressez à nouveau la version dans le dossier de Sally."
 IDS_UPDATER_WRONG_PROCESSOR, "%s est un Sally pour un autre processeur que celui installé. Il n'a pas été installé."
 IDS_UPDATER_CHECKING, "Recherche d'une version plus récente de Sally sur GitHub..."
 IDS_UPDATER_NEWER, "Une version plus récente de Sally est disponible."
 IDS_UPDATER_LATEST, "Vous avez la dernière version de Sally."
 IDS_UPDATER_INSTALLED_VERSION, "Version installée : %s"
 IDS_UPDATER_RELEASE_VERSION, "Dernière version : %s"
 IDS_UPDATER_CHECK_FAILED, "Sally n'a pas pu rechercher de mises à jour : %s"
 IDS_UPDATER_BAD_FEED, "GitHub n'a pas répondu par une version de Sally (%s)."
 IDS_UPDATER_NOT_INSTALLABLE, "Cette version ne peut pas être installée d'ici. Téléchargez-la depuis sa page de version."
 IDS_UPDATER_DOWNLOADING, "Téléchargement de %s..."
 IDS_UPDATER_VERIFYING, "Vérification du téléchargement avec la somme SHA-256 de la version..."
 IDS_UPDATER_PREPARING, "Décompression de Sally %s..."
 IDS_UPDATER_CONFIRM_INSTALL, "Sally va se fermer, installer la version %s et redémarrer.\n\nVoulez-vous continuer ?"
 IDS_UPDATER_CONFIRM_INSTALL_OTHERS, "Sally va se fermer, installer la version %s et redémarrer.\nLes autres fenêtres Sally lancées depuis le même dossier seront aussi fermées : %d.\n\nVoulez-vous continuer ?"
 IDS_UPDATER_STOPPED, "La mise à jour s'est arrêtée : %s"
 IDS_UPDATER_NO_CHECKSUM, "La version ne publie aucune somme SHA-256 pour %s."
 IDS_UPDATER_DOWNLOAD_MISMATCH, "Le téléchargement ne correspond pas à la somme SHA-256 publiée avec la version."
 IDS_UPDATER_DOWNLOAD_INCOMPLETE, "Le téléchargement est incomplet."
 IDS_UPDATER_INSTALL_BUTTON, "&Installer et redémarrer"
 IDS_UPDATER_RELEASE_PAGE_BUTTON, "Ouvrir la page de la &version"
 IDS_UPDATER_CLOSE_BUTTON, "&Fermer"
 IDS_UPDATER_NOTES_LABEL, "Nouveautés :"
}

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN
STRINGTABLE
{
 IDS_UPDATER_TITLE, "Actualización de Sally"
 IDS_UPDATER_USAGE, "Para actualizar Sally desde una versión descargada, abra su archivo .zip con este programa o arrástrelo sobre él:\n\nsalupdate.exe Sally-v<versión>-<procesador>.zip [--yes]\n\n--yes responde Sí a todas las preguntas y solo muestra los errores. El archivo SHA256SUMS de la versión, si está junto al archivo .zip, se usa para comprobarlo."
 IDS_UPDATER_NOT_IN_SALLY, "Este actualizador no está en una carpeta de Sally:\n%s\n\nEjecute el salupdate.exe de la carpeta utils de Sally o indique la carpeta de Sally con --install <carpeta>."
 IDS_UPDATER_BAD_PACKAGE, "No se puede instalar %s:\n%s"
 IDS_UPDATER_CHECKSUM_MISMATCH, "%s no coincide con su suma SHA-256 en %s.\n\nEl archivo está dañado o no es el publicado. No se instaló."
 IDS_UPDATER_UNVERIFIED, "No se encontró ninguna suma SHA-256 para %s junto a él (el Sally-v...-SHA256SUMS.txt de la versión), así que no se puede comprobar con la versión publicada.\n\n¿Instalarlo de todos modos?"
 IDS_UPDATER_CONFIRM_NEWER, "¿Instalar Sally %s desde %s?\n\nLa versión instalada es %s."
 IDS_UPDATER_CONFIRM_SAME, "Sally %s ya está instalada. ¿Instalarla de nuevo desde %s?"
 IDS_UPDATER_CONFIRM_OLDER, "%s contiene Sally %s, que es más antigua que la %s instalada.\n\n¿Instalar la versión más antigua?"
 IDS_UPDATER_WILL_CLOSE, "Sally se está ejecutando (ventanas: %d). Se cerrará y se volverá a iniciar tras la actualización."
 IDS_UPDATER_OTHERS_RUNNING, "Cierre estos programas iniciados desde la carpeta de Sally e inténtelo de nuevo:\n%s"
 IDS_UPDATER_DONE, "Sally se actualizó de %s a %s."
 IDS_UPDATER_FAILED, "La actualización a %s falló y no se cambió nada:\n%s"
 IDS_UPDATER_INCOMPLETE, "La actualización a %s falló y algunos archivos no se pudieron restaurar:\n%s\n\nDescomprima de nuevo la versión en la carpeta de Sally."
 IDS_UPDATER_ABORTED, "La actualización a %s no se realizó porque Sally no se cerró."
 IDS_UPDATER_RECOVERED, "Se encontró una actualización interrumpida y se deshizo; Sally está como antes."
 IDS_UPDATER_RECOVER_FAILED, "No se pudo deshacer una actualización interrumpida:\n%s\n\nDescomprima de nuevo la versión en la carpeta de Sally."
 IDS_UPDATER_WRONG_PROCESSOR, "%s es una Sally para otro procesador distinto del de la instalada. No se instaló."
 IDS_UPDATER_CHECKING, "Buscando en GitHub una versión más reciente de Sally..."
 IDS_UPDATER_NEWER, "Hay disponible una versión más reciente de Sally."
 IDS_UPDATER_LATEST, "Tiene la última versión de Sally."
 IDS_UPDATER_INSTALLED_VERSION, "Versión instalada: %s"
 IDS_UPDATER_RELEASE_VERSION, "Última versión: %s"
 IDS_UPDATER_CHECK_FAILED, "Sally no pudo buscar actualizaciones: %s"
 IDS_UPDATER_BAD_FEED, "GitHub no respondió con una versión de Sally (%s)."
 IDS_UPDATER_NOT_INSTALLABLE, "Esta versión no se puede instalar desde aquí. Descárguela desde su página de versión."
 IDS_UPDATER_DOWNLOADING, "Descargando %s..."
 IDS_UPDATER_VERIFYING, "Comprobando la descarga con la suma SHA-256 de la versión..."
 IDS_UPDATER_PREPARING, "Descomprimiendo Sally %s..."
 IDS_UPDATER_CONFIRM_INSTALL, "Sally se cerrará, instalará la versión %s y se volverá a iniciar.\n\n¿Desea continuar?"
 IDS_UPDATER_CONFIRM_INSTALL_OTHERS, "Sally se cerrará, instalará la versión %s y se volverá a iniciar.\nTambién se cerrarán otras ventanas de Sally iniciadas desde la misma carpeta: %d.\n\n¿Desea continuar?"
 IDS_UPDATER_STOPPED, "La actualización se detuvo: %s"
 IDS_UPDATER_NO_CHECKSUM, "La versión no publica ninguna suma SHA-256 para %s."
 IDS_UPDATER_DOWNLOAD_MISMATCH, "La descarga no coincide con la suma SHA-256 publicada con la versión."
 IDS_UPDATER_DOWNLOAD_INCOMPLETE, "La descarga está incompleta."
 IDS_UPDATER_INSTALL_BUTTON, "&Instalar y reiniciar"
 IDS_UPDATER_RELEASE_PAGE_BUTTON, "Abrir la página de la &versión"
 IDS_UPDATER_CLOSE_BUTTON, "&Cerrar"
 IDS_UPDATER_NOTES_LABEL, "Novedades:"
}

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH
STRINGTABLE
{
 IDS_UPDATER_TITLE, "Sally bijwerken"
 IDS_UPDATER_USAGE, "Om Sally bij te werken vanuit een gedownloade release, opent u het .zip-bestand met dit programma of sleept u het erop:\n\nsalupdate.exe Sally-v<versie>-<processor>.zip [--yes]\n\n--yes beantwoordt elke vraag met Ja en meldt alleen fouten. Het SHA256SUMS-bestand van de release wordt gebruikt voor de controle als het naast het .zip-bestand staat."
 IDS_UPDATER_NOT_IN_SALLY, "Dit updateprogramma staat niet in een Sally-map:\n%s\n\nStart de salupdate.exe in de utils-map van Sally, of geef de Sally-map op met --install <map>."
 IDS_UPDATER_BAD_PACKAGE, "%s kan niet worden geïnstalleerd:\n%s"
 IDS_UPDATER_CHECKSUM_MISMATCH, "%s komt niet overeen met de SHA-256-controlesom in %s.\n\nHet bestand is beschadigd of niet het gepubliceerde bestand. Het is niet geïnstalleerd."
 IDS_UPDATER_UNVERIFIED, "Naast %s is geen SHA-256-controlesom gevonden (de Sally-v...-SHA256SUMS.txt van de release), dus het kan niet met de gepubliceerde release worden vergeleken.\n\nToch installeren?"
 IDS_UPDATER_CONFIRM_NEWER, "Sally %s installeren vanuit %s?\n\nDe geïnstalleerde versie is %s."
 IDS_UPDATER_CONFIRM_SAME, "Sally %s is al geïnstalleerd. Opnieuw installeren vanuit %s?"
 IDS_UPDATER_CONFIRM_OLDER, "%s bevat Sally %s, ouder dan de geïnstalleerde %s.\n\nDe oudere versie installeren?"
 IDS_UPDATER_WILL_CLOSE, "Sally draait (vensters: %d). Sally wordt gesloten en na de update opnieuw gestart."
 IDS_UPDATER_OTHERS_RUNNING, "Sluit deze programma's die vanuit de Sally-map zijn gestart en probeer het opnieuw:\n%s"
 IDS_UPDATER_DONE, "Sally is bijgewerkt van %s naar %s."
 IDS_UPDATER_FAILED, "De update naar %s is mislukt en er is niets gewijzigd:\n%s"
 IDS_UPDATER_INCOMPLETE, "De update naar %s is mislukt en sommige bestanden konden niet worden hersteld:\n%s\n\nPak de release opnieuw uit in de Sally-map."
 IDS_UPDATER_ABORTED, "De update naar %s is niet uitgevoerd omdat Sally niet werd gesloten."
 IDS_UPDATER_RECOVERED, "Een onderbroken update is gevonden en ongedaan gemaakt; Sally is weer zoals voorheen."
 IDS_UPDATER_RECOVER_FAILED, "Een onderbroken update kon niet ongedaan worden gemaakt:\n%s\n\nPak de release opnieuw uit in de Sally-map."
 IDS_UPDATER_WRONG_PROCESSOR, "%s is een Sally voor een andere processor dan de geïnstalleerde. Het is niet geïnstalleerd."
 IDS_UPDATER_CHECKING, "Er wordt op GitHub gezocht naar een nieuwere Sally-release..."
 IDS_UPDATER_NEWER, "Er is een nieuwere Sally-release beschikbaar."
 IDS_UPDATER_LATEST, "U hebt de nieuwste Sally-release."
 IDS_UPDATER_INSTALLED_VERSION, "Geïnstalleerde versie: %s"
 IDS_UPDATER_RELEASE_VERSION, "Nieuwste release: %s"
 IDS_UPDATER_CHECK_FAILED, "Sally kon niet op updates controleren: %s"
 IDS_UPDATER_BAD_FEED, "GitHub antwoordde niet met een Sally-release (%s)."
 IDS_UPDATER_NOT_INSTALLABLE, "Deze release kan niet vanuit hier worden geïnstalleerd. Download hem van de releasepagina."
 IDS_UPDATER_DOWNLOADING, "%s wordt gedownload..."
 IDS_UPDATER_VERIFYING, "De download wordt gecontroleerd met de SHA-256-controlesom van de release..."
 IDS_UPDATER_PREPARING, "Sally %s wordt uitgepakt..."
 IDS_UPDATER_CONFIRM_INSTALL, "Sally wordt gesloten, installeert versie %s en start opnieuw.\n\nWilt u doorgaan?"
 IDS_UPDATER_CONFIRM_INSTALL_OTHERS, "Sally wordt gesloten, installeert versie %s en start opnieuw.\nAndere Sally-vensters die vanuit dezelfde map zijn gestart, worden ook gesloten: %d.\n\nWilt u doorgaan?"
 IDS_UPDATER_STOPPED, "De update is gestopt: %s"
 IDS_UPDATER_NO_CHECKSUM, "De release publiceert geen SHA-256-controlesom voor %s."
 IDS_UPDATER_DOWNLOAD_MISMATCH, "De download komt niet overeen met de SHA-256-controlesom die bij de release is gepubliceerd."
 IDS_UPDATER_DOWNLOAD_INCOMPLETE, "De download is onvolledig."
 IDS_UPDATER_INSTALL_BUTTON, "&Installeren en opnieuw starten"
 IDS_UPDATER_RELEASE_PAGE_BUTTON, "&Releasepagina openen"
 IDS_UPDATER_CLOSE_BUTTON, "S&luiten"
 IDS_UPDATER_NOTES_LABEL, "Nieuw:"
}

LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
STRINGTABLE
{
 IDS_UPDATER_TITLE, "Sally frissítése"
 IDS_UPDATER_USAGE, "A Sally letöltött kiadásból való frissítéséhez nyissa meg a .zip fájlt ezzel a programmal, vagy húzza rá:\n\nsalupdate.exe Sally-v<verzió>-<processzor>.zip [--yes]\n\nA --yes minden kérdésre Igennel felel, és csak a hibákat jelzi. A kiadás SHA256SUMS fájlja, ha a .zip fájl mellett van, az ellenőrzésre szolgál."
 IDS_UPDATER_NOT_IN_SALLY, "Ez a frissítőprogram nem egy Sally mappában van:\n%s\n\nIndítsa a Sally utils mappájában lévő salupdate.exe-t, vagy adja meg a Sally mappát a --install <mappa> kapcsolóval."
 IDS_UPDATER_BAD_PACKAGE, "%s nem telepíthető:\n%s"
 IDS_UPDATER_CHECKSUM_MISMATCH, "%s nem egyezik a(z) %s fájlban lévő SHA-256 ellenőrzőösszegével.\n\nA fájl sérült, vagy nem a közzétett fájl. Nem lett telepítve."
 IDS_UPDATER_UNVERIFIED, "%s mellett nem található SHA-256 ellenőrzőösszeg (a kiadás Sally-v...-SHA256SUMS.txt fájlja), így nem ellenőrizhető a közzétett kiadással.\n\nMégis telepíti?"
 IDS_UPDATER_CONFIRM_NEWER, "Telepíti a Sally %s verzióját innen: %s?\n\nA telepített verzió: %s."
 IDS_UPDATER_CONFIRM_SAME, "A Sally %s már telepítve van. Újratelepíti innen: %s?"
 IDS_UPDATER_CONFIRM_OLDER, "%s a Sally %s verzióját tartalmazza, amely régebbi a telepített %s verziónál.\n\nTelepíti a régebbi verziót?"
 IDS_UPDATER_WILL_CLOSE, "A Sally fut (ablakok: %d). Bezárul, és a frissítés után újraindul."
 IDS_UPDATER_OTHERS_RUNNING, "Zárja be ezeket a Sally mappájából indított programokat, majd próbálja újra:\n%s"
 IDS_UPDATER_DONE, "A Sally frissült: %s -> %s."
 IDS_UPDATER_FAILED, "A(z) %s verzióra frissítés nem sikerült, semmi sem változott:\n%s"
 IDS_UPDATER_INCOMPLETE, "A(z) %s verzióra frissítés nem sikerült, és néhány fájl nem állítható vissza:\n%s\n\nCsomagolja ki újra a kiadást a Sally mappájába."
 IDS_UPDATER_ABORTED, "A(z) %s verzióra frissítés nem történt meg, mert a Sally nem zárult be."
 IDS_UPDATER_RECOVERED, "Egy megszakadt frissítést találtunk és visszavontunk; a Sally olyan, mint előtte."
 IDS_UPDATER_RECOVER_FAILED, "Egy megszakadt frissítés nem vonható vissza:\n%s\n\nCsomagolja ki újra a kiadást a Sally mappájába."
 IDS_UPDATER_WRONG_PROCESSOR, "%s egy másik processzorra készült Sally, mint a telepített. Nem lett telepítve."
 IDS_UPDATER_CHECKING, "Újabb Sally kiadás keresése a GitHubon..."
 IDS_UPDATER_NEWER, "Újabb Sally kiadás érhető el."
 IDS_UPDATER_LATEST, "A legújabb Sally kiadás van telepítve."
 IDS_UPDATER_INSTALLED_VERSION, "Telepített verzió: %s"
 IDS_UPDATER_RELEASE_VERSION, "Legújabb kiadás: %s"
 IDS_UPDATER_CHECK_FAILED, "A Sally nem tudta ellenőrizni a frissítéseket: %s"
 IDS_UPDATER_BAD_FEED, "A GitHub nem Sally kiadással válaszolt (%s)."
 IDS_UPDATER_NOT_INSTALLABLE, "Ez a kiadás innen nem telepíthető. Töltse le a kiadási oldaláról."
 IDS_UPDATER_DOWNLOADING, "%s letöltése..."
 IDS_UPDATER_VERIFYING, "A letöltés ellenőrzése a kiadás SHA-256 ellenőrzőösszegével..."
 IDS_UPDATER_PREPARING, "A Sally %s kicsomagolása..."
 IDS_UPDATER_CONFIRM_INSTALL, "A Sally bezárul, telepíti a(z) %s verziót, majd újraindul.\n\nFolytatja?"
 IDS_UPDATER_CONFIRM_INSTALL_OTHERS, "A Sally bezárul, telepíti a(z) %s verziót, majd újraindul.\nAz ugyanabból a mappából indított többi Sally ablak is bezárul: %d.\n\nFolytatja?"
 IDS_UPDATER_STOPPED, "A frissítés leállt: %s"
 IDS_UPDATER_NO_CHECKSUM, "A kiadás nem tesz közzé SHA-256 ellenőrzőösszeget ehhez: %s."
 IDS_UPDATER_DOWNLOAD_MISMATCH, "A letöltés nem egyezik a kiadással közzétett SHA-256 ellenőrzőösszeggel."
 IDS_UPDATER_DOWNLOAD_INCOMPLETE, "A letöltés hiányos."
 IDS_UPDATER_INSTALL_BUTTON, "&Telepítés és újraindítás"
 IDS_UPDATER_RELEASE_PAGE_BUTTON, "&Kiadási oldal megnyitása"
 IDS_UPDATER_CLOSE_BUTTON, "&Bezárás"
 IDS_UPDATER_NOTES_LABEL, "Újdonságok:"
}

LANGUAGE LANG_ROMANIAN, SUBLANG_DEFAULT
STRINGTABLE
{
 IDS_UPDATER_TITLE, "Actualizare Sally"
 IDS_UPDATER_USAGE, "Pentru a actualiza Sally dintr-o versiune descărcată, deschideți fișierul .zip cu acest program sau trageți-l peste el:\n\nsalupdate.exe Sally-v<versiune>-<procesor>.zip [--yes]\n\n--yes răspunde Da la orice întrebare și afișează doar erorile. Fișierul SHA256SUMS al versiunii, dacă se află lângă fișierul .zip, este folosit pentru verificare."
 IDS_UPDATER_NOT_IN_SALLY, "Acest program de actualizare nu se află într-un dosar Sally:\n%s\n\nPorniți salupdate.exe din dosarul utils al Sally sau indicați dosarul Sally cu --install <dosar>."
 IDS_UPDATER_BAD_PACKAGE, "%s nu poate fi instalat:\n%s"
 IDS_UPDATER_CHECKSUM_MISMATCH, "%s nu corespunde sumei sale SHA-256 din %s.\n\nFișierul este deteriorat sau nu este cel publicat. Nu a fost instalat."
 IDS_UPDATER_UNVERIFIED, "Lângă %s nu s-a găsit nicio sumă SHA-256 (fișierul Sally-v...-SHA256SUMS.txt al versiunii), deci nu poate fi verificat față de versiunea publicată.\n\nÎl instalați totuși?"
 IDS_UPDATER_CONFIRM_NEWER, "Instalați Sally %s din %s?\n\nVersiunea instalată este %s."
 IDS_UPDATER_CONFIRM_SAME, "Sally %s este deja instalat. Îl reinstalați din %s?"
 IDS_UPDATER_CONFIRM_OLDER, "%s conține Sally %s, mai vechi decât %s instalat.\n\nInstalați versiunea mai veche?"
 IDS_UPDATER_WILL_CLOSE, "Sally rulează (ferestre: %d). Se va închide și va porni din nou după actualizare."
 IDS_UPDATER_OTHERS_RUNNING, "Închideți aceste programe pornite din dosarul Sally, apoi încercați din nou:\n%s"
 IDS_UPDATER_DONE, "Sally a fost actualizat de la %s la %s."
 IDS_UPDATER_FAILED, "Actualizarea la %s a eșuat și nu s-a modificat nimic:\n%s"
 IDS_UPDATER_INCOMPLETE, "Actualizarea la %s a eșuat și unele fișiere nu au putut fi restaurate:\n%s\n\nDezarhivați din nou versiunea în dosarul Sally."
 IDS_UPDATER_ABORTED, "Actualizarea la %s nu a avut loc deoarece Sally nu s-a închis."
 IDS_UPDATER_RECOVERED, "A fost găsită și anulată o actualizare întreruptă; Sally este ca înainte."
 IDS_UPDATER_RECOVER_FAILED, "O actualizare întreruptă nu a putut fi anulată:\n%s\n\nDezarhivați din nou versiunea în dosarul Sally."
 IDS_UPDATER_WRONG_PROCESSOR, "%s este un Sally pentru alt procesor decât cel instalat. Nu a fost instalat."
 IDS_UPDATER_CHECKING, "Se caută pe GitHub o versiune mai nouă a Sally..."
 IDS_UPDATER_NEWER, "Este disponibilă o versiune mai nouă a Sally."
 IDS_UPDATER_LATEST, "Aveți cea mai nouă versiune a Sally."
 IDS_UPDATER_INSTALLED_VERSION, "Versiunea instalată: %s"
 IDS_UPDATER_RELEASE_VERSION, "Cea mai nouă versiune: %s"
 IDS_UPDATER_CHECK_FAILED, "Sally nu a putut căuta actualizări: %s"
 IDS_UPDATER_BAD_FEED, "GitHub nu a răspuns cu o versiune Sally (%s)."
 IDS_UPDATER_NOT_INSTALLABLE, "Această versiune nu poate fi instalată de aici. Descărcați-o de pe pagina versiunii."
 IDS_UPDATER_DOWNLOADING, "Se descarcă %s..."
 IDS_UPDATER_VERIFYING, "Se verifică descărcarea cu suma SHA-256 a versiunii..."
 IDS_UPDATER_PREPARING, "Se dezarhivează Sally %s..."
 IDS_UPDATER_CONFIRM_INSTALL, "Sally se va închide, va instala versiunea %s și va porni din nou.\n\nDoriți să continuați?"
 IDS_UPDATER_CONFIRM_INSTALL_OTHERS, "Sally se va închide, va instala versiunea %s și va porni din nou.\nSe vor închide și alte ferestre Sally pornite din același dosar: %d.\n\nDoriți să continuați?"
 IDS_UPDATER_STOPPED, "Actualizarea s-a oprit: %s"
 IDS_UPDATER_NO_CHECKSUM, "Versiunea nu publică nicio sumă SHA-256 pentru %s."
 IDS_UPDATER_DOWNLOAD_MISMATCH, "Descărcarea nu corespunde sumei SHA-256 publicate cu versiunea."
 IDS_UPDATER_DOWNLOAD_INCOMPLETE, "Descărcarea este incompletă."
 IDS_UPDATER_INSTALL_BUTTON, "&Instalează și repornește"
 IDS_UPDATER_RELEASE_PAGE_BUTTON, "Deschide pagina &versiunii"
 IDS_UPDATER_CLOSE_BUTTON, "Î&nchide"
 IDS_UPDATER_NOTES_LABEL, "Noutăți:"
}

LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT
STRINGTABLE
{
 IDS_UPDATER_TITLE, "Обновление Sally"
 IDS_UPDATER_USAGE, "Чтобы обновить Sally из загруженного выпуска, откройте его файл .zip этой программой или перетащите файл на неё:\n\nsalupdate.exe Sally-v<версия>-<процессор>.zip [--yes]\n\n--yes отвечает «Да» на все вопросы и сообщает только об ошибках. Файл SHA256SUMS выпуска, если он лежит рядом с файлом .zip, используется для проверки."
 IDS_UPDATER_NOT_IN_SALLY, "Эта программа обновления находится не в папке Sally:\n%s\n\nЗапустите salupdate.exe из папки utils программы Sally или укажите папку Sally параметром --install <папка>."
 IDS_UPDATER_BAD_PACKAGE, "Не удаётся установить %s:\n%s"
 IDS_UPDATER_CHECKSUM_MISMATCH, "%s не совпадает со своей контрольной суммой SHA-256 в %s.\n\nФайл повреждён или это не опубликованный файл. Он не установлен."
 IDS_UPDATER_UNVERIFIED, "Рядом с %s не найдена контрольная сумма SHA-256 (файл Sally-v...-SHA256SUMS.txt выпуска), поэтому его нельзя сверить с опубликованным выпуском.\n\nВсё равно установить?"
 IDS_UPDATER_CONFIRM_NEWER, "Установить Sally %s из %s?\n\nУстановленная версия: %s."
 IDS_UPDATER_CONFIRM_SAME, "Sally %s уже установлена. Установить её заново из %s?"
 IDS_UPDATER_CONFIRM_OLDER, "%s содержит Sally %s, более старую, чем установленная %s.\n\nУстановить более старую версию?"
 IDS_UPDATER_WILL_CLOSE, "Sally запущена (окон: %d). Она закроется и запустится снова после обновления."
 IDS_UPDATER_OTHERS_RUNNING, "Закройте эти программы, запущенные из папки Sally, и повторите попытку:\n%s"
 IDS_UPDATER_DONE, "Sally обновлена с версии %s до %s."
 IDS_UPDATER_FAILED, "Обновление до %s не удалось, ничего не изменено:\n%s"
 IDS_UPDATER_INCOMPLETE, "Обновление до %s не удалось, и некоторые файлы не удалось восстановить:\n%s\n\nРаспакуйте выпуск в папку Sally заново."
 IDS_UPDATER_ABORTED, "Обновление до %s не выполнено, так как Sally не закрылась."
 IDS_UPDATER_RECOVERED, "Найдено прерванное обновление; оно отменено, Sally в прежнем состоянии."
 IDS_UPDATER_RECOVER_FAILED, "Не удалось отменить прерванное обновление:\n%s\n\nРаспакуйте выпуск в папку Sally заново."
 IDS_UPDATER_WRONG_PROCESSOR, "%s — это Sally для другого процессора, чем установленная. Она не установлена."
 IDS_UPDATER_CHECKING, "Поиск более новой версии Sally на GitHub..."
 IDS_UPDATER_NEWER, "Доступна более новая версия Sally."
 IDS_UPDATER_LATEST, "У вас последняя версия Sally."
 IDS_UPDATER_INSTALLED_VERSION, "Установленная версия: %s"
 IDS_UPDATER_RELEASE_VERSION, "Последняя версия: %s"
 IDS_UPDATER_CHECK_FAILED, "Sally не удалось проверить обновления: %s"
 IDS_UPDATER_BAD_FEED, "GitHub не ответил сведениями о версии Sally (%s)."
 IDS_UPDATER_NOT_INSTALLABLE, "Эту версию нельзя установить отсюда. Загрузите её со страницы выпуска."
 IDS_UPDATER_DOWNLOADING, "Загрузка %s..."
 IDS_UPDATER_VERIFYING, "Проверка загрузки по контрольной сумме SHA-256 выпуска..."
 IDS_UPDATER_PREPARING, "Распаковка Sally %s..."
 IDS_UPDATER_CONFIRM_INSTALL, "Sally закроется, установит версию %s и запустится снова.\n\nПродолжить?"
 IDS_UPDATER_CONFIRM_INSTALL_OTHERS, "Sally закроется, установит версию %s и запустится снова.\nДругие окна Sally, запущенные из той же папки, тоже закроются: %d.\n\nПродолжить?"
 IDS_UPDATER_STOPPED, "Обновление остановлено: %s"
 IDS_UPDATER_NO_CHECKSUM, "Выпуск не публикует контрольную сумму SHA-256 для %s."
 IDS_UPDATER_DOWNLOAD_MISMATCH, "Загруженный файл не совпадает с контрольной суммой SHA-256, опубликованной с выпуском."
 IDS_UPDATER_DOWNLOAD_INCOMPLETE, "Загрузка не завершена."
 IDS_UPDATER_INSTALL_BUTTON, "&Установить и перезапустить"
 IDS_UPDATER_RELEASE_PAGE_BUTTON, "Открыть страницу &выпуска"
 IDS_UPDATER_CLOSE_BUTTON, "&Закрыть"
 IDS_UPDATER_NOTES_LABEL, "Что нового:"
}

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
STRINGTABLE
{
 IDS_UPDATER_TITLE, "Sally 更新"
 IDS_UPDATER_USAGE, "要从下载的发布版本更新 Sally，请用本程序打开其 .zip 文件，或将 .zip 文件拖放到本程序上：\n\nsalupdate.exe Sally-v<版本>-<处理器>.zip [--yes]\n\n--yes 对所有问题回答“是”，除错误外不显示消息。如果发布版本的 SHA256SUMS 文件位于 .zip 文件旁边，将用它进行校验。"
 IDS_UPDATER_NOT_IN_SALLY, "此更新程序不在 Sally 文件夹中：\n%s\n\n请运行 Sally 的 utils 文件夹中的 salupdate.exe，或用 --install <文件夹> 指定 Sally 文件夹。"
 IDS_UPDATER_BAD_PACKAGE, "无法安装 %s：\n%s"
 IDS_UPDATER_CHECKSUM_MISMATCH, "%s 与 %s 中的 SHA-256 校验和不匹配。\n\n该文件已损坏或不是发布的文件，未安装。"
 IDS_UPDATER_UNVERIFIED, "在 %s 旁边没有找到它的 SHA-256 校验和（发布版本的 Sally-v...-SHA256SUMS.txt），因此无法与发布的版本核对。\n\n仍然安装吗？"
