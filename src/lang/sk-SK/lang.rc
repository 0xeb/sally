    LTEXT           "D&ostupné stĺpce:",IDC_VIEWLIST_HEADER2,182,26,65,8
    CONTROL         "",IDC_VIEW_LIST2,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,182,36,114,99
    LTEXT           "Zobrazenia v režime Podrobný môžu obsahovať všetky dostupné stĺpce.",IDC_VIEW_TEXT1,1,2,269,8
    LTEXT           "Zvoľte zo zoznamu stĺpce, ktoré chcete vidieť vo vybranom zobrazení.",IDC_VIEW_TEXT3,1,12,252,8
    GROUPBOX        " Nastaviť šírku vybraného stĺpca zo zoznamu dostupných stĺpcov: ",IDC_VIEW_TEXT4,1,141,295,50,WS_GROUP
    CONTROL         "&Pevná šírka stĺpca v ľavom paneli:",IDC_VIEW_LEFT_FIXED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,9,152,122,12
    EDITTEXT        IDC_VIEW_LEFT_WIDTH,138,152,26,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "bodov",IDC_VIEW_TEXT2,167,154,114,8
    CONTROL         "P&evná šírka stĺpca v pravom paneli:",IDC_VIEW_RIGHT_FIXED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,9,166,128,12
    EDITTEXT        IDC_VIEW_RIGHT_WIDTH,138,166,26,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "bodov",IDC_VIEW_TEXT5,167,168,114,8
    LTEXT           "Poznámka: nezaškrtnuté = šírka stĺpca zodpovedá najdlhšej hodnote v stĺpci",IDC_VIEW_TEXT6,9,180,231,8
    GROUPBOX        " Inteligentný režim (úzky stĺpec Názov na obmedzenie rolovania) pre vybrané zobrazenie v: ",IDC_VIEW_TEXT7,1,194,295,37,WS_GROUP
