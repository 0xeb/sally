IDD_CFGPAGE_GENERAL DIALOGEX 65, 18, 299, 231
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Všeobecné"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "&Pred ukončením uložiť konfiguráciu",IDC_AUTOSAVE,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,1,3,100,12
    CONTROL         "Pri &kopírovaní z kompaktného disku odstrániť atribút len na čítanie",IDC_CLEARREADONLY,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,1,16,209,12
    CONTROL         "Povol&iť iba jednu inštanciu programu Sally",IDC_ONLYONEINSTANCE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,1,29,182,12
    CONTROL         "&Upozorniť zvukovým signálom na dokončenie operácie v neaktívnom okne",IDC_MINBEEPWHENDONE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,1,42,238,12
    CONTROL         "Zat&voriť okno prostredia po vykonaní príkazu (z príkazového riadku)",IDC_CLOSESHELL,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,1,55,227,12
