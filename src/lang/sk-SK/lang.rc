END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_VIEWERMENU MENU
{
 POPUP "&Súbor"
 {
  MENUITEM "&Otvoriť...\tCtrl+O", CM_OPENFILE
  MENUITEM "&Aktualizovať\tCtrl+R", CM_REREADFILE
  MENUITEM SEPARATOR
  
// POZOR: pokud se zmeni index tohoto submenu, je potreba zmenit VIEWER_FILE_MENU_OTHFILESINDEX
  POPUP "&Ďalšie súbory"
  {
   MENUITEM "&Predchádzajúci\tBackspace", CM_PREVFILE
   MENUITEM "&Ďalší\tMedzerník", CM_NEXTFILE
   MENUITEM SEPARATOR
   MENUITEM "Pr&edchádzajúci vybraný\tCtrl+Backspace", CM_PREVSELFILE
   MENUITEM "Ď&alší vybraný\tCtrl+Medzerník", CM_NEXTSELFILE
   MENUITEM SEPARATOR
   MENUITEM "P&rvý\tShift+Backspace", CM_FIRSTFILE
   MENUITEM "P&osledný\tShift+Medzerník", CM_LASTFILE
  } 
  
  MENUITEM SEPARATOR
  MENUITEM "&Koniec\tAlt+F4", CM_EXIT
 }

 POPUP "&Upraviť"
 {
  MENUITEM "&Kopírovať\tCtrl+C", CM_COPYTOCLIP
  MENUITEM "K&opírovať do súboru...\tCtrl+S", CM_COPYTOFILE
  MENUITEM SEPARATOR
  MENUITEM "Vybrať &všetko\tCtrl+A", CM_SELECTALLTEXT
 }

 POPUP "&Hľadať"
 {
  MENUITEM "&Nájsť...\tCtrl+F", CM_FINDSET
  MENUITEM "Nájsť &ďalší\tCtrl+N", CM_FINDNEXT
  MENUITEM "Nájsť &predchádzajúci\tCtrl+P", CM_FINDPREV
 }

 POPUP "&Zobraziť"
 {
  MENUITEM "&Voliť automaticky", CM_VIEW_AUTOSEL
  MENUITEM SEPARATOR
  MENUITEM "&Šestnástkovo\tCtrl+H", CM_TO_HEX
  MENUITEM "&Textovo\tCtrl+T", CM_TO_TEXT
  MENUITEM SEPARATOR
  MENUITEM "&Nastaviť ako predvolený", CM_VIEW_SETDEFAULT
  MENUITEM SEPARATOR
  MENUITEM "&Celá obrazovka\tF11", CM_VIEW_FULLSCREEN
  MENUITEM SEPARATOR
  MENUITEM "P&rejsť na pozíciu...\tCtrl+G", CM_GOTOOFFSET
  MENUITEM SEPARATOR
  MENUITEM "&Zalamovať\tCtrl+W", CM_WRAPED
 }

 POPUP "&Možnosti"
 {
  MENUITEM "&Konfigurácia...", CM_VIEWER_CONFIG
  MENUITEM SEPARATOR
  MENUITEM "&Automaticky kopírovať výber do schránky", CM_VIEWER_AUTOCOPY
 }

 POPUP "Ná&poveda"
 {
  MENUITEM "&Obsah\tF1", CM_VIEWERHLP_INTRO
  MENUITEM "&Klávesové skratky", CM_VIEWERHLP_KEYBOARD
 }
}

IDM_VIEWERCONTEXTMENU MENU
{
 POPUP ""
 {
  MENUITEM "&Kopírovať\tCtrl+C", CM_COPYTOCLIP
  MENUITEM "K&opírovať do...", CM_COPYTOFILE
  MENUITEM SEPARATOR
  MENUITEM "Vybrať &všetko\tCtrl+A", CM_SELECTALLTEXT
  MENUITEM SEPARATOR
  MENUITEM "&Nájsť...\tCtrl+F", CM_FINDSET
  MENUITEM "Nájsť &ďalší\tCtrl+N", CM_FINDNEXT
  MENUITEM "Nájsť &predchádzajúci\tCtrl+P", CM_FINDPREV
  MENUITEM SEPARATOR
  MENUITEM "&Šestnástkovo\tCtrl+H", CM_TO_HEX
  MENUITEM "&Textovo\tCtrl+T", CM_TO_TEXT
  MENUITEM SEPARATOR
  MENUITEM "P&rejsť na pozíciu...\tCtrl+G", CM_GOTOOFFSET
  MENUITEM SEPARATOR
  MENUITEM "&Zalamovanie riadkov\tCtrl+W", CM_WRAPED
 }
}

