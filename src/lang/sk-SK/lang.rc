    RTEXT           "Podrobnosti:",IDC_STATIC_4,3,23,31,8
    EDITTEXT        IDS_DETAILS,35,23,312,9,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Chcete sledovať odkaz a kopírovať súbory a adresáre z cieľa odkazu?",IDC_STATIC_1,37,43,310,8,SS_NOPREFIX
    LTEXT           "Kliknite na tlačidlo Preskočiť na ignorovanie cieľu odkazu a na vytvorenie iba prázdneho adresára.",IDC_STATIC_2,37,51,310,8,SS_NOPREFIX
END

