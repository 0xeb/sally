                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,1,68,182,12
    EDITTEXT        IDE_TIMERESOLUTION,184,68,28,12,ES_AUTOHSCROLL
    LTEXT           "s",IDC_STATIC_2,216,70,6,8,NOT WS_GROUP
    CONTROL         "Po&rovnanie adresárov: ignorovať časové rozdiely presne jednej alebo dvoch hodín",IDC_IGNOREDSTSHIFTS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,1,81,256,12
    CONTROL         "Vybr&ať aj príponu súboru v príkazoch Rýchlo premenovať a Komprimovať",IDC_QUICKRENAME_SELALL,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,1,94,243,12
    CONTROL         "Vybrať aj prípo&nu súboru v príkaze Upraviť nový súbor",IDC_EDITNEW_SELALL,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,1,107,202,12
    CONTROL         "Použiť rýchly presun adresárov na Novell Net&Ware",IDC_NETWAREFASTDIRMOVE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,1,120,156,12
    CONTROL         "Kopírovanie &súborov: použiť rýchlejší asynchrónny algoritmus na sieť (Windows 7 a novšie)",IDC_ASYNCCOPYALG,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,1,133,282,12
    CONTROL         "U&držiavať premenné prostredia aktualizované na systémové hodnoty",IDC_RELOADENVVARS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,1,146,193,12
END

IDD_CFGPAGE_REGIONAL DIALOGEX 65, 18, 299, 231
