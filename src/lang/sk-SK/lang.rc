                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,9,204,274,12
    CONTROL         "P&ravý panel (iba pre voľnú šírku stĺpca Názov; použite Ctrl+N v pravom paneli)",IDC_VIEW_RIGHT_SMARTMODE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,9,217,285,12
END

