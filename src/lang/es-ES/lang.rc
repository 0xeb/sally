IDM_VIEWERMENU MENU
{
 POPUP "&Fichero"
 {
  MENUITEM "&Abrir...\tCtrl+O", CM_OPENFILE
  MENUITEM "&Refrescar\tCtrl+R", CM_REREADFILE
  MENUITEM SEPARATOR
  
// POZOR: pokud se zmeni index tohoto submenu, je potreba zmenit VIEWER_FILE_MENU_OTHFILESINDEX
  POPUP "&Otros ficheros"
  {
   MENUITEM "Pre&vio\tRetroceso", CM_PREVFILE
   MENUITEM "S&iguiente\tEspacio", CM_NEXTFILE
   MENUITEM SEPARATOR
   MENUITEM "P&revio seleccionado\tCtrl+Backspace", CM_PREVSELFILE
   MENUITEM "Si&guiente seleccionado\tCtrl+Space", CM_NEXTSELFILE
   MENUITEM SEPARATOR
   MENUITEM "Pri&mero\tMays+Retroceso", CM_FIRSTFILE
   MENUITEM "&Último\tMays+Espacio", CM_LASTFILE
  } 
  
  MENUITEM SEPARATOR
  MENUITEM "&Salir\tAlt+F4", CM_EXIT
 }

 POPUP "&Editar"
 {
  MENUITEM "&Copiar\tCtrl+C", CM_COPYTOCLIP
  MENUITEM "C&opiar a fichero...\tCtrl+S", CM_COPYTOFILE
  MENUITEM SEPARATOR
  MENUITEM "Seleccionar &todo\tCtrl+A", CM_SELECTALLTEXT
 }

 POPUP "&Buscar"
 {
  MENUITEM "&Buscar...\tCtrl+F", CM_FINDSET
  MENUITEM "Buscar &siguiente\tCtrl+N", CM_FINDNEXT
  MENUITEM "Buscar &previo\tCtrl+P", CM_FINDPREV
 }

 POPUP "&Ver"
 {
  MENUITEM "&Autoseleccionar", CM_VIEW_AUTOSEL
  MENUITEM SEPARATOR
  MENUITEM "&Hex\tCtrl+H", CM_TO_HEX
  MENUITEM "&Texto\tCtrl+T", CM_TO_TEXT
  MENUITEM SEPARATOR
