  MENUITEM SEPARATOR
  MENUITEM "&Pantalla completa\tF11", CM_VIEW_FULLSCREEN
  MENUITEM SEPARATOR
  MENUITEM "&Ir a offset...\tCtrl+G", CM_GOTOOFFSET
  MENUITEM SEPARATOR
  MENUITEM "&Flujo de texto\tCtrl+W", CM_WRAPED
 }

 POPUP "Opc&iones"
 {
  MENUITEM "&Configuración...", CM_VIEWER_CONFIG
  MENUITEM SEPARATOR
