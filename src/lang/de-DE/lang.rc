/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_VIEWERMENU MENU
{
 POPUP "&Datei"
 {
  MENUITEM "Ö&ffnen...\tStrg+O", CM_OPENFILE
  MENUITEM "Aktualisie&ren\tStrg+R", CM_REREADFILE
  MENUITEM SEPARATOR
  
// POZOR: pokud se zmeni index tohoto submenu, je potreba zmenit VIEWER_FILE_MENU_OTHFILESINDEX
  POPUP "&Weitere Dateien"
  {
   MENUITEM "Vorhe&rige\tRücktaste", CM_PREVFILE
   MENUITEM "&Nächste\tLeertaste", CM_NEXTFILE
   MENUITEM SEPARATOR
   MENUITEM "&Vorherige ausgewählte\tStrg+Rücktaste", CM_PREVSELFILE
   MENUITEM "Nächste aus&gewählte\tStrg+Leertaste", CM_NEXTSELFILE
   MENUITEM SEPARATOR
   MENUITEM "Er&ste\tUmschalt+Rücktaste", CM_FIRSTFILE
   MENUITEM "&Letzte\tUmschalt+Leertaste", CM_LASTFILE
  } 
  
  MENUITEM SEPARATOR
  MENUITEM "&Beenden\tAlt+F4", CM_EXIT
 }

 POPUP "&Bearbeiten"
 {
  MENUITEM "&Kopieren\tStrg+C", CM_COPYTOCLIP
  MENUITEM "K&opieren nach Datei...\tStrg+S", CM_COPYTOFILE
  MENUITEM SEPARATOR
  MENUITEM "&Alles auswählen\tStrg+A", CM_SELECTALLTEXT
 }

 POPUP "&Suchen"
 {
  MENUITEM "&Suchen...\tStrg+F", CM_FINDSET
  MENUITEM "&Nächsten suchen\tStrg+N", CM_FINDNEXT
  MENUITEM "&Vorherigen suchen\tStrg+P", CM_FINDPREV
 }

 POPUP "&Ansicht"
 {
  MENUITEM "&Automatische Auswahl", CM_VIEW_AUTOSEL
  MENUITEM SEPARATOR
  MENUITEM "&Hex\tStrg+H", CM_TO_HEX
  MENUITEM "&Text\tStrg+T", CM_TO_TEXT
  MENUITEM SEPARATOR
  MENUITEM "Als &Standard festlegen", CM_VIEW_SETDEFAULT
  MENUITEM SEPARATOR
  MENUITEM "&Vollbild\tF11", CM_VIEW_FULLSCREEN
  MENUITEM SEPARATOR
  MENUITEM "&Gehe zu Position...\tStrg+G", CM_GOTOOFFSET
  MENUITEM SEPARATOR
  MENUITEM "&Zeilenumbruch\tStrg+W", CM_WRAPED
 }

 POPUP "&Optionen"
 {
  MENUITEM "&Konfiguration...", CM_VIEWER_CONFIG
  MENUITEM SEPARATOR
  MENUITEM "&Auswahl in Zwischenablage kopieren", CM_VIEWER_AUTOCOPY
 }

 POPUP "&Hilfe"
 {
  MENUITEM "&Inhalt\tF1", CM_VIEWERHLP_INTRO
  MENUITEM "&Tastaturbelegung", CM_VIEWERHLP_KEYBOARD
 }
}

IDM_VIEWERCONTEXTMENU MENU
{
