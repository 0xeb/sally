    LTEXT           "Pixel (Breite in Kopfzeile wählen)",IDC_VIEW_TEXT2,167,154,114,8
    CONTROL         "F&este Spaltenbreite im rechten Fenster:",IDC_VIEW_RIGHT_FIXED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,9,166,128,12
    EDITTEXT        IDC_VIEW_RIGHT_WIDTH,138,166,26,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "Pixel (Breite in Kopfzeile wählen)",IDC_VIEW_TEXT5,167,168,114,8
    LTEXT           "Hinweis: kein Haken - Breite wird automatisch an den längsten Eintrag angepasst",IDC_VIEW_TEXT6,9,180,231,8
    GROUPBOX        " Intelligenter Spaltenmodus (schmale Namensspalte) für gewählte Ansicht festlegen: ",IDC_VIEW_TEXT7,1,194,295,37,WS_GROUP
    CONTROL         "&Linkes Fenster (nur wenn Breite der Namensspalte nicht fest ist; benutze Strg+N)",IDC_VIEW_LEFT_SMARTMODE,
