IDD_CFGPAGE_SYSTEM DIALOGEX 71, 58, 299, 231
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Papierkorb"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Sie können wählen ob gelöschte Dateien und Verzeichnisse in den Papierkorb verschoben oder endgültig vom Datenträger gelöscht werden sollen.",IDC_STATIC_1,1,4,278,16
    GROUPBOX        "    ",IDC_STATIC_11,2,28,295,57
    LTEXT           "Halten Sie die UMSCHALT-Taste zum endgültigen Löschen der Dateien und Verzeich-",IDC_STATIC_4,9,42,186,8,NOT WS_GROUP
    LTEXT           "nisse. Bestätigungen erfolgen entsprechend den Papierkorbeigenschaften.",IDC_STATIC_5,9,51,174,8,NOT WS_GROUP
    LTEXT           "Das Löschen wird von WINDOWS ausgeführt, erweiterte Funktionen wie 'Fort-",IDC_STATIC_6,9,60,227,8,NOT WS_GROUP
    LTEXT           "schrittsbalken', 'Überspringen' und 'Wiederholen' werden nicht unterstützt.",IDC_STATIC_7,9,69,220,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_10,2,95,295,37
    LTEXT           "Halten Sie die UMSCHALT-Taste zum Verschieben der Dateien und Verzeichnisse",IDC_STATIC_2,9,107,202,8,NOT WS_GROUP
    LTEXT           "in den Papierkorb. Es gelten die Einstellungen unter 'Bestätigungen'.",IDC_STATIC_3,9,116,164,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_12,2,142,295,57
    CONTROL         "Gelöschte D&ateien und Verzeichnisse in den Papierkorb verschieben",IDR_RECYCLE2,
                    "Button",BS_AUTORADIOBUTTON | BS_VCENTER | WS_GROUP | WS_TABSTOP,9,27,196,12
    CONTROL         "Dateien und Ve&rzeichnisse endgültig löschen",IDR_RECYCLE1,
                    "Button",BS_AUTORADIOBUTTON,9,93,197,12
    CONTROL         "&Folgende Dateien in den Papierkorb verschieben, andere endgültig löschen",IDR_RECYCLE3,
                    "Button",BS_AUTORADIOBUTTON,9,141,232,12
    LTEXT           "Halten Sie die UMSCHALT-Taste zum endgültigen Löschen",IDC_STATIC_8,9,175,186,8,NOT WS_GROUP
    LTEXT           "der Dateien und Verzeichnisse. Es gelten die Einstellungen unter 'Bestätigungen'.",IDC_STATIC_9,9,184,164,8,NOT WS_GROUP
    EDITTEXT        IDE_RECYCLEMASKS,9,156,279,12,ES_AUTOHSCROLL | WS_GROUP
    RTEXT           "Masken Hinweise",IDC_FILEMASK_HINT,250,169,38,8,NOT WS_GROUP | WS_TABSTOP
END

IDD_CFGPAGE_VIEWS DIALOGEX 51, 24, 299, 231
