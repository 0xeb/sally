IDD_SALMON_MAIN DIALOGEX 81, 47, 351, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Sally 버그 보고 도구"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "문제가 발생하여 Sally가 중지되었으며 충돌 보고서가 이 컴퓨터에 저장되었습니다. GitHub에서 문제를 보고해 주십시오. Sally가 브라우저에서 간단한 요약이 포함된 새 이슈를 열며, 제출하기 전에 내용을 검토할 수 있습니다.",IDC_SALMON_INTRO,8,7,336,32
    LTEXT           "...",IDC_SALMON_PROGRESS,8,42,84,8
    LTEXT           "오류 설명(선택 사항)",IDC_SALMON_DESCRIPTION,8,46,240,8
