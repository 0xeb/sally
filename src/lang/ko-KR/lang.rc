/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_VIEWERMENU MENU
{
 POPUP "파일(&F)"
 {
  MENUITEM "열기(&O)...\tCtrl+O", CM_OPENFILE
  MENUITEM "새로 고침(&R)\tCtrl+R", CM_REREADFILE
  MENUITEM SEPARATOR
  
// POZOR: pokud se zmeni index tohoto submenu, je potreba zmenit VIEWER_FILE_MENU_OTHFILESINDEX
  POPUP "기타 파일(&H)"
  {
   MENUITEM "이전(&P)\tBackspace", CM_PREVFILE
   MENUITEM "다음(&N)\tSpace", CM_NEXTFILE
   MENUITEM SEPARATOR
   MENUITEM "이전 선택 파일(&R)\tCtrl+Backspace", CM_PREVSELFILE
   MENUITEM "다음 선택 파일(&E)\tCtrl+Space", CM_NEXTSELFILE
   MENUITEM SEPARATOR
   MENUITEM "처음(&F)\tShift+Backspace", CM_FIRSTFILE
   MENUITEM "마지막(&L)\tShift+Space", CM_LASTFILE
  } 
  
  MENUITEM SEPARATOR
  MENUITEM "끝내기(&X)\tAlt+F4", CM_EXIT
 }

 POPUP "편집(&E)"
 {
  MENUITEM "복사(&C)\tCtrl+C", CM_COPYTOCLIP
  MENUITEM "파일로 복사(&O)...\tCtrl+S", CM_COPYTOFILE
  MENUITEM SEPARATOR
  MENUITEM "모두 선택(&A)\tCtrl+A", CM_SELECTALLTEXT
 }

 POPUP "검색(&S)"
 {
  MENUITEM "찾기(&F)...\tCtrl+F", CM_FINDSET
  MENUITEM "다음 찾기(&N)\tCtrl+N", CM_FINDNEXT
  MENUITEM "이전 찾기(&P)\tCtrl+P", CM_FINDPREV
 }

 POPUP "보기(&V)"
 {
  MENUITEM "자동 선택(&A)", CM_VIEW_AUTOSEL
  MENUITEM SEPARATOR
  MENUITEM "16진수(&H)\tCtrl+H", CM_TO_HEX
  MENUITEM "텍스트(&T)\tCtrl+T", CM_TO_TEXT
  MENUITEM SEPARATOR
  MENUITEM "기본값으로 설정(&S)", CM_VIEW_SETDEFAULT
  MENUITEM SEPARATOR
  MENUITEM "전체 화면(&F)\tF11", CM_VIEW_FULLSCREEN
  MENUITEM SEPARATOR
  MENUITEM "오프셋으로 이동(&G)...\tCtrl+G", CM_GOTOOFFSET
  MENUITEM SEPARATOR
  MENUITEM "자동 줄 바꿈(&W)\tCtrl+W", CM_WRAPED
 }

 POPUP "옵션(&O)"
 {
  MENUITEM "설정(&C)...", CM_VIEWER_CONFIG
  MENUITEM SEPARATOR
  MENUITEM "선택 영역을 클립보드에 자동 복사(&A)", CM_VIEWER_AUTOCOPY
 }

 POPUP "도움말(&H)"
 {
  MENUITEM "목차(&C)\tF1", CM_VIEWERHLP_INTRO
  MENUITEM "단축키(&K)", CM_VIEWERHLP_KEYBOARD
 }
}

IDM_VIEWERCONTEXTMENU MENU
{
 POPUP ""
 {
  MENUITEM "복사(&C)\tCtrl+C", CM_COPYTOCLIP
  MENUITEM "파일로 복사(&O)...", CM_COPYTOFILE
  MENUITEM SEPARATOR
  MENUITEM "모두 선택(&A)\tCtrl+A", CM_SELECTALLTEXT
  MENUITEM SEPARATOR
  MENUITEM "찾기(&F)...\tCtrl+F", CM_FINDSET
  MENUITEM "다음 찾기(&N)\tCtrl+N", CM_FINDNEXT
  MENUITEM "이전 찾기(&P)\tCtrl+P", CM_FINDPREV
  MENUITEM SEPARATOR
  MENUITEM "16진수(&H)\tCtrl+H", CM_TO_HEX
  MENUITEM "텍스트(&T)\tCtrl+T", CM_TO_TEXT
  MENUITEM SEPARATOR
  MENUITEM "오프셋으로 이동(&G)...\tCtrl+G", CM_GOTOOFFSET
  MENUITEM SEPARATOR
  MENUITEM "자동 줄 바꿈(&W)\tCtrl+W", CM_WRAPED
 }
}

