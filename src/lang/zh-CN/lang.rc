    LTEXT           "像素(在列头行中拖动列宽)",IDC_VIEW_TEXT2,167,154,114,8
    CONTROL         "在左侧面板中固定列宽(&x):",IDC_VIEW_RIGHT_FIXED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,9,166,128,12
    EDITTEXT        IDC_VIEW_RIGHT_WIDTH,138,166,26,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "像素(在列头行中拖动列宽)",IDC_VIEW_TEXT5,167,168,114,8
    LTEXT           "注意: 不勾选 = 列宽适应列中的最长值",IDC_VIEW_TEXT6,9,180,231,8
    GROUPBOX        " 为选定的视图设置智能模式(使""名称""列变窄以减少滚动)，在: ",IDC_VIEW_TEXT7,1,194,295,37,WS_GROUP
