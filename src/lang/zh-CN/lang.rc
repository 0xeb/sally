/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_VIEWERMENU MENU
{
 POPUP "文件(&F)"
 {
  MENUITEM "打开(&O)...\tCtrl+O", CM_OPENFILE
  MENUITEM "刷新(&R)\tCtrl+R", CM_REREADFILE
  MENUITEM SEPARATOR
  
// POZOR: pokud se zmeni index tohoto submenu, je potreba zmenit VIEWER_FILE_MENU_OTHFILESINDEX
  POPUP "其他文件(&H)"
  {
   MENUITEM "上一个(&P)\tBackspace", CM_PREVFILE
   MENUITEM "下一个(&N)\tSpace", CM_NEXTFILE
   MENUITEM SEPARATOR
   MENUITEM "上一个选中的(&r)\tCtrl+Backspace", CM_PREVSELFILE
   MENUITEM "下一个选中的(&e)\tCtrl+Space", CM_NEXTSELFILE
   MENUITEM SEPARATOR
   MENUITEM "第一个(&F)\tShift+Backspace", CM_FIRSTFILE
   MENUITEM "最后一个(&L)\tShift+Space", CM_LASTFILE
  } 
  
  MENUITEM SEPARATOR
  MENUITEM "退出(&x)\tAlt+F4", CM_EXIT
 }

 POPUP "编辑(&E)"
 {
  MENUITEM "复制(&C)\tCtrl+C", CM_COPYTOCLIP
  MENUITEM "复制到文件(&o)...\tCtrl+S", CM_COPYTOFILE
  MENUITEM SEPARATOR
  MENUITEM "选择全部(&A)\tCtrl+A", CM_SELECTALLTEXT
 }

 POPUP "搜索(&S)"
 {
  MENUITEM "查找(&F)...\tCtrl+F", CM_FINDSET
  MENUITEM "查找下一个(&N)\tCtrl+N", CM_FINDNEXT
  MENUITEM "查找上一个(&P)\tCtrl+P", CM_FINDPREV
 }

 POPUP "查看(&V)"
