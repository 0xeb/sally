IDD_CFGPAGE_SYSTEM DIALOGEX 71, 58, 299, 231
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "回收站"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "您可以选择是否将删除的文件和目录放置在回收站或从磁盘被永久删除。",IDC_STATIC_1,1,4,278,16
    GROUPBOX        "    ",IDC_STATIC_11,2,28,295,57
    LTEXT           "按住 SHIFT 键永久删除文件和目录。",IDC_STATIC_4,9,42,186,8,NOT WS_GROUP
    LTEXT           "确认由""回收站""属性驱动。",IDC_STATIC_5,9,51,174,8,NOT WS_GROUP
    LTEXT           "删除操作由 Windows 执行，所以高级功能",IDC_STATIC_6,9,60,227,8,NOT WS_GROUP
    LTEXT           "如：详细进度栏、跳过和重试，不被支持。",IDC_STATIC_7,9,69,220,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_10,2,95,295,37
    LTEXT           "按住 SHIFT 来移动文件和目录到""回收站""。",IDC_STATIC_2,9,107,202,8,NOT WS_GROUP
    LTEXT           "确认由""确认""页面驱动。",IDC_STATIC_3,9,116,164,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_12,2,142,295,57
    CONTROL         "移动所有删除的文件和目录到""回收站""(&a)",IDR_RECYCLE2,
                    "Button",BS_AUTORADIOBUTTON | BS_VCENTER | WS_GROUP | WS_TABSTOP,9,27,196,12
    CONTROL         "当删除时立即移除文件和目录(&R)",IDR_RECYCLE1,
                    "Button",BS_AUTORADIOBUTTON,9,93,197,12
    CONTROL         "移动以下文件到""回收站""，其他的永久删除(&f)",IDR_RECYCLE3,
                    "Button",BS_AUTORADIOBUTTON,9,141,232,12
    LTEXT           "按住 SHIFT 永久删除文件和目录。",IDC_STATIC_8,9,175,186,8,NOT WS_GROUP
    LTEXT           "确认由""确认""页面驱动。",IDC_STATIC_9,9,184,164,8,NOT WS_GROUP
    EDITTEXT        IDE_RECYCLEMASKS,9,156,279,12,ES_AUTOHSCROLL | WS_GROUP
    RTEXT           "过滤提示",IDC_FILEMASK_HINT,250,169,38,8,NOT WS_GROUP | WS_TABSTOP
END

IDD_CFGPAGE_VIEWS DIALOGEX 51, 24, 299, 231
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
