IDD_CFGPAGE_SYSTEM DIALOGEX 71, 58, 299, 231
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Recycle Bin"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Poti alege daca fisierele sterse si directoarele vor fi duse in Recycle Bin sau vor fi sterse permanent de pe disk.",IDC_STATIC_1,1,4,278,16
    GROUPBOX        "    ",IDC_STATIC_11,2,28,295,57
    LTEXT           "Tine tasta SHIFT apasata pentru a sterge fisierele si directoarele permanent.",IDC_STATIC_4,9,42,186,8,NOT WS_GROUP
    LTEXT           "Confirmarile sunt date de proprietatile Recycle Bin.",IDC_STATIC_5,9,51,174,8,NOT WS_GROUP
    LTEXT           "Operatiunea de stergere e facuta de Windows, deci functiile avansate cum ar",IDC_STATIC_6,9,60,227,8,NOT WS_GROUP
    LTEXT           "fi o bara de progresie detaliata, sari peste, si mai incearca nu sunt suportate.",IDC_STATIC_7,9,69,220,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_10,2,95,295,37
    LTEXT           "Tine tasta SHIFT apasata pentru a muta fisierele si directoarele la Recycle Bin.",IDC_STATIC_2,9,107,202,8,NOT WS_GROUP
    LTEXT           "Confirmarile sunt date de pagina de Confirmari.",IDC_STATIC_3,9,116,164,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_12,2,142,295,57
    CONTROL         "Muta &toate fisierele si directoarele sterse in Recycle Bin",IDR_RECYCLE2,
                    "Button",BS_AUTORADIOBUTTON | BS_VCENTER | WS_GROUP | WS_TABSTOP,9,27,196,12
    CONTROL         "&Scoate fisierele si directoarele imediat dupa ce sunt sterse",IDR_RECYCLE1,
                    "Button",BS_AUTORADIOBUTTON,9,93,197,12
    CONTROL         "Muta &urmatoarele fisiere in Recycle Bin, sterge-le pe celelalte permanent",IDR_RECYCLE3,
                    "Button",BS_AUTORADIOBUTTON,9,141,232,12
    LTEXT           "Tine tasta SHIFT apasata pentru a sterge fisierele si directoarele permanent.",IDC_STATIC_8,9,175,186,8,NOT WS_GROUP
    LTEXT           "Confirmarile sunt date de pagina de Confirmari.",IDC_STATIC_9,9,184,164,8,NOT WS_GROUP
    EDITTEXT        IDE_RECYCLEMASKS,9,156,279,12,ES_AUTOHSCROLL | WS_GROUP
    RTEXT           "masca indicii",IDC_FILEMASK_HINT,250,169,38,8,NOT WS_GROUP | WS_TABSTOP
END

