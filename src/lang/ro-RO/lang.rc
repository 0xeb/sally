/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_VIEWERMENU MENU
{
 POPUP "&Fisier"
 {
  MENUITEM "&Deschide...\tCtrl+O", CM_OPENFILE
  MENUITEM "&Reimprospateaza\tCtrl+R", CM_REREADFILE
  MENUITEM SEPARATOR
  
// POZOR: pokud se zmeni index tohoto submenu, je potreba zmenit VIEWER_FILE_MENU_OTHFILESINDEX
  POPUP "&Alte fisiere"
  {
   MENUITEM "&Anterior\tBackspace", CM_PREVFILE
   MENUITEM "Urmat&orul\tSpace", CM_NEXTFILE
   MENUITEM SEPARATOR
   MENUITEM "Selectat A&nterior\tCtrl+Backspace", CM_PREVSELFILE
   MENUITEM "Selectat U&rmator\tCtrl+Space", CM_NEXTSELFILE
   MENUITEM SEPARATOR
   MENUITEM "&Primul\tShift+Backspace", CM_FIRSTFILE
   MENUITEM "Ulti&mul\tShift+Space", CM_LASTFILE
  } 
  
  MENUITEM SEPARATOR
  MENUITEM "E&xit\tAlt+F4", CM_EXIT
 }

 POPUP "&Editeaza"
 {
  MENUITEM "&Copie\tCtrl+C", CM_COPYTOCLIP
  MENUITEM "C&opie in Fisierul...\tCtrl+S", CM_COPYTOFILE
  MENUITEM SEPARATOR
  MENUITEM "Selecteaza &Tot\tCtrl+A", CM_SELECTALLTEXT
 }

 POPUP "&Cauta"
 {
  MENUITEM "&Gaseste...\tCtrl+F", CM_FINDSET
  MENUITEM "Gaseste &Urmatorul\tCtrl+N", CM_FINDNEXT
  MENUITEM "Gaseste &Anterior\tCtrl+P", CM_FINDPREV
 }

 POPUP "&Vizualizeaza"
 {
  MENUITEM "&Auto-Select", CM_VIEW_AUTOSEL
  MENUITEM SEPARATOR
  MENUITEM "&Hex\tCtrl+H", CM_TO_HEX
  MENUITEM "&Text\tCtrl+T", CM_TO_TEXT
  MENUITEM SEPARATOR
  MENUITEM "&Seteaza ca Default", CM_VIEW_SETDEFAULT
  MENUITEM SEPARATOR
  MENUITEM "&Pe Tot Ecranul\tF11", CM_VIEW_FULLSCREEN
  MENUITEM SEPARATOR
  MENUITEM "&Mergi la Poziție...\tCtrl+G", CM_GOTOOFFSET
  MENUITEM SEPARATOR
  MENUITEM "&Impacheteaza\tCtrl+W", CM_WRAPED
 }

 POPUP "&Optiuni"
 {
  MENUITEM "&Configuratie...", CM_VIEWER_CONFIG
  MENUITEM SEPARATOR
  MENUITEM "&Auto-Copie Selectia in Clipboard", CM_VIEWER_AUTOCOPY
 }

 POPUP "&Help"
 {
  MENUITEM "&Continut\tF1", CM_VIEWERHLP_INTRO
  MENUITEM "Scurtaturi &Tastatura", CM_VIEWERHLP_KEYBOARD
 }
}

