    CONTROL         "P&ravý panel (pouze pro volnou šířku sloupce Název; použijte Ctrl+N v pravém panelu)",IDC_VIEW_RIGHT_SMARTMODE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,9,217,285,12
END

