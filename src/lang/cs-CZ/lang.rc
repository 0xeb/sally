IDD_CFGPAGE_SYSTEM DIALOGEX 71, 58, 299, 231
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Koš"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Můžete zvolit, zda budou mazané soubory a adresáře přesunuty do koše nebo trvale odstraněny z Vašeho disku.",IDC_STATIC_1,1,4,278,16
    GROUPBOX        "    ",IDC_STATIC_11,2,28,295,57
    LTEXT           "Podržte klávesu Shift pro trvalé odstranění souborů a adresářů.",IDC_STATIC_4,9,42,186,8,NOT WS_GROUP
    LTEXT           "Potvrzování se řídí vlastnostmi koše.",IDC_STATIC_5,9,51,174,8,NOT WS_GROUP
    LTEXT           "Operaci mazání provádí systém Windows, takže nejsou podporovány pokročilé",IDC_STATIC_6,9,60,227,8,NOT WS_GROUP
    LTEXT           "funkce jako je podrobný průběh operace, možnosti přeskočit a opakovat.",IDC_STATIC_7,9,69,220,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_10,2,95,295,37
    LTEXT           "Podržte klávesu Shift pro přesunutí mazaných souborů a adresářů do koše.",IDC_STATIC_2,9,107,202,8,NOT WS_GROUP
    LTEXT           "Potvrzování se řídí na stránce Potvrzení.",IDC_STATIC_3,9,116,164,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_12,2,142,295,57
    CONTROL         "&Přesunout všechny mazané soubory a adresáře do koše",IDR_RECYCLE2,
                    "Button",BS_AUTORADIOBUTTON | BS_VCENTER | WS_GROUP | WS_TABSTOP,9,27,196,12
    CONTROL         "P&o smazání soubory a adresáře okamžitě odstranit",IDR_RECYCLE1,
                    "Button",BS_AUTORADIOBUTTON,9,93,197,12
    CONTROL         "Přesunout následující mazané &soubory do koše, ostatní trvale odstranit",IDR_RECYCLE3,
                    "Button",BS_AUTORADIOBUTTON,9,141,232,12
    LTEXT           "Podržte klávesu Shift pro trvalé odstranění souborů a adresářů.",IDC_STATIC_8,9,175,186,8,NOT WS_GROUP
    LTEXT           "Potvrzování se řídí na stránce Potvrzení.",IDC_STATIC_9,9,184,164,8,NOT WS_GROUP
    EDITTEXT        IDE_RECYCLEMASKS,9,156,279,12,ES_AUTOHSCROLL | WS_GROUP
    RTEXT           "nápověda k masce",IDC_FILEMASK_HINT,250,169,38,8,NOT WS_GROUP | WS_TABSTOP
END

IDD_CFGPAGE_VIEWS DIALOGEX 51, 24, 299, 231
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
