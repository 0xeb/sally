END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_VIEWERMENU MENU
{
 POPUP "&Soubor"
 {
  MENUITEM "&Otevřít...\tCtrl+O", CM_OPENFILE
  MENUITEM "&Aktualizovat\tCtrl+R", CM_REREADFILE
  MENUITEM SEPARATOR
  
// POZOR: pokud se zmeni index tohoto submenu, je potreba zmenit VIEWER_FILE_MENU_OTHFILESINDEX
  POPUP "&Další soubory"
  {
   MENUITEM "&Předchozí\tBackspace", CM_PREVFILE
   MENUITEM "&Další\tMezerník", CM_NEXTFILE
   MENUITEM SEPARATOR
   MENUITEM "Př&edchozí vybraný\tCtrl+Backspace", CM_PREVSELFILE
   MENUITEM "D&alší vybraný\tCtrl+Mezerník", CM_NEXTSELFILE
   MENUITEM SEPARATOR
   MENUITEM "P&rvní\tShift+Backspace", CM_FIRSTFILE
   MENUITEM "P&oslední\tShift+Mezerník", CM_LASTFILE
  } 
  
  MENUITEM SEPARATOR
  MENUITEM "&Konec\tAlt+F4", CM_EXIT
 }

 POPUP "&Upravit"
 {
  MENUITEM "&Kopírovat\tCtrl+C", CM_COPYTOCLIP
  MENUITEM "K&opírovat do souboru...\tCtrl+S", CM_COPYTOFILE
  MENUITEM SEPARATOR
  MENUITEM "Vybrat &vše\tCtrl+A", CM_SELECTALLTEXT
 }

 POPUP "&Hledat"
 {
  MENUITEM "&Najít...\tCtrl+F", CM_FINDSET
  MENUITEM "Najít &další\tCtrl+N", CM_FINDNEXT
  MENUITEM "Najít &předchozí\tCtrl+P", CM_FINDPREV
 }

 POPUP "&Zobrazit"
 {
  MENUITEM "&Volit automaticky", CM_VIEW_AUTOSEL
  MENUITEM SEPARATOR
  MENUITEM "&Šestnáctkově\tCtrl+H", CM_TO_HEX
  MENUITEM "&Textově\tCtrl+T", CM_TO_TEXT
  MENUITEM SEPARATOR
  MENUITEM "&Nastavit jako výchozí", CM_VIEW_SETDEFAULT
  MENUITEM SEPARATOR
  MENUITEM "&Celá obrazovka\tF11", CM_VIEW_FULLSCREEN
  MENUITEM SEPARATOR
  MENUITEM "&Přejít na pozici...\tCtrl+G", CM_GOTOOFFSET
  MENUITEM SEPARATOR
  MENUITEM "&Zalamovat\tCtrl+W", CM_WRAPED
 }

 POPUP "&Možnosti"
 {
  MENUITEM "&Konfigurace...", CM_VIEWER_CONFIG
  MENUITEM SEPARATOR
  MENUITEM "&Automaticky kopírovat výběr do schránky", CM_VIEWER_AUTOCOPY
 }

 POPUP "Ná&pověda"
 {
  MENUITEM "&Obsah\tF1", CM_VIEWERHLP_INTRO
  MENUITEM "&Klávesové zkratky", CM_VIEWERHLP_KEYBOARD
 }
}

IDM_VIEWERCONTEXTMENU MENU
{
 POPUP ""
 {
  MENUITEM "&Kopírovat\tCtrl+C", CM_COPYTOCLIP
  MENUITEM "K&opírovat do...", CM_COPYTOFILE
  MENUITEM SEPARATOR
  MENUITEM "Vybrat &vše\tCtrl+A", CM_SELECTALLTEXT
  MENUITEM SEPARATOR
  MENUITEM "&Najít...\tCtrl+F", CM_FINDSET
  MENUITEM "Najít &další\tCtrl+N", CM_FINDNEXT
  MENUITEM "Najít &předchozí\tCtrl+P", CM_FINDPREV
  MENUITEM SEPARATOR
  MENUITEM "&Šestnáctkově\tCtrl+H", CM_TO_HEX
  MENUITEM "&Textově\tCtrl+T", CM_TO_TEXT
  MENUITEM SEPARATOR
  MENUITEM "Př&ejít na pozici...\tCtrl+G", CM_GOTOOFFSET
  MENUITEM SEPARATOR
  MENUITEM "&Zalamování řádků\tCtrl+W", CM_WRAPED
 }
}

