    EDITTEXT        IDE_VGTO_OFFSET,8,18,189,12,ES_AUTOHSCROLL | WS_GROUP
    CONTROL         "Š&estnáctkově",IDC_VGTO_HEX,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,8,33,60,12
    DEFPUSHBUTTON   "OK",IDOK,19,59,50,14,WS_GROUP
    PUSHBUTTON      "Storno",IDCANCEL,77,59,50,14
    PUSHBUTTON      "Nápověda",IDHELP,135,59,50,14
END

