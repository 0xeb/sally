    LTEXT           "Klepnutím na tlačítko Přeskočit se cíl odkazu vynechá a vytvoří se jen prázdný adresář.",IDC_STATIC_2,37,51,310,8,SS_NOPREFIX
END

IDD_VIEWERGOTOOFFSET DIALOGEX 75, 140, 205, 81
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Přejít na pozici"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
