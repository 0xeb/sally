                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,9,152,122,12
    EDITTEXT        IDC_VIEW_LEFT_WIDTH,138,152,26,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "bodů (šířku změníte tažením v záhlaví)",IDC_VIEW_TEXT2,167,154,114,8
    CONTROL         "P&evná šířka sloupce v pravém panelu:",IDC_VIEW_RIGHT_FIXED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,9,166,128,12
    EDITTEXT        IDC_VIEW_RIGHT_WIDTH,138,166,26,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "bodů (šířku změníte tažením v záhlaví)",IDC_VIEW_TEXT5,167,168,114,8
    LTEXT           "Poznámka: nezaškrtnuto = šířka sloupce odpovídá nejdelší hodnotě ve sloupci",IDC_VIEW_TEXT6,9,180,231,8
    GROUPBOX        " Chytrý režim (úzký sloupec Název pro omezení rolování) pro vybrané zobrazení v: ",IDC_VIEW_TEXT7,1,194,295,37,WS_GROUP
