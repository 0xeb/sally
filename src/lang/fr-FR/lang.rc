IDM_VIEWERMENU MENU
{
 POPUP "&Fichier"
 {
  MENUITEM "&Ouvrir...\tCtrl+O", CM_OPENFILE
  MENUITEM "Mett&re à jour\tCtrl+R", CM_REREADFILE
  MENUITEM SEPARATOR
  
// POZOR: pokud se zmeni index tohoto submenu, je potreba zmenit VIEWER_FILE_MENU_OTHFILESINDEX
  POPUP "&Autres fichiers"
  {
   MENUITEM "&Précédent\tEspace arrière", CM_PREVFILE
   MENUITEM "&Suivant\tEspace", CM_NEXTFILE
   MENUITEM SEPARATOR
   MENUITEM "Pré&cédemment sélectionné\tCtrl+Espace arrière", CM_PREVSELFILE
   MENUITEM "Suivant sél&ectionné\tCtrl+Espace", CM_NEXTSELFILE
   MENUITEM SEPARATOR
   MENUITEM "P&remier\tMAJ+Espace arrière", CM_FIRSTFILE
   MENUITEM "&Dernier\tMAJ+Espace", CM_LASTFILE
  } 
  
  MENUITEM SEPARATOR
  MENUITEM "&Quitter\tAlt+F4", CM_EXIT
 }

 POPUP "&Édition"
 {
  MENUITEM "&Copier\tCtrl+C", CM_COPYTOCLIP
