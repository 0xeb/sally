    LTEXT           "pixels (glisser/déposer la largeur dans le bandeau d'en-tête)",IDC_VIEW_TEXT2,167,154,114,8
    CONTROL         "Largeur con&stante des colonnes du panneau droit:",IDC_VIEW_RIGHT_FIXED,
                    "Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,9,166,128,12
    EDITTEXT        IDC_VIEW_RIGHT_WIDTH,138,166,26,12,ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "pixels (glisser/déposer la largeur dans le bandeau d'en-tête)",IDC_VIEW_TEXT5,167,168,114,8
    LTEXT           "Note : la largeur d'une colonne désélectionnée correspond au plus long élément de la colonne",IDC_VIEW_TEXT6,9,180,231,8
