  MENUITEM "&Aller à décalage...\tCtrl+G", CM_GOTOOFFSET
  MENUITEM SEPARATOR
  MENUITEM "&Wrap\tCtrl+W", CM_WRAPED
 }

 POPUP "&Options"
 {
