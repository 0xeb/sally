IDD_BETAEXPIRED DIALOGEX 84, 53, 291, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Sally"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "&Quitter",IDCANCEL,92,57,50,14,WS_GROUP
    PUSHBUTTON      "&Continuer",IDOK,149,57,50,14
    LTEXT           "Cette version beta a expiré. Veuillez télécharger et installer une version beta à jour:",IDC_STATIC_1,10,10,274,8
