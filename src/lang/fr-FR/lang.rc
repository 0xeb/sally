IDD_CFGPAGE_SYSTEM DIALOGEX 71, 58, 299, 231
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Corbeille"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Décider si les fichiers et répertoires suppimés sont placés dans la Corbeille avant leur destruction définitive du disque.",IDC_STATIC_1,1,4,278,16
    GROUPBOX        "    ",IDC_STATIC_11,2,28,295,57
    LTEXT           "Appuyer en même temps sur MAJ pour détruire définitivement fichiers ou répertoires.",IDC_STATIC_4,9,42,186,8,NOT WS_GROUP
    LTEXT           "Le régime des confirmations est régi par les propriétés de la Corbeille.",IDC_STATIC_5,9,51,174,8,NOT WS_GROUP
    LTEXT           "La suppression est effectuée par Windows ; les fonctions avancées",IDC_STATIC_6,9,60,227,8,NOT WS_GROUP
    LTEXT           "comme la barre de progression, le saut ou le réessai ne sont pas disponibles.",IDC_STATIC_7,9,69,220,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_10,2,95,295,37
    LTEXT           "Appuyer en même temps sur MAJ pour déplacer des fichiers ou des répertoires vers la Corbeille.",IDC_STATIC_2,9,107,202,8,NOT WS_GROUP
    LTEXT           "Les confirmations sont régies par la page Confirmations.",IDC_STATIC_3,9,116,164,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_12,2,142,295,57
    CONTROL         "Déplacer &tous les fichiers ou répertoires à supprimer dans la Corbeille",IDR_RECYCLE2,
                    "Button",BS_AUTORADIOBUTTON | BS_VCENTER | WS_GROUP | WS_TABSTOP,9,27,196,12
    CONTROL         "&Retirer immédiatement les fichiers ou répertoires après leur suppression",IDR_RECYCLE1,
                    "Button",BS_AUTORADIOBUTTON,9,93,197,12
    CONTROL         "Déplacer les &fichiers suivants vers la Corbeille, détruire les autres définitivement",IDR_RECYCLE3,
                    "Button",BS_AUTORADIOBUTTON,9,141,232,12
    LTEXT           "Appuyer en même temps sur MAJ pour détruire définitivement fichiers ou répertoires.",IDC_STATIC_8,9,175,186,8,NOT WS_GROUP
    LTEXT           "Les confirmations sont régies par la page Confirmations.",IDC_STATIC_9,9,184,164,8,NOT WS_GROUP
    EDITTEXT        IDE_RECYCLEMASKS,9,156,279,12,ES_AUTOHSCROLL | WS_GROUP
    RTEXT           "indications sur les masques",IDC_FILEMASK_HINT,250,169,38,8,NOT WS_GROUP | WS_TABSTOP
END

IDD_CFGPAGE_VIEWS DIALOGEX 51, 24, 299, 231
