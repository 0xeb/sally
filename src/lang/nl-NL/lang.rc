IDD_CFGPAGE_SYSTEM DIALOGEX 71, 58, 299, 231
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Prullenbak"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "U kunt kiezen of gewiste bestanden en mappen in de prullenbak gelegd worden of dat ze permanent van de schijf gewist worden.",IDC_STATIC_1,1,4,278,16
    GROUPBOX        "    ",IDC_STATIC_11,2,28,295,57
    LTEXT           "Houdt SHIFT vast om bestanden en mappen permanent te wissen.",IDC_STATIC_4,9,42,186,8,NOT WS_GROUP
    LTEXT           "Bevestigingen worden conform de 'prullenbak' instellingen gehandhaafd.",IDC_STATIC_5,9,51,174,8,NOT WS_GROUP
    LTEXT           "De 'wis' operaties worden via Windows uitgevoerd, geavanceerde functies",IDC_STATIC_6,9,60,227,8,NOT WS_GROUP
    LTEXT           "zoals progressbar, overslaan en herhalen worden niet ondersteund.",IDC_STATIC_7,9,69,220,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_10,2,95,295,37
    LTEXT           "Houd SHIFT vast om bestanden en mappen naar de prullenbak te verplaatsen.",IDC_STATIC_2,9,107,202,8,NOT WS_GROUP
    LTEXT           "Bevestigingen worde gehanteerd conform de 'Bevestigingen' pagina.",IDC_STATIC_3,9,116,164,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_12,2,142,295,57
    CONTROL         "&Alle gewiste bestanden en mappen naar de prullenbak verplaatsen",IDR_RECYCLE2,
                    "Button",BS_AUTORADIOBUTTON | BS_VCENTER | WS_GROUP | WS_TABSTOP,9,27,196,12
    CONTROL         "&Bestanden en mappen permanent wissen",IDR_RECYCLE1,
                    "Button",BS_AUTORADIOBUTTON,9,93,197,12
    CONTROL         "Verplaats &volgende bestanden naar de prullenbak. Wis andere permanent",IDR_RECYCLE3,
                    "Button",BS_AUTORADIOBUTTON,9,141,232,12
    LTEXT           "Houd SHIFT toets om bestanden en mappen permanent te wissen.",IDC_STATIC_8,9,175,186,8,NOT WS_GROUP
    LTEXT           "Bevestigingen worde gehanteerd conform de 'Bevestigingen' pagina.",IDC_STATIC_9,9,184,164,8,NOT WS_GROUP
    EDITTEXT        IDE_RECYCLEMASKS,9,156,279,12,ES_AUTOHSCROLL | WS_GROUP
    RTEXT           "masker hints",IDC_FILEMASK_HINT,250,169,38,8,NOT WS_GROUP | WS_TABSTOP
END

