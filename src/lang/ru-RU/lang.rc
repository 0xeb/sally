IDM_VIEWERMENU MENU
{
 POPUP "&Файл"
 {
  MENUITEM "&Открыть...\tCtrl+O", CM_OPENFILE
  MENUITEM "О&бновить\tCtrl+R", CM_REREADFILE
  MENUITEM SEPARATOR
  
// POZOR: pokud se zmeni index tohoto submenu, je potreba zmenit VIEWER_FILE_MENU_OTHFILESINDEX
  POPUP "&Другие файлы"
  {
   MENUITEM "&Предыдущий\tBackspace", CM_PREVFILE
   MENUITEM "&Следующий\tПробел", CM_NEXTFILE
   MENUITEM SEPARATOR
   MENUITEM "П&редыдущее выделение\tCtrl+Backspace", CM_PREVSELFILE
   MENUITEM "С&ледующее выделение\tCtrl+Пробел", CM_NEXTSELFILE
   MENUITEM SEPARATOR
   MENUITEM "П&ервый\tShift+Backspace", CM_FIRSTFILE
   MENUITEM "П&оследний\tShift+Пробел", CM_LASTFILE
  } 
  
  MENUITEM SEPARATOR
  MENUITEM "&Выход\tAlt+F4", CM_EXIT
 }

 POPUP "&Правка"
 {
  MENUITEM "&Копировать\tCtrl+C", CM_COPYTOCLIP
  MENUITEM "К&опировать в файл...\tCtrl+S", CM_COPYTOFILE
  MENUITEM SEPARATOR
  MENUITEM "&Выделить все\tCtrl+A", CM_SELECTALLTEXT
 }

 POPUP "П&оиск"
 {
  MENUITEM "&Найти...\tCtrl+F", CM_FINDSET
  MENUITEM "Н&айти следующее\tCtrl+N", CM_FINDNEXT
  MENUITEM "На&йти предыдущее\tCtrl+P", CM_FINDPREV
 }

 POPUP "&Вид"
 {
