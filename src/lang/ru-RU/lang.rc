    LTEXT           "Политика конфиденциальности: Отчет конфиденциальный и анонимный.",IDC_SALMON_PRIVACY,8,33,259,8
    LTEXT           "...",IDC_SALMON_UPLOADING,8,42,84,8
    LTEXT           "Описание ошибки (не обязательно)",IDC_SALMON_DESCRIPTION,8,51,169,8
    PUSHBUTTON      "П&росмотр отчета",IDC_SALMON_VIEW,254,48,90,14
    LTEXT           "Последнее выполнявшееся &действие:",IDC_SALMON_ACTION_LABEL,8,69,40,8
    EDITTEXT        IDC_SALMON_ACTION,8,79,336,54,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "Адрес &электронной почты:",IDC_SALMON_EMAIL_LABEL,8,144,50,8
    EDITTEXT        IDC_SALMON_EMAIL,8,154,336,14,ES_AUTOHSCROLL
    CONTROL         "&Перезапуск Sally",IDC_SALMON_RESTART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,178,98,10
    DEFPUSHBUTTON   "&Отправить отчет",IDOK,158,176,90,14
    PUSHBUTTON      "&Не отправлять отчет",IDCANCEL,254,176,90,14
END

IDD_CONFIRMLINKTGTCOPY DIALOGEX 15, 34, 352, 96
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Подтверждение копирования файлов по ссылке"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "&Да",IDYES,31,73,50,14,WS_GROUP
    PUSHBUTTON      "&Все",IDB_ALL,91,73,50,14
    DEFPUSHBUTTON   "П&ропустить",IDB_SKIP,151,73,50,14
    PUSHBUTTON      "Пр&опустить все",IDB_SKIPALL,211,73,50,14
    PUSHBUTTON      "Отмена",IDCANCEL,271,73,50,14
    RTEXT           "Ссылка:",IDC_STATIC_3,3,10,31,8
    LTEXT           "",IDS_FILENAME,37,10,310,8,SS_NOPREFIX | NOT WS_GROUP
    RTEXT           "Детали:",IDC_STATIC_4,3,23,31,8
    EDITTEXT        IDS_DETAILS,35,23,312,9,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Вы хотите выполнить копирование файлов и папок, на которые указывает ссылка?",IDC_STATIC_1,37,43,310,8,SS_NOPREFIX
    LTEXT           "Нажмите кнопку ""Пропустить"", чтобы пропустить копирование файлов по ссылке и создать пустую папку.",IDC_STATIC_2,37,51,310,8,SS_NOPREFIX
END

