  MENUITEM SEPARATOR
  MENUITEM "Переход по сме&щению...\tCtrl+G", CM_GOTOOFFSET
  MENUITEM SEPARATOR
  MENUITEM "П&еренос\tCtrl+W", CM_WRAPED
 }

 POPUP "Параметр&ы"
 {
