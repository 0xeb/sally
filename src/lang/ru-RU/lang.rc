IDD_CFGPAGE_SYSTEM DIALOGEX 71, 58, 299, 231
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Корзина"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Вы можете выбрать способ удаления файлов и папок: уничтожать их сразу или помещать в Корзину.",IDC_STATIC_1,1,4,278,16
    GROUPBOX        "    ",IDC_STATIC_11,2,28,295,57
    LTEXT           "Удерживайте клавишу Shift для безвозвратного удаления файлов и папок.",IDC_STATIC_4,9,42,186,8,NOT WS_GROUP
    LTEXT           "Подтверждения на удаление настраиваются в свойствах Корзины.",IDC_STATIC_5,9,51,174,8,NOT WS_GROUP
    LTEXT           "Операция удаления выполняется средствами Windows, поэтому дополнительные действия при этом",IDC_STATIC_6,9,60,227,8,NOT WS_GROUP
    LTEXT           "недоступны.",IDC_STATIC_7,9,69,220,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_10,2,95,295,37
    LTEXT           "Удерживайте клавишу Shift для удаления файлов и папок в Корзину.",IDC_STATIC_2,9,107,202,8,NOT WS_GROUP
    LTEXT           "Запросы на удаление настраиваются на странице ""Подтверждения"".",IDC_STATIC_3,9,116,164,8,NOT WS_GROUP
    GROUPBOX        "    ",IDC_STATIC_12,2,142,295,57
    CONTROL         "&Перемещать все удаленные файлы и папки в Корзину",IDR_RECYCLE2,
                    "Button",BS_AUTORADIOBUTTON | BS_VCENTER | WS_GROUP | WS_TABSTOP,9,27,196,12
    CONTROL         "&Немедленное удаление файлов и папок",IDR_RECYCLE1,
                    "Button",BS_AUTORADIOBUTTON,9,93,197,12
    CONTROL         "&Удалять указанные файлы в Корзину, остальные - безвозвратно",IDR_RECYCLE3,
                    "Button",BS_AUTORADIOBUTTON,9,141,232,12
    LTEXT           "Удерживайте клавишу Shift для безвозвратного удаления файлов и папок.",IDC_STATIC_8,9,175,186,8,NOT WS_GROUP
    LTEXT           "Запросы на удаление настраиваются на странице ""Подтверждения"".",IDC_STATIC_9,9,184,164,8,NOT WS_GROUP
    EDITTEXT        IDE_RECYCLEMASKS,9,156,279,12,ES_AUTOHSCROLL | WS_GROUP
    RTEXT           "использование масок",IDC_FILEMASK_HINT,250,169,38,8,NOT WS_GROUP | WS_TABSTOP
END

