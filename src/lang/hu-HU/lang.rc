FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Megadhatja, hogy törléskor a törölt fájlok és mappák a Lomtárba kerüljenek vagy véglegesen törlődjenek a lemezről.",IDC_STATIC_1,1,4,278,16
