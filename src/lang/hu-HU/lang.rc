END

IDD_DEFAULT_SHELL DIALOGEX 0, 0, 244, 72
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Alapértelmezett parancssor"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Parancssor megnyitása ezzel:",IDC_STATIC_1,8,9,228,8
    COMBOBOX        IDC_DEFAULT_SHELL_TARGET,8,20,228,108,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,128,50,50,14
    PUSHBUTTON      "Mégse",IDCANCEL,186,50,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_VIEWERMENU MENU
{
 POPUP "&Fájl"
 {
  MENUITEM "&Megnyitás...\tCtrl+O", CM_OPENFILE
  MENUITEM "F&rissítés\tCtrl+R", CM_REREADFILE
  MENUITEM SEPARATOR
  
// POZOR: pokud se zmeni index tohoto submenu, je potreba zmenit VIEWER_FILE_MENU_OTHFILESINDEX
  POPUP "&Egyéb fájlok"
  {
   MENUITEM "Elő&ző\tBackspace", CM_PREVFILE
   MENUITEM "&Következő\tSpace", CM_NEXTFILE
   MENUITEM SEPARATOR
   MENUITEM "Előző kijelöl&t\tCtrl+Backspace", CM_PREVSELFILE
   MENUITEM "Köv&etkező kijelölt\tCtrl+Space", CM_NEXTSELFILE
   MENUITEM SEPARATOR
   MENUITEM "El&ső\tShift+Backspace", CM_FIRSTFILE
   MENUITEM "Uto&lsó\tShift+Space", CM_LASTFILE
  } 
  
  MENUITEM SEPARATOR
  MENUITEM "&Kilépés\tAlt+F4", CM_EXIT
 }

 POPUP "Sz&erkesztés"
 {
  MENUITEM "&Másolás\tCtrl+C", CM_COPYTOCLIP
  MENUITEM "Más&olás fájlba...\tCtrl+S", CM_COPYTOFILE
  MENUITEM SEPARATOR
  MENUITEM "Min&d kijelöl\tCtrl+A", CM_SELECTALLTEXT
 }

 POPUP "&Keresés"
 {
  MENUITEM "&Keresés...\tCtrl+F", CM_FINDSET
  MENUITEM "Követke&ző keresése\tCtrl+N", CM_FINDNEXT
  MENUITEM "&Előző keresése\tCtrl+P", CM_FINDPREV
 }

 POPUP "&Nézet"
 {
  MENUITEM "&Automatikus kijelölés", CM_VIEW_AUTOSEL
  MENUITEM SEPARATOR
  MENUITEM "&Hexa\tCtrl+H", CM_TO_HEX
  MENUITEM "S&zöveges\tCtrl+T", CM_TO_TEXT
  MENUITEM SEPARATOR
  MENUITEM "Alapértelmezé&s", CM_VIEW_SETDEFAULT
  MENUITEM SEPARATOR
  MENUITEM "&Teljes képernyő\tF11", CM_VIEW_FULLSCREEN
  MENUITEM SEPARATOR
  MENUITEM "Eltolásra u&grás...\tCtrl+G", CM_GOTOOFFSET
  MENUITEM SEPARATOR
  MENUITEM "Hosszú sorok tö&rdelése\tCtrl+W", CM_WRAPED
 }

 POPUP "&Beállítások"
 {
  MENUITEM "&Beállítások...", CM_VIEWER_CONFIG
  MENUITEM SEPARATOR
  MENUITEM "Kijelölés &automatikus másolása vágólapra", CM_VIEWER_AUTOCOPY
 }

 POPUP "Sú&gó"
 {
  MENUITEM "&Tartalomjegyzék\tF1", CM_VIEWERHLP_INTRO
  MENUITEM "Billentyűparancso&k", CM_VIEWERHLP_KEYBOARD
 }
}

IDM_VIEWERCONTEXTMENU MENU
{
 POPUP ""
 {
  MENUITEM "&Másolás\tCtrl+C", CM_COPYTOCLIP
  MENUITEM "Más&olás ide...", CM_COPYTOFILE
  MENUITEM SEPARATOR
  MENUITEM "Mi&nd kijelöl\tCtrl+A", CM_SELECTALLTEXT
  MENUITEM SEPARATOR
  MENUITEM "&Keresés...\tCtrl+F", CM_FINDSET
  MENUITEM "Követke&ző keresése\tCtrl+N", CM_FINDNEXT
  MENUITEM "Előző ke&resése\tCtrl+P", CM_FINDPREV
  MENUITEM SEPARATOR
  MENUITEM "&Hexa\tCtrl+H", CM_TO_HEX
  MENUITEM "&Szöveg\tCtrl+T", CM_TO_TEXT
  MENUITEM SEPARATOR
  MENUITEM "Eltolásra u&grás...\tCtrl+G", CM_GOTOOFFSET
  MENUITEM SEPARATOR
  MENUITEM "Hosszú sorok tör&delése\tCtrl+W", CM_WRAPED
 }
}

